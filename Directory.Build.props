<Project>

  <!-- Shared by every project in the repository (apps, tests, tools). -->
  <PropertyGroup>
    <!-- Framework and package satellite assemblies only for the two interface languages; NuGet packages and the runtime
         packs otherwise bring a dozen more. The app's own strings are embedded JSON (docs/localization.md). -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Symbols stay in bin/ for local debugging; published apps (installers, portable zips) do not carry them. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Code analyzers for the shipped code in src/* (build-time only: PrivateAssets keeps them out of the published apps).
       Which rules are warnings and why the rest are off: .editorconfig. Not in tests/* and tools/*: there the findings
       were test literals, console output and deliberate idioms (nested dispatcher frames, synchronous fixture I/O). -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.317" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
