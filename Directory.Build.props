<Project>

  <!-- Shared by every project in the repository (apps, tests, tools). -->
  <PropertyGroup>
    <!-- Framework and package satellite assemblies only for the two interface languages; NuGet packages and the runtime
         packs otherwise bring a dozen more. The app's own strings are embedded JSON (docs/localization.md). -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Symbols stay in bin/ for local debugging; published apps (installers, portable zips) do not carry them. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- CI (HEARTHPULSE_STRICT=true in ci.yml) fails on any warning: compiler, analyzers, XAML. NuGet vulnerability
       advisories (NU1901-NU1904) stay warnings: one published overnight must not stop every branch; it is a task of its
       own. Local builds and the release workflow are unchanged. -->
  <PropertyGroup Condition="'$(HEARTHPULSE_STRICT)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Opt-in edit-compile loop (tools/dev/check.ps1 -Fast sets HEARTHPULSE_FAST=true): no analyzers, so a build is
       quicker but misses their warnings. Never in strict mode: CI and the default check keep every analyzer. -->
  <PropertyGroup Condition="'$(HEARTHPULSE_FAST)' == 'true' and '$(HEARTHPULSE_STRICT)' != 'true'">
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <!-- Code analyzers for every project (build-time only: PrivateAssets keeps them out of the published apps). Which rules
       are warnings and why the rest are off: .editorconfig; tests/* and tools/* get the soft set there (ADR 0003). -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.317" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
