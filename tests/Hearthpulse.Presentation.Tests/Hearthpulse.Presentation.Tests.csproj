<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Code coverage: dotnet test with the "XPlat Code Coverage" collector writes cobertura XML (CI, hearthpulse-testing). -->
    <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
    <Compile Include="..\Hearthpulse.Tests\TestDataFolder.cs" Link="Support\TestDataFolder.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hearthpulse.App\Hearthpulse.App.csproj" />
    <ProjectReference Include="..\..\src\Hearthpulse.UI\Hearthpulse.UI.csproj" />
  </ItemGroup>
</Project>
