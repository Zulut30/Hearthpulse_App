<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform UI shared by the desktop app (Windows, macOS, Linux) and the mobile app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hearthpulse.UI</RootNamespace>
    <Version>0.14.0</Version>
    <HearthpulsePresentationFlavor>Avalonia</HearthpulsePresentationFlavor>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Montserrat: SIL Open Font License 1.1. Material Design Icons: Pictogrammers (Apache 2.0). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared presentation's layout modules (ChartGeometry, CardPreviewLayout, ...) are internal; the tests read them. -->
    <InternalsVisibleTo Include="Hearthpulse.Tests" />
    <InternalsVisibleTo Include="Hearthpulse.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearthpulse.Core\Hearthpulse.Core.csproj" />
  </ItemGroup>

  <Import Project="..\Hearthpulse.Presentation\Hearthpulse.Presentation.projitems" />

</Project>
