            <!-- motifs:end -->
            <DrawingBrush x:Key="MotifBrush" Stretch="Uniform" SourceRect="0,0,1000,1000">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Geometry="{StaticResource MotifTavern}">
                            <GeometryDrawing.Pen>
                                <Pen Brush="{StaticResource AccentLine}" Thickness="8" LineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="{StaticResource MotifTavernAlt}" Brush="{StaticResource Accent2}" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <!-- The content plate: lamplight from the top left, a wash of the second accent and the motif in the bottom right -->
            <DrawingBrush x:Key="ContentFill" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Bottom" SourceRect="0,0,1600,1000">
                <DrawingBrush.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 H1600 V1000 H0 Z">
                        <GeometryDrawing Geometry="M0,0 H1600 V1000 H0 Z">
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush GradientOrigin="25%,0%" Center="25%,0%" RadiusX="100%" RadiusY="90%">
                                    <GradientStop Color="#2D1E12" Offset="0" />
                                    <GradientStop Color="#1D140C" Offset="1" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M0,0 H1600 V1000 H0 Z">
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush GradientOrigin="87%,80%" Center="87%,80%" RadiusX="42%" RadiusY="62%">
                                    <GradientStop Color="#144FC2A8" Offset="0" />
                                    <GradientStop Color="#004FC2A8" Offset="1" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <DrawingGroup>
                            <DrawingGroup.Transform>
                                <MatrixTransform Matrix="0.9,0,0,0.9,950,330" />
                            </DrawingGroup.Transform>
                            <GeometryDrawing Geometry="{StaticResource MotifTavern}">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{StaticResource MotifInk}" Thickness="3" LineCap="Round" LineJoin="Round" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                            <GeometryDrawing Geometry="{StaticResource MotifTavernAlt}" Brush="{StaticResource MotifInk2}" />
                        </DrawingGroup>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <SolidColorBrush x:Key="RarityCommon" Color="#D8CDB8" />
            <SolidColorBrush x:Key="RarityRare" Color="#5B9BFF" />
            <SolidColorBrush x:Key="RarityEpic" Color="#B98AF5" />
            <SolidColorBrush x:Key="RarityLegendary" Color="#FFB547" />

            <SolidColorBrush x:Key="TierS" Color="#FFC857" />
            <SolidColorBrush x:Key="TierA" Color="#8CCF63" />
            <SolidColorBrush x:Key="TierB" Color="#7CC0FF" />
            <SolidColorBrush x:Key="TierC" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="TierD" Color="{StaticResource NegativeColor}" />

            <!-- ===== Type: Montserrat for display (OFL), the platform UI font for text, Material Design Icons ===== -->
            <!-- UiFont is replaced at startup with the platform's UI font (Segoe UI on Windows, Inter elsewhere). -->
            <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="DisplayFont">avares://Hearthpulse.UI/Assets/Fonts#Montserrat</FontFamily>
            <FontFamily x:Key="IconFont">avares://Hearthpulse.UI/Assets/Fonts#Material Design Icons</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource GildedText}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource StatText}" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces: framed panels lit on top, with an edge that catches the accent ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style Selector="Border.overlayCard">
        <Setter Property="Background" Value="{StaticResource OverlayCardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,2" />
    </Style>
    <Style Selector="Border.segmentBar">
        <Setter Property="Background" Value="{StaticResource GrooveFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GrooveEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- ===== Buttons: framed rectangles, gold for the primary action. States fade in (0.12 s) and a press
         shrinks the button a little, as in the WPF theme. ===== -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
        <Setter Property="Background" Value="{StaticResource GhostFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhostEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root" RenderTransform="scale(1)">
                    <Panel.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut" />
                        </Transitions>
                    </Panel.Transitions>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                    <Border Name="Lift" Background="{StaticResource PrimaryFillHover}" CornerRadius="8" Opacity="0" IsVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <!-- Polished metal on the primary button: a bright rim along the top edge -->
                    <Border Name="Sheen" CornerRadius="7" Margin="1" BorderBrush="{StaticResource Sheen}" BorderThickness="0,1,0,0" IsVisible="False" />
                    <Border Name="State" Background="{StaticResource Hover}" CornerRadius="8" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#State">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Panel#Root">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryEdge}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryEdge}" />
    </Style>
    <Style Selector="Button.primary /template/ Border#Lift">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary /template/ Border#Sheen">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#Lift">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#State">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Round icon buttons stay circles. -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="999" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" RenderTransform="scale(1)">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="RenderTransform" Value="scale(0.9)" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- A button with no chrome: the content draws everything (overlay chips, rows). -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Background="{TemplateBinding Background}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A picture as a button (the Settings theme tiles): it lifts a little under the mouse and gives under a press.
         The page sets ContentTemplate. Same as the WPF ThemeSwatch. -->
    <Style Selector="Button.themeSwatch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Background="Transparent" RenderTransform="scale(1)">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.themeSwatch:pointerover /template/ ContentPresenter#Presenter">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.themeSwatch:pressed /template/ ContentPresenter#Presenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- ===== Navigation: the active item is a raised plate with a gold edge and a gold bar on the left (the WPF pill's
         look); plate, bar and lit glyph fade in, hover fades, a press gives a little. ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="10,2" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Bd" CornerRadius="8" Margin="10,2" Background="Transparent">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Border Name="Selected" CornerRadius="8" Margin="10,2" Background="{StaticResource NavSelectedFill}"
                            BorderBrush="{StaticResource NavSelectedEdge}" BorderThickness="1" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                        <Border Name="Bar" Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left" Background="{StaticResource Accent}" />
                    </Border>
                    <!-- Glyph and label share one column grid, so every item's text starts at the same x whatever its glyph -->
                    <Grid Name="Face" ColumnDefinitions="24,*" Margin="26,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0%,50%"
                          RenderTransform="scale(1)">
                        <Grid.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut" />
                            </Transitions>
                        </Grid.Transitions>
                        <!-- No "icon" class here: a class style would outrank these template values in Avalonia. -->
                        <TextBlock Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontSize="20"
                                   FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Name="GlyphLit" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontSize="20"
                                   FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" Opacity="0">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <ContentPresenter Name="Presenter" Grid.Column="1" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Grid#Face">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Selected">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ TextBlock#GlyphLit">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ===== Chips / segmented filter ===== -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bd" CornerRadius="6" Padding="12,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="Check" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="14" FontWeight="Normal"
                                       Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" IsVisible="False" />
                            <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- The selected chip is a raised plate: a lit hairline on its top edge -->
                    <Border Name="Edge" Height="1" Margin="6,1,6,0" VerticalAlignment="Top" Background="{StaticResource EdgeLight}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.segment:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ TextBlock#Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Edge">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Switch (the track stays rounded: it is a toggle) ===== -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <!-- Same as the WPF switch: a Surface4 track with a Muted rim, gold when on; the knob slides and grows -->
                    <Panel Grid.Column="1" Width="48" Height="28">
                        <Border Name="Track" CornerRadius="14" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Muted}" BorderThickness="2" />
                        <Border Name="OnFill" CornerRadius="14" Background="{StaticResource PrimaryFill}" Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Panel Name="Thumb" Width="24" Height="24" HorizontalAlignment="Left" Margin="2,0" RenderTransform="translate(0px,0px) scale(0.67)">
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                                </Transitions>
                            </Panel.Transitions>
                            <Ellipse Name="Knob" Fill="{StaticResource Muted}" />
                            <TextBlock Name="Tick" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="17" FontWeight="Normal"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#OnFill">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Panel#Thumb">
        <Setter Property="RenderTransform" Value="translate(20px,0px) scale(0.83)" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ TextBlock#Tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.switch:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ===== List rows ===== -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="-10,0,-10,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- List boxes draw no chrome: rows style themselves. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="0,0,0,3" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="8" Padding="13,9" Margin="0,0,0,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:selected /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>

    <!-- ===== Combo boxes and menus (colours come from the Fluent resources above) ===== -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="MenuItem TextBlock.icon">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource GrooveFill}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</Styles>
