                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#0AF4E7C9" Geometry="M20,20 h2 v2 h-2 Z M96,18 h1.5 v1.5 h-1.5 Z M170,30 h2 v2 h-2 Z M58,70 h1.5 v1.5 h-1.5 Z M140,66 h2 v2 h-2 Z M14,118 h1.5 v1.5 h-1.5 Z M92,120 h2 v2 h-2 Z M200,112 h1.5 v1.5 h-1.5 Z" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <!-- The hero's art dissolves towards the text on the left (an opacity mask: only the alpha counts) -->
            <LinearGradientBrush x:Key="PageHeroFade" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#B3000000" Offset="0.3" />
                <GradientStop Color="#FF000000" Offset="0.6" />
            </LinearGradientBrush>
            <!-- ...and towards its bottom, so the square art never ends in an edge on a taller plate -->
            <LinearGradientBrush x:Key="PageHeroFloor" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FF000000" Offset="0.55" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
            <!-- Over the art: a light vignette and floor in the plate's own colour; the hero's own colours light the page
                 (CardArt.Glow through PageGlowMask) -->
            <RadialGradientBrush x:Key="PageVignette" Center="72%,32%" GradientOrigin="72%,32%" RadiusX="85%" RadiusY="105%">
                <GradientStop Color="#001D140C" Offset="0.35" />
                <GradientStop Color="#8C1D140C" Offset="0.85" />
                <GradientStop Color="#CC1D140C" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="PageShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#001D140C" Offset="0.55" />
                <GradientStop Color="#B31D140C" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="PageGlowMask" Center="72%,30%" GradientOrigin="72%,30%" RadiusX="75%" RadiusY="90%">
                <GradientStop Color="#99000000" Offset="0" />
                <GradientStop Color="#40000000" Offset="0.55" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
            <!-- A thin gold frame inside the page plate, bright on top and fading down -->
            <LinearGradientBrush x:Key="PageFrame" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#99E9B949" Offset="0" />
                <GradientStop Color="#33E9B949" Offset="0.5" />
                <GradientStop Color="#1AE9B949" Offset="1" />
            </LinearGradientBrush>
            <!-- The open page's sidebar item glows round its icon -->
            <RadialGradientBrush x:Key="NavSelectedGlow" Center="12%,50%" GradientOrigin="12%,50%" RadiusX="30%" RadiusY="110%">
                <GradientStop Color="#4DE9B949" Offset="0" />
                <GradientStop Color="#00E9B949" Offset="1" />
            </RadialGradientBrush>

            <!-- The setup wizard's veil over the page: the plate colour, so the page's hero still shows faintly through -->
            <SolidColorBrush x:Key="SetupScrim" Color="#B8140D08" />
            <!-- Engraved gold glyphs (V3 icons I1, Controls/GoldGlyph): gradient, the flat gold of small sizes, the lit item's
                 brighter gold, a dark outline and drop, the bevel's light and dark edges and the top gloss -->
            <LinearGradientBrush x:Key="GlyphGold" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFE7A6" Offset="0" />
                <GradientStop Color="#E9B949" Offset="0.5" />
                <GradientStop Color="#A8742A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlyphGoldFlat" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFEDB8" Offset="0" />
                <GradientStop Color="#F0C254" Offset="0.55" />
                <GradientStop Color="#C8913A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlyphGoldLit" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFF8E2" Offset="0" />
                <GradientStop Color="#FFD66E" Offset="0.5" />
                <GradientStop Color="#D9A040" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlyphGoldEdge" Color="#F0C254" />
            <SolidColorBrush x:Key="GlyphOutline" Color="#E60C0704" />
            <SolidColorBrush x:Key="GlyphBevelLight" Color="#C8FFF6D2" />
            <SolidColorBrush x:Key="GlyphBevelDark" Color="#99472A08" />
            <LinearGradientBrush x:Key="GlyphGloss" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="RarityCommon" Color="#D8CDB8" />
            <SolidColorBrush x:Key="RarityRare" Color="#5B9BFF" />
            <SolidColorBrush x:Key="RarityEpic" Color="#B98AF5" />
            <SolidColorBrush x:Key="RarityLegendary" Color="#FFB547" />
            <!-- Rarity-lit edge of a card row (V3): the rarity colours at 85 % alpha, so the edge needs no Opacity layer -->
            <SolidColorBrush x:Key="RarityCommonEdge" Color="#D9D8CDB8" />
            <SolidColorBrush x:Key="RarityRareEdge" Color="#D95B9BFF" />
            <SolidColorBrush x:Key="RarityEpicEdge" Color="#D9B98AF5" />
            <SolidColorBrush x:Key="RarityLegendaryEdge" Color="#D9FFB547" />

            <SolidColorBrush x:Key="TierS" Color="#FFC857" />
            <SolidColorBrush x:Key="TierA" Color="#8CCF63" />
            <SolidColorBrush x:Key="TierB" Color="#7CC0FF" />
            <SolidColorBrush x:Key="TierC" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="TierD" Color="{StaticResource NegativeColor}" />

            <!-- ===== Scale (D1, hearthpulse-design): type ramp, corner radii, padding of plates. Spacing literals stay on
                 0/1/2/4/8/12/16/24/32 (and multiples of 4 from 40); DesignTokenTests counts the rest. ===== -->
            <x:Double x:Key="FontSizeMicro">10</x:Double>
            <x:Double x:Key="FontSizeSmall">11</x:Double>
            <x:Double x:Key="FontSizeLabel">12</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeLead">14</x:Double>
            <x:Double x:Key="FontSizeTitle">16</x:Double>
            <x:Double x:Key="FontSizeIcon">18</x:Double>
            <x:Double x:Key="FontSizeSubhead">20</x:Double>
            <x:Double x:Key="FontSizeHeadline">24</x:Double>
            <x:Double x:Key="FontSizeStat">28</x:Double>
            <x:Double x:Key="FontSizeDisplay">32</x:Double>
            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
            <CornerRadius x:Key="RadiusPill">999</CornerRadius>
            <Thickness x:Key="CardPadding">24</Thickness>
            <!-- ===== Type: Montserrat for display (OFL), the platform UI font for text, Material Design Icons ===== -->
            <!-- UiFont is replaced at startup with the platform's UI font (Segoe UI on Windows, Inter elsewhere). -->
            <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="DisplayFont">avares://Hearthpulse.UI/Assets/Fonts#Montserrat</FontFamily>
            <FontFamily x:Key="IconFont">avares://Hearthpulse.UI/Assets/Fonts#Material Design Icons</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource GildedText}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeStat}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource StatText}" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeIcon}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces: framed panels lit on top, with an edge that catches the accent ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style Selector="Border.overlayCard">
        <Setter Property="Background" Value="{DynamicResource OverlayCardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>
    <!-- The same card with a denser fill, for panels over a busy part of the board (card pool, odds, toasts, picks) -->
    <Style Selector="Border.overlayCard.solid">
        <Setter Property="Background" Value="{DynamicResource OverlayPanelSolid}" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <!-- A segmented group: a thin common line under its tabs (see RadioButton.segment) -->
    <Style Selector="Border.segmentBar">
        <Setter Property="Background" Value="{StaticResource SegmentBand}" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== Buttons: framed rectangles, gold for the primary action. States fade in (0.12 s) and a press
         shrinks the button a little, as in the WPF theme. ===== -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
        <Setter Property="Background" Value="{StaticResource GhostFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhostEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root" RenderTransform="scale(1)">
                    <Panel.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                        </Transitions>
                    </Panel.Transitions>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                    <Border Name="Lift" Background="{StaticResource PrimaryFillHover}" CornerRadius="8" Opacity="0" IsVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <!-- Polished metal on the primary button: a bright rim along the top edge -->
                    <Border Name="Sheen" CornerRadius="7" Margin="1" BorderBrush="{StaticResource Sheen}" BorderThickness="0,1,0,0" IsVisible="False" />
                    <Border Name="State" Background="{StaticResource Hover}" CornerRadius="8" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#State">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Panel#Root">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryEdge}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryEdge}" />
    </Style>
    <Style Selector="Button.primary /template/ Border#Lift">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary /template/ Border#Sheen">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#Lift">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#State">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Round icon buttons stay circles. -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeIcon}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="999" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" RenderTransform="scale(1)">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
        <Setter Property="RenderTransform" Value="scale(0.9)" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- A button with no chrome: the content draws everything (overlay chips, rows). -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Rows and cards drawn by their content: the same ring as the WPF FocusRing (Fluent's default sits off the theme). -->
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Background="{TemplateBinding Background}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A picture as a button (the Settings theme tiles): it lifts a little under the mouse and gives under a press.
         The page sets ContentTemplate. Same as the WPF ThemeSwatch. -->
    <Style Selector="Button.themeSwatch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Background="Transparent" RenderTransform="scale(1)">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.themeSwatch:pointerover /template/ ContentPresenter#Presenter">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.themeSwatch:pressed /template/ ContentPresenter#Presenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- ===== Navigation: the active item is a raised plate with a gold edge and a gold bar on the left (the WPF pill's
         look); plate, bar and lit glyph fade in, hover fades, a press gives a little. ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLead}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="8,2" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Bd" CornerRadius="8" Margin="10,2" Background="Transparent">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Border Name="Selected" CornerRadius="8" Margin="10,2" Background="{StaticResource NavSelectedFill}"
                            BorderBrush="{StaticResource NavSelectedEdge}" BorderThickness="1" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="{StaticResource MotionSettle}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                        <Panel>
                            <!-- A gold glow round the open page's icon -->
                            <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource NavSelectedGlow}" />
                            <Border Name="Bar" Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left" Background="{StaticResource Accent}" />
                        </Panel>
                    </Border>
                    <!-- Glyph and label share one column grid, so every item's text starts at the same x whatever its glyph -->
                    <Grid Name="Face" ColumnDefinitions="24,*" Margin="26,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0%,50%"
                          RenderTransform="scale(1)">
                        <Grid.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Grid.Transitions>
                        <!-- The page's engraved gold glyph (V3 icons I1, Tag = a GameIcons geometry), a little dimmer until its page opens -->
                        <c:GoldGlyph Name="Glyph" Glyph="{TemplateBinding Tag}" Width="22" Height="22" Opacity="0.8"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <c:GoldGlyph Name="GlyphLit" Glyph="{TemplateBinding Tag}" Lit="True" Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                            <c:GoldGlyph.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="{StaticResource MotionSettle}" Easing="CubicEaseOut" />
                                </Transitions>
                            </c:GoldGlyph.Transitions>
                        </c:GoldGlyph>
                        <ContentPresenter Name="Presenter" Grid.Column="1" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Grid#Face">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Selected">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ c|GoldGlyph#GlyphLit">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ===== Segmented choices: underline tabs (owner, 2026-11-05). No frame, no check mark: the group sits on a thin
         common line on a soft band (Border.segmentBar), the choices in muted text; the chosen one is gold with a 2 px gold line over that
         line. Hover lights the text and a soft tint; the width never changes. Same as the WPF Segment. ===== -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bd" CornerRadius="6,6,0,0" Padding="12,6,12,8" Background="Transparent">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </Border>
                    <Border Name="Underline" Height="2" CornerRadius="1" Margin="4,0,4,-1" VerticalAlignment="Bottom" Background="{StaticResource Accent}"
                            RenderTransform="scaleX(0)">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionSettle}" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.segment:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Underline">
        <Setter Property="RenderTransform" Value="scaleX(1)" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Switch (the track stays rounded: it is a toggle) ===== -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLead}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <!-- Same as the WPF switch: a slim pill track, gold with a dark knob when on, dark with a muted knob when off;
                         a round knob that slides, no tick -->
                    <Panel Grid.Column="1" Width="42" Height="24">
                        <Border Name="Track" CornerRadius="{StaticResource RadiusLarge}" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Muted}" BorderThickness="1" />
                        <Border Name="OnFill" CornerRadius="{StaticResource RadiusLarge}" Background="{StaticResource PrimaryFill}" Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="{StaticResource MotionSettle}" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Panel Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0" RenderTransform="translate(0px,0px)">
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionSettle}" Easing="CubicEaseOut" />
                                </Transitions>
                            </Panel.Transitions>
                            <Ellipse Name="Knob" Fill="{StaticResource Muted}" />
                        </Panel>
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#OnFill">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Panel#Thumb">
        <Setter Property="RenderTransform" Value="translate(16px,0px)" />
    </Style>
    <Style Selector="CheckBox.switch:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ===== List rows ===== -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="-8,0,-8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- List boxes draw no chrome: rows style themselves. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== Combo boxes and menus (colours come from the Fluent resources above) ===== -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,8" />
    </Style>
    <Style Selector="MenuItem TextBlock.icon">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource GrooveFill}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</Styles>
