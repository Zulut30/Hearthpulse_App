<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ===== Palette: Hearthstone menus - dark wood browns, parchment text, gold trim ===== -->
            <Color x:Key="BgColor">#140D08</Color>
            <Color x:Key="SurfaceColor">#21160E</Color>
            <Color x:Key="Surface2Color">#2B1D12</Color>
            <Color x:Key="Surface3Color">#3A2817</Color>
            <Color x:Key="Surface4Color">#4A331E</Color>
            <Color x:Key="BorderColor">#3D2A19</Color>
            <Color x:Key="OutlineColor">#6E4E2C</Color>
            <Color x:Key="TextColor">#F4E7C9</Color>
            <Color x:Key="MutedColor">#CDB894</Color>
            <Color x:Key="FaintColor">#8F7A5C</Color>
            <Color x:Key="AccentColor">#E9B949</Color>
            <Color x:Key="AccentDeepColor">#C48E2C</Color>
            <Color x:Key="AccentContainerColor">#5A3D17</Color>
            <Color x:Key="SecondaryContainerColor">#3F2C19</Color>
            <Color x:Key="PositiveColor">#8CCF63</Color>
            <Color x:Key="NegativeColor">#EC6A52</Color>
            <Color x:Key="InfoColor">#6FB8F2</Color>

            <!-- Fluent controls (sliders, scroll bars, focus) pick up the app accent: Hearthstone gold. -->
            <Color x:Key="SystemAccentColor">#E9B949</Color>
            <Color x:Key="SystemAccentColorDark1">#C48E2C</Color>
            <Color x:Key="SystemAccentColorDark2">#8A6533</Color>
            <Color x:Key="SystemAccentColorDark3">#5A3D17</Color>
            <Color x:Key="SystemAccentColorLight1">#EFC865</Color>
            <Color x:Key="SystemAccentColorLight2">#F5D88A</Color>
            <Color x:Key="SystemAccentColorLight3">#FBE3A6</Color>

            <!-- Fluent scroll bars: parchment-tinted thumb (same as the WPF ScrollThumb), warm track and arrows. -->
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#2EF4E7C9</Color>
            <Color x:Key="ScrollBarThumbBackgroundColor">#2EF4E7C9</Color>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#2EF4E7C9" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#55F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#55F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#21160E" Opacity="0.9" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#21160E" Opacity="0.9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#CDB894" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#8F7A5C" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#1FF4E7C9" />

            <!-- Fluent sliders: the unfilled track is Surface4 (Outline on hover), like the WPF slider. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#4A331E" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#6E4E2C" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4A331E" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#3A2817" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#8F7A5C" />
            <!-- Fluent turns the thumb near-white on hover and grey when pressed: keep it gold. -->
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource AccentDeepColor}" />

            <!-- Fluent text boxes: a light border and a near-black hover/focus fill; keep the warm surface and an
                 Outline border that turns gold on focus, like the WPF text box. -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#99E9B949" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A110B" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A110B" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#8F7A5C" />

            <!-- Fluent combo boxes and menu flyouts: the text box frame, a card for the list, gold for the selected row. -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#99E9B949" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#1FF4E7C9" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1FF4E7C9" />

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="Surface4" Color="{StaticResource Surface4Color}" />
            <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1FE9B949" />
            <SolidColorBrush x:Key="AccentLine" Color="#99E9B949" />
            <SolidColorBrush x:Key="AccentContainer" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="OnAccentContainer" Color="#FBE3A6" />
            <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
            <SolidColorBrush x:Key="OnSecondaryContainer" Color="#EBDDBD" />
            <SolidColorBrush x:Key="OnAccent" Color="#2A1906" />
            <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="PositiveSoft" Color="#228CCF63" />
            <SolidColorBrush x:Key="Negative" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="NegativeSoft" Color="#24EC6A52" />
            <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="Hover" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="Pressed" Color="#1FF4E7C9" />
            <SolidColorBrush x:Key="Decor" Color="#0EE9B949" />
            <SolidColorBrush x:Key="DecorStrong" Color="#16E9B949" />
            <SolidColorBrush x:Key="OverlayPanel" Color="#F0201510" />
            <SolidColorBrush x:Key="OverlayPanelSolid" Color="#FA201510" />
            <SolidColorBrush x:Key="OverlayBorder" Color="#40E9B949" />
            <SolidColorBrush x:Key="ManaGem" Color="#3D7BE0" />
            <!-- Card pool chart: one colour per stat (mana gem, attack, health). Keys start with PoolStat: never recoloured by a theme. -->
            <Color x:Key="PoolStatCostTopColor">#78B0FF</Color>
            <Color x:Key="PoolStatCostColor">#2A5FC0</Color>
            <Color x:Key="PoolStatAttackTopColor">#FFDC82</Color>
            <Color x:Key="PoolStatAttackColor">#C8871C</Color>
            <Color x:Key="PoolStatHealthTopColor">#FF907A</Color>
            <Color x:Key="PoolStatHealthColor">#B23A2B</Color>
            <LinearGradientBrush x:Key="PoolStatCostBar" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{StaticResource PoolStatCostTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource PoolStatCostColor}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PoolStatAttackBar" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{StaticResource PoolStatAttackTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource PoolStatAttackColor}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PoolStatHealthBar" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{StaticResource PoolStatHealthTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource PoolStatHealthColor}" Offset="1" />
            </LinearGradientBrush>
            <!-- Sheen over the median bar -->
            <LinearGradientBrush x:Key="PoolStatShine" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#70FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.7" />
            </LinearGradientBrush>
            <!-- Mechanic share bars (themed: gold follows the accent) -->
            <LinearGradientBrush x:Key="PoolMechanicFill" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="{StaticResource AccentDeepColor}" Offset="0" />
                <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Row" Color="#2E1F13" />
            <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />
            <LinearGradientBrush x:Key="TileFade" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FF2E1F13" Offset="0" />
                <GradientStop Color="#FF2E1F13" Offset="0.42" />
                <GradientStop Color="#662E1F13" Offset="0.8" />
                <GradientStop Color="#142E1F13" Offset="1" />
            </LinearGradientBrush>
            <!-- Dark plate under small numbers drawn over card art (same as the WPF token) -->
            <SolidColorBrush x:Key="OverlayBadgeShade" Color="#CC140D08" />
            <!-- Layout-mode stand-in for a panel that is not shown (same as the WPF token) -->
            <SolidColorBrush x:Key="OverlayPlaceholder" Color="#E6201510" />

            <!-- Gold trim, framed edges and the selected / primary fills. -->
            <SolidColorBrush x:Key="GoldTrim" Color="#8A6533" />
            <SolidColorBrush x:Key="GoldFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelEdge" Color="#3D2A19" />
            <!-- Same as the WPF tokens: a raised leather plate with a gold edge, and a polished gold button -->
            <SolidColorBrush x:Key="SelectedEdge" Color="#A27839" />
            <LinearGradientBrush x:Key="SelectedFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#5C4120" Offset="0" />
                <GradientStop Color="#3C2A18" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFE79E" Offset="0" />
                <GradientStop Color="#EFC253" Offset="0.45" />
                <GradientStop Color="#C88F2E" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFF0C2" Offset="0" />
                <GradientStop Color="#F6CD66" Offset="0.45" />
                <GradientStop Color="#D69C3C" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PanelFill" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="OverlayFill" Color="#F0201510" />
            <SolidColorBrush x:Key="SidebarFill" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="WindowBg" Color="{StaticResource BgColor}" />

            <!-- ===== Gilded Tavern (same as the WPF tokens): light falls from above, every plate is lit on top ===== -->
            <LinearGradientBrush x:Key="GildedText" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFF6D8" Offset="0" />
                <GradientStop Color="#F3CF72" Offset="0.55" />
                <GradientStop Color="#D29A35" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StatText" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFFAEE" Offset="0" />
                <GradientStop Color="#EDD6A4" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="WindowFill" GradientOrigin="10%,0%" Center="10%,0%" RadiusX="90%" RadiusY="110%">
                <GradientStop Color="#22160C" Offset="0" />
                <GradientStop Color="#110B07" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="ContentEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#86602F" Offset="0" />
                <GradientStop Color="#3A2919" Offset="0.35" />
                <GradientStop Color="#2A1C12" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#352516" Offset="0" />
                <GradientStop Color="#2C1F13" Offset="0.45" />
                <GradientStop Color="#23180F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#8A6436" Offset="0" />
                <GradientStop Color="#4A331D" Offset="0.3" />
                <GradientStop Color="#2E1F13" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GhostFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#47321C" Offset="0" />
                <GradientStop Color="#34241A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GhostEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#86603A" Offset="0" />
                <GradientStop Color="#4E3720" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PrimaryEdge" Color="#8A5E22" />
            <LinearGradientBrush x:Key="BestEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFF0C2" Offset="0" />
                <GradientStop Color="#E9B949" Offset="0.45" />
                <GradientStop Color="#A87526" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="BestHalo">
                <GradientStop Color="#4DE9B949" Offset="0.6" />
                <GradientStop Color="#00E9B949" Offset="1" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="Sheen" Color="#80FFF4D6" />
            <SolidColorBrush x:Key="GrooveFill" Color="#1A110B" />
            <SolidColorBrush x:Key="GrooveEdge" Color="#36261A" />
            <LinearGradientBrush x:Key="NavSelectedFill" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#42E9B949" Offset="0" />
                <GradientStop Color="#14E9B949" Offset="0.55" />
                <GradientStop Color="#06E9B949" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavSelectedEdge" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#AAE9B949" Offset="0" />
                <GradientStop Color="#40E9B949" Offset="0.5" />
                <GradientStop Color="#14E9B949" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="OverlayCardFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F22E2015" Offset="0" />
                <GradientStop Color="#F01B120B" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="OverlayEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#A6E9B949" Offset="0" />
                <GradientStop Color="#45E9B949" Offset="0.35" />
                <GradientStop Color="#2AE9B949" Offset="1" />
            </LinearGradientBrush>

            <!-- ===== Character of the theme (same as the WPF tokens): a second accent, soft glows, a backdrop motif ===== -->
            <!-- The second accent decorates; it never carries meaning. -->
            <Color x:Key="Accent2Color">#4FC2A8</Color>
            <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />
            <SolidColorBrush x:Key="Accent2Soft" Color="#1F4FC2A8" />
            <SolidColorBrush x:Key="Accent2Line" Color="#994FC2A8" />
            <RadialGradientBrush x:Key="Glow">
                <GradientStop Color="#3DE9B949" Offset="0" />
                <GradientStop Color="#14E9B949" Offset="0.55" />
                <GradientStop Color="#00E9B949" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Accent2Glow">
                <GradientStop Color="#334FC2A8" Offset="0" />
                <GradientStop Color="#0F4FC2A8" Offset="0.55" />
                <GradientStop Color="#004FC2A8" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="EdgeLight" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00FFE9B0" Offset="0" />
                <GradientStop Color="#8CFFE9B0" Offset="0.5" />
                <GradientStop Color="#00FFE9B0" Offset="1" />
            </LinearGradientBrush>
            <!-- Backdrop motifs: original line art in a 1000x1000 box (tools/themes/motifs.py). This theme is Tavern. -->
            <SolidColorBrush x:Key="MotifInk" Color="#17E9B949" />
            <SolidColorBrush x:Key="MotifInk2" Color="#244FC2A8" />
            <!-- motifs:begin -->
