            <!-- The content plate: lamplight from the top left, a wash of the second accent and the motif in the bottom right -->
            <DrawingBrush x:Key="ContentFill" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Bottom" SourceRect="0,0,1600,1000">
                <DrawingBrush.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 H1600 V1000 H0 Z">
                        <GeometryDrawing Geometry="M0,0 H1600 V1000 H0 Z">
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush GradientOrigin="25%,0%" Center="25%,0%" RadiusX="100%" RadiusY="90%">
