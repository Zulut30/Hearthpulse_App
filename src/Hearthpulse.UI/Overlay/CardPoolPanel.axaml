<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:c="using:Hearthpulse.UI.Controls"
             x:Class="Hearthpulse.UI.Overlay.CardPoolPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The compact card pool panel (300 wide): at its own spot (MovablePanel "card-pool") or next to its card (the card
         pool layer). Header, the cards of this game a hovered card looks back at, a summary grid, the most played cards as
         tracker rows, the right-click hint (the full view is the pool browser), and the card's related cards in a zone
         of their own. DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- Every card row of the panel (this game, Excavate, meta, related) as a deck tracker row: cost gem, name over a
             strip of art, "×2" or a share on the right; one quiet edge for all, no rarity colour. -->
        <DataTemplate x:Key="PoolRowTemplate" x:DataType="o:PoolListRow">
            <!-- The full card on hover: the panel lets clicks through, so the pointer update finds the row under it -->
            <Grid Height="24" Margin="0,0,0,2" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                <Border Classes="capsule">
                    <Panel>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="1,0,3,0">
                            <c:ManaCost Text="{Binding Cost}" Width="22" Height="22" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,4,0" />
                            <Border Classes="countBadge" DockPanel.Dock="Right" IsVisible="{Binding CountText, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding CountText}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Panel>
                </Border>
                <Border Classes="rarityEdge" BorderBrush="{StaticResource OverlayBorder}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Section chips (the generator's separate pools) -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!-- The popup next to a hand card: a fill that does not fade with the overlay opacity -->
        <Style Selector="Border.overlayCard.solid.popup">
            <Setter Property="Background" Value="{DynamicResource OverlayPopupSolid}" />
        </Style>

        <!-- The pointer holds the pool: a gold edge and a gold right-click hint -->
        <Style Selector="Border.overlayCard.held">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.hint.held">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- Pick hint: the clearly most taken option is gold with a star -->
        <Style Selector="TextBlock.pickName.top">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- Pick hint: numbers on few games are faded (bar, share, win rate; the name stays) -->
        <Style Selector="Grid.lowSample > Border, Grid.lowSample > TextBlock">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <!-- Not interactive: clicks reach the board and the Discover options under it; the host passes pointer and buttons.
         Its opacity (set in code) carries the short fade-in when it first appears. -->
    <Border x:Name="Card" Classes="overlayCard solid" Classes.held="{Binding CardPoolHeld}" Width="300">
        <StackPanel>
            <!-- ===== Header: the pool's size (or the list's name), one line of classes · format ===== -->
            <Border Classes="overlayHeader">
                <StackPanel>
                    <TextBlock Text="{Binding CardPoolTitle}" Classes="headerTitle" TextWrapping="Wrap" MaxLines="2" />
                    <!-- Next to its card: "classes · format"; at its own spot the card's name comes first (code shows one) -->
                    <TextBlock x:Name="PopupNote" Text="{Binding CardPoolMeta}" Classes="headerNote" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="PanelNote" Text="{Binding CardPoolSourceNote}" Classes="headerNote" TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding CardPoolSections}" Margin="12,8,12,-4" IsVisible="{Binding ShowCardPoolPanelSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:PoolChipModel">
                        <Border Classes="chip">
                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== This game: the cards the hovered card looks back at (died, cast, played) ===== -->
            <StackPanel Margin="12,12,12,0" IsVisible="{Binding ShowCardPoolList}">
                <ContentControl Classes="overlaySection" Content="{Binding CardPoolListTitle}" Margin="0,0,0,4"
                                IsVisible="{Binding CardPoolListTitle, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding CardPoolList}" ItemTemplate="{StaticResource PoolRowTemplate}" />
                <TextBlock Text="{Binding CardPoolListNote}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                           IsVisible="{Binding CardPoolListNote, Converter={StaticResource Truthy}}" />
            </StackPanel>

            <!-- ===== Excavate: the next tier's treasures as rows, then the other tiers in the cycle's order, one line each ===== -->
            <StackPanel Margin="12,12,12,0" IsVisible="{Binding ShowCardPoolExcavate}">
                <ContentControl Classes="overlaySection" Content="{Binding CardPoolExcavateNext}" Margin="0,0,0,4"
                                IsVisible="{Binding CardPoolExcavateNext, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateRows}" ItemTemplate="{StaticResource PoolRowTemplate}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateTiers}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ExcavateTierRow">
                            <!-- The tier's rarity is its colour: the one place the panel shows one -->
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="3" Height="12" CornerRadius="1.5" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                           Width="34" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Names}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Your open choice: what players take from these options, Hearthpulse data (numbers only, no advice) ===== -->
            <StackPanel Margin="12,12,12,0" IsVisible="{Binding CardPoolPicks, Converter={StaticResource Truthy}}">
                <ContentControl Classes="overlaySection" Content="{i:Loc Pool.Picks.Title}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding CardPoolPicks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolPickRowModel">
                            <!-- Two lines: the name (gold with a star when clearly the most taken), then pick bar, share and win rate; faded on few games. -->
                            <StackPanel Margin="0,0,0,3">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,3,0" IsVisible="{Binding Top}" />
                                    <TextBlock Classes="pickName" Classes.top="{Binding Top}" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Height="15" ColumnDefinitions="150,40,*" Classes.lowSample="{Binding LowSample}">
                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Hover}" VerticalAlignment="Center">
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource PoolMechanicFill}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding PickText}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding WinText}" FontSize="9.5" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardPoolPicksNote}" FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0"
                           IsVisible="{Binding CardPoolPicksNote, Converter={StaticResource Truthy}}" />
            </StackPanel>

            <!-- ===== Summary: averages, then the most common mechanics, two cells a row ===== -->
            <ItemsControl ItemsSource="{Binding CardPoolSummary}" Margin="12,12,0,0" IsVisible="{Binding CardPoolSummary, Converter={StaticResource Truthy}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:PoolAverage">
                        <DockPanel Height="18" Margin="0,0,12,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Most played in meta decks: rows with their share ===== -->
            <StackPanel Margin="12,12,12,0" IsVisible="{Binding CardPoolTopCards, Converter={StaticResource Truthy}}">
                <ContentControl Classes="overlaySection" Content="{i:Loc Pool.FeaturedReason}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding CardPoolTopCards}" ItemTemplate="{StaticResource PoolRowTemplate}" />
            </StackPanel>

            <!-- ===== The end of the pool: the right-click hint (gold while the pointer holds the pool) ===== -->
            <TextBlock Classes="hint" Classes.held="{Binding CardPoolHeld}" Text="{i:Loc Pool.RightClickHint}" FontSize="{StaticResource FontSizeSmall}"
                       HorizontalAlignment="Center" Margin="12,8,12,8" TextTrimming="CharacterEllipsis" IsVisible="{Binding CardPoolHasCards}" />
            <Border Height="8" IsVisible="{Binding CardPoolHasCards, Converter={StaticResource Truthy}, ConverterParameter=!}" />

            <!-- ===== Related cards: a zone of its own under a full-width hairline, not part of the pool ===== -->
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8,12,8" IsVisible="{Binding ShowCardPoolRelated}">
                <StackPanel>
                    <ContentControl Classes="overlaySection" Content="{Binding CardPoolRelatedTitle}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding CardPoolRelated}" ItemTemplate="{StaticResource PoolRowTemplate}" />
                    <TextBlock Text="{Binding CardPoolRelatedNote}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                               IsVisible="{Binding CardPoolRelatedNote, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
