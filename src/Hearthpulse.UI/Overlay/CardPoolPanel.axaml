<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:c="using:Hearthpulse.UI.Controls"
             x:Class="Hearthpulse.UI.Overlay.CardPoolPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The compact card pool panel (300 wide): at its own spot (MovablePanel "card-pool") or next to its card (the card
         pool layer). The cards of this game a hovered card looks back at, one line of averages, the most played cards as
         tracker rows; the full view is the pool browser
         (right-click). DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- A tracker row: cost gem, the whole name over a strip of art, rarity strip, "×2" when it counts twice. -->
        <DataTemplate x:Key="ListRowTemplate" x:DataType="o:PoolListRow">
            <Grid Height="22" Margin="0,0,0,2" ColumnDefinitions="25,*">
                <c:ManaCost Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                    <Panel>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Classes="rarityStrip" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,3,0">
                            <Border Classes="countBadge" DockPanel.Dock="Right" Height="16" IsVisible="{Binding CountText, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Classes="rowSheen" />
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style Selector="TextBlock.poolLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Pick hint: the clearly most taken option is gold with a star -->
        <Style Selector="TextBlock.pickName.top">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- Pick hint: numbers on few games are faded (bar, share, win rate; the name stays) -->
        <Style Selector="Grid.lowSample > Border, Grid.lowSample > TextBlock">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <!-- Not interactive: clicks reach the board and the Discover options under it; the host passes pointer and buttons.
         Its opacity (set in code) carries the short fade-in when it appears or its pool changes. -->
    <Border x:Name="Card" Classes="overlayCard" Width="300" Background="{StaticResource OverlayPanelSolid}">
        <StackPanel>
            <!-- ===== Summary: pool size, the generator's words, classes · format · source, sections ===== -->
            <Border Classes="overlayHeader">
                <StackPanel>
                    <TextBlock Text="{Binding CardPoolTitle}" Classes="headerTitle" />
                    <TextBlock Text="{Binding CardPoolPhrase}" Classes="headerNote" TextTrimming="None" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Margin="12,5,12,0">
                <TextBlock Text="{Binding CardPoolMeta}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding CardPoolMeta, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding CardPoolSections}" Margin="0,5,0,-4" IsVisible="{Binding ShowCardPoolPanelSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolChipModel">
                            <Border Classes="chip">
                                <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Excavate: the next tier's treasures as tracker rows, then the other tiers in the cycle's order, one line each ===== -->
            <StackPanel Margin="12,9,12,0" IsVisible="{Binding ShowCardPoolExcavate}">
                <TextBlock Classes="poolLabel" Text="{Binding CardPoolExcavateNext}" Foreground="{StaticResource Accent}"
                           IsVisible="{Binding CardPoolExcavateNext, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateRows}" ItemTemplate="{StaticResource ListRowTemplate}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateTiers}" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ExcavateTierRow">
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="3" Height="11" CornerRadius="1.5" Margin="0,0,5,0" VerticalAlignment="Center"
                                        Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Width="34" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Names}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== This game: the cards the hovered card looks back at (died, cast, played), as tracker rows ===== -->
            <StackPanel Margin="12,9,12,0" IsVisible="{Binding ShowCardPoolList}">
                <TextBlock Classes="poolLabel" Text="{Binding CardPoolListTitle}" IsVisible="{Binding CardPoolListTitle, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding CardPoolList}" ItemTemplate="{StaticResource ListRowTemplate}" />
                <TextBlock Text="{Binding CardPoolListNote}" FontSize="9.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"
                           IsVisible="{Binding CardPoolListNote, Converter={StaticResource Truthy}}" />
            </StackPanel>

            <!-- ===== Your open choice: what players take from these options, Hearthpulse data (numbers only, no advice) ===== -->
            <StackPanel Margin="12,9,12,0" IsVisible="{Binding CardPoolPicks, Converter={StaticResource Truthy}}">
                <TextBlock Classes="poolLabel" Text="{i:Loc Pool.Picks.Title}" />
                <ItemsControl ItemsSource="{Binding CardPoolPicks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolPickRowModel">
                            <!-- Two lines: the name (gold with a star when clearly the most taken), then pick bar, share and win rate; faded on few games. -->
                            <StackPanel Margin="0,0,0,3">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,3,0" IsVisible="{Binding Top}" />
                                    <TextBlock Classes="pickName" Classes.top="{Binding Top}" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Height="15" ColumnDefinitions="150,40,*" Classes.lowSample="{Binding LowSample}">
                                    <Border Height="6" CornerRadius="3" Background="{StaticResource Hover}" VerticalAlignment="Center">
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource PoolMechanicFill}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding PickText}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding WinText}" FontSize="9.5" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardPoolPicksNote}" FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0" />
            </StackPanel>

            <!-- ===== One line of averages: "Average  Mana 6  Attack 4.2  Health 5.1" ===== -->
            <DockPanel Margin="12,9,12,0" IsVisible="{Binding CardPoolAverages, Converter={StaticResource Truthy}}">
                <TextBlock DockPanel.Dock="Left" Text="{i:Loc Pool.Average}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ItemsControl ItemsSource="{Binding CardPoolAverages}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolAverage">
                            <StackPanel Orientation="Horizontal" Margin="0,0,11,0">
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ===== The most common mechanics, one quiet line ===== -->
            <ItemsControl ItemsSource="{Binding CardPoolMechanicRows}" Margin="12,5,12,0" IsVisible="{Binding CardPoolMechanicRows, Converter={StaticResource Truthy}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:PoolMechanicRow">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,1">
                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding PercentText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="3,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Most played in meta decks: tracker rows (cost gem, whole name over the art strip, share) ===== -->
            <StackPanel Margin="12,10,12,0" IsVisible="{Binding CardPoolTopCards, Converter={StaticResource Truthy}}">
                <TextBlock Classes="poolLabel" Text="{i:Loc Pool.FeaturedReason}" />
                <ItemsControl ItemsSource="{Binding CardPoolTopCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolTopRow">
                            <Grid Height="22" Margin="0,0,0,2" ColumnDefinitions="25,*">
                                <c:ManaCost Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                                    <Panel>
                                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                        <Rectangle Fill="{StaticResource TileFade}" />
                                        <Border Classes="rarityStrip" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                        <DockPanel Margin="9,0,3,0">
                                            <Border Classes="countBadge" DockPanel.Dock="Right" Height="16">
                                                <TextBlock Text="{Binding ShareText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Classes="rowSheen" />
                                    </Panel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{i:Loc Pool.RightClickHint}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,8"
                       IsVisible="{Binding CardPoolHasCards}" />
            <Border Height="9" IsVisible="{Binding CardPoolHasCards, Converter={StaticResource Truthy}, ConverterParameter=!}" />
        </StackPanel>
    </Border>
</UserControl>
