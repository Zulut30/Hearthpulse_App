<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:p="using:Hearthpulse.Core.CardPool"
             x:Class="Hearthpulse.UI.Overlay.CardPoolPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The card pool panel (MovablePanel "card-pool"); DataContext is the OverlayViewModel. -->
    <UserControl.Resources>

        <DataTemplate x:Key="HistogramTemplate" x:DataType="o:PoolHistogramModel">
            <StackPanel Classes="histogram" Classes.attack="{Binding IsAttack}" Classes.health="{Binding IsHealth}" Margin="5,0">
                <TextBlock Classes="histTitle" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Bars}" Height="36" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolBarModel">
                            <Border Classes="bar" Classes.median="{Binding IsMedian}" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="1,0"
                                    CornerRadius="1.5" ToolTip.Tip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource OverlayBorder}" />
                <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:PoolBarModel">
                            <TextBlock Text="{Binding Label}" FontSize="8.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MedianText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="median" FontSize="9.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MechanicTemplate" x:DataType="p:PoolMechanic">
            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="8,3,8,4" Margin="0,0,5,5" MinWidth="62">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="o:PoolChipModel">
            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,5,4">
                <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="StackPanel.histogram TextBlock.histTitle">
            <Setter Property="Foreground" Value="{StaticResource ManaGem}" />
        </Style>
        <Style Selector="StackPanel.histogram Border.bar">
            <Setter Property="Background" Value="{StaticResource ManaGem}" />
        </Style>
        <Style Selector="StackPanel.histogram.attack TextBlock.histTitle">
            <Setter Property="Foreground" Value="{StaticResource TierS}" />
        </Style>
        <Style Selector="StackPanel.histogram.attack Border.bar">
            <Setter Property="Background" Value="{StaticResource TierS}" />
        </Style>
        <Style Selector="StackPanel.histogram.health TextBlock.histTitle">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="StackPanel.histogram.health Border.bar">
            <Setter Property="Background" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="StackPanel.histogram Border.bar.median">
            <Setter Property="Background" Value="{StaticResource Text}" />
        </Style>
    </UserControl.Styles>

    <!-- Not interactive: clicks reach the board and the Discover options under it; the host passes pointer and buttons. -->
    <Border x:Name="Card" Classes="overlayCard" Width="324" Background="{StaticResource OverlayPanelSolid}">
        <StackPanel Margin="10,9,10,8">
            <TextBlock Text="{Binding CardPoolTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CardPoolDescription}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,1,0,0" />
            <!-- The generator's separate pools (Hearthstone Wiki: one per rune...) and where the pool comes from -->
            <ItemsControl ItemsSource="{Binding CardPoolSections}" ItemTemplate="{StaticResource SectionTemplate}" Margin="0,6,0,0" HorizontalAlignment="Center"
                          IsVisible="{Binding CardPoolHasSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding CardPoolSourceNote}" FontSize="9.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0"
                       IsVisible="{Binding CardPoolSourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding CardPoolHistograms}" ItemTemplate="{StaticResource HistogramTemplate}" Margin="-5,9,-5,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Highlighted card: most played in meta decks -->
            <Border Margin="-10,8,-10,0" Height="30" Background="{StaticResource Row}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="0,1"
                    IsVisible="{Binding CardPoolFeatured, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding CardPoolFeaturedNote}">
                <Panel>
                    <Panel Width="200" HorizontalAlignment="Right">
                        <Image i:CardArt.Tile="{Binding CardPoolFeatured.CardId, FallbackValue={x:Null}}" Width="150" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                    </Panel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xF04CE;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CardPoolFeatured.Name, FallbackValue=''}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>

            <ItemsControl ItemsSource="{Binding CardPoolMechanics}" ItemTemplate="{StaticResource MechanicTemplate}" Margin="0,9,0,0" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Right-click to see all options" FontSize="10.5" FontStyle="Italic"
                       Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                       IsVisible="{Binding CardPoolHasCards}" />
        </StackPanel>
    </Border>
</UserControl>
