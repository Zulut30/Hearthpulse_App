<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.BgBadgesLayer"
             x:DataType="o:OverlayViewModel"
             IsHitTestVisible="False" Focusable="False">
    <!-- Labels beside the leaderboard tiles ("bg-badges", DataContext: the overlay view model), in words: "Tavern 5", then the
         main tribe of the board last seen ("Quilboar: 4 of 7"). No glyphs. Each item fills the strip right of its tile and
         centres on it; the whole layer hides while the mouse is on the leaderboard (the game's popup sits there). -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>
    <ItemsControl Name="Badges" ItemsSource="{Binding BgBadges}" IsVisible="{Binding ShowBgBadges}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="o:BgBadge">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                <Setter Property="Height" Value="{Binding Height}" />
            </ControlTheme>
        </ItemsControl.ItemContainerTheme>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="o:BgBadge">
                <!-- The label in words, two lines: "Tavern 5", then "Quilboar: 4 of 7" once a fight showed the board | column 1 kept
                     empty for the opponents' rating (up to 6 characters): it takes its width from that text -->
                <Grid Classes="bgBadge" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                    <Border Name="Label" MinWidth="72" CornerRadius="4" Padding="6,2" Background="{DynamicResource OverlayBadgeShade}"
                            BorderBrush="{StaticResource AccentDeep}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{i:Loc Overlay.LeaderboardBadge.Tier}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Empty until a board was seen and a tribe has two minions on it -->
                            <TextBlock Text="{Binding Tribe}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Text}" IsVisible="{Binding HasTribe}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
