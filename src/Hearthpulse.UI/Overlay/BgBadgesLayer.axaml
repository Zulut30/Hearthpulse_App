<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.BgBadgesLayer"
             x:DataType="o:OverlayViewModel"
             IsHitTestVisible="False" Focusable="False">
    <!-- Badges beside the leaderboard tiles ("bg-badges", DataContext: the overlay view model): tavern tier, then the main
         tribe of the board last seen with its count. Each item fills the strip right of its tile and centres on it. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Grid.bgBadge.dead">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>
    <ItemsControl Name="Badges" ItemsSource="{Binding BgBadges}" IsVisible="{Binding ShowBgBadges}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="o:BgBadge">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                <Setter Property="Height" Value="{Binding Height}" />
            </ControlTheme>
        </ItemsControl.ItemContainerTheme>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="o:BgBadge">
                <!-- Column 2 is kept empty for the opponents' rating (up to 6 characters): it takes its width from that text -->
                <Grid Classes="bgBadge" Classes.dead="{Binding Dead}" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <Border Name="Tier" Width="22" Height="22" CornerRadius="5" Background="{StaticResource OverlayPanelSolid}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1">
                        <TextBlock Text="{Binding Tier}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Empty until a board was seen: an opponent's only after a fight with them -->
                    <Border Name="Tribe" Grid.Column="1" Height="22" CornerRadius="11" Padding="3,0,6,0" Margin="4,0,0,0"
                            Background="{StaticResource OverlayPanelSolid}" IsVisible="{Binding Tribe, Converter={StaticResource Truthy}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tribe.Glyph}" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TribeCount}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
