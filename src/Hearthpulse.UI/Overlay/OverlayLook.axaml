<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="using:Hearthpulse.UI.Overlay"
        xmlns:c="using:Hearthpulse.UI.Controls">
    <!-- Overlay-only look shared by the overlay view and its panels (WPF: Overlay/OverlayLook.xaml, same names as keys).
         Theme tokens only, no hex. Nothing here loops, blurs or casts a shadow: the overlay draws over the game. The one motion is the row flash below. -->

    <!-- Panel header (V3 "gold frame"): no plate, only a gold hairline under it that fades out at both ends -->
    <Style Selector="Border.overlayHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayHeaderRule}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Header content, the same in every panel: an optional gold glyph (with the icon class), the title, one muted line -->
    <Style Selector="TextBlock.headerIcon">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style Selector="TextBlock.headerTitle">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLead}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.headerNote">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- Section label inside a panel (D5, one frame): the label, then a gold hairline fading to the right - the header's
         rule, not an ornament -->
    <Style Selector="ContentControl.overlaySection">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" Margin="8,1,0,0" VerticalAlignment="Center" Background="{StaticResource OverlaySectionRule}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Dark plate for a few key figures under a header -->
    <Style Selector="Border.statPlate">
        <Setter Property="Background" Value="{DynamicResource OverlayBadgeShade}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5,8,4" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Card row as a capsule (V3): the plate, the art and the flash are clipped to it (radius 12 on a 24 row) -->
    <Style Selector="Border.capsule">
        <Setter Property="Background" Value="{StaticResource Row}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Rarity-lit edge around a capsule row: KeyBrush with "edge" gives the rarity colour at 85 % alpha (a card
         without a rarity gets the faint gold edge) -->
    <Style Selector="Border.rarityEdge">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Copy count on a dark pill at the right end of a card row, readable over bright art -->
    <Style Selector="Border.countBadge">
        <Setter Property="Background" Value="{DynamicResource OverlayBadgeShade}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Gold wash over a card row whose count just moved: fades out once (1.4 s) when the row gets the class, nothing loops;
         only under "motion", which the overlay view sets when the system allows animations -->
    <Style Selector="Border.rowFlash">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector=".motion Grid.tileRow.changed Border.rowFlash">
        <Style.Animations>
            <Animation Duration="0:0:1.4" Easing="CubicEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- The tier letter at the end of a list row (S to E, coloured by the row's tier through KeyBrush) -->
    <Style Selector="TextBlock.tierLetter">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card rows (deck, opponent, graveyard...): gem and row sizes, compact lists and the empty deck row. Here, not in the
         overlay view, so the OBS windows (StreamView) size the deck panel's rows the same way. -->
    <Style Selector="c|ManaCost.cost">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|ManaCost.cost.short">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
    </Style>
    <Style Selector="Grid.cardRow">
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Grid.cardRow.short">
        <Setter Property="Height" Value="22" />
    </Style>
    <!-- Compact lists (the panel's tag button; Border.compactRows in the Settings preview): short rows without art. After the
         full sizes, so these win. -->
    <Style Selector="o|MovablePanel.compact Grid.cardRow, Border.compactRows Grid.cardRow">
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="o|MovablePanel.compact Image.tileArt, Border.compactRows Image.tileArt">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="o|MovablePanel.compact Rectangle.tileFade, Border.compactRows Rectangle.tileFade">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="o|MovablePanel.compact c|ManaCost.cost, Border.compactRows c|ManaCost.cost">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Grid.tileRow.empty Image.tileArt">
        <Setter Property="Opacity" Value="0.22" />
    </Style>
    <Style Selector="Grid.tileRow.empty c|ManaCost.cost">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.countText">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Grid.tileRow.legendary TextBlock.tileName, Grid.tileRow.legendary TextBlock.countText">
        <Setter Property="Foreground" Value="{StaticResource RarityLegendary}" />
    </Style>
    <Style Selector="Grid.tileRow.empty Border.rarityEdge">
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style Selector="Grid.tileRow.empty Border.countBadge">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Grid.tileRow.empty TextBlock.tileName">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
</Styles>
