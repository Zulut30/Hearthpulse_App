<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Overlay-only look shared by the overlay view and its panels (WPF: Overlay/OverlayLook.xaml, same names as keys).
         Theme tokens only, no hex. Nothing here animates, blurs or casts a shadow: the overlay draws over the game. -->

    <!-- Panel header: a warm gold band with a hairline under it, flush with the card's rounded top (card radius 8 - 1px edge) -->
    <Style Selector="Border.overlayHeader">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="7,7,0,0" />
        <Setter Property="Padding" Value="12,8,12,7" />
    </Style>

    <!-- Dark plate for a few key figures under a header -->
    <Style Selector="Border.statPlate">
        <Setter Property="Background" Value="{StaticResource OverlayBadgeShade}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5,8,4" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Card rows: a gold hairline along the top edge lifts the row off the panel -->
    <Style Selector="Border.rowSheen">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- One small source line at the bottom of a panel -->
    <Style Selector="TextBlock.overlayFooter">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
