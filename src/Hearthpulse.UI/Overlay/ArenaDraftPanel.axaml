<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.ArenaDraftPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Arena draft panel: the run's class and picks, the average ArenaSmith score, the mana curve, class win rates at
         the hero pick and the cards picked so far. Read-only: only the header takes the pointer, for the tier legend and the
         data source in its tooltip. DataContext: OverlayViewModel.
         Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
        <Style Selector="TextBlock.className">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Border.curveBar">
            <Setter Property="Background" Value="{StaticResource AccentDeep}" />
        </Style>
        <Style Selector="Border.curveBar.offered">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.curveCost.offered">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.className.offered">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayCard" Width="244">
        <StackPanel>
            <!-- Header: what the panel is and how far the draft got, then the run's class -->
            <Border Classes="overlayHeader" o:OverlayHit.Interactive="True">
                <!-- What the letters mean (the class scale at the hero pick, the card scale after it) and where the scores come from -->
                <ToolTip.Tip>
                    <StackPanel MaxWidth="260">
                        <TextBlock Text="{Binding ArenaTierLegend}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   IsVisible="{Binding ArenaTierLegend, Converter={StaticResource Truthy}}" />
                        <TextBlock Text="{Binding ArenaSource}" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip.Tip>
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xF0538;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{i:Loc Arena.Panel.Title}" Classes="label" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="pill" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ArenaDraftPicks}" FontFamily="{DynamicResource DisplayFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding ArenaDraftTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArenaMode}" FontSize="10.5" Foreground="{StaticResource Muted}" IsVisible="{Binding ArenaMode, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </Border>

        <StackPanel Margin="12,0,12,9">
            <!-- Why the scores are dashes, right under the header: at the end of a long panel it was out of sight -->
            <TextBlock Name="ArenaNoDataNote" Text="{Binding ArenaNoData}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       IsVisible="{Binding ArenaNoData, Converter={StaticResource Truthy}}" />
            <!-- The run's class: win rate, place among the classes, 7+ wins - one figure per column, never wrapped mid-number -->
            <Border Classes="statPlate" Margin="0,8,0,0" IsVisible="{Binding ArenaClassStats, Converter={StaticResource Truthy}}">
                <ItemsControl ItemsSource="{Binding ArenaClassStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ArenaStat">
                            <StackPanel>
                                <!-- Only the win rate has a tier colour; the other figures stay plain text -->
                                <TextBlock Text="{Binding Value}" Classes="statValue" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                           IsVisible="{Binding Tier, Converter={StaticResource Truthy}}" />
                                <TextBlock Text="{Binding Value}" Classes="statValue" Foreground="{StaticResource Text}"
                                           IsVisible="{Binding Tier, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                <TextBlock Text="{Binding Label}" Classes="statLabel" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Average score of the deck so far and the mana curve, once a card is picked -->
            <StackPanel IsVisible="{Binding ArenaHasPicks}">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Panel Width="38" Height="38" VerticalAlignment="Center">
                        <c:Scallop Fill="{Binding ArenaAverageTier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                        <TextBlock Text="{Binding ArenaAverageTier}" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArenaAverage}" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding ArenaAverageTier, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Text="{i:Loc Arena.Panel.Average}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Mana curve: 0 .. 7+ -->
                <TextBlock Text="{i:Loc Arena.Panel.Curve}" Classes="label section" />
                <ItemsControl ItemsSource="{Binding ArenaCurve}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ArenaCurveBar">
                            <StackPanel Margin="2,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Count}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <!-- The costs of the offered cards are lit, so the curve shows where each would go -->
                                <Panel Height="34">
                                    <Border Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2" Classes="curveBar" Classes.offered="{Binding Offered}" />
                                </Panel>
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Classes="curveCost" Classes.offered="{Binding Offered}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ArenaTypes}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding ArenaTypes, Converter={StaticResource Truthy}}" />
            </StackPanel>

            <!-- Hero pick: classes by community win rate, the offered ones in gold -->
            <StackPanel IsVisible="{Binding ArenaClasses, Converter={StaticResource Truthy}}">
                <TextBlock Text="{i:Loc Arena.Panel.Classes}" Classes="label section" />
                <ItemsControl ItemsSource="{Binding ArenaClasses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ArenaClassRow">
                            <Grid Height="19" ColumnDefinitions="*,Auto,18,54">
                                <TextBlock Text="{Binding Name}" Classes="className" Classes.offered="{Binding Offered}" FontSize="11.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding WinRate}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Tier}" Classes="tierLetter" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="3" Text="{Binding SevenPlus}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Cards picked so far, by cost -->
            <StackPanel IsVisible="{Binding ArenaDeck, Converter={StaticResource Truthy}}">
                <TextBlock Text="{i:Loc Arena.Panel.Deck}" Classes="label section" />
                <ItemsControl ItemsSource="{Binding ArenaDeck}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:ArenaDeckRow">
                            <Grid Height="21" Margin="0,0,0,2" ColumnDefinitions="25,*,Auto,26,18">
                                <!-- A plate behind name, copies and score, lifted by a hairline -->
                                <Border Grid.Column="1" Grid.ColumnSpan="4" Background="{StaticResource Row}" CornerRadius="4">
                                    <Border Classes="rowSheen" />
                                </Border>
                                <c:ManaCost Width="20" Height="20" Text="{Binding Cost}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Copies}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Score}" FontFamily="{DynamicResource DisplayFont}" FontSize="11.5" FontWeight="Bold" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="4" Text="{Binding Tier}" Classes="tierLetter" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
