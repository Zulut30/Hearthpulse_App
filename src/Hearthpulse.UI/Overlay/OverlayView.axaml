<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.OverlayView"
             x:DataType="o:OverlayViewModel"
             Background="Transparent" Foreground="{StaticResource Text}"
             FontFamily="{DynamicResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />
        <i:SignBrush x:Key="SignBrush" />
        <i:FractionWidth x:Key="Fraction" />
        <i:LeftMargin x:Key="LeftMargin" />

        <!-- Deck row: cost gem, name over card art with a rarity strip and the copy count, then the draw chance in its own
             column so it never runs into the name. A card with no copies left dims (art, gem and name sink back, the plate
             stays so the row keeps its place); the row whose count just moved flashes once (OverlayLook: rowFlash). -->
        <DataTemplate x:Key="DeckTileTemplate" x:DataType="o:DeckTile">
            <Grid Classes="tileRow" Classes.empty="{Binding Empty}" Classes.changed="{Binding Changed}" Height="24" Margin="0,0,0,2" ColumnDefinitions="26,*,Auto" Background="Transparent"
                  c:CardPreview.CardId="{Binding CardId}">
                <c:ManaCost Classes="cost" Text="{Binding Cost}" HorizontalAlignment="Left" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                    <Panel>
                        <Image Classes="tileArt" i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Classes="rarityStrip" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,3,0">
                            <Border Classes="countBadge" DockPanel.Dock="Right" IsVisible="{Binding ShowCount}">
                                <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#xF0674;" Classes="icon" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" IsVisible="{Binding Created}" />
                            <TextBlock Classes="tileName" Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Classes="rowSheen" />
                        <Border Classes="rowFlash" />
                    </Panel>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Chance}" Width="31" TextAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding $parent[ItemsControl].((o:OverlayViewModel)DataContext).ShowChance, FallbackValue=True}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlayedTemplate" x:DataType="o:PlayedTile">
            <Grid Height="22" Margin="0,0,0,2" ColumnDefinitions="25,*">
                <c:ManaCost Classes="cost" Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                    <Panel>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="8,0,3,0">
                            <!-- Copies and turn on a dark plate, like the deck's copy count, so they stay readable over bright art -->
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" Height="16" Padding="5,0"
                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,5,0"
                                               VerticalAlignment="Center" IsVisible="{Binding Count, Converter={StaticResource Truthy}}" />
                                    <TextBlock Text="{Binding Turn}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Classes="rowSheen" />
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HandTemplate" x:DataType="o:HandTile">
            <Grid Height="22" Margin="0,0,0,2" ColumnDefinitions="22,62,*">
                <Border Background="{StaticResource Surface3}" CornerRadius="5">
                    <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Turn}" FontSize="11" Foreground="{StaticResource Muted}" Margin="7,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="handDetail" Classes.known="{Binding Highlight}" Classes.unknown="{Binding Unknown}" Text="{Binding Detail}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Counter tooltip strip: card art behind the name, count on the right; a part of a goal gets a done mark -->
        <DataTemplate x:Key="CounterCardTemplate" x:DataType="o:CounterTipCard">
            <Grid Classes="counterCard" Classes.pending="{Binding !Done}" Height="22" Margin="0,0,0,2">
                <Border Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                    <Panel>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="7,0,7,0">
                            <TextBlock DockPanel.Dock="Left" Classes="icon partMark" Classes.done="{Binding Done}" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center" IsVisible="{Binding IsPart}" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="20" Height="16" Padding="4,0"
                                    Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Count, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- What a counter's tooltip and its opened row list: the goal's parts, what was counted, the cards that need it -->
        <DataTemplate x:Key="CounterCardsTemplate" x:DataType="o:CounterChip">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" Margin="0,0,0,2" IsVisible="{Binding Details, Converter={StaticResource Truthy}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding Parts, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Goal}" Classes="counterSection" />
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding Counted, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Classes="counterSection" />
                    <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                    <TextBlock Text="{Binding MoreCounted}" FontSize="11" Foreground="{StaticResource Muted}" IsVisible="{Binding MoreCounted, Converter={StaticResource Truthy}}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding Related, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Classes="counterSection" />
                    <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                    <TextBlock Text="{Binding MoreRelated}" FontSize="11" Foreground="{StaticResource Muted}" IsVisible="{Binding MoreRelated, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The opened Battlegrounds chip: its cards only, under the details the row already shows -->
        <DataTemplate x:Key="BgCounterCardsTemplate" x:DataType="o:CounterChip">
            <StackPanel>
                <StackPanel IsVisible="{Binding Counted, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Classes="counterSection" />
                    <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding Related, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Classes="counterSection" />
                    <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Counter tooltip: title and value, what the counter is, then its cards -->
        <DataTemplate x:Key="CounterTipTemplate" x:DataType="o:CounterChip">
            <StackPanel Width="232" Margin="0,2,0,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Classes="number" FontSize="14" Foreground="{StaticResource Accent}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,2" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Counter row: card art (the cross over it on hover hides the counter), title with its progress under it, value
             right-aligned; hover shows the cards, a click opens them under the row -->
        <DataTemplate x:Key="CounterTemplate" x:DataType="o:CounterChip">
            <Border Classes="counterChip" Classes.open="{Binding Expanded}" CornerRadius="5" Padding="3,1,4,1" Cursor="Hand" Background="Transparent"
                    ToolTip.Placement="Right" ToolTip.HorizontalOffset="8" ToolTip.ShowDelay="250" ToolTip.ServiceEnabled="{Binding !Expanded}">
                <ToolTip.Tip>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
                </ToolTip.Tip>
                <StackPanel>
                    <Panel Height="24">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((o:OverlayViewModel)DataContext).ToggleCounter}" CommandParameter="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="CounterValue" />
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding IconCardId}" />
                                <Ellipse Width="20" Height="20" Stroke="{StaticResource OverlayBorder}" StrokeThickness="1" />
                                <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Segments}" Margin="0,3,-2,0" IsVisible="{Binding Segments, Converter={StaticResource Truthy}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:Boolean">
                                                <Border Classes="counterSegment" Classes.lit="{Binding}" Height="3" CornerRadius="1.5" Margin="0,0,2,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressBar Classes="counterBar" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="0,3,0,0" IsVisible="{Binding HasBar}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="number" FontSize="14" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="icon hideCounter" Content="&#xF0156;" FontSize="11" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource Surface3}" Focusable="False" ToolTip.Tip="{i:Loc Overlay.Counter.HideTip}"
                                Command="{Binding $parent[UserControl].((o:OverlayViewModel)DataContext).HideCounter}" CommandParameter="{Binding Id}" />
                    </Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" Margin="27,0,0,6" IsVisible="{Binding Expanded}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Battlegrounds counter chip: art, title over value; a click opens its details under the row, the cross hides it -->
        <DataTemplate x:Key="BgCounterTemplate" x:DataType="o:CounterChip">
            <Border Classes="bgCounterChip" Classes.open="{Binding Expanded}" BorderThickness="1" CornerRadius="8" Padding="5,4,6,4" Margin="0,0,6,6"
                    Cursor="Hand" ToolTip.ShowDelay="250">
                <ToolTip.Tip>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
                </ToolTip.Tip>
                <Grid ColumnDefinitions="Auto,Auto">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                            Command="{Binding $parent[UserControl].((o:OverlayViewModel)DataContext).ToggleBgCounter}" CommandParameter="{Binding Id}">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" VerticalAlignment="Center" i:CardArt.Portrait="{Binding IconCardId}" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="{StaticResource Muted}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Value}" Classes="number" FontSize="15" />
                                <Border Height="2" CornerRadius="1" Background="{StaticResource Surface4}" Width="56" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        IsVisible="{Binding HasProgress}">
                                    <Border HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource Accent}"
                                            Width="{Binding Progress, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="icon hideCounter" Content="&#xF0156;" FontSize="10" Width="18" Height="18" Margin="4,0,0,0" VerticalAlignment="Top"
                            Focusable="False" ToolTip.Tip="{i:Loc Overlay.BgCounter.HideTip}"
                            Command="{Binding $parent[UserControl].((o:OverlayViewModel)DataContext).HideBgCounter}" CommandParameter="{Binding Id}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TierTemplate" x:DataType="o:TierButton">
            <Button Classes="bare tierChip" Classes.current="{Binding IsCurrent}" Classes.selected="{Binding IsSelected}" Click="OnTierClick"
                    Margin="0,0,3,0" Focusable="False" ToolTip.Tip="{i:Loc Overlay.Bar.TierTip}">
                <Border Name="Chip" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5">
                    <TextBlock Name="Num" Text="{Binding Tier}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CombatTemplate" x:DataType="o:CombatDot">
            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,4,0" Background="{Binding Result, Converter={StaticResource KeyBrush}}" ToolTip.Tip="{Binding Tooltip}" />
        </DataTemplate>

        <!-- Hero pick: compact badge centred above each hero portrait (slot = HDT hero pitch, 340 units) -->
        <DataTemplate x:Key="HeroPickTemplate" x:DataType="o:HeroPickCard">
            <Panel Width="340" Classes="pick" Classes.best="{Binding Recommended}" Classes.noData="{Binding !HasMeta}">
                <Border Classes="overlayCard pickCard" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        Width="232" Padding="10,8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="38" Height="38" VerticalAlignment="Center">
                            <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Place}" Classes="number" FontSize="18" />
                                <TextBlock Text="{Binding Delta}" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                           Foreground="{Binding DeltaValue, Converter={StaticResource SignBrush}}" />
                                <TextBlock Text="{Binding PlaceNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,3" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Personal}" FontSize="11" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Personal, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="bestTag" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource Accent}" CornerRadius="5" Padding="8,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Classes="icon" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Panel>
        </DataTemplate>

        <!-- Trinket pick: compact badge above each offered trinket (slot = HDT trinket pitch, 277 units) -->
        <DataTemplate x:Key="TrinketBadgeTemplate" x:DataType="o:TrinketBadge">
            <Panel Width="277" Classes="pick" Classes.best="{Binding Recommended}" Classes.noData="{Binding !HasMeta}">
                <Border Classes="overlayCard pickCard" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        Width="196" Padding="9,7" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="34" Height="34" VerticalAlignment="Center">
                            <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Place}" Classes="number" FontSize="16" />
                                <TextBlock Text="{i:Loc Overlay.Badge.AvgPlace}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,2" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="bestTag" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource Accent}" CornerRadius="5" Padding="8,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Classes="icon" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Panel>
        </DataTemplate>

        <!-- Tavern: buy hint pinned above one shop minion: reasons, plus how players who bought it placed -->
        <DataTemplate x:Key="ShopBadgeTemplate" x:DataType="o:ShopBadge">
            <Border Classes="shopBadge" Classes.best="{Binding Best}" Classes.dataOnly="{Binding !Label.Length}" Width="126" MinHeight="26" CornerRadius="6" Padding="8,3" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{Binding Left, Converter={StaticResource LeftMargin}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Name="Buy" Text="{i:Loc Overlay.Badge.Buy}" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                        <TextBlock Name="Lbl" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="100"
                                   IsVisible="{Binding Label, Converter={StaticResource Truthy}}" />
                    </StackPanel>
                    <TextBlock Name="Data" Text="{Binding Placement}" HorizontalAlignment="Center"
                               IsVisible="{Binding Placement, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Discover-style choice (hero power, spell, triple reward, Dark Gift…): one badge above each option (slot = 340 units) -->
        <DataTemplate x:Key="DiscoverBadgeTemplate" x:DataType="o:DiscoverBadge">
            <Panel Width="340" Classes="pick discover" Classes.best="{Binding Best}">
                <Border Classes="overlayCard pickCard" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        MinWidth="150" MaxWidth="236" Padding="9,7,12,7" Margin="0,9,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel VerticalAlignment="Center">
                            <!-- "Mark the best": rank among the options (Rank is 0 otherwise) -->
                            <Panel Width="32" Height="32" Margin="0,0,9,0" IsVisible="{Binding Rank, Converter={StaticResource Truthy}}">
                                <c:Scallop Name="Cookie" Lobes="8" Depth="0.1" />
                                <TextBlock Name="RankText" FontFamily="{DynamicResource DisplayFont}" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="#" FontSize="10" /><Run Text="{Binding Rank, Mode=OneWay}" /></TextBlock>
                            </Panel>
                            <!-- Otherwise no ranking: the option's tavern tier, drawn like the top bar's tier chips -->
                            <Panel IsVisible="{Binding Rank, Converter={StaticResource Truthy}, ConverterParameter=!}">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,9,0" Background="{StaticResource Surface3}"
                                        IsVisible="{Binding Tier, Converter={StaticResource Truthy}}" ToolTip.Tip="{i:Loc Overlay.Common.TavernTier}">
                                    <TextBlock Text="{Binding Tier}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Placement}" Classes="number" FontSize="16" />
                                <TextBlock Text="{Binding PlacementNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="5,0,0,2" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Label, Converter={StaticResource Truthy}}" />
                            <TextBlock Text="{Binding Gift}" FontSize="10.5" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Gift, Converter={StaticResource Truthy}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="bestTag" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource Accent}" CornerRadius="5" Padding="8,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Classes="icon" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Panel>
        </DataTemplate>

        <!-- Comp card list row -->
        <DataTemplate x:Key="CompCardTemplate" x:DataType="o:CompCardTile">
            <Grid Classes="compCard" Classes.owned="{Binding Owned}" Height="22" Margin="0,0,0,2" ColumnDefinitions="24,*"
                  ToolTip.ShowDelay="150">
                <ToolTip.Tip>
                    <StackPanel Width="248">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,4" />
                        <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                    </StackPanel>
                </ToolTip.Tip>
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                    <Panel>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Width="2" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,6,0">
                            <TextBlock DockPanel.Dock="Right" Text="&#xF012C;" Classes="icon" FontSize="12" Foreground="{StaticResource Positive}"
                                       IsVisible="{Binding Owned}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource KeyBrush}}" />
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AlternativeTemplate" x:DataType="o:CompRow">
            <Button Classes="bare alternative" Click="OnAlternativeClick" Focusable="False" Margin="0,0,0,3" HorizontalAlignment="Stretch"
                    ToolTip.Tip="{Binding $parent[ItemsControl].((o:OverlayViewModel)DataContext).CompRowTooltip, FallbackValue=''}">
                <Border Name="Bd" CornerRadius="6" Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- "I choose": an empty radio mark on every comp; the chosen one sits above with a filled mark -->
                        <TextBlock Name="Choose" Text="&#xF043D;" Classes="icon" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[ItemsControl].((o:OverlayViewModel)DataContext).CompManual, FallbackValue=False}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Tribes, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding OwnedCore, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding CoreCount, Mode=OneWay}" /><Run Text="{i:Loc Overlay.Comp.CoreOwnedSuffix}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Placement}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Power}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Power, Converter={StaticResource KeyBrush}}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BrowserCardTemplate" x:DataType="o:BrowserCard">
            <Panel Width="92" Margin="2" ToolTip.ShowDelay="120">
                <ToolTip.Tip>
                    <StackPanel Width="248">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,4" />
                        <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                    </StackPanel>
                </ToolTip.Tip>
                <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="92" Height="128" Stretch="Uniform"
                       Classes="zoomImg" RenderTransformOrigin="1,0.5" />
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{StaticResource Accent}" CornerRadius="5"
                        Padding="6,0" Margin="0,0,0,2" IsVisible="{Binding InComp}">
                    <TextBlock Text="{i:Loc Overlay.Browser.InPlan}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </Border>
            </Panel>
        </DataTemplate>

        <DataTemplate x:Key="LobbyMinionTemplate" x:DataType="o:LobbyMinion">
            <Grid Width="78" Margin="2,0" RowDefinitions="Auto,Auto" ToolTip.ShowDelay="120">
                <ToolTip.Tip>
                    <StackPanel Width="248">
                        <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                        <TextBlock Text="{Binding Keywords}" FontSize="10.5" TextWrapping="Wrap" Margin="2,4,2,0" />
                    </StackPanel>
                </ToolTip.Tip>
                <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="78" Height="108" Stretch="Uniform"
                       Classes="zoomImg" RenderTransformOrigin="1,0.5" />
                <Border Width="78" Height="108" BorderBrush="{StaticResource TierS}" BorderThickness="2" CornerRadius="6" IsVisible="{Binding Golden}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Attack}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TierS}" />
                    <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource Faint}" />
                    <TextBlock Text="{Binding Health}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Negative}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LobbyRowTemplate" x:DataType="o:LobbyRow">
            <Grid Classes="lobbyRow" Classes.next="{Binding Next}" Classes.you="{Binding You}" Classes.dead="{Binding Dead}"
                  Height="28" Margin="0,0,0,2" ColumnDefinitions="16,28,*,24,42">
                <Border Name="Bg" Grid.ColumnSpan="5" CornerRadius="6" Margin="-5,0" />
                <TextBlock Text="{Binding Place}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding HeroCardId}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock Name="HeroName" Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <Border Height="2" CornerRadius="1" Background="{StaticResource Surface3}" Margin="0,3,0,0">
                        <Border HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource Positive}"
                                Width="{Binding HealthFraction, Converter={StaticResource Fraction}, ConverterParameter=96}" />
                    </Border>
                </StackPanel>
                <Border Grid.Column="3" Width="19" Height="18" CornerRadius="4" Background="{StaticResource Surface3}" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Overlay.Common.TavernTier}">
                    <TextBlock Text="{Binding Tier}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Health}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Last}" FontSize="9.5" HorizontalAlignment="Right" Foreground="{Binding LastKey, Converter={StaticResource KeyBrush}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PillTemplate" x:DataType="x:String">
            <Border Classes="pill" Margin="0,0,4,4" Padding="7,1">
                <TextBlock Text="{Binding}" FontSize="11" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HRow">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapRow">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Overlay/OverlayLook.axaml" />
        <!-- Card art answers the mouse: the tile grows and a large tooltip makes small card text readable -->
        <Style Selector="Image.zoomImg:pointerover">
            <Setter Property="RenderTransform" Value="scale(2.2)" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
        </Style>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="c|ManaCost.cost">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.tileRow.empty Image.tileArt">
            <Setter Property="Opacity" Value="0.22" />
        </Style>
        <Style Selector="Grid.tileRow.empty c|ManaCost.cost">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Grid.tileRow.empty Border.rarityStrip">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Grid.tileRow.empty Border.countBadge">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Grid.tileRow.empty TextBlock.tileName">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="TextBlock.handDetail">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.handDetail.known">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="TextBlock.handDetail.unknown">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>

        <!-- Tier chips -->
        <Style Selector="Button.tierChip Border#Chip">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.tierChip TextBlock#Num">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Button.tierChip:pointerover Border#Chip">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Button.tierChip:pointerover TextBlock#Num">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.tierChip.current Border#Chip">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.tierChip.current TextBlock#Num">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        </Style>
        <Style Selector="Button.tierChip.selected Border#Chip">
            <Setter Property="BorderBrush" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Button.tierChip.selected TextBlock#Num">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <!-- Pick badges: hero, trinket, discover. Only "Mark the best" (Grid#Surface.marking) singles one out:
             BEST PICK tag, gold edge, gold rank cookie, other options dimmed. "Stats only" draws every option alike. -->
        <Style Selector="Panel.pick Border.bestTag">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.marking Panel.pick.best Border.bestTag">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid.marking Panel.pick.best Border.pickCard">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Panel.pick.noData Border.pickCard">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Grid.marking Panel.discover Border.pickCard">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Grid.marking Panel.discover.best Border.pickCard">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.discover TextBlock#RankText">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- Fill set by style (not on the element) so the best option's gold fill below can apply -->
        <Style Selector="Panel.discover c|Scallop#Cookie">
            <Setter Property="Fill" Value="{StaticResource Surface4}" />
        </Style>
        <Style Selector="Grid.marking Panel.discover.best c|Scallop#Cookie">
            <Setter Property="Fill" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Grid.marking Panel.discover.best TextBlock#RankText">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        </Style>

        <!-- Shop badges: neutral; gold with BUY only for the best buy in "Mark the best" -->
        <Style Selector="Border.shopBadge">
            <Setter Property="Background" Value="{StaticResource OverlayPanelSolid}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        </Style>
        <Style Selector="Border.shopBadge TextBlock#Buy">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.shopBadge TextBlock#Lbl">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Border.shopBadge TextBlock#Data">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <!-- A badge with no tags (stats only) shows its placement at a readable size -->
        <Style Selector="Border.shopBadge.dataOnly TextBlock#Data">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Grid.marking Border.shopBadge.best">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Grid.marking Border.shopBadge.best TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        </Style>
        <Style Selector="Grid.marking Border.shopBadge.best TextBlock#Buy">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Comp cards and alternatives -->
        <Style Selector="Grid.compCard">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Grid.compCard.owned">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.alternative Border#Bd">
            <Setter Property="Background" Value="{StaticResource Row}" />
        </Style>
        <Style Selector="Button.alternative:pointerover Border#Bd">
            <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
        </Style>
        <Style Selector="Button.alternative TextBlock#Choose">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="Button.alternative:pointerover TextBlock#Choose">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.lock Border#Bd">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
        </Style>
        <Style Selector="Button.lock:pointerover Border#Bd">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
        </Style>
        <Style Selector="Button.lock.pinned Border#Bd">
            <Setter Property="Background" Value="{StaticResource AccentContainer}" />
        </Style>
        <Style Selector="Button.lock.pinned TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OnAccentContainer}" />
        </Style>

        <!-- Lobby rows -->
        <Style Selector="Grid.lobbyRow.next Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.lobbyRow.you TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Grid.lobbyRow.dead">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Session place chips -->
        <Style Selector="Border.placeChip">
            <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
        </Style>
        <Style Selector="Border.placeChip TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Border.placeChip.top">
            <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
        </Style>
        <Style Selector="Border.placeChip.top TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>

        <!-- Movable panel host: frame, label and placeholder in layout mode -->
        <Style Selector="Border.counterChip:pointerover, Border.counterChip.open">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="Border.counterSegment">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
        </Style>
        <Style Selector="Border.counterSegment.lit">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="ProgressBar.counterBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.counterSection">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style Selector="TextBlock.partMark">
            <Setter Property="Text" Value="&#xF0766;" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="TextBlock.partMark.done">
            <Setter Property="Text" Value="&#xF05E0;" />
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Grid.counterCard.pending">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.hideCounter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.counterChip:pointerover Button.hideCounter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.bgCounterChip">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        </Style>
        <!-- Raised plate on hover (the Hover wash would make the chip see-through against the panel) -->
        <Style Selector="Border.bgCounterChip:pointerover">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
        </Style>
        <Style Selector="Border.bgCounterChip.open">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Border.bgCounterChip:pointerover Button.hideCounter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.good">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="o|MovablePanel" x:DataType="o:OverlayViewModel">
            <Setter Property="IsEditing" Value="{Binding LayoutEditing}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <LayoutTransformControl Name="PART_Scaler" ClipToBounds="False">
                            <Panel>
                                <!-- Placeholder: its own dashed frame, so a wide pick row frames only its label, not the whole card row -->
                                <Panel Name="Placeholder" IsVisible="False" HorizontalAlignment="{TemplateBinding PlaceholderAlignment}">
                                    <Border MinWidth="200" MinHeight="36" Background="{StaticResource OverlayPlaceholder}" CornerRadius="8"
                                            BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,8">
                                            <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Name="HintText" Text="{TemplateBinding Hint}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" IsVisible="False" />
                                            <TextBlock Text="{TemplateBinding ScaleText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                                                       IsVisible="{TemplateBinding ScaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Border>
                                    <Rectangle Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False" />
                                </Panel>
                                <ContentPresenter Name="Body" Content="{TemplateBinding Content}" />
                                <Border Name="Shield" Background="#01000000" IsVisible="False" />
                            </Panel>
                        </LayoutTransformControl>
                        <!-- Layout-mode frame and name tag sit outside the scaler so they are never clipped. -->
                        <Rectangle Name="Frame" IsVisible="False" Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}"
                                   StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False" />
                        <Border Name="Tag" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-26,0,0" Height="18"
                                Background="{StaticResource Accent}" CornerRadius="5" Padding="7,0" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                <!-- The size the player scrolled to, so two panels can be given the same one -->
                                <TextBlock Text="{TemplateBinding ScaleText}" FontSize="10.5" Foreground="{StaticResource OnAccent}" Margin="6,0,0,0"
                                           IsVisible="{TemplateBinding ScaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="o|MovablePanel.editing /template/ Border#Shield">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="o|MovablePanel.editing /template/ Rectangle#Frame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="o|MovablePanel.editing /template/ Border#Tag">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="o|MovablePanel.placeholder /template/ Panel#Placeholder">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="o|MovablePanel.placeholder /template/ ContentPresenter#Body">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Most panels show during matches and need no note; menu and draft panels name their scene in Hint -->
        <Style Selector="o|MovablePanel.hinted /template/ TextBlock#HintText">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- A placeholder already carries the title; the tag would only repeat it and pile up over its neighbours. Only the
             placeholder itself takes the mouse, so a wide row's empty width never hides its neighbours. -->
        <Style Selector="o|MovablePanel.editing.placeholder /template/ Border#Tag">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="o|MovablePanel.editing.placeholder /template/ Border#Shield">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="o|MovablePanel.editing.placeholder /template/ Rectangle#Frame">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Panel Name="Root">
        <LayoutTransformControl Name="SurfaceHost" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
            <Grid Name="Surface" Width="1920" Height="1080" Classes.marking="{Binding ShowBestBadges}">

                <!-- ============ Constructed: your deck (right) ============ -->
                <o:MovablePanel Id="deck" Title="{i:Loc Overlay.Panel.Deck}" Shown="{Binding ShowConstructed}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,12,0">
                    <Border Classes="overlayCard" Width="252">
                        <StackPanel>
                            <Border Classes="overlayHeader" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeckName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeckRecord}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                               Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.Caption="{Binding DeckRecordTip}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Deck}" ItemTemplate="{StaticResource DeckTileTemplate}" Margin="8,0,8,4" o:OverlayHit.Interactive="True" />
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,7,12,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeckCounts}" FontSize="11" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding NextDraw}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding NextDraw, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Constructed: opponent (left) ============ -->
                <o:MovablePanel Id="opponent" Title="{i:Loc Overlay.Common.Opponent}" Shown="{Binding ShowOpponent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,76,0,0">
                    <Border Classes="overlayCard" Width="214">
                        <StackPanel>
                            <Border Classes="overlayHeader">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Portrait in a gold ring -->
                                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Padding="1">
                                        <Border CornerRadius="16" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding OpponentHeroId}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OpponentTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OpponentSubtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <StackPanel Margin="12,0,12,10">
                            <!-- Hand, deck and Secrets: the numbers first, on one dark plate -->
                            <Border Classes="statPlate" Margin="0,10,0,0">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OpponentHand}" Classes="statValue" FontSize="17" />
                                        <TextBlock Text="{i:Loc Overlay.Opponent.Hand}" Classes="statLabel" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OpponentDeck}" Classes="statValue" FontSize="17" />
                                        <TextBlock Text="{i:Loc Overlay.Opponent.Deck}" Classes="statLabel" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OpponentSecrets}" Classes="statValue" FontSize="17" />
                                        <TextBlock Text="{i:Loc Overlay.Opponent.Secrets}" Classes="statLabel" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding OpponentMatchup}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding OpponentMatchup, Converter={StaticResource Truthy}}" />

                            <c:Ornament Text="{i:Loc Overlay.Opponent.Played}" Size="10.5" Margin="0,12,0,6" IsVisible="{Binding Played, Converter={StaticResource Truthy}}" />
                            <ItemsControl ItemsSource="{Binding Played}" ItemTemplate="{StaticResource PlayedTemplate}" />

                            <c:Ornament Text="{i:Loc Overlay.Opponent.CardsInHand}" Size="10.5" Margin="0,12,0,6" IsVisible="{Binding Hand, Converter={StaticResource Truthy}}" />
                            <ItemsControl ItemsSource="{Binding Hand}" ItemTemplate="{StaticResource HandTemplate}" />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Constructed: opponent's likely archetype (left, beside the opponent tracker and under the card pool; the right side holds the deck and secrets) ============ -->
                <o:MovablePanel Id="opponent-archetype" Title="{i:Loc Widgets.Archetype.Panel}" Shown="{Binding ShowArchetype}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="248,520,0,0">
                    <o:OpponentArchetypePanel />
                </o:MovablePanel>

                <!-- ============ Menus: ranked ladder session (top right, outside games only) ============ -->
                <o:MovablePanel Id="ladder-session" Title="{i:Loc Widgets.Ladder.Panel}" Hint="{i:Loc Overlay.Layout.AppearsInMenus}" Shown="{Binding ShowLadder}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,276,0">
                    <o:LadderSessionPanel />
                </o:MovablePanel>

                <!-- ============ Constructed: turn timers, left of each hero portrait (weapon slot side, clear of the hero power) ============ -->
                <o:MovablePanel Id="turn-timer-opponent" Title="{i:Loc Widgets.Turn.OpponentPanel}" Shown="{Binding ShowTurnTimer}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,660,0">
                    <o:TurnTimerPanel DataContext="{Binding OpponentTimer}" />
                </o:MovablePanel>
                <o:MovablePanel Id="turn-timer" Title="{i:Loc Widgets.Turn.Panel}" Shown="{Binding ShowTurnTimer}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,660,200">
                    <o:TurnTimerPanel DataContext="{Binding MyTimer}" />
                </o:MovablePanel>

                <!-- ============ Constructed: marks under the opponent's hand fan (top centre; move and scale it onto the cards) ============ -->
                <o:MovablePanel Id="opponent-hand" PlaceholderAlignment="Center" Title="{i:Loc Overlay.Panel.OpponentHand}" MinWidth="{x:Static o:OverlayViewModel.HandPanelWidth}" Shown="{Binding ShowHandMarks}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0">
                    <o:OpponentHandPanel />
                </o:MovablePanel>

                <!-- ============ Constructed and Arena: the opponent's Secrets (x 1180-1390 right of their Hero Power, above the board, folded to 4 rows; rows take clicks) ============ -->
                <o:MovablePanel Id="secrets" Title="{i:Loc Overlay.Panel.Secrets}" GameAnchored="True" Shown="{Binding ShowSecrets}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="650,140,0,0">
                    <o:SecretsPanel />
                </o:MovablePanel>

                <!-- ============ Constructed: counters (bottom-left) ============ -->
                <o:MovablePanel Id="counters" Title="{i:Loc Overlay.Panel.Counters}" Shown="{Binding ShowCounters}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,110">
                    <Border x:Name="CountersCard" Classes="overlayCard" Width="214" o:OverlayHit.Interactive="True">
                        <!-- One value column for every row, so the progress under each title ends at the same place -->
                        <StackPanel Margin="9,8,9,7" Grid.IsSharedSizeScope="True">
                            <StackPanel IsVisible="{Binding OpponentCounters, Converter={StaticResource Truthy}}">
                                <c:Ornament Text="{i:Loc Overlay.Common.Opponent}" Size="10.5" Margin="3,0,0,3" />
                                <ItemsControl ItemsSource="{Binding OpponentCounters}" ItemTemplate="{StaticResource CounterTemplate}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding MyCounters, Converter={StaticResource Truthy}}">
                                <c:Ornament Text="{i:Loc Overlay.Counters.You}" Size="10.5" Margin="3,6,0,3" />
                                <ItemsControl ItemsSource="{Binding MyCounters}" ItemTemplate="{StaticResource CounterTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: counters row (bottom-left) ============ -->
                <o:MovablePanel Id="bg-counters" Title="{i:Loc Overlay.Panel.BgCounters}" Shown="{Binding ShowBgCounters}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,250">
                    <Border Classes="overlayCard" Padding="8,8,2,2" MaxWidth="560" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding BgCounters}" ItemTemplate="{StaticResource BgCounterTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Margin="2,0,8,8" MaxWidth="520" HorizontalAlignment="Left" IsVisible="{Binding BgCounterDetails, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding BgCounterDetailTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding BgCounterDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ContentControl Content="{Binding BgCounterOpen}" ContentTemplate="{StaticResource BgCounterCardsTemplate}" Width="232" HorizontalAlignment="Left"
                                                IsVisible="{Binding BgCounterOpen, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Constructed: card pool of a Discover / random generator ============ -->
                <o:MovablePanel Id="card-pool" Title="{i:Loc Overlay.Panel.CardPool}" Shown="{Binding ShowCardPoolPanel}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="248,76,0,0">
                    <o:CardPoolPanel x:Name="CardPool" />
                </o:MovablePanel>

                <!-- ============ Constructed: card pool browser (every card; right-click on the pool panel) ============ -->
                <!-- Left edge by default: on the right it would cover the End Turn button. -->
                <o:MovablePanel Id="card-pool-browser" Title="{i:Loc Overlay.Panel.CardPoolBrowser}" Shown="{Binding CardPoolBrowserOpen}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="248,148,0,0">
                    <o:CardPoolBrowser />
                </o:MovablePanel>

                <!-- ============ Constructed: the same card pool panel next to its card (hand, board, Discover options) ============ -->
                <!-- Not a MovablePanel: it follows the card, placed by PoolPlacement in CardPoolPanel.axaml.cs. -->
                <Canvas>
                    <o:CardPoolPanel x:Name="CardPoolPopup" Anchored="True" IsVisible="{Binding ShowCardPoolPopup}" />
                </Canvas>

                <!-- ============ Constructed: mulligan bars over the offered cards (card row centred, card tops at ~310 of 1080; the panel hangs from 300 up) ============ -->
                <o:MovablePanel Id="mulligan-bars" Title="{i:Loc Overlay.Panel.MulliganStrip}" GameAnchored="True" Shown="{Binding ShowMulligan}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,0,780">
                    <o:MulliganPanel />
                </o:MovablePanel>

                <!-- The mulligan summary under the cards (card bottoms at ~690), above the Confirm button -->
                <o:MovablePanel Id="mulligan-summary" Title="{i:Loc Overlay.Panel.MulliganSummary}" GameAnchored="True" Shown="{Binding ShowMulligan}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,700,0,0">
                    <o:MulliganSummary />
                </o:MovablePanel>

                <!-- ============ Battlegrounds: slim top bar + minion browser (top-left) ============ -->
                <o:MovablePanel Id="bgbar" Title="{i:Loc Overlay.Panel.BgBar}" Shown="{Binding ShowBattlegrounds}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                    <StackPanel>
                        <Border Classes="overlayCard" Padding="12,7" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Overlay.Bar.TurnTip}">
                                    <TextBlock Text="{i:Loc Overlay.Bar.Turn}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Turn}" Classes="number" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Classes="divider" />
                                <ItemsControl ItemsSource="{Binding Tiers}" ItemTemplate="{StaticResource TierTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                                <Border Classes="divider" />
                                <Panel VerticalAlignment="Center" MaxWidth="300" ToolTip.Tip="{i:Loc Overlay.Bar.TribesTip}">
                                    <ItemsControl ItemsSource="{Binding Tribes}" ItemsPanel="{StaticResource WrapRow}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="pill" Margin="0,0,4,4" Padding="7,1">
                                                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                               IsVisible="{Binding Tribes, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                </Panel>
                                <Border Classes="divider" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Overlay.Bar.RatingTip}">
                                    <TextBlock Text="{Binding Rating}" Classes="number" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RatingDelta}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding RatingDeltaValue, Converter={StaticResource SignBrush}}" />
                                </StackPanel>
                                <Border Classes="divider" IsVisible="{Binding Combats, Converter={StaticResource Truthy}}" />
                                <ItemsControl ItemsSource="{Binding Combats}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}"
                                              VerticalAlignment="Center" IsVisible="{Binding Combats, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="overlayCard" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                IsVisible="{Binding Anomaly, Converter={StaticResource Truthy}}">
                            <TextBlock FontSize="11"><Run Text="{i:Loc Overlay.Bar.Anomaly}" Foreground="{StaticResource Muted}" /><Run Text="  " /><Run Text="{Binding Anomaly, Mode=OneWay}" /></TextBlock>
                        </Border>

                        <!-- Minion browser for the selected tier -->
                        <Border Classes="overlayCard" Background="{StaticResource OverlayPanelSolid}" Margin="0,6,0,0" Padding="12,10"
                                HorizontalAlignment="Left" MaxWidth="900" o:OverlayHit.Interactive="True"
                                IsVisible="{Binding Browser, Converter={StaticResource Truthy}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="{i:Loc Overlay.Browser.Tier}" /><Run Text=" " /><Run Text="{Binding SelectedTier, Mode=OneWay}" /><Run Text=" " /><Run Text="{i:Loc Overlay.Browser.MinionsInLobby}" Foreground="{StaticResource Muted}" FontWeight="Normal" /></TextBlock>
                                    <Button Classes="icon" Content="&#xF0156;" HorizontalAlignment="Right" Command="{Binding CloseBrowser}" ToolTip.Tip="{i:Loc Overlay.Common.Close}" />
                                </Grid>
                                <ScrollViewer MaxHeight="760" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Browser}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="o:BrowserGroup">
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Title}" Classes="sectionLabel" Margin="2,0,0,2" />
                                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BrowserCardTemplate}" ItemsPanel="{StaticResource WrapRow}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: hero pick badges, one above each hero (HDT: pitch 340, +7 x) ============ -->
                <o:MovablePanel Id="hero-row" PlaceholderAlignment="Left" Title="{i:Loc Overlay.Panel.HeroPick}" MinWidth="1360" Shown="{Binding ShowHeroPick}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,212,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MetaSource}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding HeroPicks}" ItemTemplate="{StaticResource HeroPickTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                    </StackPanel>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: trinket pick badges (HDT: pitch 277, +10 x) ============ -->
                <o:MovablePanel Id="trinket-row" PlaceholderAlignment="Right" Title="{i:Loc Overlay.Panel.TrinketPick}" MinWidth="1108" Shown="{Binding ShowTrinkets}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,226,0,0">
                    <StackPanel>
                        <TextBlock Text="{i:Loc Overlay.Trinket.Source}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding TrinketPicks}" ItemTemplate="{StaticResource TrinketBadgeTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                    </StackPanel>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: buy hints over the tavern row (HDT: row top 0.297H, pitch 138) ============ -->
                <o:MovablePanel Id="tavern-row" PlaceholderAlignment="Left" Title="{i:Loc Overlay.Panel.TavernRow}" MinWidth="966" Shown="{Binding ShowShop}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,274,0,0">
                    <ItemsControl ItemsSource="{Binding ShopBadges}" ItemTemplate="{StaticResource ShopBadgeTemplate}" Width="966" Height="40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: simulated combat odds (top centre, during combat) ============ -->
                <o:MovablePanel Id="odds" Title="{i:Loc Overlay.Panel.Odds}" Shown="{Binding ShowOdds}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Border x:Name="OddsCard" Classes="overlayCard" Classes.lethal="{Binding LethalDanger}" Background="{StaticResource OverlayPanelSolid}" Padding="14,7,14,8" Width="250">
                        <Border.Styles>
                            <!-- Red edge while the fight can kill the player -->
                            <Style Selector="Border.lethal">
                                <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                            </Style>
                        </Border.Styles>
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OddsWin}" Classes="number" FontSize="17" Foreground="{StaticResource Positive}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{i:Loc Overlay.Odds.Win}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding OddsDamageWin}" ToolTip.Tip="{Binding OddsDamageWinTip}" Classes="number" FontSize="11" Foreground="{StaticResource Positive}"
                                               HorizontalAlignment="Center" IsVisible="{Binding OddsDamageWin, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OddsTie}" Classes="number" FontSize="17" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{i:Loc Overlay.Odds.Tie}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OddsLoss}" Classes="number" FontSize="17" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{i:Loc Overlay.Odds.Loss}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding OddsDamageLoss}" ToolTip.Tip="{Binding OddsDamageLossTip}" Classes="number" FontSize="11" Foreground="{StaticResource Negative}"
                                               HorizontalAlignment="Center" IsVisible="{Binding OddsDamageLoss, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </UniformGrid>
                            <Border Height="4" CornerRadius="1" ClipToBounds="True" Margin="0,6,0,5" Background="{StaticResource Surface3}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Positive}" Width="{Binding WinShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                                    <Border Background="{StaticResource Faint}" Width="{Binding TieShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                                    <Border Background="{StaticResource Negative}" Width="{Binding LossShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                                </StackPanel>
                            </Border>
                            <!-- Lethal: the share of fights that kill either hero -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip.Tip="{i:Loc Overlay.Odds.LethalTip}" IsVisible="{Binding OddsLethal, Converter={StaticResource Truthy}}">
                                    <TextBlock Text="&#xF068C;" Classes="icon" FontSize="12" Foreground="{StaticResource Negative}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OddsLethal}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding OddsKill}" ToolTip.Tip="{i:Loc Overlay.Odds.KillTip}" FontSize="11" Foreground="{StaticResource Positive}" Margin="5,0" VerticalAlignment="Center"
                                           IsVisible="{Binding OddsKill, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding OddsNote}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: Discover pick hints (Dark Gift, triple reward…) ============ -->
                <o:MovablePanel Id="choice-row" PlaceholderAlignment="Center" Title="{i:Loc Overlay.Panel.Choice}" MinWidth="1360" Shown="{Binding ShowDiscover}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,222,0,0">
                    <StackPanel>
                        <Border HorizontalAlignment="Center" CornerRadius="6" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" Padding="11,2"
                                IsVisible="{Binding DiscoverTitle, Converter={StaticResource Truthy}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0674;" Classes="icon" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DiscoverTitle}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding DiscoverBadges}" ItemTemplate="{StaticResource DiscoverBadgeTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                    </StackPanel>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: game plan (right) ============ -->
                <o:MovablePanel Id="plan" Title="{i:Loc Overlay.Plan.Title}" Shown="{Binding ShowComp}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,148,12,0">
                    <Border Classes="overlayCard" Width="252" o:OverlayHit.Interactive="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="12,9,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                            ToolTip.Tip="{Binding PlanTooltip}">
                                    <TextBlock Text="&#xF08C9;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                    <TextBlock Text="{i:Loc Overlay.Plan.Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xF02FD;" Classes="icon" FontSize="11" Foreground="{StaticResource Faint}" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Bracket}" FontSize="10.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,2,0"
                                               ToolTip.Tip="{i:Loc Overlay.Plan.BracketTip}" Background="Transparent" />
                                    <Button Classes="icon" Width="24" Height="24" Command="{Binding ToggleComp}" ToolTip.Tip="{i:Loc Overlay.Plan.ToggleTip}">
                                        <Panel>
                                            <TextBlock Text="&#xF0140;" IsVisible="{Binding CompCollapsed}" />
                                            <TextBlock Text="&#xF0143;" IsVisible="{Binding !CompCollapsed}" />
                                        </Panel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- No comp yet: how to get one ("I choose": pick one below; Automatic: lock one) -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PlanHint}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="12,6,12,8"
                                       IsVisible="{Binding PlanHint, Converter={StaticResource Truthy}}" />

                            <!-- Target comp: the one you chose or locked ("AIM FOR" is the advisor's pick, only with "Mark the best") -->
                            <StackPanel DockPanel.Dock="Top" Margin="12,6,12,8" IsVisible="{Binding Target, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding TargetLabel}" Classes="sectionLabel" Margin="0,0,0,2" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Target.Name, FallbackValue=''}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Classes="bare lock" Classes.pinned="{Binding Target.IsPinned, FallbackValue=False}"
                                            Command="{Binding Pin}" CommandParameter="{Binding Target.Id, FallbackValue=''}" Focusable="False" VerticalAlignment="Top" Margin="6,0,0,0"
                                            ToolTip.Tip="{Binding PinTooltip}">
                                        <Border Name="Bd" CornerRadius="6" Padding="7,2" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Panel>
                                                    <!-- "I choose": filled radio mark, the counterpart of the empty marks in the comp list -->
                                                    <TextBlock Text="&#xF043E;" Classes="icon" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding CompManual}" />
                                                    <Panel IsVisible="{Binding !CompManual}">
                                                        <TextBlock Text="&#xF0FC7;" Classes="icon" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                                   IsVisible="{Binding !Target.IsPinned, FallbackValue=True}" />
                                                        <TextBlock Text="&#xF033E;" Classes="icon" FontSize="12" VerticalAlignment="Center"
                                                                   IsVisible="{Binding Target.IsPinned, FallbackValue=False}" />
                                                    </Panel>
                                                </Panel>
                                                <TextBlock Text="{Binding PinText}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*" IsVisible="{Binding Target.Why, Converter={StaticResource Truthy}, FallbackValue=False}">
                                    <TextBlock Text="&#xF06E9;" Classes="icon" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,1,6,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Target.Why, FallbackValue=''}" FontSize="11.5" TextWrapping="Wrap" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Background="Transparent"
                                            ToolTip.Tip="{i:Loc Overlay.Plan.PowerTip}">
                                    <Panel Width="22" Height="22" VerticalAlignment="Center">
                                        <c:Scallop Fill="{Binding Target.Power, Converter={StaticResource KeyBrush}, FallbackValue={x:Null}}" Lobes="8" Depth="0.1" />
                                        <TextBlock Text="{Binding Target.Power, FallbackValue=''}" FontFamily="{DynamicResource DisplayFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Target.Placement, Mode=OneWay, FallbackValue=''}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /><Run Text="{i:Loc Overlay.Plan.AvgPlaceSep}" /><Run Text="{Binding Target.OwnedCore, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /><Run Text="/" /><Run Text="{Binding Target.CoreCount, Mode=OneWay, FallbackValue=0}" /><Run Text="{i:Loc Overlay.Plan.CoreSuffix}" /></TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Target.Tribes, FallbackValue=''}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{StaticResource SecondaryContainer}"
                                        IsVisible="{Binding Target.LookFor, Converter={StaticResource Truthy}, FallbackValue=False}"
                                        ToolTip.Tip="{i:Loc Overlay.Plan.LookForTip}">
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource OnSecondaryContainer}"><Run Text="{i:Loc Overlay.Plan.LookFor}" FontWeight="Bold" /><Run Text="{Binding Target.LookFor, Mode=OneWay, FallbackValue=''}" /></TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Advisor's turn budget plan -->
                            <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="10,8" CornerRadius="8"
                                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1"
                                    IsVisible="{Binding ShopPlan, Converter={StaticResource Truthy}}"
                                    ToolTip.Tip="{i:Loc Overlay.Plan.ShopPlanTip}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShopPlan.ActionLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                        </Border>
                                        <TextBlock Text="{Binding ShopPlan.Title}" FontSize="12.5" FontWeight="Bold" Margin="7,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShopPlan.Reason}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Dark Gift timing -->
                            <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="9,6" CornerRadius="6" Background="{StaticResource AccentSoft}"
                                    BorderBrush="{StaticResource AccentLine}" BorderThickness="1" IsVisible="{Binding DarkGift, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding DarkGift}" FontSize="11.5" TextWrapping="Wrap" />
                            </Border>

                            <!-- Freeze reminder -->
                            <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="9,6" CornerRadius="6" Background="{StaticResource Surface3}"
                                    IsVisible="{Binding Freeze, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding Freeze}" FontSize="11.5" TextWrapping="Wrap" />
                            </Border>

                            <!-- Pairs one copy away from a triple -->
                            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" IsVisible="{Binding Pairs, Converter={StaticResource Truthy}}">
                                <c:Ornament Text="{i:Loc Overlay.Plan.Pairs}" Size="10.5" Margin="0,0,0,5" />
                                <ItemsControl ItemsSource="{Binding Pairs}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" />
                            </StackPanel>

                            <!-- Owned trinkets -->
                            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" IsVisible="{Binding OwnedTrinkets, Converter={StaticResource Truthy}}">
                                <c:Ornament Text="{i:Loc Overlay.Plan.Trinkets}" Size="10.5" Margin="0,0,0,5" />
                                <ItemsControl ItemsSource="{Binding OwnedTrinkets}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MetaSource}" FontSize="9.5" Foreground="{StaticResource Faint}" Margin="12,0,12,8" TextWrapping="Wrap" />

                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="12,0,12,8">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Overlay.Plan.CompCards}" Size="10.5" Margin="0,0,0,6" IsVisible="{Binding TargetCards, Converter={StaticResource Truthy}}"
                                                ToolTip.Tip="{i:Loc Overlay.Plan.CompCardsTip}" />
                                    <ItemsControl ItemsSource="{Binding TargetCards}" ItemTemplate="{StaticResource CompCardTemplate}" Margin="0,0,0,6" />

                                    <StackPanel IsVisible="{Binding !CompCollapsed}">
                                        <c:Ornament Text="{i:Loc Overlay.Plan.YourBoard}" Size="10.5" Margin="0,4,0,6" IsVisible="{Binding BoardTribes, Converter={StaticResource Truthy}}" />
                                        <ItemsControl ItemsSource="{Binding BoardTribes}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" Margin="0,0,0,6" />

                                        <c:Ornament Text="{i:Loc Overlay.Plan.WhenToCommit}" Size="10.5" Margin="0,4,0,6" IsVisible="{Binding CommitHint, Converter={StaticResource Truthy}}" />
                                        <TextBlock Text="{Binding CommitHint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding CommitHint, Converter={StaticResource Truthy}}" />

                                        <c:Ornament Text="{i:Loc Overlay.Plan.HowToPlay}" Size="10.5" Margin="0,4,0,6" IsVisible="{Binding CompTip, Converter={StaticResource Truthy}}" />
                                        <TextBlock Text="{Binding CompTip}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   MaxHeight="120" TextTrimming="WordEllipsis" IsVisible="{Binding CompTip, Converter={StaticResource Truthy}}" />
                                    </StackPanel>

                                    <!-- Comps to choose from: shown even while collapsed when there is no target, so there is always something to click -->
                                    <StackPanel IsVisible="{Binding ShowCompList}">
                                        <c:Ornament Text="{Binding CompListTitle}" Size="10.5" Margin="0,4,0,6" />
                                        <ItemsControl ItemsSource="{Binding Alternatives}" ItemTemplate="{StaticResource AlternativeTemplate}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: leaderboard hover ============ -->
                <Canvas Name="LobbyLayer" IsHitTestVisible="False">
                    <Border Classes="overlayCard" Background="{StaticResource OverlayPanelSolid}" Padding="12,10"
                            Canvas.Left="{Binding LobbyLeft}" Canvas.Top="{Binding LobbyTop}"
                            IsVisible="{Binding Lobby, Converter={StaticResource Truthy}}">
                        <StackPanel DataContext="{Binding Lobby}" x:DataType="o:LobbyPopup">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeroName}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"><Run Text="#" /><Run Text="{Binding Place, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" ·  " /><Run Text="{Binding Health, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text="{i:Loc Overlay.LobbyPopup.Hp}" /><Run Text="{i:Loc Overlay.LobbyPopup.Tier}" /><Run Text="{Binding Tier, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text="{i:Loc Overlay.LobbyPopup.Triples}" /><Run Text="{Binding Triples, Mode=OneWay}" Foreground="{StaticResource Text}" /></TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="5" Padding="8,1" VerticalAlignment="Top"
                                        IsVisible="{Binding NextOpponent}">
                                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.Next}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                </Border>
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,6"><Run Text="{Binding LastSeen, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding LastResult, Mode=OneWay}" Foreground="{StaticResource Text}" /></TextBlock>
                            <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource LobbyMinionTemplate}" ItemsPanel="{StaticResource HRow}" />
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- ============ Leaderboard calibration guides ============ -->
                <Canvas Name="GuideLayer" IsHitTestVisible="False" />

                <!-- ============ Arena draft: a score badge over each offered card or hero (centred on the play area left of the client's
                     deck list: right margin 339 shifts the centre 170 left; anchors from HdtArenaHelper, MIT) ============ -->
                <o:MovablePanel Id="arena-picks" Title="{i:Loc Arena.Panel.Picks}" Hint="{i:Loc Overlay.Layout.AppearsInArenaDraft}" GameAnchored="True" Shown="{Binding ShowArenaPicks}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,566,339,0">
                    <o:ArenaPicksPanel />
                </o:MovablePanel>

                <!-- ============ Arena draft: deck so far, curve, average score, class win rates (left) ============ -->
                <o:MovablePanel Id="arena-draft" Title="{i:Loc Arena.Panel.Title}" Hint="{i:Loc Overlay.Layout.AppearsInArenaDraft}" Shown="{Binding ShowArenaDraft}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,148,0,0">
                    <o:ArenaDraftPanel />
                </o:MovablePanel>

                <!-- ============ Battlegrounds: session (top-right) ============ -->
                <o:MovablePanel Id="session" Title="{i:Loc Overlay.Session.Title}" Shown="{Binding ShowSession}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                    <Border Classes="overlayCard" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Overlay.Session.Title}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SessionRating}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RatingDelta}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding RatingDeltaValue, Converter={StaticResource SignBrush}}" />
                            <ItemsControl ItemsSource="{Binding SessionPlaces}" Margin="10,0,0,0" VerticalAlignment="Center" ItemsPanel="{StaticResource HRow}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="o:PlaceChip">
                                        <Border Classes="placeChip" Classes.top="{Binding Top}" Width="19" Height="19" CornerRadius="5" Margin="0,0,3,0">
                                            <TextBlock Text="{Binding Place}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Battlegrounds: lobby list (bottom-right) ============ -->
                <o:MovablePanel Id="lobby" Title="{i:Loc Overlay.Lobby.Title}" Shown="{Binding ShowLobby}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,14">
                    <Border Classes="overlayCard" Width="230" Padding="12,9,12,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{i:Loc Overlay.Lobby.Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{i:Loc Overlay.Lobby.Header}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LobbyRows}" ItemTemplate="{StaticResource LobbyRowTemplate}" />
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Layout mode banner (centre band, clear of the default spots of the top-row panels) ============ -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,400,0,0" Classes="overlayCard"
                        Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource Accent}" Padding="16,10" o:OverlayHit.Interactive="True"
                        IsVisible="{Binding LayoutEditing}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{i:Loc Overlay.Layout.Title}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{i:Loc Overlay.Layout.Hint}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Button Classes="ghost" Content="{i:Loc Overlay.Layout.ResetAll}" Margin="18,0,8,0" Command="{Binding ResetLayout}" Focusable="False" />
                        <!-- The global shortcuts are registered on Windows only (WindowsOverlayPlatform) -->
                        <Button Classes="ghost primary" Content="{i:Loc Overlay.Layout.Done}" Command="{Binding FinishLayout}" Focusable="False"
                                ToolTip.Tip="{i:Loc Overlay.Layout.Shortcuts}" ToolTip.ServiceEnabled="{x:Static o:OverlayView.GlobalShortcuts}" />
                    </StackPanel>
                </Border>

                <!-- ============ End of game toast ============ -->
                <o:MovablePanel Id="toast" Title="{i:Loc Overlay.Panel.Toast}" Shown="{Binding ShowToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120">
                    <Border Classes="overlayCard" Background="{StaticResource OverlayPanelSolid}" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" CornerRadius="7,0,0,7" Background="{Binding ToastResult, Converter={StaticResource KeyBrush}}" />
                            <StackPanel Margin="16,11,22,12">
                                <TextBlock Text="{Binding ToastTitle}" Classes="number" FontSize="22" />
                                <TextBlock Text="{Binding ToastDetail}" FontSize="12.5" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </o:MovablePanel>

                <!-- ============ Card preview on hover (top layer, never takes the pointer) ============ -->
                <c:CardPreviewHost Name="PreviewHost" />
            </Grid>
        </LayoutTransformControl>
    </Panel>
</UserControl>
