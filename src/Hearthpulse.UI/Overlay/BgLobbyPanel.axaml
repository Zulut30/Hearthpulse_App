<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.BgLobbyPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The compact lobby panel ("bg-lobby", DataContext: the overlay view model): the lobby's minion types, then one
         line per player - place, portrait, hero, tavern tier and the main type of the board last seen with its count. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Grid.bgLobbyRow.you TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Grid.bgLobbyRow.dead">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>
    <Border Classes="overlayCard" Width="214" Padding="10,8,10,7">
        <StackPanel>
            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Right" Text="{i:Loc Overlay.BgLobby.Unconfirmed}" FontSize="9.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                           IsVisible="{Binding LobbyTribesUnconfirmed}" />
                <TextBlock Text="{i:Loc Overlay.BgLobby.Tribes}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding LobbyTribes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:TribeIcon">
                        <Border Height="20" CornerRadius="10" Padding="5,0,7,0" Margin="0,0,3,3" Background="{StaticResource Surface3}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Classes="icon" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="10.5" Foreground="{StaticResource Faint}"
                       IsVisible="{Binding LobbyTribes, Converter={StaticResource Truthy}, ConverterParameter=!}" />
            <ItemsControl ItemsSource="{Binding LobbyRows}" Margin="0,4,0,0" IsVisible="{Binding LobbyRows, Converter={StaticResource Truthy}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:LobbyRow">
                        <Grid Classes="bgLobbyRow" Classes.you="{Binding You}" Classes.dead="{Binding Dead}" Height="22" ColumnDefinitions="14,22,*,22,34">
                            <TextBlock Text="{Binding Place}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                    i:CardArt.Portrait="{Binding HeroCardId}" />
                            <TextBlock Name="HeroName" Grid.Column="2" Text="{Binding Name}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Border Grid.Column="3" Width="18" Height="16" CornerRadius="4" Background="{StaticResource Surface3}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Tier}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Empty until a board was seen: an opponent's only after a fight with them -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding Tribe, Converter={StaticResource Truthy}}">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Surface3}">
                                    <TextBlock Text="{Binding Tribe.Glyph}" Classes="icon" FontSize="10" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding TribeCount}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
