<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.BgLobbyPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The compact lobby panel ("bg-lobby", DataContext: the overlay view model): the lobby's tribes, then one line per
         player - place, portrait, hero, tavern tier and the main tribe of the board last seen in words ("Murlocs: 3"). -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Grid.bgLobbyRow.you TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Grid.bgLobbyRow.dead">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>
    <Border Classes="overlayCard" Width="280">
        <StackPanel>
            <!-- The header every list panel has: glyph and title, "not confirmed" on the right while the tribes are a guess -->
            <Border Classes="overlayHeader">
                <DockPanel>
                    <TextBlock Text="&#xF0849;" Classes="icon headerIcon" />
                    <TextBlock DockPanel.Dock="Right" Text="{i:Loc Overlay.BgLobby.Unconfirmed}" Classes="headerNote" Margin="8,0,0,0" VerticalAlignment="Center"
                               IsVisible="{Binding LobbyTribesUnconfirmed}" />
                    <TextBlock Text="{i:Loc Overlay.BgLobby.Title}" Classes="headerTitle" />
                </DockPanel>
            </Border>
            <StackPanel Margin="12,7,12,7">
                <TextBlock Text="{i:Loc Overlay.BgLobby.Tribes}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,5" />
                <ItemsControl ItemsSource="{Binding LobbyTribes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:TribeIcon">
                            <Border Height="20" CornerRadius="10" Padding="7,0" Margin="0,0,3,3" Background="{StaticResource Surface3}">
                                <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="10.5" Foreground="{StaticResource Muted}"
                           IsVisible="{Binding LobbyTribes, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                <ItemsControl ItemsSource="{Binding LobbyRows}" Margin="0,4,0,0" IsVisible="{Binding LobbyRows, Converter={StaticResource Truthy}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="o:LobbyRow">
                            <!-- Column 3 is kept empty for the opponents' rating (up to 6 characters): it takes its width from that
                                 text, and the name column gives way -->
                            <Grid Classes="bgLobbyRow" Classes.you="{Binding You}" Classes.dead="{Binding Dead}" Height="22" ColumnDefinitions="14,22,*,Auto,20,Auto">
                                <TextBlock Text="{Binding Place}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                        i:CardArt.Portrait="{Binding HeroCardId}" />
                                <TextBlock Name="HeroName" Grid.Column="2" Text="{Binding Name}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Border Grid.Column="4" Width="18" Height="16" CornerRadius="4" Background="{StaticResource Surface3}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Tier}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- The main tribe in words ("Murlocs: 3"), empty until a board was seen: an opponent's only after a fight with them -->
                                <TextBlock Grid.Column="5" Text="{Binding TribeText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="6,0,0,0" IsVisible="{Binding Tribe, Converter={StaticResource Truthy}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
