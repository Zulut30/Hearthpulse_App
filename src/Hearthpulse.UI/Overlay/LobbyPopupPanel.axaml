<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.LobbyPopupPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The opponent under the mouse on the leaderboard ("lobby-popup", top centre, DataContext: the overlay view model):
         portrait, hero, place and health, the player's last fight with them, the board last seen as round portraits with
         attack, health and tavern tier. No card text, no tribe glyphs. Same tree as LobbyPopupPanel.xaml. Tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Overlay/OverlayPanels.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A minion of the last seen board: portrait 64, attack and health on its lower edge, the tier shield top left -->
            <DataTemplate x:Key="PopupMinionTemplate" x:DataType="o:LobbyMinion">
                <Panel Width="64" Height="72" Margin="0,0,4,0">
                    <Border Classes="popupRing" Classes.golden="{Binding Golden}" Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top"
                            Background="{StaticResource Surface4}" Padding="1.5">
                        <Border CornerRadius="31" ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                    </Border>
                    <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="17" IsVisible="{Binding HasTier}">
                        <Path Data="M0.5,0.5 H19.5 V11 C19.5,17 15.5,21.5 10,23.5 C4.5,21.5 0.5,17 0.5,11 Z" Stretch="Fill"
                              Fill="{DynamicResource OverlayBadgeShade}" Stroke="{StaticResource AccentDeep}" StrokeThickness="1" />
                        <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                    </Panel>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" MinWidth="20" Height="18" CornerRadius="9" Padding="3,0"
                            Background="{DynamicResource OverlayBadgeShade}" BorderBrush="{StaticResource TierS}" BorderThickness="1">
                        <TextBlock Text="{Binding Attack}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource TierS}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="20" Height="18" CornerRadius="9" Padding="3,0"
                            Background="{DynamicResource OverlayBadgeShade}" BorderBrush="{StaticResource Negative}" BorderThickness="1">
                        <TextBlock Text="{Binding Health}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Negative}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.popupRing">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.popupRing.golden">
            <Setter Property="BorderBrush" Value="{StaticResource TierS}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <!-- Out: the portrait fades, the name turns muted (a faded text would drop below AA) -->
        <Style Selector="Border#Hero.dead">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="TextBlock#HeroName.dead">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayCard solid" Width="502" Padding="12,12,12,8">
        <StackPanel DataContext="{Binding Lobby}" x:DataType="o:LobbyPopup">
            <!-- Header: portrait, hero (two lines at most), place and health; "Next opponent" or "Out" on the right -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Name="Hero" Classes.dead="{Binding Dead}" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Surface3}" ClipToBounds="True"
                        i:CardArt.Portrait="{Binding HeroCardId}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock Name="HeroName" Classes.dead="{Binding Dead}" Text="{Binding HeroName}" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="4" Padding="8,2" VerticalAlignment="Top" IsVisible="{Binding NextOpponent}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.Next}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </Border>
                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding Dead}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.Out}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                </Border>
            </Grid>

            <!-- The player's last fight with them, from the player's side, and every fight as dots once there are two -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding HasFight}">
                <TextBlock Text="{i:Loc Overlay.LobbyPopup.LastFight}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastResult}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" IsVisible="{Binding History, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.AllFights}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- How long ago the board was seen, and its main tribe in words -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsVisible="{Binding LastSeen, Converter={StaticResource Truthy}}">
                <TextBlock Text="{Binding LastSeen}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" />
                <TextBlock Text=" · " FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" IsVisible="{Binding Tribe, Converter={StaticResource Truthy}}" />
                <TextBlock Text="{Binding Tribe}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Text}" IsVisible="{Binding Tribe, Converter={StaticResource Truthy}}" />
            </StackPanel>

            <!-- The board last seen, or why there is none -->
            <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource PopupMinionTemplate}" ItemsPanel="{StaticResource HRow}" Margin="0,8,0,0"
                          HorizontalAlignment="Left" IsVisible="{Binding Board, Converter={StaticResource Truthy}}" />
            <TextBlock Text="{Binding BoardNote}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" MinHeight="24"
                       IsVisible="{Binding BoardNote, Converter={StaticResource Truthy}}" />
        </StackPanel>
    </Border>
</UserControl>
