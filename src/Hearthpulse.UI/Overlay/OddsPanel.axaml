<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.OddsPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Simulated combat odds (MovablePanel "odds" and the OBS window "Hearthpulse — Combat odds", docs/streaming.md): one row
         of up to five cells - you kill, win, tie, loss, you die (a lethal cell at 0 is gone) - with the damage range under win
         and loss, the share bar, and a bottom line only for unsimulated effects or the damage cap; a red edge while the
         fight can kill the player. Width follows the content (360..460). DataContext: OverlayViewModel (inherited). Tokens only.
         Same tree as the WPF OddsPanel.xaml. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:FractionWidth x:Key="Fraction" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="StackPanel.cell">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.pct">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeIcon}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cellLabel">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cellDamage">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.cellDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
        </Style>
        <!-- Red edge while the fight can kill the player -->
        <Style Selector="Border.lethal">
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="OddsCard" Classes="overlayCard solid" Classes.lethal="{Binding LethalDanger}" Padding="12,8" MinWidth="360" MaxWidth="460" HorizontalAlignment="Left">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Classes="cell" ToolTip.Tip="{i:Loc Overlay.Odds.KillTip}" IsVisible="{Binding OddsKill, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{Binding OddsKill}" Classes="pct" Foreground="{StaticResource Positive}" />
                    <TextBlock Text="{i:Loc Overlay.Odds.KillLabel}" Classes="cellLabel" />
                </StackPanel>
                <Border Classes="cellDivider" IsVisible="{Binding OddsKill, Converter={StaticResource Truthy}}" />
                <StackPanel Classes="cell">
                    <TextBlock Text="{Binding OddsWin}" Classes="pct" Foreground="{StaticResource Positive}" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Win}" Classes="cellLabel" />
                    <TextBlock Text="{Binding OddsDamageWin}" ToolTip.Tip="{Binding OddsDamageWinTip}" Classes="cellDamage" Foreground="{StaticResource Positive}" />
                </StackPanel>
                <StackPanel Classes="cell">
                    <TextBlock Text="{Binding OddsTie}" Classes="pct" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Tie}" Classes="cellLabel" />
                </StackPanel>
                <StackPanel Classes="cell">
                    <TextBlock Text="{Binding OddsLoss}" Classes="pct" Foreground="{StaticResource Negative}" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Loss}" Classes="cellLabel" />
                    <TextBlock Text="{Binding OddsDamageLoss}" ToolTip.Tip="{Binding OddsDamageLossTip}" Classes="cellDamage" Foreground="{StaticResource Negative}" />
                </StackPanel>
                <Border Classes="cellDivider" IsVisible="{Binding OddsLethal, Converter={StaticResource Truthy}}" />
                <StackPanel Classes="cell" ToolTip.Tip="{i:Loc Overlay.Odds.LethalTip}" IsVisible="{Binding OddsLethal, Converter={StaticResource Truthy}}">
                    <TextBlock Text="{Binding OddsLethal}" Classes="pct" Foreground="{StaticResource Negative}" />
                    <TextBlock Text="{i:Loc Overlay.Odds.LethalLabel}" Classes="cellLabel" />
                </StackPanel>
            </StackPanel>
            <!-- The share bar: a 220-wide row stretched to the card's width (the card is 360..460 wide) -->
            <Border Height="4" CornerRadius="1" ClipToBounds="True" Margin="0,8,0,4" Background="{StaticResource Surface3}">
                <Viewbox Stretch="Fill">
                    <StackPanel Orientation="Horizontal" Width="220" Height="4">
                        <Border Background="{StaticResource Positive}" Width="{Binding WinShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                        <Border Background="{StaticResource Faint}" Width="{Binding TieShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                        <Border Background="{StaticResource Negative}" Width="{Binding LossShare, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                    </StackPanel>
                </Viewbox>
            </Border>
            <!-- Only when there is something to say: unsimulated effects, the hero damage cap -->
            <TextBlock Text="{Binding OddsNote}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding OddsNote, Converter={StaticResource Truthy}}" />
        </StackPanel>
    </Border>
</UserControl>
