<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.MulliganPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Mulligan strip: a slim badge under each offered card (Keep / Replace, one number, small flags; click = keep or
         replace), lined up with the cards of the mulligan screen, and one summary line. Details are in the tooltips.
         DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource OverlayPanelSolid}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="9,4,11,4" />
            <Setter Property="MinWidth" Value="124" />
        </Style>
        <Style Selector="Border.badge.keep">
            <Setter Property="BorderBrush" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.badge.toss">
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
        </Style>
        <!-- The player replaces it (a click on the badge): dimmed until they keep it again -->
        <Style Selector="Border.badge.replaced">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.badgeButton:pointerover Border.badge">
            <Setter Property="Background" Value="{StaticResource Hover}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.call">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.call.keep">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="TextBlock.call.toss">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="TextBlock.flag">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Info}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style Selector="TextBlock.summary.good">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="TextBlock.summary.bad">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
    </UserControl.Styles>

    <!-- One slot per offered card across the width of the mulligan card row, so each badge sits under its card -->
    <StackPanel Width="{Binding MulliganRowWidth}">
        <ItemsControl ItemsSource="{Binding MulliganCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="o:MulliganPlate">
                    <Button Classes="bare badgeButton" HorizontalAlignment="Center" Focusable="False" Cursor="Hand" ToolTip.Tip="{Binding Tooltip}" o:OverlayHit.Interactive="True"
                            Command="{Binding $parent[o:MulliganPanel].((o:OverlayViewModel)DataContext).ToggleMulliganCard}" CommandParameter="{Binding EntityId}">
                        <Border Classes="badge" Classes.keep="{Binding KeepCall}" Classes.toss="{Binding MulliganCall}" Classes.replaced="{Binding !Kept}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Panel VerticalAlignment="Center">
                                    <TextBlock Text="&#xF05E0;" Classes="icon" FontSize="15" Foreground="{StaticResource Positive}" IsVisible="{Binding KeepCall}" />
                                    <TextBlock Text="&#xF006A;" Classes="icon" FontSize="15" Foreground="{StaticResource Negative}" IsVisible="{Binding MulliganCall}" />
                                    <TextBlock Text="&#xF0625;" Classes="icon" FontSize="15" Foreground="{StaticResource Muted}" IsVisible="{Binding NoCall}" />
                                </Panel>
                                <TextBlock Text="{Binding Call}" Classes="call" Classes.keep="{Binding KeepCall}" Classes.toss="{Binding MulliganCall}" Margin="5,0,0,0" />
                                <TextBlock Text="{Binding Number}" Classes="number" FontSize="14" VerticalAlignment="Center" Margin="9,0,0,0"
                                           Classes.good="{Binding Good}" Classes.bad="{Binding Bad}" IsVisible="{Binding Number, Converter={StaticResource Truthy}}" />
                                <TextBlock Text="&#xF0339;" Classes="icon flag" IsVisible="{Binding Synergy}" />
                                <TextBlock Text="×2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           IsVisible="{Binding Duplicate}" />
                                <TextBlock Text="&#xF0150;" Classes="icon flag" IsVisible="{Binding Late}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="12"
                HorizontalAlignment="Center" Padding="12,3,12,4" Margin="0,8,0,0" ToolTip.Tip="{Binding MulliganDetails}" o:OverlayHit.Interactive="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MulliganSummary}" Classes="summary" Classes.good="{Binding MulliganImpactGood}" Classes.bad="{Binding MulliganImpactBad}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="&#xF02FD;" Classes="icon flag" IsVisible="{Binding MulliganHasWarnings}" />
                <TextBlock Text="{Binding MulliganSource}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsVisible="{Binding MulliganSource, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
