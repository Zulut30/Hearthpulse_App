<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.SecretsPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Secrets helper: the opponent's active Secrets (one line each) and every Secret of their pool. Possible ones on top,
         then the ones crossed out by hand, then the ones the game ruled out (struck through, dimmed). A click on a row
         crosses it out or brings it back; only the rows take clicks. DataContext: OverlayViewModel. Tokens only. -->
    <UserControl.Styles>
        <Style Selector="Border.secretTile">
            <Setter Property="Background" Value="{StaticResource Row}" />
        </Style>
        <Style Selector="Button.secretButton:pointerover Border.secretTile">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="TextBlock.secretName.closed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Image.secretArt.closed">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Grid.secretRow.ruledOut">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayCard" Width="220">
        <StackPanel Margin="10,8,10,8">
            <DockPanel>
                <TextBlock Text="&#xF02D7;" Classes="icon" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding SecretsTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding SecretsPool}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            <ItemsControl ItemsSource="{Binding SecretSlots}" Margin="0,4,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:SecretSlotLine">
                        <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SecretTiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="o:SecretTile">
                        <Button Classes="bare secretButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Focusable="False" Cursor="Hand"
                                o:OverlayHit.Interactive="True" Margin="0,0,0,2"
                                Command="{Binding $parent[o:SecretsPanel].((o:OverlayViewModel)DataContext).ToggleSecret}" CommandParameter="{Binding Key}">
                            <Grid Classes="secretRow" Classes.ruledOut="{Binding RuledOut}" Height="22" ColumnDefinitions="25,*">
                                <Border Width="21" Height="21" CornerRadius="5" Background="{StaticResource ManaGem}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Cost}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Classes="secretTile" CornerRadius="5" ClipToBounds="True">
                                    <Panel>
                                        <Image Classes="secretArt" Classes.closed="{Binding !Open}" i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                        <Rectangle Fill="{StaticResource TileFade}" />
                                        <DockPanel Margin="8,0,6,0">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xF05E0;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}"
                                                       VerticalAlignment="Center" IsVisible="{Binding Known}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Classes="secretName" Classes.closed="{Binding !Open}" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Panel>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{i:Loc Overlay.Secrets.Hint}" FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
