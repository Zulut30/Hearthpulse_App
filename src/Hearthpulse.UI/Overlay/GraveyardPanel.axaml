<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:c="using:Hearthpulse.UI.Controls"
             x:Class="Hearthpulse.UI.Overlay.GraveyardPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The Graveyard panel (MovablePanel "graveyard", docs/graveyard.md): the minions that died this game, the opponent's
         above yours as on the board, as tracker rows; the full card on hover. Row sizes and compact come from the
         overlay's cardRow / cost / tileArt styles. DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- A dead minion: cost gem, name over the art with its rarity strip, "×2" for repeats -->
        <DataTemplate x:Key="DeadRow" x:DataType="o:PoolListRow">
            <Grid Classes="cardRow short" Margin="0,0,0,2" Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.CardId="{Binding CardId}">
                <Border Classes="capsule">
                    <Panel>
                        <Image Classes="tileArt" i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Classes="tileFade" Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="1,0,3,0">
                            <c:ManaCost Classes="cost short" Text="{Binding Cost}" DockPanel.Dock="Left" Margin="0,0,4,0" />
                            <Border Classes="countBadge" DockPanel.Dock="Right" Height="16" IsVisible="{Binding CountText, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Panel>
                </Border>
                <Border Classes="rarityEdge" BorderBrush="{Binding Rarity, Converter={StaticResource KeyBrush}, ConverterParameter=edge}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.sideNote">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayCard" Width="214">
        <StackPanel>
            <Border Classes="overlayHeader">
                <DockPanel>
                    <TextBlock Text="&#xF068C;" Classes="icon headerIcon" />
                    <TextBlock Text="{i:Loc Related.Graveyard.Title}" Classes="headerTitle" />
                </DockPanel>
            </Border>
            <StackPanel Margin="12,0,12,10">
                <ContentControl Classes="overlaySection" Content="{Binding GraveyardOpponentTitle}" Margin="0,10,0,6" />
                <ItemsControl ItemsSource="{Binding GraveyardOpponent}" ItemTemplate="{StaticResource DeadRow}" />
                <TextBlock Text="{Binding GraveyardOpponentMore}" Classes="sideNote" IsVisible="{Binding GraveyardOpponentMore, Converter={StaticResource Truthy}}" />

                <ContentControl Classes="overlaySection" Content="{Binding GraveyardLocalTitle}" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding GraveyardLocal}" ItemTemplate="{StaticResource DeadRow}" />
                <TextBlock Text="{Binding GraveyardLocalMore}" Classes="sideNote" IsVisible="{Binding GraveyardLocalMore, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
