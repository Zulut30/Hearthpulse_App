<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.LobbyPanel"
             x:DataType="o:OverlayViewModel">
    <!-- The Battlegrounds lobby list (MovablePanel "lobby" and the OBS window "Hearthpulse — Lobby", docs/streaming.md): every
         player by place under column headings - place, hero, tavern tier, health and the player's own last fight with them
         in words. "You" and "Next" plates say which row is which. DataContext: OverlayViewModel (inherited). Tokens only. -->
    <UserControl.Resources>
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- Place | portrait | hero (wraps) | tavern | health | your fight: the same columns as the headings -->
        <DataTemplate x:Key="LobbyRowTemplate" x:DataType="o:LobbyRow">
            <Grid Classes="lobbyRow" Classes.next="{Binding Next}" Classes.dead="{Binding Dead}" Classes.low="{Binding LowHealth}"
                  MinHeight="28" Margin="0,0,0,2" ColumnDefinitions="20,32,*,44,40,92">
                <Border Name="Bg" Grid.ColumnSpan="6" CornerRadius="6" Margin="-5,0" />
                <TextBlock Text="{Binding Place}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Border Name="Portrait" Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                        ClipToBounds="True" i:CardArt.Portrait="{Binding HeroCardId}" />
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,8,2">
                    <TextBlock Name="HeroName" Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxWidth="150" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Classes="pill" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding You}">
                        <TextBlock Text="{i:Loc Overlay.Lobby.You}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    </Border>
                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding Next}">
                        <TextBlock Text="{i:Loc Overlay.Lobby.Next}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </Border>
                </WrapPanel>
                <TextBlock Name="Tier" Grid.Column="3" Text="{Binding Tier}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Name="Health" Grid.Column="4" Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Name="Out" Grid.Column="4" Text="{i:Loc Overlay.Lobby.Out}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Last}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding LastKey, Converter={StaticResource KeyBrush}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.lobbyRow.next Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.lobbyRow TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Grid.lobbyRow TextBlock#Tier">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Grid.lobbyRow TextBlock#Health">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="Grid.lobbyRow.low TextBlock#Health">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Grid.lobbyRow TextBlock#Out">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Out: the portrait fades, the texts turn muted (a faded text would drop below AA), "Out" in place of the health -->
        <Style Selector="Grid.lobbyRow.dead Border#Portrait">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.lobbyRow.dead TextBlock#HeroName">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Grid.lobbyRow.dead TextBlock#Tier">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Grid.lobbyRow.dead TextBlock#Health">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.lobbyRow.dead TextBlock#Out">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayCard" Width="410">
        <StackPanel>
            <Border Classes="overlayHeader">
                <DockPanel>
                    <TextBlock Text="&#xF126F;" Classes="icon headerIcon" />
                    <TextBlock Text="{i:Loc Overlay.Lobby.Title}" Classes="headerTitle" />
                </DockPanel>
            </Border>
            <!-- Column headings, on the rows' columns -->
            <Grid Margin="12,6,12,2" ColumnDefinitions="52,*,44,40,92">
                <TextBlock Text="{i:Loc Overlay.Lobby.ColPlace}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="{i:Loc Overlay.Lobby.ColHero}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="{i:Loc Overlay.Lobby.ColTier}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{i:Loc Overlay.Lobby.ColHealth}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{i:Loc Overlay.Lobby.ColFight}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding LobbyRows}" ItemTemplate="{StaticResource LobbyRowTemplate}" Margin="12,2,12,8" />
        </StackPanel>
    </Border>
</UserControl>
