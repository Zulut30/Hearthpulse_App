<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.BattlegroundsBarPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Content of the "bgbar" overlay panel. Line 1: turn, the tavern tiers that open the minion browser, the combat
         history; line 2: the lobby's tribes as text. The tribe filter lives in the browser's head. Rating is in the
         "session" panel. Same tree as the WPF BattlegroundsBarPanel.xaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Overlay/OverlayPanels.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.tribesLine">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style Selector="TextBlock.tribesLine.reading">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <Border Classes="overlayCard" Padding="12,4" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Height="24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Overlay.Bar.TurnTip}">
                        <TextBlock Text="{i:Loc Overlay.Bar.Turn}" Classes="headerNote" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Turn}" Classes="number" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Classes="divider" />
                    <TextBlock Text="{i:Loc Overlay.Bar.Tavern}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Tiers}" ItemTemplate="{StaticResource TierTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                    <Border Classes="divider" IsVisible="{Binding Combats, Converter={StaticResource Truthy}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding Combats, Converter={StaticResource Truthy}}">
                        <TextBlock Text="{i:Loc Overlay.Bar.Fights}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding Combats}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <!-- The lobby's tribes: text, not buttons (the filter is in the tier list) -->
                <DockPanel Margin="0,4,0,0" MaxWidth="596" HorizontalAlignment="Left" Background="Transparent" ToolTip.Tip="{i:Loc Overlay.Bar.TribesTip}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TribesLabel}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding TribesNames}" Classes="tribesLine" Classes.reading="{Binding TribeChips, Converter={StaticResource Truthy}, ConverterParameter=!}"
                               FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Classes="overlayCard" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                IsVisible="{Binding Anomaly, Converter={StaticResource Truthy}}">
            <TextBlock FontSize="11"><Run Text="{i:Loc Overlay.Bar.Anomaly}" Foreground="{StaticResource Muted}" /><Run Text="  " /><Run Text="{Binding Anomaly, Mode=OneWay}" /></TextBlock>
        </Border>

        <!-- Minion browser for the selected tier -->
        <Border Classes="overlayCard solid" Margin="0,6,0,0" Padding="10,7,10,8"
                HorizontalAlignment="Left" MaxWidth="880" o:OverlayHit.Interactive="True"
                IsVisible="{Binding Browser, Converter={StaticResource Truthy}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Classes="icon" Content="&#xF0143;" Width="24" Height="24" Command="{Binding CloseBrowser}"
                            ToolTip.Tip="{i:Loc Overlay.Browser.Collapse}" AutomationProperties.Name="{i:Loc Overlay.Browser.Collapse}" Focusable="False" />
                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding BrowserTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" /><Run Text="  ·  " FontSize="11" Foreground="{StaticResource Faint}" /><Run Text="{Binding BrowserScope, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Muted}" /></TextBlock>
                </DockPanel>
                <!-- Tribe filter: one tribe at a time, the chosen one filled; the same chip again shows every tribe -->
                <Panel DockPanel.Dock="Top" Margin="0,4,0,8">
                    <ItemsControl ItemsSource="{Binding TribeChips}" ItemsPanel="{StaticResource WrapRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="o:TribeChip">
                                <Button Classes="bare tribeChip" Classes.selected="{Binding Selected}" Margin="0,0,4,4" Focusable="False" Cursor="Hand"
                                        Command="{Binding $parent[UserControl].((o:OverlayViewModel)DataContext).SelectTribe}" CommandParameter="{Binding Key}"
                                        ToolTip.Tip="{i:Loc Overlay.Bar.TribeFilterTip}" AutomationProperties.Name="{Binding Name}">
                                    <Border Name="Chip" Height="22" CornerRadius="11" Padding="8,0" BorderThickness="1">
                                        <TextBlock Name="Name" Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               IsVisible="{Binding TribeChips, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </Panel>
                <ScrollViewer MaxHeight="760" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Browser}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="o:BrowserGroup">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Title}" Classes="sectionLabel" Margin="1,0,0,1" />
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BrowserCardTemplate}" ItemsPanel="{StaticResource WrapRow}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
