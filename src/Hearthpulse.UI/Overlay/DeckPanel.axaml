<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.DeckPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Your deck (MovablePanel "deck" and the OBS window "Hearthpulse — Deck", docs/streaming.md): the deck name and its
         record, a row per card, the counts and the likeliest next draw. Row sizes, compact and the empty row come from
         OverlayLook (included by the overlay view and the OBS window's StreamView); compact needs a compact MovablePanel, so
         the OBS window's rows stay full. DataContext: OverlayViewModel (inherited). Tokens only. -->
    <UserControl.Resources>
        <i:Truthy x:Key="Truthy" />
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- Deck row (V3 "gold frame"): a capsule with the cost gem at its left end, the name over card art, the copy count
             (or the legendary star) on a dark pill, and a rarity-lit edge; the draw chance in its own column so it never runs
             into the name. A card with no copies left dims (art, gem, edge and name sink back, the capsule stays so the row
             keeps its place); the row whose count just moved flashes once (OverlayLook: rowFlash). -->
        <DataTemplate x:Key="DeckTileTemplate" x:DataType="o:DeckTile">
            <Grid Classes="tileRow cardRow" Classes.empty="{Binding Empty}" Classes.changed="{Binding Changed}" Classes.legendary="{Binding Legendary}"
                  Margin="0,0,0,2" ColumnDefinitions="*,Auto" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                <Border Classes="capsule">
                    <Panel>
                        <Image Classes="tileArt" i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Classes="tileFade" Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="1,0,3,0">
                            <c:ManaCost Classes="cost" Text="{Binding Cost}" DockPanel.Dock="Left" Margin="0,0,4,0" />
                            <Border Classes="countBadge" DockPanel.Dock="Right" IsVisible="{Binding ShowCount}">
                                <TextBlock Classes="countText" Text="{Binding Count}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#xF0674;" Classes="icon" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource Accent}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" IsVisible="{Binding Created}" />
                            <TextBlock Classes="tileName" Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Classes="rowFlash" />
                    </Panel>
                </Border>
                <Border Classes="rarityEdge" BorderBrush="{Binding Rarity, Converter={StaticResource KeyBrush}, ConverterParameter=edge}" />
                <TextBlock Grid.Column="1" Text="{Binding Chance}" Width="31" TextAlignment="Right" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding $parent[ItemsControl].((o:OverlayViewModel)DataContext).ShowChance, FallbackValue=True}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Classes="overlayCard" Width="252">
        <StackPanel>
            <Border Classes="overlayHeader" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding DeckName}" Classes="headerTitle" />
                    <TextBlock Text="{Binding DeckRecord}" Classes="headerNote"
                               Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.Caption="{Binding DeckRecordTip}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Deck}" ItemTemplate="{StaticResource DeckTileTemplate}" Margin="8,0,8,4" o:OverlayHit.Interactive="True" />
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,7,12,9">
                <StackPanel>
                    <TextBlock Text="{Binding DeckCounts}" FontSize="11" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding NextDraw}" FontSize="11" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding NextDraw, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
