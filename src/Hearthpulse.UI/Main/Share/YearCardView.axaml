<UserControl x:Class="Hearthpulse.UI.Main.Share.YearCardView"
             x:DataType="s:ShareViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:s="using:Hearthpulse.UI.Main.Share"
             Width="720">
    <!-- The year in review picture (proposal A3), as WPF's Main/Share/YearCardView.xaml. Only the player's own history. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Share/ShareLook.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Share/ShareStyles.axaml" />
    </UserControl.Styles>

    <Border Background="{StaticResource Bg}" Padding="16">
        <Border Classes="card" Padding="32,24">
            <StackPanel>
                <DockPanel>
                    <Image Source="{StaticResource HearthpulseLogo}" Width="40" Height="40" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Year.Title}" Classes="h2" FontSize="{StaticResource FontSizeSubhead}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Hearthpulse" Classes="wordmark" FontSize="{StaticResource FontSizeSubhead}" />
                        <TextBlock Text="{i:Loc Growth.Share.Tagline}" Classes="caption" />
                    </StackPanel>
                </DockPanel>
                <c:Wave Width="168" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="2,12,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,16" IsVisible="{Binding !Year.IsEmpty}">
                    <Border Width="88" Height="88" Margin="8,0" Classes="sharePortrait" i:CardArt.Portrait="{Binding Year.ClassHeroCardId}"
                            IsVisible="{Binding Year.ClassHeroCardId, Converter={StaticResource Truthy}}" />
                    <Border Width="88" Height="88" Margin="8,0" Classes="sharePortrait" i:CardArt.Portrait="{Binding Year.HeroCardId}" IsVisible="{Binding Year.HasHero}" />
                    <Border Width="88" Height="88" Margin="8,0" Classes="sharePortrait" i:CardArt.Portrait="{Binding Year.TopCardId}" IsVisible="{Binding Year.HasTopCard}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Year.Stats}" ItemTemplate="{StaticResource ShareStatTile}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding Year.Empty}" Classes="caption" FontSize="{StaticResource FontSizeLead}" Margin="0,24" HorizontalAlignment="Center"
                           TextWrapping="Wrap" IsVisible="{Binding Year.IsEmpty}" />

                <DockPanel Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{i:Loc Growth.Share.Site}" Classes="site" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BattleTag}" Classes="label" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
