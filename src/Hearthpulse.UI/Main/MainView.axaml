<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:core="using:Hearthpulse.Core"
             xmlns:s="using:Hearthpulse.UI.Main.Stats"
             xmlns:mm="using:Hearthpulse.UI.Main.Meta"
             xmlns:dk="using:Hearthpulse.UI.Main.Decks"
             xmlns:mt="using:Hearthpulse.UI.Main.Match"
             xmlns:mg="using:Hearthpulse.UI.Main.Migration"
             xmlns:cs="using:Hearthpulse.Core.Stats"
             xmlns:pg="using:Hearthpulse.UI.Main.Pages"
             x:Class="Hearthpulse.UI.Main.MainView"
             x:DataType="m:MainViewModel"
             Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
             FontFamily="{DynamicResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Logo.axaml" />
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/MainPages.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/MainLook.axaml" />
        <!-- A History row is selected only when a deck page sends a game there -->
        <Style Selector="ListBox.history ListBoxItem:selected /template/ ContentPresenter#Presenter">
            <Setter Property="Background" Value="{StaticResource SelectedFill}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.tableHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tierBadge">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Grid.navGroup">
            <Setter Property="Margin" Value="28,16,20,4" />
        </Style>
        <Style Selector="StackPanel.pageSubtitle">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="2,6,0,24" />
        </Style>
        <Style Selector="ScrollViewer.page">
            <Setter Property="Padding" Value="40,0,40,120" />
        </Style>
        <Style Selector="Border.placeBar">
            <Setter Property="Background" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Border.placeBar.top">
            <Setter Property="Background" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.placeBar.first">
            <Setter Property="Background" Value="{StaticResource TierS}" />
        </Style>
        <!-- Settings rows with a segmented choice: label and a muted line left, segments right; dimmed while disabled. -->
        <Style Selector="Grid.choiceRow:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.choiceRow Border.choice">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Narrow windows and phones: icon-only navigation and tighter pages. -->
        <Style Selector="m|MainView.compact RadioButton.nav /template/ ContentPresenter#Presenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Live bar: an overlay panel's show/hide button, the glyph in Accent while the panel is on, Faint while it is off -->
        <Style Selector="ToggleButton.panelToggle">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border CornerRadius="999" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
                </FocusAdornerTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.panelToggle:checked">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- Streamer mode on: a filled circle all the time, not only under the pointer -->
        <Style Selector="ToggleButton.panelToggle.streamer:checked">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:pointerover:unchecked">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <!-- The ⋯ menu: every panel, its glyph and name dimmed while it is off -->
        <Style Selector="StackPanel.panelItem.off TextBlock.icon">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="StackPanel.panelItem.off TextBlock.panelName">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="m|MainView.compact ScrollViewer.page">
            <Setter Property="Padding" Value="16,0,16,120" />
        </Style>
        <!-- Narrow: the segments drop under the explanation instead of squeezing the label. -->
        <Style Selector="m|MainView.compact Grid.choiceRow Border.choice">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Grid.choiceRow RadioButton.segment /template/ Border#Bd">
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <!-- Make your own theme: the preview left of the sliders; narrow, the sliders drop under it. -->
        <Style Selector="Grid.themeCustom StackPanel.themeSliders">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="20,0,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Grid.themeCustom StackPanel.themeSliders">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- A page's header filter sits top right; narrow, it drops under the title instead of covering it. -->
        <Style Selector="Grid.pageHead Border.headFilter">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Grid#PageHistory">
            <Setter Property="Margin" Value="40,0,40,110" />
        </Style>
        <Style Selector="m|MainView.compact Grid.pageHead Border.headFilter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="m|MainView.compact Grid#PageHistory">
            <Setter Property="Margin" Value="16,0,16,110" />
        </Style>

        <!-- My Stats (Main/Stats): filters drop under the title, side-by-side cards stack, the hero table loses its charts. -->
        <Style Selector="TextBlock.statsValue">
            <Setter Property="FontSize" Value="25" />
        </Style>
        <Style Selector="m|MainView.compact TextBlock.statsValue">
            <Setter Property="FontSize" Value="19" />
        </Style>
        <Style Selector=":is(Control).statsRight">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="UniformGrid.tiles3">
            <Setter Property="Columns" Value="3" />
        </Style>
        <Style Selector=":is(Control).narrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="m|MainView.compact UniformGrid.tiles3">
            <Setter Property="Columns" Value="2" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).narrow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="m|MainView.compact Border.statsBar RadioButton.segment /template/ Border#Bd">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="m|MainView.compact Grid.statsHead Border.statsFilter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).statsLeft">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).statsRight">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid Name="Frame" ColumnDefinitions="250,*">

        <!-- ================= Navigation ================= -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="24,22,0,18">
                    <Image Source="{StaticResource HearthpulseLogo}" Width="42" Height="42" />
                    <TextBlock Classes="h2 wide" Text="Hearthpulse" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <RadioButton Name="NavOverview" Classes="nav" Content="{i:Loc Main.Nav.Home}" Tag="&#xF02DC;" GroupName="Nav" IsChecked="True"
                             ToolTip.Tip="{i:Loc Main.Nav.HomeTip}" />

                <Grid Classes="navGroup wide" ColumnDefinitions="Auto,*">
                    <TextBlock Text="{i:Loc Main.Nav.Modes}" Classes="label" />
                    <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                </Grid>
                <RadioButton Name="NavBattlegrounds" Classes="nav" Content="{i:Loc Main.Mode.Battlegrounds}" Tag="&#xF0787;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.BattlegroundsTip}" />
                <RadioButton Name="NavStandard" Classes="nav" Content="{i:Loc Main.Nav.Standard}" Tag="&#xF063A;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.StandardTipShort}" />
                <RadioButton Name="NavWild" Classes="nav" Content="{i:Loc Main.Nav.Wild}" Tag="&#xF06E4;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.WildTipShort}" />
                <RadioButton Name="NavArena" Classes="nav" Content="{i:Loc Main.Mode.Arena}" Tag="&#xF0538;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.ArenaTip}" />

                <Grid Classes="navGroup wide" ColumnDefinitions="Auto,*">
                    <TextBlock Text="{i:Loc Main.Nav.Library}" Classes="label" />
                    <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                </Grid>
                <RadioButton Name="NavHistory" Classes="nav" Content="{i:Loc Main.Nav.History}" Tag="&#xF02DA;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.HistoryTip}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                <RadioButton Name="NavSettings" Classes="nav" Content="{i:Loc Main.Nav.Settings}" Tag="&#xF08BB;" GroupName="Nav"
                             ToolTip.Tip="{i:Loc Main.Nav.SettingsTip}" />
                <TextBlock Text="{Binding Version}" Classes="caption wide" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,8,0,0" />
            </StackPanel>
            <Panel />
        </DockPanel>

        <!-- ================= Content ================= -->
        <!-- The content plate: lamplight, a wash of the second accent and the theme's motif (same as the WPF window) -->
        <Border Grid.Column="1" Background="{StaticResource ContentFill}" BorderBrush="{StaticResource ContentEdge}" BorderThickness="1" CornerRadius="16"
                Margin="0,10,10,10" ClipToBounds="True">
            <Grid RowDefinitions="52,*">

                <!-- Top bar: what runs in the background on the left (only while something does), status chips on the right -->
                <!-- A dock, not a horizontal stack: the stack measures the line at infinite width, so the ellipsis never showed.
                     A long message (Hearthstone not found, startup problem) is read in full in the tip. -->
                <DockPanel Name="BusyLine" Margin="40,0,320,0" VerticalAlignment="Center" IsVisible="{Binding Busy, Converter={StaticResource Truthy}}">
                    <ToolTip.Tip>
                        <StackPanel MaxWidth="420">
                            <TextBlock Text="{Binding Busy}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Main.Busy.Tip}" Classes="caption" Margin="0,4,0,0" />
                        </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="&#xF04E6;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent2}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Busy}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Button Classes="ghost primary" Content="{i:Loc Main.Update.Ready}" Command="{Binding InstallUpdate}" IsVisible="{Binding UpdateReady}"
                            VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding UpdateText}" />
                    <Border Classes="pill" Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource GrooveEdge}" BorderThickness="1"
                            CornerRadius="999" Padding="12,5" ToolTip.Tip="{i:Loc Main.Status.Tip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" />
                            <TextBlock Text="{Binding MemoryStatus}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Home ===== -->
                <pg:OverviewPage Name="PageOverview" Grid.Row="1" />

                <!-- ===== Battlegrounds ===== -->
                <ScrollViewer Name="PageBattlegrounds" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel>
                        <Grid Classes="pageHead" RowDefinitions="Auto,Auto">
                            <StackPanel>
                                <TextBlock Text="{i:Loc Main.Mode.Battlegrounds}" Classes="display pageTitle" />
                                <c:Wave Classes="pageRule" />
                            </StackPanel>
                            <Border Classes="segmentBar headFilter"
                                    ToolTip.Tip="{i:Loc Main.Bg.ModeTip}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="segment" Content="{i:Loc Main.Bg.Solo}" GroupName="BgMode" IsChecked="True" Command="{Binding SetBgMode}" CommandParameter="Battlegrounds" />
                                    <RadioButton Classes="segment" Content="{i:Loc Main.Mode.Duos}" GroupName="BgMode" Command="{Binding SetBgMode}" CommandParameter="Duos" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- My stats (Main/Stats): header numbers, MMR over time, hero performance -->
                        <s:BattlegroundsStatsView Name="BgStats" />

                        <c:Ornament Text="{i:Loc Main.Bg.TierLists}" Icon="&#xF11D0;" Size="15" Margin="0,0,0,14" />
                        <WrapPanel Margin="0,0,0,14">
                            <Border Classes="segmentBar" Margin="0,0,12,8">
                                <WrapPanel>
                                    <RadioButton Name="TabHeroes" Classes="segment" Content="{i:Loc Main.Bg.Heroes}" GroupName="BgTab" IsChecked="True"
                                                 ToolTip.Tip="{i:Loc Main.Bg.HeroesTip}" />
                                    <RadioButton Name="TabComps" Classes="segment" Content="{i:Loc Main.Bg.Comps}" GroupName="BgTab"
                                                 ToolTip.Tip="{i:Loc Main.Bg.CompCaptionComps}" />
                                    <RadioButton Name="TabTrinkets" Classes="segment" Content="{i:Loc Main.Bg.Trinkets}" GroupName="BgTab"
                                                 ToolTip.Tip="{i:Loc Main.Bg.TrinketsTip}" />
                                    <RadioButton Name="TabCards" Classes="segment" Content="{i:Loc Main.Bg.Cards}" GroupName="BgTab"
                                                 ToolTip.Tip="{i:Loc Main.Bg.CardsCaption}" />
                                    <RadioButton Name="TabMine" Classes="segment" Content="{i:Loc Main.Bg.MyHeroes}" GroupName="BgTab"
                                                 ToolTip.Tip="{i:Loc Main.Bg.MyHeroesTip}" />
                                </WrapPanel>
                            </Border>
                            <!-- The brackets the loaded stats have (the API: top 50/20/5/1%); hidden when there is no choice -->
                            <Panel IsVisible="{Binding HasBracketChoice}">
                                <Border Name="BracketPicker" Classes="segmentBar" Margin="0,0,0,8"
                                        ToolTip.Tip="{i:Loc Main.Bg.BracketTip}">
                                    <ItemsControl ItemsSource="{Binding BracketOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:BracketOption">
                                                <RadioButton Classes="segment" Content="{Binding Label}" GroupName="Bracket" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding Select}" CommandParameter="{Binding Value}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Panel>
                        </WrapPanel>

                        <!-- Tier lists (Main/Meta): heroes and trinkets by tier, comps, cards, your heroes -->
                        <mm:BattlegroundsTiersView Name="BgTiers" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Constructed ===== -->
                <ScrollViewer Name="PageConstructed" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel>
                        <TextBlock Text="{Binding ConstructedTitle}" Classes="display pageTitle" />
                        <c:Wave Classes="pageRule" />

                        <Border HorizontalAlignment="Left" Classes="segmentBar" Margin="0,0,0,14">
                            <WrapPanel>
                                <RadioButton Name="TabMyDecks" Classes="segment" Content="{i:Loc Main.Ct.MyStats}" GroupName="CtTab" IsChecked="True"
                                             ToolTip.Tip="{i:Loc Main.Ct.MyStatsTip}" />
                                <RadioButton Name="TabMetaTiers" Classes="segment" Content="{i:Loc Main.Ct.MetaTiers}" GroupName="CtTab"
                                             ToolTip.Tip="{i:Loc Main.Ct.MetaTiersTip}" />
                                <RadioButton Name="TabMetaDecks" Classes="segment" Content="{i:Loc Main.Ct.TopDecks}" GroupName="CtTab"
                                             ToolTip.Tip="{i:Loc Main.Ct.TopDecksTip}" />
                                <RadioButton Name="TabMetaMatchups" Classes="segment" Content="{i:Loc Main.Ct.MetaMatchups}" GroupName="CtTab"
                                             ToolTip.Tip="{i:Loc Main.Ct.MetaMatchupsTip}" />
                            </WrapPanel>
                        </Border>

                        <!-- Community tabs (Main/Meta): tier list, top decks, matchup heat map -->
                        <mm:ConstructedMetaView Name="CtMeta" IsVisible="False" />

                        <!-- My stats (Main/Stats): Standard/Wild results; your decks follow below -->
                        <s:ConstructedStatsView Name="CtStats" />

                        <Grid Name="DeckColumns" ColumnDefinitions="3*,16,2*">
                            <Border Classes="card" VerticalAlignment="Top">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Main.Ct.Decks}" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                                    <!-- Decks that look like versions of one -->
                                    <ItemsControl ItemsSource="{Binding DeckSuggestions}" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dk:DeckSuggestionRow">
                                                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Text="&#xF062C;" Classes="icon" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{i:Loc Main.Ct.SameDeck}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                                            <TextBlock Text="{Binding Detail}" Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Classes="ghost primary" Content="{i:Loc Main.Ct.Merge}" Padding="12,5" FontSize="12" Margin="8,0,6,0"
                                                                    Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).MergeSuggested}" CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{i:Loc Main.Ct.MergeTip}" />
                                                            <Button Classes="ghost" Content="{i:Loc Main.Ct.NotSame}" Padding="10,5" FontSize="12"
                                                                    Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).DismissSuggested}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Decks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:DeckRow">
                                                <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).OpenDeck}" CommandParameter="{Binding}">
                                                    <Border Classes="row" Padding="13,9" Margin="0,0,0,3">
                                                        <Grid ColumnDefinitions="*,70,150,22">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="caption"><Run Text="{Binding Class, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastPlayed, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Text="{Binding Versions}" Classes="caption" Foreground="{StaticResource Info}"
                                                                           IsVisible="{Binding Versions, Converter={StaticResource Truthy}}" ToolTip.Tip="{i:Loc Main.Ct.VersionsTip}" />
                                                                <TextBlock Text="{Binding Meta}" Classes="caption" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding Meta, Converter={StaticResource Truthy}}" ToolTip.Tip="{i:Loc Main.Ct.MetaTip}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Record}" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="caption"
                                                                       ToolTip.Tip="{i:Loc Main.Ct.RecordTip}" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Main.Table.WinRate}">
                                                                <c:WinBar Width="80" Height="8" VerticalAlignment="Center" Fraction="{Binding WinFraction}" Games="{Binding Games}" Few="{Binding Few}" />
                                                                <TextBlock Text="{Binding WinRate}" Width="50" TextAlignment="Right" FontWeight="Bold" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="&#xF0142;" Classes="icon" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{i:Loc Main.Ct.DecksEmpty}" Classes="caption" Margin="0,8"
                                               IsVisible="{Binding Decks, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                </StackPanel>
                            </Border>
                            <Border Name="MatchupCard" Grid.Column="2" Classes="card" VerticalAlignment="Top">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Main.Ct.Matchups}" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10"
                                                ToolTip.Tip="{i:Loc Main.Ct.MatchupsHint}" />
                                    <ItemsControl ItemsSource="{Binding Matchups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:MatchupRow">
                                                <Border Classes="row" Padding="10,8">
                                                    <Grid ColumnDefinitions="*,60,56">
                                                        <TextBlock Text="{Binding Class}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Record}" Classes="caption" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{i:Loc Main.Ct.MatchupsEmpty}" Classes="caption" IsVisible="{Binding Matchups, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Deck page (Main/Decks): replaces the Constructed page while a deck is open ===== -->
                <ScrollViewer Name="PageDeck" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <dk:DeckDetailsView Name="DeckDetails" DataContext="{Binding DeckPage}" />
                </ScrollViewer>

                <!-- ===== Arena ===== -->
                <ScrollViewer Name="PageArena" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel>
                        <TextBlock Text="{i:Loc Main.Mode.Arena}" Classes="display pageTitle" />
                        <c:Wave Classes="pageRule" />
                        <s:ArenaStatsView Name="ArenaStats" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== History ===== -->
                <Grid Name="PageHistory" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Classes="pageHead" RowDefinitions="Auto,Auto">
                        <StackPanel>
                            <TextBlock Text="{i:Loc Main.Nav.History}" Classes="display pageTitle" />
                            <c:Wave Classes="pageRule" Margin="2,0,0,0" />
                            <StackPanel Classes="pageSubtitle">
                                <Panel Width="26" Height="26">
                                    <c:Scallop Fill="{StaticResource AccentContainer}" Lobes="9" Depth="0.12" />
                                    <TextBlock Text="&#xF02DA;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                                </Panel>
                                <TextBlock Classes="caption" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Library.Subtitle, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Border Classes="segmentBar headFilter" ToolTip.Tip="{i:Loc Main.History.FilterTip}">
                            <WrapPanel>
                                <RadioButton Name="HistoryAll" Classes="segment" Content="{i:Loc Main.History.All}" GroupName="Hist" IsChecked="True" Command="{Binding SetHistoryFilter}" CommandParameter="All" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.Mode.Battlegrounds}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Battlegrounds" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.Mode.Duos}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Duos" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.Mode.Ranked}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Ranked" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.History.Other}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Other" />
                            </WrapPanel>
                        </Border>
                    </Grid>
                    <!-- Tabs Recent / Saved / Imported, status, game cards (Main/Match/ReplayLibraryView) -->
                    <mt:ReplayLibraryView Name="LibraryView" Grid.Row="1" DataContext="{Binding Library}" />
                </Grid>

                <!-- ===== Match page (Main/Match): replaces the History list while a game is open ===== -->
                <ScrollViewer Name="PageMatch" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <mt:MatchView Name="MatchDetails" DataContext="{Binding MatchPage}" />
                </ScrollViewer>

                <!-- ===== Settings: tabs General / Overlay / Tracker / Stream / Account / Data / About (the last one shown is kept in AppSettings.SettingsTab) ===== -->
                <ScrollViewer Name="PageSettings" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="{i:Loc Settings.Title}" Classes="display pageTitle" />
                        <c:Wave Classes="pageRule" />

                        <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <WrapPanel>
                                <RadioButton Name="SettingsTabGeneral" Classes="segment" Content="{i:Loc Settings.Tab.General}" GroupName="SettingsTab" Tag="General" IsChecked="True" />
                                <RadioButton Name="SettingsTabOverlay" Classes="segment" Content="{i:Loc Settings.Tab.Overlay}" GroupName="SettingsTab" Tag="Overlay" />
                                <RadioButton Name="SettingsTabTracker" Classes="segment" Content="{i:Loc Settings.Tab.Tracker}" GroupName="SettingsTab" Tag="Tracker" />
                                <RadioButton Name="SettingsTabStream" Classes="segment" Content="{i:Loc Stream.Tab}" GroupName="SettingsTab" Tag="Stream" />
                                <RadioButton Name="SettingsTabAccount" Classes="segment" Content="{i:Loc Settings.Tab.Account}" GroupName="SettingsTab" Tag="Account" />
                                <RadioButton Name="SettingsTabData" Classes="segment" Content="{i:Loc Settings.Tab.Data}" GroupName="SettingsTab" Tag="Data" />
                                <RadioButton Name="SettingsTabAbout" Classes="segment" Content="{i:Loc Settings.Tab.About}" GroupName="SettingsTab" Tag="About" />
                            </WrapPanel>
                        </Border>

                        <!-- ===== General: language, theme, app ===== -->
                        <StackPanel Name="SettingsGeneral">
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Language.Title}" Icon="&#xF05CA;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Language}" Classes="caption cardNote" />
                                    <!-- Each radio's Tag is applied in MainView.axaml.cs (ApplyChoice) -->
                                    <Grid Classes="choiceRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" DataContext="{Binding Settings}" x:DataType="core:AppSettings">
                                        <TextBlock Text="{i:Loc Settings.Language.Label}" Classes="settingLabel" ToolTip.Tip="{i:Loc Settings.Language.Caption}" />
                                        <Border Classes="segmentBar choice">
                                            <WrapPanel>
                                                <RadioButton Classes="segment" Content="{i:Loc Settings.Language.System}" GroupName="Language"
                                                             IsChecked="{Binding LanguageAuto, Mode=OneWay}" Tag="Language.auto" />
                                                <RadioButton Classes="segment" Content="English" GroupName="Language"
                                                             IsChecked="{Binding LanguageEnglish, Mode=OneWay}" Tag="Language.en" />
                                                <RadioButton Classes="segment" Content="Русский" GroupName="Language"
                                                             IsChecked="{Binding LanguageRussian, Mode=OneWay}" Tag="Language.ru" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding LanguageRestartHint}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                                               IsVisible="{Binding LanguageRestartHint, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </Border>

                            <!-- Theme: presets as tiles in their own colours, then your own accent and background (shared view model,
                                 Presentation MainViewModel.Theme.cs; the app repaints in place, Infrastructure/ThemeEngine.cs) -->
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Theme.Title}" Icon="&#xF03D8;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Theme}" Classes="caption cardNote" />
                                    <TextBlock Text="{i:Loc Settings.Theme.Presets}" Classes="label settingGroup" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Themes}" Margin="0,0,-10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ThemeChoice">
                                                <!-- The preset's key, not its localized name: the settings keep the key -->
                                                <Button Classes="themeSwatch" Content="{Binding}" ContentTemplate="{StaticResource ThemeTile}" ToolTip.Tip="{Binding Name}"
                                                        AutomationProperties.Name="{Binding Name}" CommandParameter="{Binding Key}"
                                                        Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SelectTheme}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{i:Loc Settings.Theme.MakeOwn}" Classes="label settingGroup" />
                                    <Grid Classes="themeCustom" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <ContentControl Content="{Binding CustomPreview}" ContentTemplate="{StaticResource ThemeTile}" VerticalAlignment="Top" Focusable="False" />
                                        <StackPanel Classes="themeSliders">
                                            <Grid ColumnDefinitions="150,*" Margin="0,0,0,10">
                                                <TextBlock Text="{i:Loc Settings.Theme.Accent}" Classes="settingLabel" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Slider Minimum="0" Maximum="360" Value="{Binding AccentHue}" SmallChange="5" LargeChange="30"
                                                            AutomationProperties.Name="{i:Loc Settings.Theme.Accent}" />
                                                    <Border Height="4" CornerRadius="2" Margin="8,-6,8,0" Background="{StaticResource HueStrip}" IsHitTestVisible="False" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="150,*" Margin="0,0,0,10">
                                                <TextBlock Text="{i:Loc Settings.Theme.Background}" Classes="settingLabel" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Slider Minimum="0" Maximum="360" Value="{Binding BaseHue}" SmallChange="5" LargeChange="30"
                                                            AutomationProperties.Name="{i:Loc Settings.Theme.Background}" />
                                                    <Border Height="4" CornerRadius="2" Margin="8,-6,8,0" Background="{StaticResource HueStrip}" IsHitTestVisible="False" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="150,*" Margin="0,0,0,14">
                                                <TextBlock Text="{i:Loc Settings.Theme.Tint}" Classes="settingLabel" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1.5" Value="{Binding BaseTint}" SmallChange="0.05" LargeChange="0.25"
                                                        AutomationProperties.Name="{i:Loc Settings.Theme.Tint}" ToolTip.Tip="{i:Loc Settings.Theme.TintTip}" />
                                            </Grid>
                                            <Button Classes="ghost primary" Content="{i:Loc Settings.Theme.UseMine}" Command="{Binding ApplyCustomTheme}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.App.Title}" Icon="&#xF0614;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.App}" Classes="caption cardNote" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.App.Tray}" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,14" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.App.AutoUpdate}" IsChecked="{Binding Settings.AutoUpdate}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.App.AutoUpdateTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.App.StartWithSignIn}" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,14" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.App.StartMinimized}" IsChecked="{Binding Settings.StartMinimized}" />
                                </StackPanel>
                            </Border>

                            <!-- Every shortcut in one place (they were only in tips). The overlay's global ones exist on Windows only
                                 (WindowsOverlayPlatform), so their rows show there (MainView.axaml.cs); there is no hard refresh here. -->
                            <Border Name="ShortcutsCard" Classes="card" Margin="0,16,0,0">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Shortcuts.Title}" Icon="&#xF030C;" Size="13" Margin="0,0,0,14" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <TextBlock Text="{i:Loc Settings.Shortcuts.Pages}" Classes="settingLabel" TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                            <TextBlock Text="{i:Loc Settings.Shortcuts.PagesKeys}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <TextBlock Text="{i:Loc Settings.Shortcuts.Back}" Classes="settingLabel" TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                            <TextBlock Text="{i:Loc Settings.Shortcuts.BackKeys}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Grid Name="ShortcutHideRow" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <TextBlock Text="{i:Loc Settings.Shortcuts.Hide}" Classes="settingLabel" TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                            <TextBlock Text="{i:Loc Settings.Shortcuts.HideKeys}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Grid Name="ShortcutLayoutRow" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{i:Loc Settings.Shortcuts.Layout}" Classes="settingLabel" TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                            <TextBlock Text="{i:Loc Settings.Shortcuts.LayoutKeys}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Overlay: what is drawn over the game, its size, panel layout ===== -->
                        <StackPanel Name="SettingsOverlay" IsVisible="False">
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel DataContext="{Binding Settings}" x:DataType="core:AppSettings">
                                    <c:Ornament Text="{i:Loc Settings.Overlay.Title}" Icon="&#xF0A07;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Overlay}" Classes="caption cardNote" />
                                    <CheckBox Name="OverlaySetting" Classes="switch" Content="{i:Loc Settings.Overlay.Enabled}" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.EnabledTipWindows}" />
                                    <!-- The overlay is off: said by a banner in the accent container colours (as the setup warning on Home); the
                                         headings and switches below keep their full contrast and still work, so panels can be set up ahead -->
                                    <Border Name="OverlayOffBanner" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,-4,0,14"
                                            IsVisible="{Binding !#OverlaySetting.IsChecked}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="&#xF002A;" Classes="icon" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,10,0" />
                                            <TextBlock Name="OverlayOffNote" Grid.Column="1" Text="{i:Loc Settings.Overlay.OffNote}" TextWrapping="Wrap" Foreground="{StaticResource OnAccentContainer}" />
                                        </Grid>
                                    </Border>
                                    <!-- Size and opacity act on the whole overlay: right under its switch, before the panels -->
                                    <Grid Margin="0,0,0,12" ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Settings.Overlay.Size}" Classes="settingLabel" ToolTip.Tip="{i:Loc Settings.Overlay.SizeTip}" />
                                        <Slider Grid.Column="1" Minimum="0.7" Maximum="1.4" Value="{Binding OverlayScale}" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" />
                                        <TextBlock Grid.Column="2" Text="{Binding OverlayScale, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                    </Grid>
                                    <Grid Margin="0,0,0,18" ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Settings.Overlay.Opacity}" Classes="settingLabel" ToolTip.Tip="{i:Loc Settings.Overlay.OpacityTip}" />
                                        <Slider Grid.Column="1" Minimum="0.4" Maximum="1" Value="{Binding OverlayOpacity}" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" />
                                        <TextBlock Grid.Column="2" Text="{Binding OverlayOpacity, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                    </Grid>
                                    <StackPanel Name="OverlayPanelSwitches">
                                    <TextBlock Text="{i:Loc Widgets.Settings.Section}" Classes="label settingGroup" />
                                    <CheckBox Classes="switch" Content="{i:Loc Widgets.Turn.Setting}" IsChecked="{Binding ShowTurnTimer}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Widgets.Turn.SettingTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Widgets.Archetype.Setting}" IsChecked="{Binding ShowOpponentArchetype}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Widgets.Archetype.SettingTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Widgets.Ladder.Setting}" IsChecked="{Binding ShowLadderSession}" Margin="0,0,0,10"
                                              ToolTip.Tip="{i:Loc Widgets.Ladder.SettingTip}" />
                                    <Grid Margin="0,0,0,14" ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Widgets.Ladder.Break}" Classes="settingLabel" ToolTip.Tip="{i:Loc Widgets.Ladder.BreakTip}" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="12" Value="{Binding LadderSessionBreakHours}" SmallChange="1" LargeChange="2"
                                                IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption">
                                            <Run Text="{Binding LadderSessionBreakHours, Mode=OneWay}" /><Run Text=" " /><Run Text="{i:Loc Widgets.Ladder.HoursUnit}" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{i:Loc Settings.Overlay.Constructed}" Classes="label settingGroup" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.Secrets}" IsChecked="{Binding ShowSecrets}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.SecretsTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Related.Graveyard.Setting}" IsChecked="{Binding ShowGraveyard}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Related.Graveyard.SettingTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc OpponentDeck.Setting}" IsChecked="{Binding ShowLikelyDeck}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc OpponentDeck.SettingTip}" />
                                    <TextBlock Text="{i:Loc Settings.Overlay.Battlegrounds}" Classes="label settingGroup" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.TopBar}" IsChecked="{Binding ShowBattlegroundsBar}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.TopBarTip}" />
                                    <!-- Pick suggestions: badges over heroes, trinkets, tavern minions and every Discover. Each option explains itself
                                         in its tooltip (same texts as the Windows app). Each radio's Tag is applied in MainView.axaml.cs. -->
                                    <Grid Classes="choiceRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
                                        <TextBlock Text="{i:Loc Settings.Overlay.PickHints}" Classes="settingLabel" />
                                        <Border Classes="segmentBar choice">
                                            <WrapPanel>
                                                <RadioButton Name="PickHintsHighlightOption" Classes="segment" Content="{i:Loc Settings.Overlay.PickHintsHighlight}" GroupName="PickHints"
                                                             IsChecked="{Binding PickHintsHighlight, Mode=OneWay}" Tag="PickHints.Highlight"
                                                             ToolTip.Tip="{i:Loc Settings.Overlay.PickHintsHighlightCaption}" />
                                                <RadioButton Name="PickHintsStatsOnlyOption" Classes="segment" Content="{i:Loc Settings.Overlay.PickHintsStatsOnly}" GroupName="PickHints"
                                                             IsChecked="{Binding PickHintsStatsOnly, Mode=OneWay}" Tag="PickHints.StatsOnly"
                                                             ToolTip.Tip="{i:Loc Settings.Overlay.PickHintsStatsOnlyCaption}" />
                                                <RadioButton Name="PickHintsOffOption" Classes="segment" Content="{i:Loc Settings.Overlay.PickHintsOff}" GroupName="PickHints"
                                                             IsChecked="{Binding PickHintsOff, Mode=OneWay}" Tag="PickHints.Off"
                                                             ToolTip.Tip="{i:Loc Settings.Overlay.PickHintsOffCaption}" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.Boards}" IsChecked="{Binding ShowOpponentBoards}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.BoardsTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.Lobby}" IsChecked="{Binding ShowLobbyPanel}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.LobbyTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.BgLobby}" IsChecked="{Binding ShowBgLobbyPanel}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.BgLobbyTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.BgBadges}" IsChecked="{Binding ShowBgLeaderboardBadges}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.BgBadgesTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.Odds}" IsChecked="{Binding ShowCombatOdds}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.OddsTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Overlay.Session}" IsChecked="{Binding ShowSessionPanel}"
                                              ToolTip.Tip="{i:Loc Settings.Overlay.SessionTip}" />
                                    </StackPanel>
                                    <!-- The deck tracker's panels are overlay panels too, one tab over -->
                                    <TextBlock Text="{i:Loc Settings.Overlay.TrackerLink}" Classes="caption" TextWrapping="Wrap" Margin="0,22,0,10" />
                                    <Button Name="OpenTrackerTab" Classes="ghost" Content="{i:Loc Settings.Overlay.OpenTracker}" HorizontalAlignment="Left" Click="OnOpenTrackerTab" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel DataContext="{Binding Settings}" x:DataType="core:AppSettings">
                                    <c:Ornament Text="{i:Loc Settings.Layout.Title}" Icon="&#xF01BE;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Layout}" Classes="caption cardNote" />
                                    <TextBlock Name="MoveHintLine" Text="{i:Loc Overlay.Move.SettingsWindows}" Classes="caption cardNote" />
                                    <CheckBox Name="PanelLockSetting" Classes="switch" Content="{i:Loc Settings.Layout.Unlocked}" IsChecked="{Binding OverlayPanelsUnlocked}"
                                              Margin="0,0,0,14" ToolTip.Tip="{i:Loc Settings.Layout.UnlockedCaption}" />
                                    <Button Classes="ghost primary" Content="{i:Loc Settings.Layout.Arrange}" HorizontalAlignment="Left" Click="OnArrangeOverlay" Margin="0,0,0,24"
                                            ToolTip.Tip="{i:Loc Settings.Layout.CaptionWindows}" />
                                    <c:Ornament Text="{i:Loc Settings.Leaderboard.Title}" Icon="&#xF01A3;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Leaderboard.CaptionCrossPlatform}" Classes="caption cardNote" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Leaderboard.Guides}" IsChecked="{Binding ShowLeaderboardGuides}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Leaderboard.CaptionCrossPlatform}" />
                                    <Grid Margin="0,0,0,10" ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Settings.Leaderboard.Top}" Classes="settingLabel" />
                                        <Slider Name="LeaderboardTopSlider" Grid.Column="1" Minimum="0.05" Maximum="0.25" Value="{Binding LeaderboardTop}" />
                                        <!-- From the slider itself: the settings object does not notify -->
                                        <TextBlock Grid.Column="2" Text="{Binding #LeaderboardTopSlider.Value, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10" ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Settings.Leaderboard.SlotHeight}" Classes="settingLabel" />
                                        <Slider Name="LeaderboardSlotSlider" Grid.Column="1" Minimum="0.06" Maximum="0.12" Value="{Binding LeaderboardSlotHeight}" />
                                        <!-- From the slider itself: the settings object does not notify -->
                                        <TextBlock Grid.Column="2" Text="{Binding #LeaderboardSlotSlider.Value, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*,56">
                                        <TextBlock Text="{i:Loc Settings.Leaderboard.Width}" Classes="settingLabel" />
                                        <Slider Name="LeaderboardWidthSlider" Grid.Column="1" Minimum="0.04" Maximum="0.2" Value="{Binding LeaderboardWidth}" />
                                        <!-- From the slider itself: the settings object does not notify -->
                                        <TextBlock Grid.Column="2" Text="{Binding #LeaderboardWidthSlider.Value, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Tracker: the Constructed deck tracker, counters and mulligan ===== -->
                        <StackPanel Name="SettingsTracker" IsVisible="False">
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel DataContext="{Binding Settings}" x:DataType="core:AppSettings">
                                    <c:Ornament Text="{i:Loc Settings.Tracker.Title}" Icon="&#xF0639;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Tracker}" Classes="caption cardNote" />
                                    <Border Name="TrackerOverlayOffBanner" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,-4,0,14"
                                            IsVisible="{Binding !#OverlaySetting.IsChecked}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="&#xF002A;" Classes="icon" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{i:Loc Settings.Overlay.OffNote}" TextWrapping="Wrap" Foreground="{StaticResource OnAccentContainer}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Name="TrackerPanelSwitches">
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Tracker.Deck}" IsChecked="{Binding ShowDeckTracker}" Margin="0,0,0,14" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Tracker.DrawChance}" IsChecked="{Binding ShowDrawChance}" Margin="0,0,0,14" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Tracker.Opponent}" IsChecked="{Binding ShowOpponentTracker}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Tracker.OpponentTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Tracker.CardPool}" IsChecked="{Binding ShowCardPool}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Tracker.CardPoolTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Arena.Settings.Show}" IsChecked="{Binding ShowArenaDraft}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Arena.Settings.ShowTip}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Tracker.Summary}" IsChecked="{Binding ShowGameToasts}" />
                                    </StackPanel>
                                    <!-- The overlay's master switch, size and layout are one tab back -->
                                    <TextBlock Text="{i:Loc Settings.Tracker.OverlayLink}" Classes="caption" TextWrapping="Wrap" Margin="0,22,0,10" />
                                    <Button Name="OpenOverlayTab" Classes="ghost" Content="{i:Loc Settings.Tracker.OpenOverlay}" HorizontalAlignment="Left" Click="OnOpenOverlayTab" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Counters.Title}" Icon="&#xF012C;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Counters}" Classes="caption cardNote" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Counters.Show}" IsChecked="{Binding Settings.ShowCounters}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Settings.Counters.Caption}" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Counters.Opponent}" IsChecked="{Binding Settings.ShowOpponentCounters}" Margin="0,0,0,14" />
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Counters.Mulligan}" IsChecked="{Binding Settings.ShowMulligan}" Margin="0,0,0,8"
                                              ToolTip.Tip="{i:Loc Settings.Counters.MulliganTip}" />
                                    <ItemsControl ItemsSource="{Binding CounterRows}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:CounterSettingRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Classes="segmentBar">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Auto}" GroupName="{Binding Id}" IsChecked="{Binding IsAuto, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding AutoKey}" />
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Always}" GroupName="{Binding Id}" IsChecked="{Binding IsAlways, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding AlwaysKey}" />
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Off}" GroupName="{Binding Id}" IsChecked="{Binding IsOff, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding OffKey}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Battlegrounds counters: same modes, ids start with "bg-" -->
                                    <TextBlock x:Name="BgCountersHeading" Text="{i:Loc Settings.Counters.Battlegrounds}" Classes="h2" Margin="0,14,0,10"
                                               Background="Transparent" ToolTip.Tip="{i:Loc Settings.Counters.BgCaption}" />
                                    <ItemsControl ItemsSource="{Binding BgCounterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:CounterSettingRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Classes="segmentBar">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Auto}" GroupName="{Binding Id}" IsChecked="{Binding IsAuto, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding AutoKey}" />
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Always}" GroupName="{Binding Id}" IsChecked="{Binding IsAlways, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding AlwaysKey}" />
                                                            <RadioButton Classes="segment" Content="{i:Loc Settings.Counters.Off}" GroupName="{Binding Id}" IsChecked="{Binding IsOff, Mode=OneWay}"
                                                                         Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).SetCounterMode}" CommandParameter="{Binding OffKey}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Stream: streamer mode and the OBS windows (docs/streaming.md); bound to the main model, which tells the host ===== -->
                        <StackPanel Name="SettingsStream" IsVisible="False">
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Stream.Mode.Title}" Icon="&#xF05E9;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Stream.Mode.Note}" Classes="caption cardNote" />
                                    <CheckBox Name="StreamerModeSetting" Classes="switch" Content="{i:Loc Stream.Mode.Switch}" IsChecked="{Binding StreamerMode}" Margin="0,0,0,12"
                                              ToolTip.Tip="{i:Loc Stream.Mode.SwitchTip}" />
                                    <!-- What it hides: a description, not a state, so the same with the mode off -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                        <TextBlock Text="&#xF0209;" Classes="icon" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{i:Loc Stream.Mode.HideNames}" Classes="caption" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                        <TextBlock Text="&#xF0209;" Classes="icon" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{i:Loc Stream.Mode.HideRatings}" Classes="caption" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                        <TextBlock Text="&#xF0209;" Classes="icon" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{i:Loc Stream.Mode.HideOwn}" Classes="caption" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{i:Loc Stream.Mode.Keeps}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Discord.Title}" Icon="&#xF066F;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Discord.Note}" Classes="caption cardNote" />
                                    <CheckBox Name="DiscordSetting" Classes="switch" Content="{i:Loc Discord.Switch}" IsChecked="{Binding DiscordStatus}" IsEnabled="{Binding DiscordAvailable}" Margin="0,0,0,12"
                                              ToolTip.Tip="{i:Loc Discord.SwitchTip}" ToolTip.ShowOnDisabled="True" />
                                    <!-- The link to the Discord app: green once connected, faint while waiting or not registered -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6" IsVisible="{Binding DiscordStatusShown}">
                                        <Panel Margin="0,5,8,0" VerticalAlignment="Top">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Faint}" />
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Positive}" IsVisible="{Binding DiscordConnected}" />
                                        </Panel>
                                        <TextBlock Grid.Column="1" Text="{Binding DiscordStatusText}" Classes="caption" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{i:Loc Discord.Keeps}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Stream.Windows.Title}" Icon="&#xF0379;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Stream.Windows.Note}" Classes="caption cardNote" />
                                    <TextBlock Text="{i:Loc Stream.Windows.Group}" Classes="label settingGroup" />
                                    <CheckBox Name="StreamDeckSetting" Classes="switch" Content="{i:Loc Stream.Window.Deck}" IsChecked="{Binding StreamDeckWindow}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Stream.Window.DeckTip}" />
                                    <CheckBox Name="StreamLobbySetting" Classes="switch" Content="{i:Loc Stream.Window.Lobby}" IsChecked="{Binding StreamLobbyWindow}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Stream.Window.LobbyTip}" />
                                    <CheckBox Name="StreamOddsSetting" Classes="switch" Content="{i:Loc Stream.Window.Odds}" IsChecked="{Binding StreamOddsWindow}" Margin="0,0,0,14"
                                              ToolTip.Tip="{i:Loc Stream.Window.OddsTip}" />
                                    <TextBlock Text="{i:Loc Stream.Look.Group}" Classes="label settingGroup" />
                                    <!-- Each radio's Tag is applied in MainView.axaml.cs (ApplyStreamChoice) -->
                                    <Grid Classes="choiceRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
                                        <TextBlock Text="{i:Loc Stream.Background}" Classes="settingLabel" />
                                        <Border Classes="segmentBar choice">
                                            <WrapPanel>
                                                <RadioButton Name="StreamBackgroundThemeOption" Classes="segment" Content="{i:Loc Stream.Background.Theme}" GroupName="StreamBackground"
                                                             IsChecked="{Binding StreamBackgroundTheme, Mode=OneWay}" Tag="StreamBackground.Theme"
                                                             ToolTip.Tip="{i:Loc Stream.Background.ThemeTip}" />
                                                <RadioButton Name="StreamBackgroundGreenOption" Classes="segment" Content="{i:Loc Stream.Background.Green}" GroupName="StreamBackground"
                                                             IsChecked="{Binding StreamBackgroundGreen, Mode=OneWay}" Tag="StreamBackground.Green"
                                                             ToolTip.Tip="{i:Loc Stream.Background.GreenTip}" />
                                                <RadioButton Name="StreamBackgroundMagentaOption" Classes="segment" Content="{i:Loc Stream.Background.Magenta}" GroupName="StreamBackground"
                                                             IsChecked="{Binding StreamBackgroundMagenta, Mode=OneWay}" Tag="StreamBackground.Magenta"
                                                             ToolTip.Tip="{i:Loc Stream.Background.MagentaTip}" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                    <CheckBox Name="StreamOnTopSetting" Classes="switch" Content="{i:Loc Stream.OnTop}" IsChecked="{Binding StreamWindowsOnTop}" Margin="0,0,0,18"
                                              ToolTip.Tip="{i:Loc Stream.OnTopTip}" />
                                    <!-- How to add a window to OBS: the names of OBS's own menus, as in OBS 30 -->
                                    <Border Background="{StaticResource SecondaryContainer}" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xF02FD;" Classes="icon" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{i:Loc Stream.Help.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="18,*" Margin="0,6,0,0">
                                                <TextBlock Text="1." Foreground="{StaticResource OnSecondaryContainer}" />
                                                <TextBlock Grid.Column="1" Text="{i:Loc Stream.Help.Step1}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="18,*" Margin="0,6,0,0">
                                                <TextBlock Text="2." Foreground="{StaticResource OnSecondaryContainer}" />
                                                <TextBlock Grid.Column="1" Text="{i:Loc Stream.Help.Step2}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="18,*" Margin="0,6,0,0">
                                                <TextBlock Text="3." Foreground="{StaticResource OnSecondaryContainer}" />
                                                <TextBlock Grid.Column="1" Text="{i:Loc Stream.Help.Step3}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="18,*" Margin="0,6,0,0">
                                                <TextBlock Text="4." Foreground="{StaticResource OnSecondaryContainer}" />
                                                <TextBlock Grid.Column="1" Text="{i:Loc Stream.Help.Step4}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Name="StreamKeyLine" Text="{Binding StreamKeyNote}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       IsVisible="{Binding StreamKeyNote, Converter={StaticResource Truthy}}" />
                                            <TextBlock Text="{i:Loc Stream.Help.Minimize}" Foreground="{StaticResource OnSecondaryContainer}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Account: the hearthpulse.net sign-in ===== -->
                        <Border Name="SettingsAccount" Classes="card" IsVisible="False">
                            <StackPanel>
                                <c:Ornament Text="{i:Loc Settings.Account.Title}" Icon="&#xF0004;" Size="13" Margin="0,0,0,14" />
                                <TextBlock Text="{i:Loc Settings.Note.Account}" Classes="caption cardNote" Margin="0,-6,0,8" />
                                <!-- Signed in -->
                                <StackPanel IsVisible="{Binding AccountShowProfile}">
                                    <TextBlock Text="{i:Loc Settings.Account.SignedInAs}" Classes="caption" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xF01A5;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,6,0"
                                                   IsVisible="{Binding AccountHasSubscription}" />
                                        <TextBlock Text="{Binding AccountSubscription}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   IsVisible="{Binding AccountHasSubscription}" />
                                        <TextBlock Text="{Binding AccountSubscription}" Classes="caption" IsVisible="{Binding !AccountHasSubscription}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AccountSessionNote}" Classes="caption" Margin="0,6,0,0" IsVisible="{Binding !AccountSessionEndingSoon}" />
                                    <TextBlock Text="{Binding AccountSessionNote}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                               IsVisible="{Binding AccountSessionEndingSoon}" />
                                    <Button Classes="bare" Command="{Binding OpenAccountProfile}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{i:Loc Settings.Account.OpenProfile}" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
                                            <TextBlock Text="&#xF03CC;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Plan 3.1: the subscription that lifts the daily free limit of the pool's stats in a game -->
                                    <Button Classes="bare" Command="{Binding OpenAccountSubscription}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{i:Loc Settings.Account.Subscription}" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
                                            <TextBlock Text="&#xF03CC;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Games to the profile on the site ("My statistics") -->
                                    <CheckBox Classes="switch" Content="{i:Loc Upload.Switch}" IsChecked="{Binding UploadGames}" Margin="0,14,0,4">
                                        <ToolTip.Tip>
                                            <StackPanel>
                                                <TextBlock Text="{i:Loc Upload.Intro}" TextWrapping="Wrap" />
                                                <TextBlock Text="{i:Loc Upload.What}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                    </CheckBox>
                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Classes="bare" Command="{Binding OpenPrivacy}" Margin="0,0,14,0">
                                            <TextBlock Text="{i:Loc Upload.Privacy}" Foreground="{StaticResource Accent}" TextDecorations="Underline" FontSize="12" />
                                        </Button>
                                        <Button Classes="bare" Command="{Binding OpenTrackerData}">
                                            <TextBlock Text="{i:Loc Upload.YourData}" Foreground="{StaticResource Accent}" TextDecorations="Underline" FontSize="12" />
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding UploadGames}">
                                        <Button Classes="ghost" Content="{i:Loc Upload.PastGames}" Command="{Binding UploadPastGames}" Margin="0,0,12,0"
                                                ToolTip.Tip="{i:Loc Upload.PastGamesTip}" />
                                        <TextBlock Text="{Binding UploadStatus}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding UploadMessage}" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0"
                                               IsVisible="{Binding UploadMessage, Converter={StaticResource Truthy}}" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Classes="ghost primary" Content="{i:Loc Settings.Account.SignInAgain}" Command="{Binding SignIn}" Margin="0,0,8,0" IsVisible="{Binding AccountSessionEndingSoon}" />
                                        <Button Classes="ghost" Content="{i:Loc Settings.Account.SignOut}" Command="{Binding SignOut}" />
                                    </WrapPanel>
                                </StackPanel>
                                <!-- Signed out -->
                                <StackPanel IsVisible="{Binding AccountSignedOut}">
                                    <Button Classes="ghost primary" Content="{i:Loc Settings.Account.SignIn}" Command="{Binding SignIn}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            ToolTip.Tip="{i:Loc Settings.Account.SignedOutCaption}" />
                                </StackPanel>
                                <!-- Signing in: getting a code, then waiting for the player to confirm it on the site -->
                                <StackPanel IsVisible="{Binding AccountWaiting}">
                                    <TextBlock Text="{i:Loc Settings.Account.GettingCode}" Classes="caption" Margin="0,4,0,14" IsVisible="{Binding !AccountHasCode}" />
                                    <StackPanel IsVisible="{Binding AccountHasCode}">
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{i:Loc Settings.Account.Open}" Margin="0,0,4,0" />
                                            <Button Classes="bare" Command="{Binding OpenSignInPage}">
                                                <TextBlock Text="{Binding AccountCodeUri}" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
                                            </Button>
                                            <TextBlock Text="{i:Loc Settings.Account.EnterCode}" Margin="4,0,0,0" />
                                        </WrapPanel>
                                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,10">
                                            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="18,6">
                                                <TextBlock Text="{Binding AccountUserCode}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="28"
                                                           Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <Button Classes="ghost" Click="OnCopyAccountCode" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xF018F;" Classes="icon" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{i:Loc Settings.Account.Copy}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding AccountWaitingHint}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    </StackPanel>
                                    <Button Classes="ghost" Content="{i:Loc Settings.Account.Cancel}" Command="{Binding CancelSignIn}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock Text="{Binding AccountMessage}" Classes="caption" TextWrapping="Wrap" Margin="0,10,0,0"
                                           IsVisible="{Binding AccountMessage, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== Data: history, the data folder, where the numbers come from ===== -->
                        <StackPanel Name="SettingsData" IsVisible="False">
                            <!-- Moving over from HDT / Firestone (Main/Migration) -->
                            <mg:MigrationCard DataContext="{Binding Migration}" Full="True" Margin="0,0,0,16" />
                            <Border Classes="card" Margin="0,0,0,16">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Data.Title}" Icon="&#xF01BC;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Data}" Classes="caption cardNote" />
                                    <!-- Plan 0.5: crash reports without asking; off by default -->
                                    <CheckBox Classes="switch" Content="{i:Loc Settings.Data.CrashReports}" IsChecked="{Binding CrashReports}" Margin="0,0,0,4" />
                                    <TextBlock Text="{i:Loc Settings.Data.CrashReportsNote}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,18" />
                                    <WrapPanel>
                                        <Button Classes="ghost" Content="{i:Loc Settings.Data.Import}" Click="OnReimport" Margin="0,0,8,8"
                                                ToolTip.Tip="{i:Loc Settings.Data.ImportTip}" />
                                        <Button Classes="ghost" Content="{i:Loc Settings.Data.OpenFolder}" Click="OnOpenData" Margin="0,0,0,8" ToolTip.Tip="{i:Loc Settings.Data.OpenFolderTip}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DataFolder}" Classes="caption" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <!-- The replay rule was only in the folder path's tip: it decides what is deleted, so it is a visible line -->
                                    <TextBlock Name="ReplayLimitNote" Text="{i:Loc Match.Settings.ReplayLimit}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Sources.Title}" Icon="&#xF0128;" Size="13" Margin="0,0,0,14" />
                                    <TextBlock Text="{i:Loc Settings.Note.Sources}" Classes="caption cardNote" Margin="0,-6,0,10" />
                                    <TextBlock Text="{Binding Attribution}" Classes="caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== About ===== -->
                        <Border Name="SettingsAbout" Classes="card" IsVisible="False">
                            <StackPanel>
                                <c:Ornament Text="{i:Loc Settings.About.Title}" Icon="&#xF02FD;" Size="13" Margin="0,0,0,10" />
                                <TextBlock TextWrapping="Wrap" Classes="caption" Text="{i:Loc Settings.About.TextCrossPlatform}" />
                                <TextBlock Text="{i:Loc Settings.About.FontsCrossPlatform}" Classes="caption" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{i:Loc Settings.About.NotAffiliated}" Classes="caption" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding VersionText}" Classes="caption" FontSize="11" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding UpdateStatus}" Classes="caption" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ParseErrorsText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource Negative}"
                                           IsVisible="{Binding ParseErrorsText, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Floating live bar (like a now-playing bar) ===== -->
                <Border Name="LiveBar" Grid.Row="1" VerticalAlignment="Bottom" Margin="23,0,23,17" CornerRadius="12" Background="{StaticResource Surface3}"
                        BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="9,9,15,9"
                        BoxShadow="0 4 24 0 #59000000">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- Compact: the pulse icon and the arrange button (also in Settings -> Overlay) give their room to the text -->
                        <Panel Width="46" Height="46" Classes="wide">
                            <c:Scallop Name="LivePulse" Fill="{StaticResource Surface4}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="&#xF0EB7;" Classes="icon" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveTitle}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                            <!-- Trimmed in a narrow bar (the "deck not recognised" tail is the first to go): the tip has it all -->
                            <TextBlock Name="LiveDetailLine" Text="{Binding LiveDetail}" Classes="caption" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding LiveDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Classes="wide" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip.Tip="{i:Loc Main.Live.SessionTip}">
                            <TextBlock Text="{Binding SessionSummary}" Classes="caption" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SessionDelta}" FontWeight="Bold" HorizontalAlignment="Right"
                                       Foreground="{Binding SessionDeltaValue, Converter={StaticResource SignBrush}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Overlay panels: the main ones as buttons (not in compact), every panel in the ⋯ menu; the same settings as Settings -> Overlay / Tracker -->
                            <ItemsControl Name="QuickPanels" Classes="wide" ItemsSource="{Binding QuickPanelToggles}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PanelToggle">
                                        <ToggleButton Classes="panelToggle" Content="{Binding Icon}" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}"
                                                      AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Name="PanelsMenuButton" Classes="icon" Content="&#xF01D8;" Width="30" Height="30" FontSize="16" Margin="1,0"
                                    ToolTip.Tip="{i:Loc Main.Live.PanelsTip}" AutomationProperties.Name="{i:Loc Main.Live.Panels}">
                                <Button.Flyout>
                                    <!-- Filled from PanelToggles in code: one MenuItem per panel, its glyph and name dimmed while it is off -->
                                    <MenuFlyout Placement="TopEdgeAlignedRight" />
                                </Button.Flyout>
                            </Button>
                            <Border Classes="wide" Width="1" Height="18" Background="{StaticResource Outline}" Margin="6,0" VerticalAlignment="Center" />
                            <!-- Streamer mode: its own button, always shown (compact hides the panels' quick buttons); on, the glyph sits on a
                                 filled circle so the state reads at a glance. Only here, the tray and Settings: never on the overlay or in the OBS windows. -->
                            <ToggleButton Name="StreamerModeButton" Classes="panelToggle streamer" Content="&#xF05E9;" IsChecked="{Binding StreamerMode}"
                                          ToolTip.Tip="{Binding StreamerModeTip}" AutomationProperties.Name="{i:Loc Stream.Mode.Switch}"
                                          AutomationProperties.HelpText="{Binding StreamerModeTip}" />
                            <!-- On Windows the tips name the global shortcuts (MainView.axaml.cs, UseShortcutTips) -->
                            <Button Name="ArrangeButton" Classes="icon wide" Content="&#xF01BE;" Width="30" Height="30" FontSize="16" Margin="1,0,14,0"
                                    Click="OnArrangeOverlay" ToolTip.Tip="{i:Loc Main.Live.ArrangeTipShort}" AutomationProperties.Name="{i:Loc Main.Live.ArrangeTipShort}" />
                            <CheckBox Name="OverlaySwitch" Classes="switch" Content="{i:Loc Main.Live.Overlay}" HorizontalAlignment="Right"
                                      Click="OnOverlaySwitch" ToolTip.Tip="{i:Loc Main.Live.OverlayTipShort}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Card preview on hover (deck page card tiles): top layer, never takes the mouse -->
        <c:CardPreviewHost Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
