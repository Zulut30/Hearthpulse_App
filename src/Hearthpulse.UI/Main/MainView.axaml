<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:core="using:Hearthpulse.Core"
             xmlns:s="using:Hearthpulse.UI.Main.Stats"
             xmlns:mm="using:Hearthpulse.UI.Main.Meta"
             xmlns:dk="using:Hearthpulse.UI.Main.Decks"
             xmlns:mt="using:Hearthpulse.UI.Main.Match"
             xmlns:mg="using:Hearthpulse.UI.Main.Migration"
             xmlns:cs="using:Hearthpulse.Core.Stats"
             xmlns:pg="using:Hearthpulse.UI.Main.Pages"
             xmlns:st="using:Hearthpulse.UI.Main.SettingsTabs"
             xmlns:su="using:Hearthpulse.UI.Main.Setup"
             x:Class="Hearthpulse.UI.Main.MainView"
             x:DataType="m:MainViewModel"
             Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
             FontFamily="{DynamicResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Logo.axaml" />
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/MainPages.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/MainLook.axaml" />
        <!-- A History row is selected only when a deck page sends a game there -->
        <Style Selector="ListBox.history ListBoxItem:selected /template/ ContentPresenter#Presenter">
            <Setter Property="Background" Value="{StaticResource SelectedFill}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.tableHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tierBadge">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Grid.navGroup">
            <Setter Property="Margin" Value="28,16,20,4" />
        </Style>
        <Style Selector="StackPanel.pageSubtitle">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="2,6,0,24" />
        </Style>
        <Style Selector="ScrollViewer.page">
            <Setter Property="Padding" Value="40,0,40,120" />
        </Style>
        <Style Selector="Border.placeBar">
            <Setter Property="Background" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Border.placeBar.top">
            <Setter Property="Background" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.placeBar.first">
            <Setter Property="Background" Value="{StaticResource TierS}" />
        </Style>
        <!-- Settings rows with a segmented choice: label and a muted line left, segments right; dimmed while disabled. -->
        <Style Selector="Grid.choiceRow:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.choiceRow Border.choice">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Narrow windows and phones: icon-only navigation and tighter pages. -->
        <Style Selector="m|MainView.compact RadioButton.nav /template/ ContentPresenter#Presenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The sidebar's status and overlay cards: a groove like the search box. Margins and paddings are styles, not local
             values, so compact can override them. -->
        <Style Selector="Border.sideCard">
            <Setter Property="Background" Value="{StaticResource GrooveFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource GrooveEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>
        <Style Selector="Border#StatusCard">
            <Setter Property="Margin" Value="14,0,14,14" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Border#OverlayCard">
            <Setter Property="Margin" Value="12,0,12,10" />
            <Setter Property="Padding" Value="10,8,8,6" />
        </Style>
        <Style Selector="Border#OverlayCard WrapPanel">
            <Setter Property="Margin" Value="-2,6,0,0" />
        </Style>
        <Style Selector="CheckBox.sideSwitch">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="m|MainView.compact Border#StatusCard, m|MainView.compact Border#OverlayCard">
            <Setter Property="Margin" Value="8,0,8,10" />
            <Setter Property="Padding" Value="4,8" />
        </Style>
        <Style Selector="m|MainView.compact Border#StatusCard Ellipse#StatusDot">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="m|MainView.compact Border#StatusCard > Grid">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="m|MainView.compact CheckBox.sideSwitch">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="m|MainView.compact CheckBox.sideSwitch /template/ ContentPresenter#Presenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="m|MainView.compact Border#OverlayCard WrapPanel">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- The overlay card: an overlay panel's show/hide button, the glyph in Accent while the panel is on, Faint while it is off -->
        <Style Selector="ToggleButton.panelToggle">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border CornerRadius="999" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
                </FocusAdornerTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.panelToggle:checked">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- Streamer mode on: a filled circle all the time, not only under the pointer -->
        <Style Selector="ToggleButton.panelToggle.streamer:checked">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:pointerover:unchecked">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <!-- The ⋯ menu: every panel, its glyph and name dimmed while it is off -->
        <Style Selector="StackPanel.panelItem.off TextBlock.icon">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="StackPanel.panelItem.off TextBlock.panelName">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="m|MainView.compact ScrollViewer.page">
            <Setter Property="Padding" Value="16,0,16,120" />
        </Style>
        <!-- Narrow: the segments drop under the explanation instead of squeezing the label. -->
        <Style Selector="m|MainView.compact Grid.choiceRow Border.choice">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Grid.choiceRow RadioButton.segment /template/ Border#Bd">
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <!-- Make your own theme: the preview left of the sliders; narrow, the sliders drop under it. -->
        <Style Selector="Grid.themeCustom StackPanel.themeSliders">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="20,0,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Grid.themeCustom StackPanel.themeSliders">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- A page's header filter sits top right; narrow, it drops under the title instead of covering it. -->
        <Style Selector="Grid.pageHead Border.headFilter">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Grid.historyPage">
            <Setter Property="Margin" Value="40,0,40,110" />
        </Style>
        <Style Selector="m|MainView.compact Grid.pageHead Border.headFilter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="m|MainView.compact Grid.historyPage">
            <Setter Property="Margin" Value="16,0,16,110" />
        </Style>

        <!-- My Stats (Main/Stats): filters drop under the title, side-by-side cards stack, the hero table loses its charts. -->
        <Style Selector="TextBlock.statsValue">
            <Setter Property="FontSize" Value="25" />
        </Style>
        <Style Selector="m|MainView.compact TextBlock.statsValue">
            <Setter Property="FontSize" Value="19" />
        </Style>
        <Style Selector=":is(Control).statsRight">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="UniformGrid.tiles3">
            <Setter Property="Columns" Value="3" />
        </Style>
        <Style Selector=":is(Control).narrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="m|MainView.compact UniformGrid.tiles3">
            <Setter Property="Columns" Value="2" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).narrow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="m|MainView.compact Border.statsBar RadioButton.segment /template/ Border#Bd">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="m|MainView.compact Grid.statsHead Border.statsFilter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).statsLeft">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).statsRight">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid Name="Frame" ColumnDefinitions="250,*">

        <!-- ================= Navigation ================= -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="24,22,0,18">
                    <Image Source="{StaticResource HearthpulseLogo}" Width="42" Height="42" />
                    <TextBlock Classes="h2 wide" Text="Hearthpulse" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- The game's status (owner's pick B, 2026-11-05): the dot (gold: Hearthstone runs, green: connected), the live
                     line and its detail, two lines at most; the tip has the whole detail, the connection and this session.
                     Compact keeps the dot. Same as the WPF MainWindow. -->
                <Border Name="StatusCard" Classes="sideCard"
                        AutomationProperties.Name="{Binding LiveTitle}" AutomationProperties.HelpText="{Binding LiveDetail}">
                    <ToolTip.Tip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{Binding MemoryStatus}" FontWeight="SemiBold" />
                            <TextBlock Text="{i:Loc Main.Status.Tip}" Classes="caption" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{i:Loc Main.Live.SessionTip}" Classes="caption" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SessionSummary}" />
                                <TextBlock Text="{Binding SessionDelta}" FontWeight="Bold" Margin="8,0,0,0" Foreground="{Binding SessionDeltaValue, Converter={StaticResource SignBrush}}" />
                            </StackPanel>
                        </StackPanel>
                    </ToolTip.Tip>
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" Classes="wide" Margin="10,0,0,0">
                            <TextBlock Text="{Binding LiveTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- The "deck not recognised" tail is the first to go: the tip has it all -->
                            <TextBlock Name="LiveDetailLine" Text="{Binding LiveDetail}" Classes="caption" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding LiveDetail}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <RadioButton Name="NavOverview" Classes="nav" Content="{i:Loc Main.Nav.Home}" Tag="{x:Static c:GameIcons.Home}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+1" IsChecked="True"
                             ToolTip.Tip="{i:Loc Main.Nav.HomeTip}" />

                <Grid Classes="navGroup wide" ColumnDefinitions="Auto,*">
                    <TextBlock Text="{i:Loc Main.Nav.Modes}" Classes="label" />
                    <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                </Grid>
                <RadioButton Name="NavBattlegrounds" Classes="nav" Content="{i:Loc Main.Mode.Battlegrounds}" Tag="{x:Static c:GameIcons.Battlegrounds}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+2"
                             ToolTip.Tip="{i:Loc Main.Nav.BattlegroundsTip}" />
                <RadioButton Name="NavStandard" Classes="nav" Content="{i:Loc Main.Nav.Standard}" Tag="{x:Static c:GameIcons.Standard}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+3"
                             ToolTip.Tip="{i:Loc Main.Nav.StandardTipShort}" />
                <RadioButton Name="NavWild" Classes="nav" Content="{i:Loc Main.Nav.Wild}" Tag="{x:Static c:GameIcons.Wild}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+4"
                             ToolTip.Tip="{i:Loc Main.Nav.WildTipShort}" />
                <RadioButton Name="NavArena" Classes="nav" Content="{i:Loc Main.Mode.Arena}" Tag="{x:Static c:GameIcons.Arena}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+5"
                             ToolTip.Tip="{i:Loc Main.Nav.ArenaTip}" />
                <RadioButton Name="NavBrawl" Classes="nav" Content="{i:Loc Main.Mode.Brawl}" Tag="{x:Static c:GameIcons.Brawl}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+6"
                             ToolTip.Tip="{i:Loc Brawl.NavTip}" />

                <Grid Classes="navGroup wide" ColumnDefinitions="Auto,*">
                    <TextBlock Text="{i:Loc Main.Nav.Library}" Classes="label" />
                    <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                </Grid>
                <RadioButton Name="NavHistory" Classes="nav" Content="{i:Loc Main.Nav.History}" Tag="{x:Static c:GameIcons.History}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+7"
                             ToolTip.Tip="{i:Loc Main.Nav.HistoryTip}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                <!-- The overlay (owner's pick B, 2026-11-05): its switch, the main panels as buttons and every panel in the ⋯ menu
                     (the same settings as Settings -> Overlay / Tracker), arrange and streamer mode; the buttons wrap to a second
                     line. Compact: the switch without its label, the ⋯ menu and streamer mode, one under the other. Same as WPF. -->
                <Border Name="OverlayCard" Classes="sideCard">
                    <StackPanel>
                        <CheckBox Name="OverlaySwitch" Classes="switch sideSwitch" Content="{i:Loc Main.Live.Overlay}"
                                  Click="OnOverlaySwitch" ToolTip.Tip="{i:Loc Main.Live.OverlayTipShort}" />
                        <WrapPanel>
                            <ItemsControl Name="QuickPanels" Classes="wide" ItemsSource="{Binding QuickPanelToggles}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PanelToggle">
                                        <ToggleButton Classes="panelToggle" Content="{Binding Icon}" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}"
                                                      AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Name="PanelsMenuButton" Classes="icon" Content="&#xF01D8;" Width="28" Height="28" FontSize="15"
                                    ToolTip.Tip="{i:Loc Main.Live.PanelsTip}" AutomationProperties.Name="{i:Loc Main.Live.Panels}">
                                <Button.Flyout>
                                    <!-- Filled from PanelToggles in code: one MenuItem per panel, its glyph and name dimmed while it is off -->
                                    <MenuFlyout Placement="RightEdgeAlignedBottom" />
                                </Button.Flyout>
                            </Button>
                            <!-- On Windows the tips name the global shortcuts (MainView.axaml.cs, UseShortcutTips) -->
                            <Button Name="ArrangeButton" Classes="icon wide" Content="&#xF01BE;" Width="28" Height="28" FontSize="15"
                                    Click="OnArrangeOverlay" ToolTip.Tip="{i:Loc Main.Live.ArrangeTipShort}" AutomationProperties.Name="{i:Loc Main.Live.ArrangeTipShort}" />
                            <!-- Streamer mode: on, the glyph sits on a filled circle so the state reads at a glance. Only here, the tray and
                                 Settings: never on the overlay or in the OBS windows. -->
                            <ToggleButton Name="StreamerModeButton" Classes="panelToggle streamer" Content="&#xF05E9;" IsChecked="{Binding StreamerMode}"
                                          ToolTip.Tip="{Binding StreamerModeTip}" AutomationProperties.Name="{i:Loc Stream.Mode.Switch}"
                                          AutomationProperties.HelpText="{Binding StreamerModeTip}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <RadioButton Name="NavSettings" Classes="nav" Content="{i:Loc Main.Nav.Settings}" Tag="{x:Static c:GameIcons.Settings}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+8"
                             ToolTip.Tip="{i:Loc Main.Nav.SettingsTip}" />
                <TextBlock Text="{Binding Version}" Classes="caption wide" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,8,0,0" />
            </StackPanel>
            <Panel />
        </DockPanel>

        <!-- ================= Content ================= -->
        <!-- The content plate: lamplight, a wash of the second accent and the theme's motif (same as the WPF window) -->
        <Border Grid.Column="1" Background="{StaticResource ContentFill}" BorderBrush="{StaticResource ContentEdge}" BorderThickness="1" CornerRadius="16"
                Margin="0,10,10,10" ClipToBounds="True">
            <Grid RowDefinitions="52,*">

                <!-- The page's material and hero (V3 direction A): stone, the page's hero dissolving towards the text, a vignette
                     and a floor in the plate's colour, then a thin gold frame. Nothing moves; the hero follows the page
                     (MainViewModel.PageHero) and is gone while "Background characters" is off. Same as the WPF MainWindow. -->
                <Panel Grid.RowSpan="2" IsHitTestVisible="False">
                    <Border Classes="pageLayer" Background="{StaticResource PageStone}" />
                    <Panel IsVisible="{Binding PageHero, Converter={StaticResource Truthy}}">
                        <!-- The hero's colours light the whole page; the art itself is square, top right, half the plate wide and
                             at most 640: HearthstoneJSON's largest art is 512, so 1.25 at most, smoothed (the columns), so at the narrowest window it still clears the titles on the left; compact (wide
                             only) keeps the hero's colours without the art, which would sit under the title -->
                        <Border Classes="pageLayer" i:CardArt.Glow="{Binding PageHero}" Opacity="0.6" OpacityMask="{StaticResource PageGlowMask}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" MaxWidth="640" />
                            </Grid.ColumnDefinitions>
                            <Border Name="PageHeroArt" Grid.Column="1" Classes="wide" Height="{Binding $self.Bounds.Width}" VerticalAlignment="Top"
                                    Opacity="0.8" OpacityMask="{StaticResource PageHeroFade}">
                                <Border Classes="pageLayer" i:CardArt.Splash="{Binding PageHero}" OpacityMask="{StaticResource PageHeroFloor}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                        </Grid>
                        <Border Classes="pageLayer" Background="{StaticResource PageVignette}" />
                        <Border Classes="pageLayer" Background="{StaticResource PageShade}" />
                    </Panel>
                    <Border Margin="8" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" BorderBrush="{StaticResource PageFrame}" />
                </Panel>

                <!-- Top bar: what runs in the background on the left (only while something does), the update and the site link on the right -->
                <!-- A dock, not a horizontal stack: the stack measures the line at infinite width, so the ellipsis never showed.
                     A long message (Hearthstone not found, startup problem) is read in full in the tip. -->
                <DockPanel Name="BusyLine" Margin="40,0,320,0" VerticalAlignment="Center" IsVisible="{Binding Busy, Converter={StaticResource Truthy}}">
                    <ToolTip.Tip>
                        <StackPanel MaxWidth="420">
                            <TextBlock Text="{Binding Busy}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Main.Busy.Tip}" Classes="caption" Margin="0,4,0,0" />
                        </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="&#xF04E6;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent2}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Busy}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Button Classes="ghost primary" Content="{i:Loc Main.Update.Ready}" Command="{Binding InstallUpdate}" IsVisible="{Binding UpdateReady}"
                            VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding UpdateText}" />
                    <!-- The site connection (account center): hidden while signed out; a click opens Settings, Account -->
                    <Button Name="AccountLinkButton" Classes="bare" Click="OnOpenAccountCenter" VerticalAlignment="Center" Margin="0,0,8,0"
                            IsVisible="{Binding AccountLinkVisible}" ToolTip.Tip="{Binding AccountLinkTip}" AutomationProperties.Name="{Binding AccountLinkTip}">
                        <Border Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource GrooveEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPill}" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Panel Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource Positive}" IsVisible="{Binding AccountLinkOk}" />
                                    <Ellipse Fill="{StaticResource InfoCaution}" IsVisible="{Binding AccountLinkWarn}" />
                                    <Ellipse Fill="{StaticResource Negative}" IsVisible="{Binding AccountLinkBad}" />
                                </Panel>
                                <TextBlock Text="{Binding AccountLinkShort}" FontSize="{StaticResource FontSizeLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- ===== Home ===== -->
                <pg:OverviewPage Name="PageOverview" Grid.Row="1" />

                <!-- ===== Battlegrounds ===== -->
                <pg:BattlegroundsPage Name="PageBattlegrounds" Grid.Row="1" IsVisible="False" />

                <!-- ===== Constructed ===== -->
                <pg:ConstructedPageView Name="PageConstructed" Grid.Row="1" IsVisible="False" />

                <!-- ===== Deck page (Main/Decks): replaces the Constructed page while a deck is open ===== -->
                <ScrollViewer Name="PageDeck" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <dk:DeckDetailsView Name="DeckDetails" DataContext="{Binding DeckPage}" />
                </ScrollViewer>

                <!-- ===== Arena ===== -->
                <ScrollViewer Name="PageArena" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:GoldGlyph Classes="pageGlyph" Glyph="{x:Static c:GameIcons.Arena}" />
                            <TextBlock Text="{i:Loc Main.Mode.Arena}" Classes="display pageTitle" />
                        </StackPanel>
                        <c:Wave Classes="pageRule" />
                        <s:ArenaStatsView Name="ArenaStats" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Tavern Brawl ===== -->
                <ScrollViewer Name="PageBrawl" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:GoldGlyph Classes="pageGlyph" Glyph="{x:Static c:GameIcons.Brawl}" />
                            <TextBlock Text="{i:Loc Main.Mode.Brawl}" Classes="display pageTitle" />
                        </StackPanel>
                        <c:Wave Classes="pageRule" />
                        <s:BrawlView />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== History ===== -->
                <pg:HistoryPage Name="PageHistory" Grid.Row="1" IsVisible="False" />

                <!-- ===== Match page (Main/Match): replaces the History list while a game is open ===== -->
                <ScrollViewer Name="PageMatch" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <mt:MatchView Name="MatchDetails" DataContext="{Binding MatchPage}" />
                </ScrollViewer>

                <!-- ===== Settings: tabs General / Overlay / Tracker / Stream / Account / Data / About (the last one shown is kept in AppSettings.SettingsTab) ===== -->
                <ScrollViewer Name="PageSettings" Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <c:GoldGlyph Classes="pageGlyph" Glyph="{x:Static c:GameIcons.Settings}" />
                            <TextBlock Text="{i:Loc Settings.Title}" Classes="display pageTitle" />
                        </StackPanel>
                        <c:Wave Classes="pageRule" />

                        <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <WrapPanel>
                                <RadioButton Name="SettingsTabGeneral" Classes="segment" Content="{i:Loc Settings.Tab.General}" GroupName="SettingsTab" Tag="General" IsChecked="True" />
                                <RadioButton Name="SettingsTabOverlay" Classes="segment" Content="{i:Loc Settings.Tab.Overlay}" GroupName="SettingsTab" Tag="Overlay" />
                                <RadioButton Name="SettingsTabTracker" Classes="segment" Content="{i:Loc Settings.Tab.Tracker}" GroupName="SettingsTab" Tag="Tracker" />
                                <RadioButton Name="SettingsTabStream" Classes="segment" Content="{i:Loc Stream.Tab}" GroupName="SettingsTab" Tag="Stream" />
                                <RadioButton Name="SettingsTabAccount" Classes="segment" Content="{i:Loc Settings.Tab.Account}" GroupName="SettingsTab" Tag="Account" />
                                <RadioButton Name="SettingsTabData" Classes="segment" Content="{i:Loc Settings.Tab.Data}" GroupName="SettingsTab" Tag="Data" />
                                <RadioButton Name="SettingsTabAbout" Classes="segment" Content="{i:Loc Settings.Tab.About}" GroupName="SettingsTab" Tag="About" />
                            </WrapPanel>
                        </Border>

                        <!-- ===== General: language, theme, app ===== -->
                        <st:GeneralSettings Name="SettingsGeneral" />

                        <!-- ===== Overlay: what is drawn over the game, its size, panel layout ===== -->
                        <st:OverlaySettings Name="SettingsOverlay" IsVisible="False" />

                        <!-- ===== Tracker: the Constructed deck tracker, counters and mulligan ===== -->
                        <st:TrackerSettings Name="SettingsTracker" IsVisible="False" />

                        <!-- ===== Stream: streamer mode and the OBS windows ===== -->
                        <st:StreamSettings Name="SettingsStream" IsVisible="False" />

                        <!-- ===== Account: the hearthpulse.net sign-in ===== -->
                        <st:AccountSettings Name="SettingsAccount" IsVisible="False" />

                        <!-- ===== Data: history, the data folder, where the numbers come from ===== -->
                        <st:DataSettings Name="SettingsData" IsVisible="False" />

                        <!-- ===== About: version, updates, licences ===== -->
                        <st:AboutSettings Name="SettingsAbout" IsVisible="False" />

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Once: game records are on by default (docs/game-stats.md); a notice, not a consent question ===== -->
                <Border Grid.Row="1" VerticalAlignment="Top" Margin="24,2,24,0" CornerRadius="16" Background="{StaticResource Surface3}" ZIndex="5"
                        BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="12,12,16,12" IsVisible="{Binding ShowGameStatsNotice}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Grid Width="46" Height="46">
                            <c:Scallop Fill="{StaticResource Surface4}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="&#xF0128;" Classes="icon" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="{i:Loc Main.GameStats.Title}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource Text}" Text="{i:Loc Main.GameStats.What}" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Text="{i:Loc Main.GameStats.Never}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button Classes="ghost" Content="{i:Loc Main.GameStats.More}" Command="{Binding AnswerGameStats}" CommandParameter="more" />
                            <Button Classes="ghost" Content="{i:Loc Main.GameStats.Off}" Command="{Binding AnswerGameStats}" CommandParameter="off" />
                            <Button Classes="ghost primary" Content="{i:Loc Main.GameStats.Ok}" Command="{Binding AnswerGameStats}" CommandParameter="ok" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Setup wizard (D4): over the whole page while open; it opens by itself once for a new player ===== -->
                <su:SetupWizard Name="Setup" Grid.RowSpan="2" ZIndex="10" IsVisible="{Binding SetupOpen}" />

            </Grid>
        </Border>

        <!-- Card preview on hover (deck page card tiles): top layer, never takes the mouse -->
        <c:CardPreviewHost Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
