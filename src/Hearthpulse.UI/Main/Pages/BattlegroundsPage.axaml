<UserControl
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:core="using:Hearthpulse.Core"
             xmlns:s="using:Hearthpulse.UI.Main.Stats"
             xmlns:mm="using:Hearthpulse.UI.Main.Meta"
             xmlns:dk="using:Hearthpulse.UI.Main.Decks"
             xmlns:mt="using:Hearthpulse.UI.Main.Match"
             xmlns:mg="using:Hearthpulse.UI.Main.Migration"
             xmlns:cs="using:Hearthpulse.Core.Stats"
             x:Class="Hearthpulse.UI.Main.Pages.BattlegroundsPage"
             x:DataType="m:MainViewModel">
    <!-- Battlegrounds: community tiers (heroes, comps, trinkets, cards) and the player's own stats, with the bracket picker. Same tree as the WPF BattlegroundsPage.xaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/MainPages.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.headFilter.away">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer Classes="page" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Classes="pageHead" RowDefinitions="Auto,Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:GoldGlyph Classes="pageGlyph" Glyph="{x:Static c:GameIcons.Battlegrounds}" />
                        <TextBlock Text="{i:Loc Main.Mode.Battlegrounds}" Classes="display pageTitle" />
                    </StackPanel>
                    <c:Wave Classes="pageRule" />
                </StackPanel>
                <!-- Solo / Duos: on My stats, and on Heroes when the service has a Duos list. Where it does not apply it is
                     out of sight and out of reach but keeps its room: in the compact layout it is a row of its own above
                     the tabs, and a row that came and went would move the tabs from under the pointer. -->
                <Border Classes="segmentBar headFilter" Classes.away="{Binding !ShowBgMode}"
                        ToolTip.Tip="{i:Loc Main.Bg.ModeTip}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" Content="{i:Loc Main.Bg.Solo}" GroupName="BgMode" IsChecked="True" Command="{Binding SetBgMode}" CommandParameter="Battlegrounds" />
                        <RadioButton Classes="segment" Content="{i:Loc Main.Mode.Duos}" GroupName="BgMode" Command="{Binding SetBgMode}" CommandParameter="Duos" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One tab row: My stats first (as Standard and Wild), then the community tier lists; after the tabs the period
                 (My stats) or the MMR slice (Heroes and Trinkets, whose lists have more than one); the window switches them -->
            <WrapPanel Margin="0,0,0,14">
                <Border Classes="segmentBar" Margin="0,0,12,8">
                    <WrapPanel>
                        <RadioButton Name="TabMine" Classes="segment" Content="{i:Loc Stats.Title}" GroupName="BgTab" IsChecked="True"
                                     ToolTip.Tip="{i:Loc Main.Bg.MyHeroesTip}" />
                        <RadioButton Name="TabHeroes" Classes="segment" Content="{i:Loc Main.Bg.Heroes}" GroupName="BgTab"
                                     ToolTip.Tip="{i:Loc Main.Bg.HeroesTip}" />
                        <RadioButton Name="TabComps" Classes="segment" Content="{Binding CompTabLabel}" GroupName="BgTab"
                                     ToolTip.Tip="{Binding CompCaption}" />
                        <RadioButton Name="TabTrinkets" Classes="segment" Content="{i:Loc Main.Bg.Trinkets}" GroupName="BgTab"
                                     ToolTip.Tip="{i:Loc Main.Bg.TrinketsTip}" />
                        <RadioButton Name="TabCards" Classes="segment" Content="{i:Loc Main.Bg.Cards}" GroupName="BgTab"
                                     ToolTip.Tip="{i:Loc Main.Bg.CardsCaption}" />
                    </WrapPanel>
                </Border>
                <Border Name="BgPeriodBar" Classes="segmentBar statsBar" Margin="0,0,0,8" ToolTip.Tip="{i:Loc Stats.Period.Tip}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" Content="{i:Loc Stats.Period.All}" GroupName="BgPeriod" IsChecked="True" Command="{Binding SetBgPeriod}" CommandParameter="All" />
                        <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Week}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Week" />
                        <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Month}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Month" />
                        <RadioButton Classes="segment" Content="{i:Loc Stats.Period.ThisMonth}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Season"
                                     ToolTip.Tip="{i:Loc Stats.Period.ThisMonthBgTip}" />
                    </StackPanel>
                </Border>
                <!-- The MMR slices of the open tab's list (heroes: top 50/20/5/1%, in Duos 50/20%; trinkets: the same four);
                     hidden when there is no choice -->
                <Panel IsVisible="{Binding HasBracketChoice}">
                    <Border Name="BracketPicker" Classes="segmentBar" Margin="0,0,0,8"
                            ToolTip.Tip="{i:Loc Main.Bg.BracketTip}">
                        <ItemsControl ItemsSource="{Binding BracketOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:BracketOption">
                                    <RadioButton Classes="segment" Content="{Binding Label}" GroupName="Bracket" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding Select}" CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Panel>
            </WrapPanel>

            <!-- My stats (Main/Stats): header numbers, MMR over time, hero performance -->
            <s:BattlegroundsStatsView Name="BgStats" />

            <!-- Tier lists (Main/Meta): heroes and trinkets by tier, comps, cards -->
            <mm:BattlegroundsTiersView Name="BgTiers" IsVisible="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
