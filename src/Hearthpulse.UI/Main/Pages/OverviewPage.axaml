<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:mg="using:Hearthpulse.UI.Main.Migration"
             xmlns:sh="using:Hearthpulse.UI.Main.Share"
             xmlns:cs="using:Hearthpulse.Core.Stats"
             x:Class="Hearthpulse.UI.Main.Pages.OverviewPage"
             x:DataType="m:MainViewModel">
    <!-- Home: setup warning, migration card, getting started, tiles, ladder session, BG rating and placements, recent
         games. Same tree as the WPF OverviewPage.xaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/MainPages.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Classes="page" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <c:GoldGlyph Classes="pageGlyph" Glyph="{x:Static c:GameIcons.Home}" />
                <TextBlock Text="{i:Loc Main.Nav.Home}" Classes="display pageTitle" />
            </StackPanel>
            <c:Wave Classes="pageRule" />

            <Border Name="SetupBanner" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" CornerRadius="12" Padding="17,13" Margin="0,0,0,16"
                    IsVisible="{Binding SetupWarning, Converter={StaticResource Truthy}}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&#xF002A;" Classes="icon" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,12,0" />
                    <TextBlock Name="SetupWarningText" Grid.Column="1" Text="{Binding SetupWarning}" TextWrapping="Wrap" Foreground="{StaticResource OnAccentContainer}" />
                </Grid>
            </Border>

            <!-- First start: games and decks of HDT / Firestone found on this PC (Main/Migration) -->
            <Panel IsVisible="{Binding Migration.ShowOnHome}">
                <mg:MigrationCard DataContext="{Binding Migration}" Margin="0,0,0,16" />
            </Panel>

            <!-- December and January: the year in review is ready (Main/Share) -->
            <sh:YearReviewBanner />

            <!-- Until the first game is recorded: three steps (the first two follow the app's state) and the two things
                 worth doing before a match. The buttons are the existing import and layout actions. -->
            <Border Name="GettingStartedCard" Classes="card" Margin="0,0,0,16" IsVisible="{Binding ShowGettingStarted}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Main.Home.Start.Title}" Icon="&#xF040A;" Size="13" Margin="0,0,0,14" />
                    <Grid ColumnDefinitions="28,*" Margin="0,0,0,8">
                        <TextBlock Text="&#xF05E0;" Classes="icon" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Top" IsVisible="{Binding HearthstoneRunning}" />
                        <TextBlock Text="&#xF0766;" Classes="icon" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" IsVisible="{Binding !HearthstoneRunning}" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step1}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="28,*" Margin="0,0,0,8">
                        <TextBlock Text="&#xF05E0;" Classes="icon" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Top" IsVisible="{Binding LogsReady}" />
                        <TextBlock Text="&#xF0766;" Classes="icon" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" IsVisible="{Binding !LogsReady}" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step2}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Main.Home.Start.Step2Tip}" />
                    </Grid>
                    <Grid ColumnDefinitions="28,*" Margin="0,0,0,14">
                        <TextBlock Text="&#xF0766;" Classes="icon" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step3}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel>
                        <Button Name="GettingStartedSetup" Classes="ghost primary" Content="{i:Loc Setup.Open}" Command="{Binding OpenSetup}"
                                ToolTip.Tip="{i:Loc Setup.OpenTip}" Margin="0,0,8,8" />
                        <Button Name="GettingStartedImport" Classes="ghost" Content="{i:Loc Settings.Data.Import}" Click="OnImport" Margin="0,0,8,8"
                                ToolTip.Tip="{i:Loc Settings.Data.ImportTip}" />
                        <Button Name="GettingStartedArrange" Classes="ghost" Content="{i:Loc Settings.Layout.Arrange}" Click="OnArrange" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding OverviewTiles}" ItemTemplate="{StaticResource StatTileTemplate}" ItemsPanel="{StaticResource TilesPanel}"
                          Margin="0,0,-14,16" />

            <!-- Ranked ladder session: Standard and Wild apart (the overlay shows it in the game's menus) -->
            <Border Classes="card" Margin="0,0,0,16" IsVisible="{Binding ShowLadder}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Widgets.Ladder.Title}" Icon="&#xF0538;" Size="13" Margin="0,0,120,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LadderSince}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LadderLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cs:LadderSessionLine">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Format}" Classes="label" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Change}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{Binding ChangeValue, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Text="{Binding Ranks}" FontFamily="{StaticResource DisplayFont}" FontSize="18" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip.Tip="{i:Loc Widgets.Ladder.RankNote}" />
                                    </DockPanel>
                                    <TextBlock Classes="caption" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Games, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Faint}" /><Run Text="{Binding Record, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" · " Foreground="{StaticResource Faint}" /><Run Text="{Binding WinRate, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Streak}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"
                                               Foreground="{Binding StreakValue, Converter={StaticResource SignBrush}}" IsVisible="{Binding Streak, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The last games first: what a player opens Home for -->
            <Border Classes="card">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Main.Home.RecentGames}" Icon="&#xF02DA;" Size="13" Margin="0,0,280,0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Name="SessionRecapButton" Content="{i:Loc Growth.Recap.Button}" Classes="ghost" Padding="14,6" FontSize="12"
                                    Click="OnSessionRecap" ToolTip.Tip="{i:Loc Growth.Recap.ButtonTip}" AutomationProperties.Name="{i:Loc Growth.Recap.Button}" />
                            <Button Content="{i:Loc Main.Home.ViewAll}" Classes="ghost" Padding="14,6" FontSize="12" Click="OnViewHistory" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource OpenGameRow}" ClipToBounds="False" />
                    <ContentControl Classes="emptyState" Tag="&#xF02DA;" Content="{i:Loc Main.Home.NoGames}"
                                    IsVisible="{Binding Recent, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    <Button Classes="ghost" Content="{i:Loc Setup.Open}" Command="{Binding OpenSetup}" ToolTip.Tip="{i:Loc Setup.OpenTip}"
                            HorizontalAlignment="Center" Margin="0,4,0,8" IsVisible="{Binding ShowGettingStarted}" />
                </StackPanel>
            </Border>

            <!-- Your decks (V3): the three decks played last as banners over their class hero's art; a click opens the deck -->
            <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding HomeDecks, Converter={StaticResource Truthy}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Main.Home.YourDecks}" Icon="&#xF063A;" Size="13" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding HomeDecks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:HomeDeck">
                                <Button Classes="bare" Margin="0,0,12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="{i:Loc Main.Home.OpenDeckTip}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].((m:MainViewModel)DataContext).OpenDeck}" CommandParameter="{Binding Key}">
                                    <!-- The key card's art in a square at its own proportions (256 px art in 104): never stretched -->
                                    <Border Height="104" CornerRadius="{StaticResource RadiusLarge}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1"
                                            Background="{StaticResource CardFill}" ClipToBounds="True">
                                        <Grid ColumnDefinitions="102,*">
                                            <Border Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding ArtCardId}" />
                                            <StackPanel Grid.Column="1" Margin="12,8,12,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="{StaticResource RadiusLarge}" Margin="0,0,8,0" ClipToBounds="True"
                                                            BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Background="{StaticResource Surface3}"
                                                            i:CardArt.Portrait="{Binding HeroCardId}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Line}" Classes="caption" Margin="0,4,0,8" />
                                                <!-- The mana curve, 0 to 7+ -->
                                                <ItemsControl ItemsSource="{Binding Curve}" Height="24" HorizontalAlignment="Left">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:HomeDeckBar">
                                                            <Border Width="8" Height="{Binding Height}" Margin="0,0,4,0" VerticalAlignment="Bottom" CornerRadius="{StaticResource RadiusSmall}"
                                                                    Background="{StaticResource Accent}" ToolTip.Tip="{Binding Tip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Battlegrounds rating over time; where you finish is on the Battlegrounds page (My stats) -->
            <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding HasBgGames}">
                <DockPanel>
                    <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Main.Home.BgRating}" Icon="&#xF012A;" Size="13" Margin="0,0,0,12" />
                    <c:RatingChart Points="{Binding RatingPoints}" Height="200" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
