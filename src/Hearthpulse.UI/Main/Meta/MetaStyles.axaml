<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:Hearthpulse.UI.Main">
    <!-- Styles of the tier-list views (Main/Meta). Theme tokens only; the WPF twins are in Main/Meta/MetaResources.xaml. -->

    <!-- A sortable column head: its label and the sort arrow; it brightens under the mouse -->
    <Style Selector="Button.sortHead">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.sortHead:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.sortHead TextBlock.sortLabel">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sortArrow">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- A tier's head: the big letter on its colour, "Tier S" and its bound; the tier colour runs down the left edge -->
    <Style Selector="Border.tierHead">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="-8,8,-8,4" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Border.tierLetter">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- The chosen archetype keeps the selected plate -->
    <Style Selector="Border.row.selected">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>
    <Style Selector="Border.row.archetype">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="-8,0,-8,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- A row of a flat tier list as one plate, 46 high (48 with the gap under it): the button's presenter draws the
         plate, and hover and the choice recolour it, so a row is a button, its presenter and its content. The plate
         stands 8 px out of the content on each side (edge 1 + padding 7), so the columns stay under the list's head.
         The chosen row does not change under the mouse. Used with Button.bare (cursor, focus ring). -->
    <Style Selector="Button.metaRow">
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="-8,0,-8,2" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.metaRow:pointerover">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="Button.metaRow.selected">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>

    <!-- A tier's head as a row of the same flat list: the height, overhang and gap of Button.metaRow, the tier colour
         down the left edge (BorderBrush from the row's tier). Its letter is Border.tierLetter. -->
    <Style Selector="Border.tierRow">
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="-8,0,-8,2" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>

    <!-- Compact: the tier list drops the popularity column (the side card goes under it, MainView.ApplyWidth) -->
    <Style Selector="m|MainView.compact :is(Control).metaWide">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>
