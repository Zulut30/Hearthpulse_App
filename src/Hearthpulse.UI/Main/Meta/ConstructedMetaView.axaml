<UserControl x:Class="Hearthpulse.UI.Main.Meta.ConstructedMetaView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:mm="using:Hearthpulse.UI.Main.Meta"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- The Standard/Wild community tabs, as hearthpulse.net lays them out: filters, the tier list (tiers or one sortable
         table) beside the chosen archetype's mulligan guide and lists, the top decks, and the matchup heat map. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Meta/MetaResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="MetaDeckTemplate" x:DataType="m:MetaDeckRow">
                <Border Classes="row" Padding="8,8">
                    <Grid ColumnDefinitions="40,*,64,64,64,Auto">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                ClipToBounds="True" i:CardArt.Portrait="{Binding HeroId}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Class}" Classes="caption" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" ToolTip.Tip="{i:Loc Main.Table.WinRate}" />
                        <TextBlock Grid.Column="3" Text="{Binding Games}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTip.Tip="{i:Loc Main.Meta.ExactListTip}" />
                        <TextBlock Grid.Column="4" Text="{Binding Dust}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTip.Tip="{i:Loc Main.Meta.DustTip}" />
                        <Button Grid.Column="5" Classes="ghost" Content="{i:Loc Main.Meta.Copy}" Padding="12,4" FontSize="{StaticResource FontSizeLabel}" Margin="12,0,0,0"
                                Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).CopyDeck}" CommandParameter="{Binding}"
                                ToolTip.Tip="{i:Loc Main.Meta.CopyTip}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Meta/MetaStyles.axaml" />
        <!-- The tier's letter of a row, in the tier's colour. On the chosen row it takes the text colour: the tier colours
             are too close to the selected plate there (D is about 3:1), and in the table the letter alone names the tier.
             Here, not in MetaStyles: the brush comes from the row through the view's converter. -->
        <Style Selector="Button.metaRow TextBlock.tierInk" x:DataType="m:MetaArchetypeRow">
            <Setter Property="Foreground" Value="{Binding Tier, Converter={StaticResource KeyBrush}}" />
        </Style>
        <Style Selector="Button.metaRow.selected TextBlock.tierInk">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </UserControl.Styles>
    <!-- The rows of the tier list, picked by the row's type in both lists (tiers and table). -->
    <UserControl.DataTemplates>
        <!-- One archetype, 13 visuals from the button down: rank, portrait, name over its detail (English name, class,
             games) in one cell, the tier's letter in its colour, win rate and popularity as a number and a bar, the play
             split in one text. The button's presenter draws the plate (Button.metaRow). -->
        <DataTemplate x:DataType="m:MetaArchetypeRow">
            <!-- No command on the row: the view hears the click of both lists (OnRowClick), which spares each row two
                 bindings and a search up the tree. -->
            <Button Classes="bare metaRow" Classes.selected="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="30,42,*,44,116,100,Auto">
                    <TextBlock Text="{Binding Rank}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                            ClipToBounds="True" i:CardArt.Portrait="{Binding HeroId}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Bottom" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Tier}" Width="30" HorizontalAlignment="Left" TextAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" FontFamily="{DynamicResource DisplayFont}"
                               Classes="tierInk" />
                    <TextBlock Grid.Column="4" Text="{Binding WinRate}" Width="56" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"
                               ToolTip.Tip="{Binding WinRateTip}"
                               Foreground="{Binding WinSign, Converter={StaticResource SignBrush}, ConverterParameter=text}" />
                    <Border Grid.Column="4" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="56,0,0,0"
                            Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                            Width="{Binding WinBar}" />
                    <TextBlock Grid.Column="5" Text="{Binding Popularity}" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Classes="caption metaWide" FontSize="{StaticResource FontSizeLabel}" />
                    <Border Grid.Column="5" Classes="metaWide" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"
                            Background="{StaticResource Accent}"
                            Width="{Binding PopularityBar}" />
                    <!-- Shown only when the source splits games by who went first -->
                    <TextBlock Grid.Column="6" Width="96" Text="{Binding PlaySplit}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" VerticalAlignment="Center"
                               IsVisible="{Binding ShowsPlaySplit}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A tier's head as a row of the same list and of the same height: the letter on its colour, "Tier S", then its
             bound and count, or that the tier is empty. Not a button. -->
        <DataTemplate x:DataType="m:TierHeadRow">
            <Border Classes="tierRow" BorderBrush="{Binding Tier, Converter={StaticResource KeyBrush}}">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Classes="tierLetter" Background="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" FontFamily="{DynamicResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Caption}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel>
        <!-- Filters: rank and period, then class and minimum games (hearthpulse.net's "Рейтинг", "Период", "Минимум игр") -->
        <StackPanel Name="MetaFilters" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,8">
                <Border Name="FilterRanks" Classes="segmentBar" Margin="0,0,12,8" ToolTip.Tip="{i:Loc Main.Ct.RankTip}">
                    <ItemsControl ItemsSource="{Binding MetaRanks}" ItemsPanel="{StaticResource ChoiceWrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MetaChoice">
                                <RadioButton Classes="segment" Content="{Binding Label}" GroupName="MetaRank" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).SetMetaRank}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Name="FilterPeriods" Classes="segmentBar" Margin="0,0,0,8" ToolTip.Tip="{i:Loc Main.Ct.PeriodTip}">
                    <ItemsControl ItemsSource="{Binding MetaPeriods}" ItemsPanel="{StaticResource ChoiceRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MetaChoice">
                                <RadioButton Classes="segment" Content="{Binding Label}" GroupName="MetaPeriod" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).SetMetaPeriod}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </WrapPanel>
            <WrapPanel>
                <Border Name="FilterClasses" Classes="segmentBar" Margin="0,0,12,8" ToolTip.Tip="{i:Loc Main.Ct.ClassTip}">
                    <ItemsControl ItemsSource="{Binding MetaClasses}" ItemsPanel="{StaticResource ChoiceWrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MetaChoice">
                                <RadioButton Classes="segment" Content="{Binding Label}" GroupName="MetaClass" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).SetMetaClass}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Name="MinGamesPicker" Classes="segmentBar" Margin="0,0,0,8" ToolTip.Tip="{i:Loc Main.Meta.MinGamesTip}">
                    <ItemsControl ItemsSource="{Binding MetaMinGames}" ItemsPanel="{StaticResource ChoiceRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MetaChoice">
                                <RadioButton Classes="segment" Content="{Binding Label}" GroupName="MetaMinGames" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).SetMetaMinGames}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- Meta tier list: archetypes on the left, the chosen one's mulligan guide and best lists on the right -->
        <Grid Name="MetaTiersPanel" ColumnDefinitions="3*,16,2*">
            <Border Name="TierCard" Classes="card" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                        <c:Ornament Text="{Binding ConstructedTitle}" Icon="&#xF11D0;" Size="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip.Tip="{i:Loc Main.Meta.TierTip}" />
                        <Border Grid.Column="1" Classes="segmentBar" ToolTip.Tip="{i:Loc Main.Meta.ViewTip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="{i:Loc Main.Meta.ViewTiers}" GroupName="MetaView" IsChecked="{Binding MetaTierView, Mode=OneWay}"
                                             Command="{Binding SetMetaView}" CommandParameter="Tiers" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.Meta.ViewTable}" GroupName="MetaView" IsChecked="{Binding MetaTableView, Mode=OneWay}"
                                             Command="{Binding SetMetaView}" CommandParameter="Table" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Column heads: a click sorts by the column, again turns the order round -->
                    <Grid Name="MetaHead" Margin="0,0,0,4" ColumnDefinitions="30,42,*,44,116,100,Auto" IsVisible="{Binding HasMetaArchetypes}">
                        <TextBlock Text="#" Classes="tableHead" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Classes="sortHead" Command="{Binding SetMetaSort}" CommandParameter="Name" ToolTip.Tip="{i:Loc Main.Meta.SortHeadTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{i:Loc Main.Table.Archetype}" Classes="sortLabel" />
                                    <TextBlock Text="{Binding MetaArrows.Name}" Classes="sortArrow" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text=" · " Classes="tableHead" />
                            <Button Classes="sortHead" Command="{Binding SetMetaSort}" CommandParameter="Games" ToolTip.Tip="{i:Loc Main.Meta.GamesTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{i:Loc Main.Table.Games}" Classes="sortLabel" />
                                    <TextBlock Text="{Binding MetaArrows.Games}" Classes="sortArrow" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="sortHead" Command="{Binding SetMetaSort}" CommandParameter="Tier" ToolTip.Tip="{i:Loc Main.Meta.TierTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{i:Loc Main.Table.Tier}" Classes="sortLabel" />
                                <TextBlock Text="{Binding MetaArrows.Tier}" Classes="sortArrow" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="sortHead" Command="{Binding SetMetaSort}" CommandParameter="WinRate" ToolTip.Tip="{i:Loc Main.Meta.WinRateTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{i:Loc Main.Table.WinRate}" Classes="sortLabel" />
                                <TextBlock Text="{Binding MetaArrows.WinRate}" Classes="sortArrow" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Classes="sortHead metaWide" Command="{Binding SetMetaSort}" CommandParameter="Popularity" ToolTip.Tip="{i:Loc Main.Meta.PopularityTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{i:Loc Main.Table.Popularity}" Classes="sortLabel" />
                                <TextBlock Text="{Binding MetaArrows.Popularity}" Classes="sortArrow" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="6" Width="96" Text="{i:Loc Main.Meta.PlaySplit}" Classes="tableHead" TextAlignment="Right"
                                   ToolTip.Tip="{i:Loc Main.Meta.PlaySplitTip}" IsVisible="{Binding MetaHasPlaySplit}" />
                    </Grid>

                    <!-- Tiers: S to D in one flat list, a tier's head and then its archetypes; an empty tier is its head alone,
                         saying so (as on the site). The list is changed in place, so the rows that stay keep their visuals.
                         Not clipped: a row's plate stands 8 px out of the list on each side, into the card's padding. -->
                    <!-- Both lists in one holder: the view keeps it hidden while it builds the rest of the tab ahead of the first
                         click (Prebuild in the code-behind), so the rows are built where the page really shows them. -->
                    <StackPanel Name="MetaLists">
                        <ItemsControl Name="MetaTierList" ItemsSource="{Binding MetaTierRows}" ItemsPanel="{StaticResource PageRows}" ClipToBounds="False"
                                      IsVisible="{Binding MetaTierView}" />

                        <!-- Table: the archetypes alone, in the chosen order -->
                        <ItemsControl Name="MetaTable" ItemsSource="{Binding MetaArchetypes}" ItemsPanel="{StaticResource PageRows}" ClipToBounds="False"
                                      IsVisible="{Binding MetaTableView}" />
                    </StackPanel>

                    <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}" IsVisible="{Binding MetaLoading}" />
                    <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}" IsVisible="{Binding MetaUnavailable}" />
                    <ContentControl Classes="emptyState" Tag="&#xF0233;" Content="{i:Loc Main.Meta.Empty}" IsVisible="{Binding MetaEmpty}" />
                    <TextBlock Text="{Binding ConstructedMetaStatus}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                               TextWrapping="Wrap" IsVisible="{Binding MetaStatusShown}" />
                </StackPanel>
            </Border>

            <Border Name="ArchetypeCard" Grid.Column="2" Classes="card" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedArchetypeTitle}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                               FontFamily="{DynamicResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArchetypeSummary}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <!-- The sections come in one step after the list is ready for input (ArchetypeDetailScheduler, set in the
                         code-behind); until the first build nothing stands here, not a false "not enough games". -->
                    <StackPanel Name="ArchetypeSections" IsVisible="{Binding ArchetypeDetailReady}">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding DetailArchetype.HasPlaySplit, FallbackValue=False}">
                        <Border Classes="segmentBar" Padding="12,4" Margin="0,0,8,0" ToolTip.Tip="{i:Loc Main.Meta.FirstTip}">
                            <TextBlock><Run Text="{i:Loc Main.Meta.GoingFirst}" Foreground="{StaticResource Muted}" /><Run Text="{Binding DetailArchetype.First, Mode=OneWay, FallbackValue=''}" FontWeight="Bold" /></TextBlock>
                        </Border>
                        <Border Classes="segmentBar" Padding="12,4" ToolTip.Tip="{i:Loc Main.Meta.CoinTip}">
                            <TextBlock><Run Text="{i:Loc Main.Meta.OnCoin}" Foreground="{StaticResource Muted}" /><Run Text="{Binding DetailArchetype.Coin, Mode=OneWay, FallbackValue=''}" FontWeight="Bold" /></TextBlock>
                        </Border>
                    </StackPanel>

                    <c:Ornament Text="{i:Loc Main.Meta.MulliganGuide}" Icon="&#xF012C;" Size="13" Margin="0,16,0,8"
                                ToolTip.Tip="{i:Loc Main.Meta.MulliganCaption}" />
                    <!-- Plan 2.4: the mulligan's own rank (Legend by default); the overlay follows it -->
                    <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,4" ToolTip.Tip="{i:Loc Main.Meta.MulliganRankTip}">
                        <ItemsControl ItemsSource="{Binding MulliganRanks}" ItemsPanel="{StaticResource ChoiceWrap}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:MetaChoice">
                                    <RadioButton Classes="segment" Content="{Binding Label}" GroupName="MulliganRank" IsChecked="{Binding Selected, Mode=OneWay}"
                                                 Command="{Binding $parent[mm:ConstructedMetaView].((m:MainViewModel)DataContext).SetMulliganRank}" CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding MulliganSource}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,4"
                               IsVisible="{Binding MulliganSource, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding Mulligan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MulliganRow">
                                <Border Classes="row" Padding="8,4">
                                    <!-- Fixed "kept" column, so every row's "kept N%" and name trim line up -->
                                    <Grid ColumnDefinitions="36,*,116,52">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Classes="caption" TextAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0" ToolTip.Tip="{i:Loc Main.Meta.KeepRateTip}" />
                                        <TextBlock Grid.Column="3" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" ToolTip.Tip="{Binding Seen}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i:Loc Main.Meta.MulliganEmpty}" Classes="caption" Margin="0,4"
                               IsVisible="{Binding Mulligan, Converter={StaticResource Truthy}, ConverterParameter=!}" />

                    <c:Ornament Text="{i:Loc Main.Meta.BestLists}" Icon="&#xF0639;" Size="13" Margin="0,16,0,8" />
                    <ItemsControl Name="BestLists" ItemsSource="{Binding ArchetypeDecks}" ItemTemplate="{StaticResource MetaDeckTemplate}" />
                    <TextBlock Text="{i:Loc Main.Meta.ListsEmpty}" Classes="caption" Margin="0,4"
                               IsVisible="{Binding ArchetypeDecks, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    <TextBlock Text="{Binding CopyNote}" Classes="caption" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding CopyNote, Converter={StaticResource Truthy}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top decks -->
        <Border Name="MetaDecksPanel" Classes="card" IsVisible="False">
            <StackPanel>
                <Grid Margin="8,0,8,8" ColumnDefinitions="40,*,64,64,64,76">
                    <TextBlock Grid.Column="1" Text="{i:Loc Main.Table.Deck}" Classes="tableHead" />
                    <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.WinRate}" Classes="tableHead" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.Games}" Classes="tableHead" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.Dust}" Classes="tableHead" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MetaDecks}" ItemTemplate="{StaticResource MetaDeckTemplate}" />
                <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}" IsVisible="{Binding MetaLoading}" />
                <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}" IsVisible="{Binding MetaUnavailable}" />
                <ContentControl Classes="emptyState" Tag="&#xF0639;" Content="{i:Loc Main.Meta.DecksEmpty}" IsVisible="{Binding MetaDecksEmpty}" />
                <TextBlock Text="{Binding CopyNote}" Classes="caption" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                           IsVisible="{Binding CopyNote, Converter={StaticResource Truthy}}" />
                <TextBlock Text="{Binding ConstructedMetaStatus}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding MetaStatusShown}" />
            </StackPanel>
        </Border>

        <!-- Matchups: a heat map of the most played archetypes, the row's win rate against the column -->
        <Border Name="MetaMatchupsPanel" Classes="card" IsVisible="False">
            <StackPanel>
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <c:Ornament Text="{i:Loc Main.Ct.MetaMatchups}" Icon="&#xF04E5;" Size="13" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <!-- Legend: red loses, plain is even, green wins -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Negative}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendLose}" Classes="caption" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Surface3}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendEven}" Classes="caption" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Positive}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendWin}" Classes="caption" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{i:Loc Main.Meta.MatchupsCaption}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding MatchupsRankNote}" Classes="caption" TextWrapping="Wrap" Margin="0,-8,0,12"
                           IsVisible="{Binding MatchupsRankNote, Converter={StaticResource Truthy}}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasMatchupMatrix}">
                    <StackPanel Name="MatchupGrid">
                        <!-- Column heads: the opponent's portrait and short name, the full name on hover -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="190" />
                            <TextBlock Width="62" Text="{i:Loc Main.Meta.MatchupsOverall}" Classes="tableHead" TextAlignment="Center" VerticalAlignment="Bottom"
                                       ToolTip.Tip="{i:Loc Main.Meta.MatchupsOverallTip}" />
                            <ItemsControl ItemsSource="{Binding MatchupHeads}" ItemsPanel="{StaticResource ChoiceRow}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:MatchupHead">
                                        <StackPanel Width="50" ToolTip.Tip="{Binding Tip}">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" HorizontalAlignment="Center"
                                                    ClipToBounds="True" i:CardArt.Portrait="{Binding HeroId}" />
                                            <TextBlock Text="{Binding Name}" Classes="caption" FontSize="{StaticResource FontSizeMicro}" TextAlignment="Center" TextWrapping="Wrap"
                                                       Height="28" Margin="1,2,1,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MatchupMatrix}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:MatchupMatrixRow">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <StackPanel Width="190" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" Margin="0,0,8,0"
                                                    ClipToBounds="True" i:CardArt.Portrait="{Binding HeroId}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock Width="62" Text="{Binding WinRate}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource ChoiceRow}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:MatchupCellView">
                                                    <Panel Width="48" Height="32" Margin="1,0" ToolTip.Tip="{Binding Tip}">
                                                        <Border CornerRadius="4" Background="{StaticResource Surface2}" />
                                                        <Border CornerRadius="4" Background="{Binding Edge, Converter={StaticResource SignBrush}}" Opacity="{Binding Heat}" />
                                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}" IsVisible="{Binding MetaLoading}" />
                <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}" IsVisible="{Binding MetaUnavailable}" />
                <ContentControl Classes="emptyState" Tag="&#xF04E5;" Content="{i:Loc Main.Meta.MatchupsEmpty}" IsVisible="{Binding MetaMatchupsEmpty}" />
                <TextBlock Text="{Binding ConstructedMetaStatus}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding MetaStatusShown}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
