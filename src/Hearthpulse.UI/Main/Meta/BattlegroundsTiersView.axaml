<UserControl x:Class="Hearthpulse.UI.Main.Meta.BattlegroundsTiersView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- The Battlegrounds tier tabs from the site's service: heroes, comps, trinkets and cards by tavern tier. Each tab
         is one card with a line "source · slice · date", the column heads and one flat list (a tier's head is a row);
         without rows the card shows one empty state instead. A card is built when its tab is first opened (ShowTab):
         the cards are templates here, not elements. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Meta/MetaResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Heroes: a click on a column head sorts the heroes inside their tiers -->
            <DataTemplate x:Key="HeroesCard" x:DataType="m:MainViewModel">
                <Border Name="HeroTierCard" Classes="card">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding HeroTab.HasRows}">
                            <TextBlock Text="{Binding HeroTab.Source}" Classes="caption bgSource" />
                            <Grid Margin="0,0,0,4" ColumnDefinitions="40,50,*,152,64,Auto,Auto,100">
                                <TextBlock Text="#" Classes="tableHead" />
                                <Button Grid.Column="2" Classes="sortHead" Command="{Binding SetHeroSort}" CommandParameter="Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i:Loc Main.Table.Hero}" Classes="sortLabel" />
                                        <TextBlock Text="{Binding HeroArrows.Name}" Classes="sortArrow" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Classes="sortHead" Command="{Binding SetHeroSort}" CommandParameter="Placement" ToolTip.Tip="{i:Loc Main.Table.AvgPlacementTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i:Loc Main.Table.AvgPlacement}" Classes="sortLabel" />
                                        <TextBlock Text="{Binding HeroArrows.Placement}" Classes="sortArrow" />
                                    </StackPanel>
                                </Button>
                                <!-- "Top 4", or "Top 2" while a Duos list is shown -->
                                <Button Grid.Column="4" Classes="sortHead" HorizontalAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="Top4" ToolTip.Tip="{Binding HeroTopTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HeroTopLabel}" Classes="sortLabel" />
                                        <TextBlock Text="{Binding HeroArrows.Top4}" Classes="sortArrow" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Classes="sortHead metaWide" HorizontalAlignment="Right" Width="56" HorizontalContentAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="First" ToolTip.Tip="{i:Loc Main.Table.FirstTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i:Loc Main.Table.First}" Classes="sortLabel" />
                                        <TextBlock Text="{Binding HeroArrows.First}" Classes="sortArrow" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Classes="sortHead metaWide" HorizontalAlignment="Right" Width="72" HorizontalContentAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="Pick" ToolTip.Tip="{i:Loc Main.Table.PickRateTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i:Loc Main.Table.PickRate}" Classes="sortLabel" />
                                        <TextBlock Text="{Binding HeroArrows.Pick}" Classes="sortArrow" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="7" Text="{i:Loc Main.Table.You}" Classes="tableHead" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Main.Table.YouTip}" />
                            </Grid>
                            <ItemsControl Name="HeroTierList" ItemsSource="{Binding HeroTierRows}" ItemsPanel="{StaticResource PageRows}" ClipToBounds="False" />
                        </StackPanel>
                        <ContentControl Classes="emptyState" Tag="{Binding HeroTab.EmptyGlyph}" Content="{Binding HeroTab.EmptyText}"
                                        IsVisible="{Binding !HeroTab.HasRows}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Comps by tier, or the pool's tribes: rows as high as their texts, so a plain list -->
            <DataTemplate x:Key="CompsCard" x:DataType="m:MainViewModel">
                <Border Name="CompTierCard" Classes="card">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding CompTab.HasRows}">
                            <TextBlock Text="{Binding CompTab.Source}" Classes="caption bgSource" />
                            <ItemsControl Name="CompTierList" ItemsSource="{Binding CompTiers}" ClipToBounds="False" />
                        </StackPanel>
                        <ContentControl Classes="emptyState" Tag="{Binding CompTab.EmptyGlyph}" Content="{Binding CompTab.EmptyText}"
                                        IsVisible="{Binding !CompTab.HasRows}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Trinkets by tier -->
            <DataTemplate x:Key="TrinketsCard" x:DataType="m:MainViewModel">
                <Border Name="TrinketTierCard" Classes="card">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding TrinketTab.HasRows}">
                            <TextBlock Text="{Binding TrinketTab.Source}" Classes="caption bgSource" />
                            <Grid Margin="0,0,0,4" ColumnDefinitions="40,64,*,192,80">
                                <TextBlock Text="#" Classes="tableHead" />
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{i:Loc Main.Table.Trinket}" Classes="tableHead" />
                                <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.AvgPlacement}" Classes="tableHead" ToolTip.Tip="{i:Loc Main.Table.TrinketPlacementTip}" />
                                <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.PickRate}" Classes="tableHead" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Main.Table.TrinketPickTip}" />
                            </Grid>
                            <ItemsControl Name="TrinketTierList" ItemsSource="{Binding TrinketTierRows}" ItemsPanel="{StaticResource PageRows}" ClipToBounds="False" />
                        </StackPanel>
                        <ContentControl Classes="emptyState" Tag="{Binding TrinketTab.EmptyGlyph}" Content="{Binding TrinketTab.EmptyText}"
                                        IsVisible="{Binding !TrinketTab.HasRows}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Cards: the tavern tier picker is always there; under it the minions of the tier, or the tavern spells -->
            <DataTemplate x:Key="CardsCard" x:DataType="m:MainViewModel">
                <Border Name="CardStatsCard" Classes="card">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Classes="segmentBar" Margin="0,0,0,12" ToolTip.Tip="{i:Loc Main.Bg.CardTierTip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="1" GroupName="CardTier" IsChecked="True" Command="{Binding SetCardTier}" CommandParameter="1" />
                                <RadioButton Classes="segment" Content="2" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="2" />
                                <RadioButton Classes="segment" Content="3" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="3" />
                                <RadioButton Classes="segment" Content="4" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="4" />
                                <RadioButton Classes="segment" Content="5" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="5" />
                                <RadioButton Classes="segment" Content="6" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="6" />
                                <RadioButton Classes="segment" Content="7" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="7" />
                                <RadioButton Classes="segment" Content="{i:Loc Main.Bg.Spells}" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="0" />
                            </StackPanel>
                        </Border>
                        <StackPanel IsVisible="{Binding CardTab.HasRows}">
                            <TextBlock Text="{Binding CardTab.Source}" Classes="caption bgSource" />
                            <Grid Margin="0,0,0,4" ColumnDefinitions="40,64,*,Auto,Auto,Auto,Auto">
                                <TextBlock Text="#" Classes="tableHead" />
                                <TextBlock Grid.Column="3" Width="72" TextAlignment="Right" Text="{i:Loc Main.Bg.Impact}" Classes="tableHead bgStat" Classes.on="{Binding CardStatsShown}"
                                           ToolTip.Tip="{i:Loc Main.Bg.ImpactTip}" />
                                <TextBlock Grid.Column="4" Width="96" TextAlignment="Right" Text="{i:Loc Main.Bg.CombatWinRate}" Classes="tableHead bgStat" Classes.on="{Binding CardStatsShown}"
                                           ToolTip.Tip="{i:Loc Main.Bg.CombatWinRateTip}" />
                                <TextBlock Grid.Column="5" Width="112" TextAlignment="Right" Text="{i:Loc Main.Bg.PlacementSplit}" Classes="tableHead bgStat wide" Classes.on="{Binding CardStatsShown}"
                                           ToolTip.Tip="{i:Loc Main.Bg.PlacementSplitTip}" />
                                <TextBlock Grid.Column="6" Width="96" TextAlignment="Right" Text="{i:Loc Main.Table.Popularity}" Classes="tableHead metaWide" />
                            </Grid>
                            <ItemsControl Name="CardTierList" ItemsSource="{Binding CardTierRows}" ItemsPanel="{StaticResource PageRows}" ClipToBounds="False" />
                        </StackPanel>
                        <ContentControl Classes="emptyState" Tag="{Binding CardTab.EmptyGlyph}" Content="{Binding CardTab.EmptyText}"
                                        IsVisible="{Binding !CardTab.HasRows}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Meta/MetaStyles.axaml" />
        <!-- A data row as one plate with the geometry of Border.tierRow (46 high, 48 with the gap, 8 out of the content on
             each side, so the columns stay under the heads). Not a button: the rows take no click and no focus. -->
        <Style Selector="Border.bgRow">
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="-8,0,-8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bgRow:pointerover">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <!-- A comp: the same plate, as high as its texts -->
        <Style Selector="Border.bgRow.comp">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <!-- The card list's stat columns: there only when the list has numbers (the class "on", from the view model: a
             style, so that compact can still drop the widest of them, which a binding on IsVisible would not allow) -->
        <Style Selector="TextBlock.bgStat">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.bgStat.on">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="m|MainView.compact TextBlock.bgStat.wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The line above a list: source, slice and date of the shown rows, or the slice being loaded -->
        <Style Selector="TextBlock.bgSource">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Styles>
    <!-- The rows of the lists, picked by the row's type -->
    <UserControl.DataTemplates>
        <!-- A tier's head as a row of the list, of the same height as a data row -->
        <DataTemplate x:DataType="m:TierHeadRow">
            <Border Classes="tierRow" BorderBrush="{Binding Tier, Converter={StaticResource KeyBrush}}">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Classes="tierLetter" Background="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" FontFamily="{DynamicResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Caption}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One hero, 11 visuals: rank, portrait, name, average place as a number and a bar, the top share, first
             places, pick rate, the player's own games. Compact drops first places and pick rate (metaWide). -->
        <DataTemplate x:DataType="m:MetaHeroRow">
            <Border Classes="bgRow">
                <Grid ColumnDefinitions="40,50,*,152,64,Auto,Auto,100">
                    <TextBlock Text="{Binding Rank}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                            ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Text="{Binding AveragePlace}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" />
                    <Border Grid.Column="3" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="44,0,0,0"
                            Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                            Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=100}" />
                    <TextBlock Grid.Column="4" Text="{Binding Top}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Width="56" TextAlignment="Right" Text="{Binding FirstPlace}" Classes="metaWide" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Width="72" TextAlignment="Right" Text="{Binding PickRate}" Classes="caption metaWide" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding Personal}" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One trinket, 9 visuals: rank, art, name over its size and cost, average place as a number and a bar, pick rate -->
        <DataTemplate x:DataType="m:MetaTrinketRow">
            <Border Classes="bgRow">
                <Grid ColumnDefinitions="40,64,*,192,80">
                    <TextBlock Text="{Binding Rank}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <!-- The square portrait crop as the frame's own fill: it covers the frame, centred; a card without art keeps the plain surface -->
                    <Border Grid.Column="1" Width="54" Height="38" CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                            ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Bottom" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Placement}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" />
                    <Border Grid.Column="3" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="44,0,0,0"
                            Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                            Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=140}" />
                    <TextBlock Grid.Column="4" Text="{Binding PickRate}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One minion or tavern spell, 10 visuals: rank, art, name over its tribes and games, impact with its sign's
             colour, combat win rate, placement with and without the card, popularity. The three stat columns are there
             only when the list has numbers (ShowsStats, the same on every row). Compact drops the last two columns. -->
        <DataTemplate x:DataType="m:MetaCardRow">
            <Border Classes="bgRow">
                <Grid ColumnDefinitions="40,64,*,Auto,Auto,Auto,Auto">
                    <TextBlock Text="{Binding Rank}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <!-- The square portrait crop as the frame's own fill: it covers the frame, centred; a card without art keeps the plain surface -->
                    <Border Grid.Column="1" Width="54" Height="38" CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                            ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Bottom" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Width="72" TextAlignment="Right" Text="{Binding Impact}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding ImpactSign, Converter={StaticResource SignBrush}}"
                               Classes="bgStat" Classes.on="{Binding ShowsStats}" />
                    <TextBlock Grid.Column="4" Width="96" TextAlignment="Right" Text="{Binding CombatWinRate}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                               Classes="bgStat" Classes.on="{Binding ShowsStats}" />
                    <TextBlock Grid.Column="5" Width="112" TextAlignment="Right" Text="{Binding PlacementSplit}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                               Classes="bgStat wide" Classes.on="{Binding ShowsStats}" />
                    <TextBlock Grid.Column="6" Width="96" TextAlignment="Right" Text="{Binding Popularity}" Classes="caption metaWide" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One comp (or one tribe of the stand-in list), 6 visuals: name, the line on its right, core cards, tip -->
        <DataTemplate x:DataType="m:MetaCompRow">
            <Border Classes="bgRow comp">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Side}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Core}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                               IsVisible="{Binding Core, Converter={StaticResource Truthy}}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Tip}" FontSize="{StaticResource FontSizeLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                               IsVisible="{Binding Tip, Converter={StaticResource Truthy}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <!-- The cards of the tabs opened so far; one is shown at a time -->
    <Panel Name="Cards" />
</UserControl>
