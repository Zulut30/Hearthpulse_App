<UserControl x:Class="Hearthpulse.UI.Main.Stats.BattlegroundsStatsView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Battlegrounds "My stats": header numbers, rating over time with a hover card, hero performance -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsStyles.axaml" />
    </UserControl.Styles>
    <StackPanel>
        <Grid Classes="statsHead" Margin="0,0,0,14" RowDefinitions="Auto,Auto">
            <c:Ornament Text="{i:Loc Stats.Title}" Icon="&#xF0128;" Size="15" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Classes="segmentBar statsFilter statsBar" ToolTip.Tip="{i:Loc Stats.Period.Tip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.All}" GroupName="BgPeriod" IsChecked="True" Command="{Binding SetBgPeriod}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Week}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Week" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Month}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Month" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.ThisMonth}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Season"
                                 ToolTip.Tip="{i:Loc Stats.Period.ThisMonthBgTip}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Highest MMR, average placement, games, time played; the combat simulator's accuracy -->
        <ItemsControl ItemsSource="{Binding BgStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsKpiPanel}" Margin="0,0,-12,4" />
        <TextBlock Text="{Binding BgSimAccuracy}" ToolTip.Tip="{i:Loc Stats.Bg.SimAccuracyTip}" Classes="caption" FontSize="11.5" Margin="2,0,0,14"
                   TextWrapping="Wrap" IsVisible="{Binding BgSimAccuracy, Converter={StaticResource Truthy}}" />

        <!-- Rating over time beside where you finish -->
        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Stats.Bg.RatingTitle}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                    </Grid>
                    <!-- No games in the period: one line instead of a tall empty chart, so the tier lists stay in view -->
                    <ContentControl DockPanel.Dock="Top" Classes="emptyState" Tag="&#xF012A;" Content="{i:Loc Stats.Bg.RatingEmpty}"
                                    IsVisible="{Binding BgRatingChart, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    <c:StatsLineChart x:Name="RatingChart" Height="250" Points="{Binding BgRatingChart}" HoverTemplate="{StaticResource BgHoverCard}"
                                      EmptyText="{i:Loc Stats.Bg.RatingEmpty}" IsVisible="{Binding BgRatingChart, Converter={StaticResource Truthy}}" />
                </DockPanel>
            </Border>
            <Border Classes="card statsRight">
                <StackPanel ToolTip.Tip="{i:Loc Stats.Bg.PlacementsTip}">
                    <c:Ornament Text="{i:Loc Stats.Bg.PlacesTitle}" Icon="&#xF0128;" Size="13" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding BgPlaces}" ItemTemplate="{StaticResource BgPlaceRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF0128;" Content="{i:Loc Stats.Bg.PlacesEmpty}"
                                    IsVisible="{Binding BgPlaces, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Stats.Bg.HeroPerf}" Icon="&#xF01A5;" Size="13" HorizontalAlignment="Left" />
                <Grid Margin="0,10,0,14">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{i:Loc Stats.Bg.MinGames}" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Classes="segmentBar statsBar" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="1" GroupName="BgMin" IsChecked="True" Command="{Binding SetBgMinGames}" CommandParameter="1" />
                                <RadioButton Classes="segment" Content="3" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="3" />
                                <RadioButton Classes="segment" Content="5" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="5" />
                                <RadioButton Classes="segment" Content="10" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="10" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{i:Loc Stats.Bg.SortBy}" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Classes="segmentBar statsBar">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="{i:Loc Stats.Bg.SortGames}" GroupName="BgSort" IsChecked="True" Command="{Binding SetBgSort}" CommandParameter="Games" />
                                <RadioButton Classes="segment" Content="{i:Loc Stats.Bg.SortAvgPlace}" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="AveragePlacement" />
                                <RadioButton Classes="segment" Content="{i:Loc Stats.Bg.NetMmr}" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="NetRating" />
                                <RadioButton Classes="segment" Content="{i:Loc Stats.Bg.PickRate}" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="PickRate" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>

                <!-- Column heads only over rows: an empty period shows the one line below instead -->
                <Panel IsVisible="{Binding BgHeroPerf, Converter={StaticResource Truthy}}">
                <Grid Classes="wide" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{i:Loc Stats.Bg.Hero}" Classes="label" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{i:Loc Stats.Bg.NetMmr}" Classes="label" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Stats.Bg.NetMmrTip}" />
                    <StackPanel Grid.Column="3" Margin="16,0,0,0" ToolTip.Tip="{i:Loc Stats.Bg.CombatTip}">
                        <TextBlock Text="{i:Loc Stats.Bg.CombatWinrate}" Classes="label" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" FontSize="11">
                            <Run Text="{i:Loc Stats.You}" Foreground="{StaticResource Accent}" /><Run Text="{i:Loc Stats.VsSeparator}" /><Run Text="{i:Loc Stats.Global}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="16,0,0,0" ToolTip.Tip="{i:Loc Stats.Bg.PlacementDistributionTip}">
                        <TextBlock Text="{i:Loc Stats.Bg.PlacementDistribution}" Classes="label" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" FontSize="11">
                            <Run Text="{i:Loc Stats.You}" Foreground="{StaticResource Accent}" /><Run Text="{i:Loc Stats.VsSeparator}" /><Run Text="{i:Loc Stats.Global}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="5" Text="{i:Loc Stats.Bg.AvgPlacement}" Classes="label" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="{i:Loc Stats.Bg.PickRate}" Classes="label" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"
                               ToolTip.Tip="{i:Loc Stats.Bg.PickRateTip}" />
                </Grid>
                </Panel>
                <ItemsControl Classes="wide" ItemsSource="{Binding BgHeroPerf}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:BgHeroPerfRow">
                            <Border Classes="row" Padding="10,7" Margin="-10,0,-10,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" MinWidth="100" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Surface4}" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding CardId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Games}" Classes="caption" FontSize="11.5" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Net}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                               Foreground="{Binding NetValue, Converter={StaticResource SignBrush}}" />
                                    <c:Sparkline Grid.Column="3" Height="32" Margin="16,0,0,0" Values="{Binding CombatYou}" Compare="{Binding CombatGlobal}" />
                                    <c:MiniBars Grid.Column="4" Height="32" Margin="16,0,0,0" Values="{Binding PlacesYou}" Compare="{Binding PlacesGlobal}" />
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Width="56" Height="6" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding AverageFraction, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                                            </Border>
                                            <TextBlock Text="{Binding AveragePlace}" FontWeight="Bold" FontSize="14" />
                                        </StackPanel>
                                        <ContentControl Content="{Binding AverageVs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Width="48" Height="6" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding PickFraction, Converter={StaticResource Fraction}, ConverterParameter=48}" />
                                            </Border>
                                            <TextBlock Text="{Binding PickRate}" FontWeight="Bold" FontSize="14" />
                                        </StackPanel>
                                        <ContentControl Content="{Binding PickVs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Narrow windows: hero, games and net MMR, average placement -->
                <ItemsControl Classes="narrow" ItemsSource="{Binding BgHeroPerf}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:BgHeroPerfRow">
                            <Border Classes="row" Padding="10,7" Margin="-10,0,-10,2">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,10,0" Background="{StaticResource Surface4}" ClipToBounds="True"
                                            VerticalAlignment="Center" i:CardArt.Portrait="{Binding CardId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Games, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Net, Mode=OneWay}"
                                                Foreground="{Binding NetValue, Converter={StaticResource SignBrush}}" /><Run Text=" MMR" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AveragePlace}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                                        <ContentControl Content="{Binding AverageVs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Classes="emptyState" Tag="&#xF01A5;" Content="{i:Loc Stats.Bg.NoHeroes}"
                                IsVisible="{Binding BgHeroPerf, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                <TextBlock Text="{Binding BgStatsNote}" Classes="caption" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,10,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding BgHeroPerf, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
