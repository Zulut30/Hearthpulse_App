<UserControl x:Class="Hearthpulse.UI.Main.Stats.BrawlView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Tavern Brawl page (docs/brawl.md): this week's class win rates by everyone's games on the left, the player's
         classes in the Brawl played last on the right (under it in compact) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <i:LocalImage x:Key="LocalImage" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,0,0,24" RowDefinitions="Auto,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Classes="card statsLeft" VerticalAlignment="Top">
            <StackPanel>
                <c:Ornament Text="{i:Loc Brawl.Classes}" Icon="&#xF0127;" Size="13" Margin="0,0,0,8" />
                <TextBlock Text="{Binding BrawlClassesNote}" Classes="caption cardNote" />
                <ContentControl Content="{i:Loc Stats.Table.Class}" Tag="{Binding BrawlClassesSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}"
                                IsVisible="{Binding BrawlClasses, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding BrawlClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Arena.Page.CommunityLoading}" IsVisible="{Binding BrawlClassesLoading}" />
                <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Arena.Page.CommunityEmpty}" IsVisible="{Binding BrawlClassesUnavailable}" />
                <ContentControl Classes="emptyState" Tag="&#xF0127;" Content="{i:Loc Brawl.Classes.None}" IsVisible="{Binding BrawlClassesNone}" />
                <TextBlock Text="{Binding BrawlUnclassed}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,8,0,0"
                           IsVisible="{Binding BrawlUnclassed, Converter={StaticResource Truthy}}" />
                <TextBlock Text="{Binding BrawlSource}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding BrawlSource, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>
        <StackPanel Classes="statsRight" VerticalAlignment="Top">
            <!-- The week's article of hs-manacost.ru (the owner's site, docs/brawl.md): shown while one is current -->
            <Border Classes="card" Margin="0,0,0,16" IsVisible="{Binding BrawlArticleShown}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Brawl.Article.Title}" Icon="&#xF0219;" Size="13" Margin="0,0,0,8" />
                    <Border CornerRadius="8" ClipToBounds="True" Height="150" Margin="0,0,0,8" Background="{StaticResource Surface3}" IsVisible="{Binding BrawlArticleHasCover}">
                        <Image Source="{Binding BrawlArticleCover, Converter={StaticResource LocalImage}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding BrawlArticleTitle}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BrawlArticleMeta}" Classes="caption" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding BrawlArticleExcerpt}" Classes="caption" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                               Margin="0,4,0,0" IsVisible="{Binding BrawlArticleHasExcerpt}" />
                    <TextBlock Text="{i:Loc Brawl.Article.InRussian}" Classes="caption" FontStyle="Italic" Margin="0,4,0,0" IsVisible="{Binding BrawlArticleInRussianNote}" />
                    <Button Classes="ghost primary" Content="{i:Loc Brawl.Article.Read}" Command="{Binding OpenBrawlArticle}" ToolTip.Tip="{i:Loc Brawl.Article.ReadTip}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Button Classes="ghost" Command="{Binding OpenBrawlDecks}" ToolTip.Tip="{i:Loc Brawl.Article.ReadTip}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsVisible="{Binding BrawlDecksShown}">
                        <TextBlock Text="{Binding BrawlDecksTitle}" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </Border>
            <Border Classes="card">
            <StackPanel>
                <c:Ornament Text="{i:Loc Brawl.Mine}" Icon="&#xF0004;" Size="13" Margin="0,0,0,8" />
                <TextBlock Text="{Binding BrawlMineNote}" Classes="caption cardNote" IsVisible="{Binding BrawlMineNote, Converter={StaticResource Truthy}}" />
                <ContentControl Content="{i:Loc Stats.Table.Class}" Tag="{Binding BrawlMineSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}"
                                IsVisible="{Binding BrawlMine, Converter={StaticResource Truthy}}" />
                <ItemsControl ItemsSource="{Binding BrawlMine}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                <ContentControl Classes="emptyState" Tag="&#xF1116;" Content="{i:Loc Brawl.Mine.Empty}" IsVisible="{Binding BrawlMineEmpty}" />
                <TextBlock Text="{i:Loc Brawl.Mine.EmptyOld}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding BrawlMineOld}" />
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>
