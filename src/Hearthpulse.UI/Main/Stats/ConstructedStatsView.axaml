<UserControl x:Class="Hearthpulse.UI.Main.Stats.ConstructedStatsView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls">
    <!-- Constructed "My stats" per format: header numbers, rank over time, classes, matchups, archetypes, game length -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Grid Classes="statsHead" Margin="0,0,0,14" RowDefinitions="Auto,Auto">
            <Border HorizontalAlignment="Left" Classes="segmentBar" ToolTip.Tip="Ranked and Casual games of this format">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="Standard" GroupName="CtFormat" IsChecked="True" Command="{Binding SetCtFormat}" CommandParameter="FT_STANDARD" />
                    <RadioButton Classes="segment" Content="Wild" GroupName="CtFormat" Command="{Binding SetCtFormat}" CommandParameter="FT_WILD" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Right" Classes="segmentBar statsFilter statsBar" ToolTip.Tip="Time frame">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="All time" GroupName="CtPeriod" IsChecked="True" Command="{Binding SetCtPeriod}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="7 days" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Week" />
                    <RadioButton Classes="segment" Content="30 days" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Month" />
                    <RadioButton Classes="segment" Content="Season" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Season"
                                 ToolTip.Tip="This month's ranked season" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding CtStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,0,-14">
                            </ItemsControl>
        </Border>

        <Border Classes="card" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <c:Ornament Text="Rank over time" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                    <TextBlock Text="Rank at the start of each ranked game" Classes="caption wide" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <c:StatsLineChart x:Name="RankChart" Height="210" Points="{Binding CtRankChart}" HoverTemplate="{StaticResource CtHoverCard}"
                                  EmptyText="Play a few ranked games of this format to see your rank climb." />
            </DockPanel>
        </Border>

        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Your classes" Icon="&#xF0004;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No games in this time frame yet." Classes="caption" IsVisible="{Binding CtClasses, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Classes="card statsRight" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Opponent classes" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No matchups yet." Classes="caption" IsVisible="{Binding CtOpponents, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,24" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Archetypes" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtArchetypes}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="Archetypes need the Constructed community meta, which only the Windows app loads." Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding CtArchetypes, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Classes="card statsRight" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Game length" Icon="&#xF02DA;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtLengths}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No games in this time frame yet." Classes="caption" IsVisible="{Binding CtLengths, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding CtStatsNote}" Classes="caption" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,-12,0,20" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
