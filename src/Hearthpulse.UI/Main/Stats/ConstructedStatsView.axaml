<UserControl x:Class="Hearthpulse.UI.Main.Stats.ConstructedStatsView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Constructed "My stats" per format: header numbers, rank over time, classes, matchups, archetypes, game length -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsStyles.axaml" />
    </UserControl.Styles>
    <StackPanel>
        <Grid Classes="statsHead" Margin="0,0,0,14" RowDefinitions="Auto,Auto">
            <Border HorizontalAlignment="Right" Classes="segmentBar statsFilter statsBar" ToolTip.Tip="{i:Loc Stats.Period.Tip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.All}" GroupName="CtPeriod" IsChecked="True" Command="{Binding SetCtPeriod}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Week}" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Week" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Month}" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Month" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Season}" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Season"
                                 ToolTip.Tip="{i:Loc Stats.Period.SeasonTip}" />
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl ItemsSource="{Binding CtStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,-12,4" />

        <Border Classes="card" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <c:Ornament Text="{i:Loc Stats.Ct.RankTitle}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" ToolTip.Tip="{i:Loc Stats.Ct.RankHint}" />
                </Grid>
                <c:StatsLineChart x:Name="RankChart" Height="210" Points="{Binding CtRankChart}" HoverTemplate="{StaticResource CtHoverCard}"
                                  EmptyText="{i:Loc Stats.Ct.RankEmpty}" />
            </DockPanel>
        </Border>

        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Stats.Ct.YourClasses}" Icon="&#xF0004;" Size="13" Margin="0,0,0,10" />
                    <ContentControl Content="{i:Loc Stats.Table.Class}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding CtClasses, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding CtClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF0004;" Content="{i:Loc Stats.Chart.NoGames}"
                                    IsVisible="{Binding CtClasses, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Classes="card statsRight" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Stats.OpponentClasses}" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10" />
                    <ContentControl Content="{i:Loc Stats.Table.Opponent}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding CtOpponents, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding CtOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF04E5;" Content="{i:Loc Stats.NoMatchups}"
                                    IsVisible="{Binding CtOpponents, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,24" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Stats.Ct.Archetypes}" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                    <ContentControl Content="{i:Loc Stats.Table.Archetype}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding CtArchetypes, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding CtArchetypes}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF0639;" Content="{i:Loc Stats.Ct.ArchetypesWindowsOnly}"
                                    IsVisible="{Binding CtArchetypes, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Classes="card statsRight" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Stats.Ct.GameLength}" Icon="&#xF02DA;" Size="13" Margin="0,0,0,10" />
                    <ContentControl Content="{i:Loc Stats.Table.Length}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding CtLengths, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding CtLengths}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF0128;" Content="{i:Loc Stats.Chart.NoGames}"
                                    IsVisible="{Binding CtLengths, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding CtStatsNote}" Classes="caption" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,-12,0,20" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
