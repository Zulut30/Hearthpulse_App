<UserControl x:Class="Hearthpulse.UI.Main.Stats.ArenaStatsView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Arena "My stats": header numbers, runs (with their deck score), classes and opponent classes, then the latest run's
         deck score and the community class win rates (docs/arena-draft.md) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A card of the deck score: name and ArenaSmith score in its tier colour -->
            <DataTemplate x:Key="ArenaCardLineTemplate" x:DataType="m:ArenaCardLine">
                <Grid Margin="0,0,0,5" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" Margin="8,0,0,0"
                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsStyles.axaml" />
    </UserControl.Styles>
    <StackPanel>
        <Grid Classes="statsHead" Margin="0,0,0,14" RowDefinitions="Auto,Auto">
            <c:Ornament Text="{i:Loc Stats.Title}" Icon="&#xF0128;" Size="15" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Classes="segmentBar statsFilter statsBar" ToolTip.Tip="{i:Loc Stats.Period.Tip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.All}" GroupName="ArenaPeriod" IsChecked="True" Command="{Binding SetArenaPeriod}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Week}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Week" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Month}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Month" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Season}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Season"
                                 ToolTip.Tip="{i:Loc Stats.Period.SinceFirstTip}" />
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl ItemsSource="{Binding ArenaStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsKpiPanel}" Margin="0,0,-12,4" />

        <Grid Margin="0,0,0,24" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Stats.Arena.Runs}" Icon="&#xF0538;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ArenaRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:ArenaRunRow">
                                <Border Classes="row" Padding="10,7" Margin="-10,0,-10,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Margin="0,0,12,0" CornerRadius="18" Background="{StaticResource Surface4}" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding HeroCardId}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" />
                                            <TextBlock Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DeckScore}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding DeckTier, Converter={StaticResource KeyBrush}}"
                                                       IsVisible="{Binding DeckScore, Converter={StaticResource Truthy}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Stats.Arena.RecordTip}">
                                            <Border Classes="wide" Width="90" Height="7" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=90}" />
                                            </Border>
                                            <TextBlock Text="{Binding Record}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="16" MinWidth="44" TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Classes="emptyState" Tag="&#xF0538;" Content="{i:Loc Stats.Arena.RunsEmpty}"
                                    IsVisible="{Binding ArenaRuns, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <StackPanel Classes="statsRight">
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.Arena.Classes}" Icon="&#xF0004;" Size="13" Margin="0,0,0,10" />
                        <ContentControl Content="{i:Loc Stats.Table.Class}" Tag="{Binding ArenaClassesSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaClasses, Converter={StaticResource Truthy}}" />
                        <ItemsControl ItemsSource="{Binding ArenaClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Classes="emptyState" Tag="&#xF0004;" Content="{i:Loc Stats.Arena.NoRuns}"
                                        IsVisible="{Binding ArenaClasses, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.OpponentClasses}" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10" />
                        <ContentControl Content="{i:Loc Stats.Table.Opponent}" Tag="{Binding ArenaOpponentsSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaOpponents, Converter={StaticResource Truthy}}" />
                        <ItemsControl ItemsSource="{Binding ArenaOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Classes="emptyState" Tag="&#xF04E5;" Content="{i:Loc Stats.NoMatchups}"
                                        IsVisible="{Binding ArenaOpponents, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Latest run's deck score and the community class win rates -->
        <Grid Margin="0,0,0,24" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="card statsLeft" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Arena.Page.DeckTitle}" Icon="&#xF0D8F;" Size="13" Margin="0,0,0,10" />
                    <StackPanel IsVisible="{Binding HasArenaDeck}">
                        <TextBlock Text="{Binding ArenaDeckTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Panel Width="46" Height="46" VerticalAlignment="Center">
                                    <c:Scallop Fill="{Binding ArenaDeckTier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                                    <TextBlock Text="{Binding ArenaDeckTier}" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ArenaDeckAverage}" Classes="stat" Foreground="{Binding ArenaDeckTier, Converter={StaticResource KeyBrush}}" />
                                    <TextBlock Text="{Binding ArenaDeckNote}" Classes="caption" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ArenaDeckCurve}" Margin="0,12,0,0" MaxWidth="280" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Classes="fixed" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:ArenaCurveColumn">
                                        <StackPanel Margin="3,0" VerticalAlignment="Bottom" ToolTip.Tip="{Binding Count}">
                                            <TextBlock Text="{Binding Count}" Classes="caption" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Panel Height="46">
                                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,1,1" Background="{StaticResource Accent}" />
                                            </Panel>
                                            <Border Height="1" Background="{StaticResource Outline}" Margin="-3,0" />
                                            <TextBlock Text="{Binding Label}" Classes="caption" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                            <StackPanel>
                                <TextBlock Text="{i:Loc Arena.Page.Best}" Classes="label" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ArenaDeckBest}" ItemTemplate="{StaticResource ArenaCardLineTemplate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{i:Loc Arena.Page.Weakest}" Classes="label" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ArenaDeckWeakest}" ItemTemplate="{StaticResource ArenaCardLineTemplate}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{i:Loc Arena.Page.DeckEmpty}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasArenaDeck}" />
                </StackPanel>
            </Border>
            <Border Classes="card statsRight" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Arena.Page.Community}" Icon="&#xF0127;" Size="13" Margin="0,0,0,10" />
                    <ContentControl Content="{i:Loc Stats.Table.Class}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaCommunity, Converter={StaticResource Truthy}}" />
                    <ItemsControl ItemsSource="{Binding ArenaCommunity}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Arena.Page.CommunityLoading}" IsVisible="{Binding ArenaCommunityLoading}" />
                    <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Arena.Page.CommunityEmpty}" IsVisible="{Binding ArenaCommunityUnavailable}" />
                    <TextBlock Text="{Binding ArenaCommunitySource}" Classes="caption" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
