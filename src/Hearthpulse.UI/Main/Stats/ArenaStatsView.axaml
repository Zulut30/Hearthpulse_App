<UserControl x:Class="Hearthpulse.UI.Main.Stats.ArenaStatsView"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Arena "My stats": header numbers, runs (with their deck score), classes and opponent classes, then the latest run's
         deck score and the community class win rates (docs/arena-draft.md) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The rewards editor of a run: five whole numbers, Enter saves, Esc cancels (docs/arena-rewards.md) -->
            <DataTemplate x:Key="ArenaRewardsEditor" x:DataType="m:ArenaRewardsEdit">
                <StackPanel Margin="0,8,0,0" AutomationProperties.Name="{Binding Name}">
                    <StackPanel.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
                    </StackPanel.KeyBindings>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,8" ToolTip.Tip="{i:Loc Stats.Arena.Rewards.FieldTip}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xF0B38;" Classes="icon" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{i:Loc Stats.Arena.Rewards.Gold}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox Text="{Binding Gold}" Padding="4,4" TextAlignment="Right" MaxLength="5" PlaceholderText="0"
                                     AutomationProperties.Name="{i:Loc Stats.Arena.Rewards.Gold}" Loaded="FocusOnLoad">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Save}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8" ToolTip.Tip="{i:Loc Stats.Arena.Rewards.DustTip}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xF01C8;" Classes="icon" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{i:Loc Stats.Arena.Rewards.Dust}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox Text="{Binding Dust}" Padding="4,4" TextAlignment="Right" MaxLength="5" PlaceholderText="0"
                                     AutomationProperties.Name="{i:Loc Stats.Arena.Rewards.Dust}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Save}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8" ToolTip.Tip="{i:Loc Stats.Arena.Rewards.PacksTip}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xF03D7;" Classes="icon" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{i:Loc Stats.Arena.Rewards.Packs}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox Text="{Binding Packs}" Padding="4,4" TextAlignment="Right" MaxLength="5" PlaceholderText="0"
                                     AutomationProperties.Name="{i:Loc Stats.Arena.Rewards.Packs}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Save}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8" ToolTip.Tip="{i:Loc Stats.Arena.Rewards.TicketsTip}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xF0516;" Classes="icon" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{i:Loc Stats.Arena.Rewards.Tickets}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox Text="{Binding Tickets}" Padding="4,4" TextAlignment="Right" MaxLength="5" PlaceholderText="0"
                                     AutomationProperties.Name="{i:Loc Stats.Arena.Rewards.Tickets}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Save}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8" ToolTip.Tip="{i:Loc Stats.Arena.Rewards.CardsTip}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xF06C7;" Classes="icon" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{i:Loc Stats.Arena.Rewards.Cards}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox Text="{Binding Cards}" Padding="4,4" TextAlignment="Right" MaxLength="5" PlaceholderText="0"
                                     AutomationProperties.Name="{i:Loc Stats.Arena.Rewards.Cards}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Save}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding Error}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Negative}" TextWrapping="Wrap" Margin="0,0,0,4"
                               IsVisible="{Binding Error, Converter={StaticResource Truthy}}" />
                    <DockPanel Margin="0,4,0,2">
                        <Button DockPanel.Dock="Right" Classes="ghost" Content="{i:Loc Stats.Arena.Rewards.Clear}" Command="{Binding Clear}" Padding="8,4"
                                ToolTip.Tip="{i:Loc Stats.Arena.Rewards.ClearTip}" IsVisible="{Binding CanClear}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="ghost primary" Content="{i:Loc Stats.Arena.Rewards.Save}" Command="{Binding Save}" IsEnabled="{Binding CanSave}" Padding="12,4" />
                            <Button Classes="ghost" Content="{i:Loc Stats.Arena.Rewards.Cancel}" Command="{Binding Cancel}" Padding="8,4" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </DataTemplate>
            <!-- A card of the deck score: name and ArenaSmith score in its tier colour -->
            <DataTemplate x:Key="ArenaCardLineTemplate" x:DataType="m:ArenaCardLine">
                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" Margin="8,0,0,0"
                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsStyles.axaml" />
        <!-- The rewards chip of a run (a copy of the deck page's diffChip) -->
        <Style Selector="Border.rewardsChip">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2,4,2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Border.rewardsChip TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Button.rewardsToggle:pointerover Border.rewardsChip">
            <Setter Property="Background" Value="{StaticResource Outline}" />
        </Style>
        <Style Selector="Button.rewardsToggle:pointerover Border.rewardsChip TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- The row being edited keeps the Row fill (no hover change) -->
        <Style Selector="Border.row.editing, Border.row.editing:pointerover">
            <Setter Property="Background" Value="{StaticResource Row}" />
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <!-- The two Arenas apart (owner, 2026-11-07): everything below follows the tab -->
        <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{i:Loc Arena.Page.Tabs}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="ArenaTabRegular" Classes="segment" GroupName="ArenaKind" Content="{i:Loc Arena.Page.TabArena}" IsChecked="{Binding ArenaTabRegular}"
                             ToolTip.Tip="{i:Loc Arena.Page.TabArenaTip}" AutomationProperties.Name="{i:Loc Arena.Page.TabArena}" />
                <RadioButton Name="ArenaTabUnderground" Classes="segment" GroupName="ArenaKind" Content="{i:Loc Arena.Page.TabUnderground}" IsChecked="{Binding ArenaTabUnderground}"
                             ToolTip.Tip="{i:Loc Arena.Page.TabUndergroundTip}" AutomationProperties.Name="{i:Loc Arena.Page.TabUnderground}" />
            </StackPanel>
        </Border>
        <Grid Classes="statsHead" Margin="0,0,0,12" RowDefinitions="Auto,Auto">
            <c:Ornament Text="{i:Loc Stats.Title}" Icon="&#xF0128;" Size="15" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Classes="segmentBar statsFilter statsBar" ToolTip.Tip="{i:Loc Stats.Period.Tip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.All}" GroupName="ArenaPeriod" IsChecked="True" Command="{Binding SetArenaPeriod}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Week}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Week" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Month}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Month" />
                    <RadioButton Classes="segment" Content="{i:Loc Stats.Period.Season}" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Season"
                                 ToolTip.Tip="{i:Loc Stats.Period.SinceFirstTip}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Four headline numbers; time played and the rewards' total wait under «Подробнее» -->
        <ItemsControl ItemsSource="{Binding ArenaStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsKpiPanel}" Margin="0,0,-12,4" />

        <!-- The runs (and «Подробнее» under them) beside the latest run's deck score and the community class win rates -->
        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="statsLeft">
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.Arena.Runs}" Icon="&#xF0538;" Size="13" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ArenaRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:ArenaRunRow">
                                    <Border Classes="row" Classes.editing="{Binding Editing}" Padding="8,8" Margin="-8,0,-8,2">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Margin="0,0,12,0" CornerRadius="18" Background="{StaticResource Surface4}" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding HeroCardId}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" />
                                                <TextBlock Classes="caption" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding DeckScore}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{Binding DeckTier, Converter={StaticResource KeyBrush}}"
                                                           IsVisible="{Binding DeckScore, Converter={StaticResource Truthy}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Stats.Arena.RecordTip}">
                                                <Border Classes="wide" Width="90" Height="7" CornerRadius="2" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}"
                                                            Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=90}" />
                                                </Border>
                                                <TextBlock Text="{Binding Record}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" MinWidth="44" TextAlignment="Right" />
                                            </StackPanel>
                                            <!-- The run's rewards (entered by the player), or "+ Add rewards"; hidden while its editor is open -->
                                            <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Classes="bare rewardsToggle" HorizontalAlignment="Left"
                                                    Command="{Binding EditRewards}" CommandParameter="{Binding Key}" ToolTip.Tip="{Binding RewardsTip}" Loaded="ChipLoaded"
                                                    AutomationProperties.Name="{Binding RewardsTip}" IsVisible="{Binding !Editing}">
                                                <Border Classes="rewardsChip">
                                                    <WrapPanel>
                                                        <ItemsControl ItemsSource="{Binding RewardParts}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:ArenaRewardPart">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Glyph}" Classes="icon" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Amount}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Margin="2,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="&#xF03EB;" Classes="icon" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" IsVisible="{Binding HasRewards}" />
                                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding !HasRewards}">
                                                            <TextBlock Text="&#xF0415;" Classes="icon" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBlock Text="{i:Loc Stats.Arena.Rewards.Add}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>
                                            </Button>
                                            <ContentControl Grid.Row="2" Grid.ColumnSpan="3" Content="{Binding Edit}" ContentTemplate="{StaticResource ArenaRewardsEditor}"
                                                            IsVisible="{Binding Editing}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl Classes="emptyState" Tag="&#xF0538;" Content="{i:Loc Stats.Arena.RunsEmpty}"
                                        IsVisible="{Binding ArenaRuns, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
                <!-- The rest, closed until asked for: time played, rewards, your classes and the opponents' -->
                <ToggleButton Name="ArenaMore" Classes="more" />
                <StackPanel IsVisible="{Binding #ArenaMore.IsChecked}">
                    <ItemsControl ItemsSource="{Binding ArenaMoreTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsKpiPanel}" Margin="0,0,-12,4" />
                    <Border Classes="card" Margin="0,0,0,16">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Stats.Arena.Classes}" Icon="&#xF0004;" Size="13" Margin="0,0,0,8" />
                            <ContentControl Content="{i:Loc Stats.Table.Class}" Tag="{Binding ArenaClassesSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaClasses, Converter={StaticResource Truthy}}" />
                            <ItemsControl ItemsSource="{Binding ArenaClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                            <ContentControl Classes="emptyState" Tag="&#xF0004;" Content="{i:Loc Stats.Arena.NoRuns}"
                                            IsVisible="{Binding ArenaClasses, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Stats.OpponentClasses}" Icon="&#xF04E5;" Size="13" Margin="0,0,0,8" />
                            <ContentControl Content="{i:Loc Stats.Table.Opponent}" Tag="{Binding ArenaOpponentsSort}" c:StickyHeader.IsEnabled="True" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaOpponents, Converter={StaticResource Truthy}}" />
                            <ItemsControl ItemsSource="{Binding ArenaOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                            <ContentControl Classes="emptyState" Tag="&#xF04E5;" Content="{i:Loc Stats.NoMatchups}"
                                            IsVisible="{Binding ArenaOpponents, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Classes="statsRight">
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Arena.Page.DeckTitle}" Icon="&#xF0D8F;" Size="13" Margin="0,0,0,8" />
                        <StackPanel IsVisible="{Binding HasArenaDeck}">
                            <TextBlock Text="{Binding ArenaDeckTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,8,0,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Panel Width="46" Height="46" VerticalAlignment="Center">
                                        <c:Scallop Fill="{Binding ArenaDeckTier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                                        <TextBlock Text="{Binding ArenaDeckTier}" FontFamily="{DynamicResource DisplayFont}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ArenaDeckAverage}" Classes="stat" Foreground="{Binding ArenaDeckTier, Converter={StaticResource KeyBrush}}" />
                                        <TextBlock Text="{Binding ArenaDeckNote}" Classes="caption" FontSize="{StaticResource FontSizeLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ArenaDeckCurve}" Margin="0,12,0,0" MaxWidth="280" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Classes="fixed" Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:ArenaCurveColumn">
                                            <StackPanel Margin="2,0" VerticalAlignment="Bottom" ToolTip.Tip="{Binding Count}">
                                                <TextBlock Text="{Binding Count}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                <Panel Height="46">
                                                    <Border Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2,2,1,1" Background="{StaticResource Accent}" />
                                                </Panel>
                                                <Border Height="1" Background="{StaticResource Outline}" Margin="-2,0" />
                                                <TextBlock Text="{Binding Label}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                                <StackPanel>
                                    <TextBlock Text="{i:Loc Arena.Page.Best}" Classes="label" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding ArenaDeckBest}" ItemTemplate="{StaticResource ArenaCardLineTemplate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{i:Loc Arena.Page.Weakest}" Classes="label" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding ArenaDeckWeakest}" ItemTemplate="{StaticResource ArenaCardLineTemplate}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{i:Loc Arena.Page.DeckEmpty}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasArenaDeck}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Arena.Page.Community}" Icon="&#xF0127;" Size="13" Margin="0,0,0,8" />
                        <ContentControl Content="{i:Loc Stats.Table.Class}" ContentTemplate="{StaticResource StatsTableHead}" IsVisible="{Binding ArenaCommunity, Converter={StaticResource Truthy}}" />
                        <ItemsControl ItemsSource="{Binding ArenaCommunity}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Arena.Page.CommunityLoading}" IsVisible="{Binding ArenaCommunityLoading}" />
                        <ContentControl Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Arena.Page.CommunityEmpty}" IsVisible="{Binding ArenaCommunityUnavailable}" />
                        <ContentControl Name="ArenaCommunityNoSplit" Classes="emptyState" Tag="&#xF002A;" Content="{i:Loc Arena.Page.CommunityNoSplit}" IsVisible="{Binding ArenaCommunityNoSplit}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
