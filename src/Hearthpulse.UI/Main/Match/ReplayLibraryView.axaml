<UserControl x:Class="Hearthpulse.UI.Main.Match.ReplayLibraryView"
             x:DataType="mt:ReplayLibraryViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:mt="using:Hearthpulse.UI.Main.Match">
    <!-- The History page as the replay library (docs/replay-library.md): tabs Recent / Saved / Imported, the search and
         the result filter, the status line, the game cards. DataContext is MainViewModel.Library. Colours are theme
         tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A hero power or trinket: a round portrait, the full card on hover -->
            <DataTemplate x:Key="Chip" x:DataType="mt:LibraryChip">
                <Border Width="22" Height="22" Margin="0,0,3,0" CornerRadius="11" ClipToBounds="True" Background="{StaticResource Surface4}"
                        BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" i:CardArt.Portrait="{Binding CardId}" c:CardPreview.CardId="{Binding CardId}"
                        ToolTip.Tip="{Binding Tooltip}" />
            </DataTemplate>

            <!-- A minion of the final board: a small oval (golden: accent rim, taunt: thick rim, divine shield: outer
                 ring) and its stats under it. 48 wide and 1 apart (LibrarySummary.MinionRoom): "736/639" fits in tabular
                 digits; longer stats trim, the tooltip has them whole. -->
            <DataTemplate x:Key="Minion" x:DataType="mt:LibraryMinion">
                <StackPanel Width="48" Margin="0,0,1,0" Background="Transparent" ToolTip.Tip="{Binding Tooltip}" c:CardPreview.CardId="{Binding CardId}">
                    <Panel Width="28" Height="34" HorizontalAlignment="Center">
                        <Border CornerRadius="14" BorderBrush="{StaticResource Info}" BorderThickness="1.5" IsVisible="{Binding DivineShield}" />
                        <Border Classes="oval" Classes.taunt="{Binding Taunt}" Classes.golden="{Binding Golden}" Width="26" Height="32" CornerRadius="13"
                                ClipToBounds="True" Background="{StaticResource Surface4}" i:CardArt.Portrait="{Binding CardId}" />
                    </Panel>
                    <TextBlock Classes="stats" Text="{Binding Stats}" FontFamily="{StaticResource DisplayFont}" FontSize="9" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="RowPanel">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <i:BoardFit x:Key="BoardFit" />

            <!-- The final board as its room shows it: whole minions, then "+N" naming the rest in its tooltip -->
            <DataTemplate x:Key="BoardRow" x:DataType="mt:LibraryBoardView">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource RowPanel}" VerticalAlignment="Center" />
                    <Border Classes="pill" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding MoreTip}" AutomationProperties.Name="{Binding MoreTip}"
                            IsVisible="{Binding More, Converter={StaticResource Truthy}}">
                        <TextBlock Text="{Binding More}" FontSize="11" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The right end of a card: star and Share (or the "no replay" mark), delete on Imported -->
            <DataTemplate x:Key="CardActions" x:DataType="mt:LibraryCard">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Classes="icon cardIcon star" Classes.starred="{Binding Starred}" Content="{Binding StarGlyph}" ToolTip.Tip="{Binding StarTip}"
                            AutomationProperties.Name="{Binding StarTip}" IsVisible="{Binding HasReplay}"
                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).ToggleStar}" CommandParameter="{Binding}" />
                    <Button Classes="icon cardIcon" Content="&#xF0497;" ToolTip.Tip="{i:Loc Library.Share}" AutomationProperties.Name="{i:Loc Library.Share}"
                            IsVisible="{Binding HasReplay}"
                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).Share}" CommandParameter="{Binding}" />
                    <!-- Plan 2.2: upload to the site / delete from it, after the confirmation in the card -->
                    <Button Classes="icon cardIcon" Content="{Binding SiteGlyph}" ToolTip.Tip="{Binding SiteTip}" AutomationProperties.Name="{Binding SiteTip}"
                            IsVisible="{Binding CanUpload}"
                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).SiteAction}" CommandParameter="{Binding}" />
                    <TextBlock Text="&#xF1036;" Classes="icon" FontSize="16" Foreground="{StaticResource Faint}" Margin="7,0" VerticalAlignment="Center"
                               ToolTip.Tip="{i:Loc Library.NoReplay}" IsVisible="{Binding NoReplay}" />
                    <Button Classes="icon cardIcon delete" Content="&#xF09E7;" ToolTip.Tip="{i:Loc Library.Delete}" AutomationProperties.Name="{i:Loc Library.Delete}"
                            IsVisible="{Binding CanDelete}"
                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).Delete}" CommandParameter="{Binding}" />
                </StackPanel>
            </DataTemplate>

            <!-- The result plate (BG: the place) and the rating change, then when and how long -->
            <DataTemplate x:Key="CardResult" x:DataType="mt:LibraryCard">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="6" Padding="10,3" Background="{StaticResource Surface3}">
                            <TextBlock Text="{Binding Result}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding Rating}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding RatingValue, Converter={StaticResource SignBrush}}" ToolTip.Tip="{i:Loc Main.Game.RatingChange}" />
                    </StackPanel>
                    <TextBlock Text="{Binding When}" Classes="caption" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding When}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="LibraryCard" x:DataType="mt:LibraryCard">
                <Button Classes="bare libraryCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="{i:Loc Match.View.OpenTip}"
                        Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).Open}" CommandParameter="{Binding}">
                    <Border Classes="plate" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Both kinds share the outer columns (hero 56 · ... · result 150 · actions 98): the result, the date
                                 and the buttons line up down the list. The result column fits the longest date and duration
                                 ("Сегодня 12:49 · 27 мин", "04 нояб. 12:49 · 27 мин": about 131-140 px), the actions column three
                                 buttons. A row has about 678 px at a 1040 window and 898 at the default (1260). -->
                            <!-- Battlegrounds: hero · name and caption (120) · chips and the board · result · actions. The board
                                 shows the minions that fit whole and "+N" for the rest: at 1040 its room is about 135 px (two
                                 minions and "+5"), at 1260 about 355 (all seven, 315). -->
                            <Grid ColumnDefinitions="56,120,*,150,98" IsVisible="{Binding IsBattlegrounds}">
                                <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{StaticResource Surface4}" HorizontalAlignment="Left"
                                        i:CardArt.Portrait="{Binding HeroCardId}" c:CardPreview.CardId="{Binding HeroCardId}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    <TextBlock Text="{Binding Caption}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Caption}" />
                                </StackPanel>
                                <Grid Grid.Column="2" ColumnDefinitions="100,11,*" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Summary.Chips}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource RowPanel}" />
                                        <Border Classes="pill" ToolTip.Tip="{Binding Summary.ChipsMoreTip}" VerticalAlignment="Center"
                                                IsVisible="{Binding Summary.ChipsMore, Converter={StaticResource Truthy}}">
                                            <TextBlock Text="{Binding Summary.ChipsMore}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Height="28" Margin="5,0" Background="{StaticResource Border}" />
                                    <!-- An empty border measures the board's room; the board itself never widens it -->
                                    <Border x:Name="BoardRoom" Grid.Column="2" />
                                    <ContentControl Grid.Column="2" ContentTemplate="{StaticResource BoardRow}" Focusable="False">
                                        <ContentControl.Content>
                                            <MultiBinding Converter="{StaticResource BoardFit}">
                                                <Binding ElementName="BoardRoom" Path="Bounds.Width" />
                                                <Binding Path="Summary" />
                                            </MultiBinding>
                                        </ContentControl.Content>
                                    </ContentControl>
                                </Grid>
                                <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource CardResult}" />
                                <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource CardActions}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Constructed, Arena and the rest: heroes · deck and caption · opponent · result · actions. The caption
                                 takes the room; the opponent ("vs Охотник на демонов" and the archetype) up to 120 with a tooltip.
                                 The longest caption ("Паладин · Рейтинговая · Стандартный · Платина 4 · 12 ходов", about 366 px)
                                 fits at 1260 (about 450 px); at 1040 (about 230) it trims, whole in the tooltip. -->
                            <Grid ColumnDefinitions="56,*,Auto,150,98" IsVisible="{Binding IsConstructed}">
                                <Panel Width="48" Height="44" HorizontalAlignment="Left">
                                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{StaticResource Surface4}" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" i:CardArt.Portrait="{Binding HeroCardId}" />
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="{StaticResource Surface4}" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" BorderBrush="{StaticResource Accent2Line}" BorderThickness="1.5" i:CardArt.Portrait="{Binding OpponentHeroCardId}"
                                            ToolTip.Tip="{Binding Opponent}" IsVisible="{Binding OpponentHeroCardId, Converter={StaticResource Truthy}}" />
                                </Panel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    <TextBlock Text="{Binding Caption}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Classes="wide" MaxWidth="120" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Opponent}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Opponent}" />
                                    <TextBlock Text="{Binding OpponentArchetype}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OpponentArchetype}" />
                                </StackPanel>
                                <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource CardResult}" />
                                <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource CardActions}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- The question before a delete, inside the card -->
                            <Border Margin="0,8,0,0" CornerRadius="8" Padding="12,8" Background="{StaticResource NegativeSoft}" BorderBrush="{StaticResource Negative}"
                                    BorderThickness="1" IsVisible="{Binding Confirming}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="12,5" Margin="8,0,0,0" Content="{i:Loc Library.ConfirmNo}"
                                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).Cancel}" CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="12,5" Foreground="{StaticResource Negative}" Content="{i:Loc Library.ConfirmYes}"
                                            Command="{Binding $parent[mt:ReplayLibraryView].((mt:ReplayLibraryViewModel)DataContext).Confirm}" CommandParameter="{Binding}" />
                                    <TextBlock Text="&#xF05D6;" Classes="icon" FontSize="16" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConfirmText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.plate">
            <Setter Property="Background" Value="{StaticResource Row}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.libraryCard:pointerover Border.plate">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="TextBlock.stats">
            <Setter Property="FontFeatures">
                <FontFeatureCollection>
                    <FontFeature Tag="tnum" Value="1" />
                </FontFeatureCollection>
            </Setter>
        </Style>
        <Style Selector="Border.oval">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.oval.taunt">
            <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.oval.golden">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.cardIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
        <Style Selector="Button.cardIcon.star.starred">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.cardIcon.delete:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <!-- Compact (< 900): the opponent column goes (the opponent stays as the small portrait with its tooltip) -->
        <Style Selector="m|MainView.compact StackPanel.wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Compact: the search box takes the whole width, the result filter goes under it -->
        <Style Selector="m|MainView.compact Grid.searchRow TextBox.search">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact Grid.searchRow Border.resultFilter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <WrapPanel Margin="0,0,0,10">
            <Border Classes="segmentBar" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" GroupName="Library" IsChecked="{Binding IsRecent, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Recent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Recent}" />
                            <TextBlock Text="{Binding RecentCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="Library" IsChecked="{Binding IsSaved, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Saved">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Saved}" />
                            <TextBlock Text="{Binding SavedCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="Library" IsChecked="{Binding IsImported, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Imported">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Imported}" />
                            <TextBlock Text="{Binding ImportedCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="icon" Content="&#xF0DCF;" Margin="0,0,8,0" ToolTip.Tip="{i:Loc Library.OpenFolder}" AutomationProperties.Name="{i:Loc Library.OpenFolder}"
                        Command="{Binding OpenFolder}" IsVisible="{Binding ShowFolder}" />
                <Button Classes="ghost" Padding="12,7" IsEnabled="{Binding CanImport}" ToolTip.Tip="{i:Loc Library.ImportTip}" Command="{Binding Import}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF02FA;" Classes="icon" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" VerticalAlignment="Center" />
                        <TextBlock Text="{i:Loc Library.Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </WrapPanel>

        <!-- Search (up to 420 wide, on the left) and the result filter (on the right); both apply to every tab -->
        <Grid Grid.Row="1" Classes="searchRow" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="420" />
                <ColumnDefinition Width="*" MinWidth="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Name="SearchBox" Classes="search" Text="{Binding Search}" PlaceholderText="{i:Loc Library.Search.Placeholder}" VerticalAlignment="Center"
                     ToolTip.Tip="{i:Loc Library.Search.Tip}" AutomationProperties.Name="{i:Loc Library.Search.Name}">
                <TextBox.InnerLeftContent>
                    <TextBlock Text="&#xF0349;" Classes="icon" FontSize="16" Foreground="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Classes="icon" Content="&#xF0156;" Width="26" Height="26" FontSize="14" Focusable="False" Margin="0,0,4,0" VerticalAlignment="Center"
                            Click="OnClearSearchText" ToolTip.Tip="{i:Loc Library.Search.ClearTip}" AutomationProperties.Name="{i:Loc Library.Search.ClearTip}"
                            IsVisible="{Binding Search, Converter={StaticResource Truthy}}" />
                </TextBox.InnerRightContent>
            </TextBox>
            <Border Grid.Column="2" Classes="segmentBar resultFilter" VerticalAlignment="Center" ToolTip.Tip="{i:Loc Library.Search.ResultTip}"
                    AutomationProperties.Name="{i:Loc Library.Search.ResultTip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Main.History.All}" GroupName="LibraryResult" IsChecked="{Binding ResultAll, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="All" />
                    <RadioButton Classes="segment" Content="{i:Loc Library.Search.Wins}" GroupName="LibraryResult" IsChecked="{Binding ResultWins, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="Win" />
                    <RadioButton Classes="segment" Content="{i:Loc Library.Search.Losses}" GroupName="LibraryResult" IsChecked="{Binding ResultLosses, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="Loss" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status of the last action; it goes at the next tab, filter, opened match or action -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,10" IsVisible="{Binding Status, Converter={StaticResource Truthy}}">
            <TextBlock Text="{Binding StatusGlyph}" Classes="icon" FontSize="14" VerticalAlignment="Center"
                       Foreground="{Binding StatusKey, Converter={StaticResource KeyBrush}}" />
            <TextBlock Text="{Binding Status}" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="bare" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenStatusFolder}" IsVisible="{Binding HasStatusFolder}">
                <TextBlock Text="{i:Loc Library.OpenFolder}" Classes="caption" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
            </Button>
        </StackPanel>

        <Border Grid.Row="3" Classes="card" Padding="16,12">
            <Panel>
                <StackPanel IsVisible="{Binding IsEmpty}">
                    <ContentControl Classes="emptyState" Tag="{Binding EmptyGlyph}" Content="{Binding EmptyText}" />
                    <!-- Nothing passes the search: one click back to every game of the tab -->
                    <Button Classes="ghost" Padding="12,6" Margin="0,4,0,8" HorizontalAlignment="Center" Content="{i:Loc Library.Search.Clear}"
                            Click="OnClearSearch" IsVisible="{Binding IsSearchEmpty}" />
                </StackPanel>
                <ListBox Name="List" Classes="plain history" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource LibraryCard}"
                         SelectedItem="{Binding SelectedCard, Mode=OneWay}" SelectionChanged="OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Panel>
        </Border>
    </Grid>
</UserControl>
