<UserControl x:Class="Hearthpulse.UI.Main.Match.MatchView"
             x:DataType="mt:MatchViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:r="using:Hearthpulse.Core.Replay"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:mt="using:Hearthpulse.UI.Main.Match"
             Focusable="True" FocusAdorner="{x:Null}">
    <!-- The match page: one History game. DataContext is MainViewModel.MatchPage. Colours are theme tokens only.
         It takes the keyboard focus so the player's keys (code-behind) work on the Replay tab. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A card back: the card's shape in the theme, used for every card the game never showed -->
            <ControlTemplate x:Key="CardBack" TargetType="ContentControl">
                <Border CornerRadius="8" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2">
                    <Border Margin="4" CornerRadius="5" Background="{StaticResource Decor}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Panel>
                            <c:Scallop Width="40" Height="40" Fill="{StaticResource Surface4}" Lobes="9" Depth="0.12" />
                            <TextBlock Text="&#xF0639;" Classes="icon" FontSize="18" Foreground="{StaticResource GoldTrim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </Border>
            </ControlTemplate>

            <!-- A minion or location on the board: the full card render, the current attack and health over the printed
                 ones, a divine shield halo; the full card shows on hover. Plan R2 (styles Panel.mark.*, by the table's
                 attack / mine classes): the step's actor glows in a frame of its side's colour (a sword badge when it
                 attacks), an attack target is framed in Negative, a play's target dashed; the health it gained or lost on
                 the step sits over the art; one that died on the step fades under a skull. MatchArrowLayer draws the arrow. -->
            <DataTemplate x:Key="Minion" x:DataType="mt:MatchCardItem">
                <StackPanel Width="86" Margin="2,0" ToolTip.Tip="{Binding Tooltip}">
                    <Panel Classes="mark" Classes.acting="{Binding Acting}" Classes.targeted="{Binding Targeted}" Classes.dying="{Binding Dying}" Height="129" Background="Transparent"
                           c:CardPreview.CardId="{Binding CardId}" mt:MatchArrowLayer.Ref="{Binding Ref}" mt:MatchArrowLayer.Anchor="Minion">
                        <Ellipse Classes="halo" Margin="-6,-2,-6,10" Fill="{StaticResource Glow}" />
                        <Panel Classes="body">
                            <Border Margin="1,6,1,2" CornerRadius="10" BorderBrush="{StaticResource Info}" BorderThickness="2.5" Opacity="0.85" IsVisible="{Binding DivineShield}" />
                            <!-- Under the render while it loads (or when it cannot): the card body with its name -->
                            <Border Margin="6,10,6,6" CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <TextBlock Text="{Binding Name}" Classes="caption" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4" VerticalAlignment="Center" />
                            </Border>
                            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,103,0,0" IsVisible="{Binding ShowStats}">
                                <TextBlock Text="{Binding Attack}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,103,0,0" IsVisible="{Binding ShowStats}">
                                <TextBlock Classes="hp" Classes.damaged="{Binding Damaged}" Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <Border Classes="frame act" Margin="-2,3,-2,-1" CornerRadius="11" BorderThickness="2.5" ToolTip.Tip="{i:Loc Match.Mark.Actor}" />
                        <Border Classes="frame hit" Margin="-2,3,-2,-1" CornerRadius="11" BorderThickness="3" ToolTip.Tip="{i:Loc Match.Mark.AttackTarget}" />
                        <Rectangle Classes="aim" Margin="-2,3,-2,-1" RadiusX="11" RadiusY="11" StrokeThickness="2" StrokeDashArray="3,2" />
                        <TextBlock Classes="icon skull" Text="&#xF0BC8;" FontSize="22" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0" />
                        <Border Classes="badge attacker" Margin="0,4,2,0" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Match.Mark.Attacker}" AutomationProperties.Name="{i:Loc Match.Mark.Attacker}">
                            <TextBlock Text="&#xF04E5;" Classes="icon" />
                        </Border>
                        <Border Classes="badge hit" Margin="0,4,2,0" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Match.Mark.AttackTarget}" AutomationProperties.Name="{i:Loc Match.Mark.AttackTarget}">
                            <TextBlock Text="&#xF04FE;" Classes="icon" />
                        </Border>
                        <Border Classes="badge aim" Margin="0,4,2,0" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Match.Mark.PlayTarget}" AutomationProperties.Name="{i:Loc Match.Mark.PlayTarget}">
                            <TextBlock Text="&#xF0068;" Classes="icon" />
                        </Border>
                        <Border Classes="change" BorderBrush="{Binding Change, Converter={StaticResource SignBrush}}" HorizontalAlignment="Center" Margin="0,34,0,0"
                                ToolTip.Tip="{Binding ChangeTip}" AutomationProperties.Name="{Binding ChangeTip}" IsVisible="{Binding ChangeText, Converter={StaticResource Truthy}}">
                            <TextBlock Text="{Binding ChangeText}" Foreground="{Binding Change, Converter={StaticResource SignBrush}}" />
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding Note}" Classes="caption" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <!-- A card in hand: the full card render (cost and text as in the game), or a card back with how it got there.
                 A card the log revealed later in the game is face up with an eye mark and the turn it was revealed. -->
            <DataTemplate x:Key="HandCard" x:DataType="mt:MatchCardItem">
                <StackPanel Width="66" Margin="1,0" ToolTip.Tip="{Binding Tooltip}">
                    <Panel Height="100">
                        <Panel Background="Transparent" c:CardPreview.CardId="{Binding CardId}" IsVisible="{Binding !CardBack}">
                            <Border Margin="4,8,4,4" CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <TextBlock Text="{Binding Name}" Classes="caption" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4" VerticalAlignment="Center" />
                            </Border>
                            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                        </Panel>
                        <ContentControl Template="{StaticResource CardBack}" Margin="4,8,4,4" IsVisible="{Binding CardBack}" />
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" IsVisible="{Binding Revealed}">
                            <TextBlock Text="&#xF06D0;" Classes="icon" FontSize="12.5" Foreground="{StaticResource OnAccentContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding Note}" Classes="caption" Classes.revealed="{Binding Revealed}" FontSize="10.5" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
            </DataTemplate>

            <!-- A card offered at a choice (Discover, mulligan): the render, the picked/kept one framed, the others dimmed -->
            <DataTemplate x:Key="ChoiceCard" x:DataType="r:MatchCardView">
                <StackPanel Classes.dimmed="{Binding Dimmed}" Width="92" Margin="3,0" ToolTip.Tip="{Binding Tooltip}">
                    <Panel Height="138">
                        <Border Margin="2,8,2,3" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="2.5" IsVisible="{Binding Picked}" />
                        <Panel Background="Transparent" c:CardPreview.CardId="{Binding CardId}" IsVisible="{Binding !CardBack}">
                            <Border Margin="6,11,6,6" CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <TextBlock Text="{Binding Name}" Classes="caption" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4" VerticalAlignment="Center" />
                            </Border>
                            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                        </Panel>
                        <ContentControl Template="{StaticResource CardBack}" Margin="6,11,6,6" IsVisible="{Binding CardBack}" />
                    </Panel>
                    <TextBlock Text="{Binding Note}" Classes="caption" Classes.revealed="{Binding Picked}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- A Battlegrounds hero offered at the start: a round portrait (as the hero line and the leaderboard) with the
                 name under it; the picked one ringed in the accent, the others dimmed. No card frame, no cost. -->
            <DataTemplate x:Key="HeroChoiceCard" x:DataType="r:MatchCardView">
                <StackPanel Classes="heroChoice" Classes.dimmed="{Binding Dimmed}" Classes.picked="{Binding Picked}" Width="124" Margin="2,0" Background="Transparent"
                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding ChoiceName}" c:CardPreview.CardId="{Binding CardId}">
                    <Panel Width="72" Height="72" HorizontalAlignment="Center">
                        <Ellipse StrokeThickness="3" Stroke="{StaticResource Accent}" IsVisible="{Binding Picked}" />
                        <Border Margin="5" CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                ClipToBounds="True" i:CardArt.Portrait="{Binding CardId}" />
                    </Panel>
                    <TextBlock Classes="heroName" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Margin="0,4,0,0" />
                </StackPanel>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="ChoicePanel">
                <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>

            <!-- A choice row: its title, then the offered cards (the hero choice: hero portraits; a hidden list builds no
                 items, it is never measured) -->
            <DataTemplate x:Key="ChoiceRow" x:DataType="r:MatchChoiceView">
                <StackPanel Margin="0,4,0,6">
                    <TextBlock Text="{Binding Title}" Classes="label" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ChoiceCard}" ItemsPanel="{StaticResource ChoicePanel}" IsVisible="{Binding !IsHero}" />
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource HeroChoiceCard}" ItemsPanel="{StaticResource ChoicePanel}" IsVisible="{Binding IsHero}" />
                </StackPanel>
            </DataTemplate>

            <!-- A small round card (weapon, hero power, secret); plan R2: a ring when it acts or is aimed at, as a minion's frame -->
            <DataTemplate x:Key="Chip" x:DataType="mt:MatchCardItem">
                <Panel Classes="mark" Classes.acting="{Binding Acting}" Classes.targeted="{Binding Targeted}" Width="40" Height="40" Margin="4,0,0,0" ToolTip.Tip="{Binding Tooltip}"
                       Background="Transparent" c:CardPreview.CardId="{Binding CardId}" mt:MatchArrowLayer.Ref="{Binding Ref}" mt:MatchArrowLayer.Anchor="Chip">
                    <Ellipse Classes="ring act" Margin="-3" StrokeThickness="2" />
                    <Ellipse Classes="ring hit" Margin="-3" StrokeThickness="2" />
                    <Ellipse Classes="ring aim" Margin="-3" StrokeThickness="2" StrokeDashArray="3,2" />
                    <Border CornerRadius="20" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5" ClipToBounds="True"
                            i:CardArt.Portrait="{Binding CardId}" IsVisible="{Binding !CardBack}" />
                    <Border CornerRadius="20" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" IsVisible="{Binding CardBack}">
                        <TextBlock Text="?" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Attack}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="-2,0,0,-4" IsVisible="{Binding ShowStats}" />
                    <TextBlock Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-4" IsVisible="{Binding ShowStats}" />
                </Panel>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="CardRow">
                <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="Wrap">
                <WrapPanel />
            </ItemsPanelTemplate>

            <!-- A side's hero line: portrait with health, weapon, hero power, secrets, mana and deck -->
            <DataTemplate x:Key="HeroLine" x:DataType="mt:MatchTableSide">
                <Grid Classes="heroLine" Margin="0,8" ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ItemsControl ItemsSource="{Binding Secrets}" ItemTemplate="{StaticResource Chip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ContentControl Content="{Binding Weapon}" ContentTemplate="{StaticResource Chip}" IsVisible="{Binding Weapon, Converter={StaticResource Truthy}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Plan R2: the portrait glows and is ringed when the hero acts or is aimed at, with its health change -->
                        <Panel Classes="mark" Classes.acting="{Binding HeroActing}" Classes.targeted="{Binding HeroTargeted}" Width="62" Height="62" ToolTip.Tip="{Binding Hero}"
                               mt:MatchArrowLayer.Ref="{Binding HeroRef}" mt:MatchArrowLayer.Anchor="Hero">
                            <Ellipse Classes="halo" Margin="-10" Fill="{StaticResource Glow}" />
                            <Ellipse Classes="ring act" Margin="-4" StrokeThickness="2.5" />
                            <Ellipse Classes="ring hit" Margin="-4" StrokeThickness="3" />
                            <Ellipse Classes="ring aim" Margin="-4" StrokeThickness="2" StrokeDashArray="3,2" />
                            <Border CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2" ClipToBounds="True"
                                    i:CardArt.Portrait="{Binding HeroCardId}" />
                            <!-- Health by a heart and armor by a shield, apart (as on the Battlegrounds table): "30 + 5" read as a sum -->
                            <Border CornerRadius="9" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" Padding="5,1,6,1"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-40,0,-40,-8" ToolTip.Tip="{Binding HealthTip}"
                                    AutomationProperties.Name="{Binding HealthTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF02D1;" Classes="icon" FontSize="11" Foreground="{StaticResource Negative}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                    <TextBlock Text="{Binding HealthText}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xF0498;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,2,0"
                                               IsVisible="{Binding ArmorText, Converter={StaticResource Truthy}}" />
                                    <TextBlock Text="{Binding ArmorText}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                               IsVisible="{Binding ArmorText, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="badge attacker" Margin="-8,-6,0,0" HorizontalAlignment="Left" ToolTip.Tip="{i:Loc Match.Mark.Attacker}" AutomationProperties.Name="{i:Loc Match.Mark.Attacker}">
                                <TextBlock Text="&#xF04E5;" Classes="icon" />
                            </Border>
                            <Border Classes="badge hit" Margin="-8,-6,0,0" HorizontalAlignment="Left" ToolTip.Tip="{i:Loc Match.Mark.AttackTarget}" AutomationProperties.Name="{i:Loc Match.Mark.AttackTarget}">
                                <TextBlock Text="&#xF04FE;" Classes="icon" />
                            </Border>
                            <Border Classes="badge aim" Margin="-8,-6,0,0" HorizontalAlignment="Left" ToolTip.Tip="{i:Loc Match.Mark.PlayTarget}" AutomationProperties.Name="{i:Loc Match.Mark.PlayTarget}">
                                <TextBlock Text="&#xF0068;" Classes="icon" />
                            </Border>
                            <Border Classes="change" BorderBrush="{Binding HealthChange, Converter={StaticResource SignBrush}}" HorizontalAlignment="Right" Margin="0,-8,-12,0"
                                    ToolTip.Tip="{Binding HealthChangeTip}" AutomationProperties.Name="{Binding HealthChangeTip}"
                                    IsVisible="{Binding HealthChangeText, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding HealthChangeText}" Foreground="{Binding HealthChange, Converter={StaticResource SignBrush}}" />
                            </Border>
                        </Panel>
                        <ContentControl Content="{Binding HeroPower}" ContentTemplate="{StaticResource Chip}" Margin="14,0,0,0" VerticalAlignment="Center"
                                        IsVisible="{Binding HeroPower, Converter={StaticResource Truthy}}" />
                    </StackPanel>
                    <!-- Column and margin from the styles (StackPanel.sideInfo): at phone width it goes under the portrait -->
                    <StackPanel Classes="sideInfo" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Classes="pill" Background="{StaticResource SecondaryContainer}" Margin="0,2,0,2" ToolTip.Tip="{i:Loc Match.View.ManaTip}">
                                <StackPanel Orientation="Horizontal">
                                    <c:ManaCost Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Mana}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <!-- Plan R2: deck, hand and Secrets as counters (the Secrets at zero too: one width for both sides) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel Classes="counter" ToolTip.Tip="{Binding DeckTip}" AutomationProperties.Name="{Binding DeckTip}">
                                <TextBlock Text="&#xF0639;" Classes="icon" />
                                <TextBlock Text="{Binding DeckCount}" />
                            </StackPanel>
                            <StackPanel Classes="counter" Margin="10,0,0,0" ToolTip.Tip="{Binding HandTip}" AutomationProperties.Name="{Binding HandTip}">
                                <TextBlock Text="&#xF0E47;" Classes="icon" />
                                <TextBlock Text="{Binding HandCount}" />
                            </StackPanel>
                            <StackPanel Classes="counter" Margin="10,0,0,0" ToolTip.Tip="{Binding SecretTip}" AutomationProperties.Name="{Binding SecretTip}">
                                <TextBlock Text="&#xF078B;" Classes="icon" />
                                <TextBlock Text="{Binding SecretCount}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- An action of the turn: clicking it shows its step. Your actions carry the gold accent, the opponent's the
                 second accent (edge + icon disc); a key card's biggest swing is starred, with why in the tooltip. -->
            <DataTemplate x:Key="ActionRow" x:DataType="mt:MatchActionItem">
                <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,3"
                        ToolTip.Tip="{Binding KeyReason}"
                        Command="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).GoFrame}" CommandParameter="{Binding}">
                    <Border Classes="row step" Classes.current="{Binding Current}" Classes.key="{Binding Key}" BorderThickness="1" BorderBrush="Transparent" Padding="10,6">
                        <Panel>
                            <Border Classes="edge" Classes.mine="{Binding Local}" Width="3" CornerRadius="1.5" Margin="-10,-2,0,-2" HorizontalAlignment="Left" />
                            <DockPanel Margin="2,0,0,0">
                                <Panel DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Border Classes="disc" Classes.mine="{Binding Local}" CornerRadius="13" />
                                    <TextBlock Text="{Binding Icon}" Classes="icon glyph" Classes.mine="{Binding Local}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xF04CE;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top" Margin="6,5,0,0" IsVisible="{Binding Key}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Panel>
                    </Border>
                </Button>
            </DataTemplate>

            <!-- A row of the game's event feed (plan R2): a turn's header (a marker in the turn's colour, its text, a rule; the
                 turn on screen in the text colour; a click goes to its first step), or an action as the turn's action row.
                 Neither takes the focus: the player keeps its keys. -->
            <DataTemplate x:Key="FeedRow" x:DataType="mt:MatchFeedItem">
                <Panel>
                    <Button Classes="bare feedHeader" Classes.first="{Binding Frame, Converter={StaticResource Truthy}, ConverterParameter=!}" Focusable="False"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="26" Padding="2,0" IsVisible="{Binding Header}"
                            ToolTip.Tip="{Binding Text}" AutomationProperties.Name="{Binding Text}"
                            Command="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).GoFrame}" CommandParameter="{Binding}">
                        <DockPanel>
                            <Border Classes="marker" Classes.mine="{Binding Local}" Classes.neutral="{Binding Mulligan}" DockPanel.Dock="Left" Width="3" Height="14" CornerRadius="1.5"
                                    VerticalAlignment="Center" />
                            <TextBlock Classes="feedTurn" Classes.current="{Binding Current}" DockPanel.Dock="Left" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                       Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Height="1" Background="{StaticResource Border}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Button Classes="bare" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,3" IsVisible="{Binding !Header}"
                            ToolTip.Tip="{Binding KeyReason}" AutomationProperties.Name="{Binding Text}"
                            Command="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).GoFrame}" CommandParameter="{Binding}">
                        <Border Classes="row step" Classes.current="{Binding Current}" Classes.key="{Binding Key}" BorderThickness="1" BorderBrush="Transparent" Padding="10,6">
                            <Panel>
                                <Border Classes="edge" Classes.mine="{Binding Local}" Width="3" CornerRadius="1.5" Margin="-10,-2,0,-2" HorizontalAlignment="Left" />
                                <DockPanel Margin="2,0,0,0">
                                    <Panel DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Border Classes="disc" Classes.mine="{Binding Local}" CornerRadius="13" />
                                        <TextBlock Text="{Binding Icon}" Classes="icon glyph" Classes.mine="{Binding Local}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xF04CE;" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Top" Margin="6,5,0,0" IsVisible="{Binding Key}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Panel>
                        </Border>
                    </Button>
                </Panel>
            </DataTemplate>

            <!-- A deck list row as in the overlay's deck: cost gem, the card's tile art behind its name, the rarity edge, copies; the note
                 (drawn, played, revealed...) under it; the full card shows on hover -->
            <DataTemplate x:Key="DeckRow" x:DataType="r:MatchDeckRow">
                <StackPanel Classes.unusedTile="{Binding !Used}" Margin="0,0,0,5" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <Grid Height="30" ColumnDefinitions="31,*">
                        <c:ManaCost Width="25" Height="25" Text="{Binding Cost}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" ClipToBounds="True">
                            <Panel>
                                <Image i:CardArt.Tile="{Binding CardId}" Width="140" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                <Rectangle Fill="{StaticResource TileFade}" />
                                <Border Width="3" HorizontalAlignment="Left" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}"
                                        IsVisible="{Binding Rarity, Converter={StaticResource Truthy}}" />
                                <DockPanel Margin="10,0,4,0">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="26" Height="21" Padding="5,0"
                                            Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Count, Converter={StaticResource Truthy}}">
                                        <TextBlock Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Panel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Note}" Classes="caption" FontSize="11" Margin="31,2,0,0" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Note, Converter={StaticResource Truthy}}" />
                </StackPanel>
            </DataTemplate>

            <!-- A Battlegrounds minion (round art with stats) -->
            <DataTemplate x:Key="BgMinion" x:DataType="r:MatchCardView">
                <Panel Width="52" Height="60" Margin="2,0" ToolTip.Tip="{Binding Tooltip}">
                    <Border Classes="art" Classes.golden="{Binding Golden}" Width="48" Height="56" CornerRadius="24" Background="{StaticResource Surface4}"
                            BorderBrush="{StaticResource Border}" BorderThickness="2" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top"
                            i:CardArt.Portrait="{Binding CardId}" />
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding ShowStats}">
                        <TextBlock Text="{Binding Attack}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding ShowStats}">
                        <TextBlock Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="RowPanel">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <!-- A minion of the Battlegrounds table (our board, Bob's offer, the combat opponent's board): the round art
                 with a rim for its state (styles Border.oval.*), the offer's tier and the step's badge on top, attack and
                 health, keyword glyphs under it. The card the step is about glows; one dying in the step fades under a skull. -->
            <DataTemplate x:Key="BgBoardMinion" x:DataType="mt:MatchBgCardItem">
                <Panel Classes="bgCell" Classes.dying="{Binding Dying}" Width="70" Height="96" Margin="2,0" ToolTip.Tip="{Binding Tooltip}" Background="Transparent"
                       c:CardPreview.CardId="{Binding CardId}">
                    <Panel Width="64" Height="76" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse Margin="-3,-4" Fill="{StaticResource Glow}" IsVisible="{Binding Acting}" />
                        <Border Margin="-3" CornerRadius="35" BorderBrush="{StaticResource Info}" BorderThickness="2.5" Opacity="0.85" IsVisible="{Binding DivineShield}" />
                        <Border Classes="oval" Classes.taunt="{Binding Taunt}" Classes.golden="{Binding Golden}" Classes.frozen="{Binding Frozen}" Classes.acting="{Binding Acting}"
                                Classes.defending="{Binding Defending}" Classes.attacking="{Binding Attacking}" i:CardArt.Portrait="{Binding CardId}" />
                        <TextBlock Text="&#xF0BC8;" Classes="icon" FontSize="22" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Dying}" />
                    </Panel>
                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding Tier, Converter={StaticResource Truthy}}">
                        <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Frozen}">
                        <TextBlock Text="&#xF0717;" Classes="icon" FontSize="12" Foreground="{StaticResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource NegativeSoft}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Defending}">
                        <TextBlock Text="&#xF04FE;" Classes="icon" FontSize="12" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentContainer}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Attacking}">
                        <TextBlock Text="&#xF04E5;" Classes="icon" FontSize="12" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,58,0,0" IsVisible="{Binding ShowStats}">
                        <TextBlock Text="{Binding Attack}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,0,0" IsVisible="{Binding ShowStats}">
                        <TextBlock Classes="hp" Classes.damaged="{Binding Damaged}" Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Height="14" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock Text="&#xF006A;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0" IsVisible="{Binding Reborn}" />
                        <TextBlock Text="&#xF1133;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0" IsVisible="{Binding Venomous}" />
                        <TextBlock Text="&#xF059D;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0" IsVisible="{Binding Windfury}" />
                        <TextBlock Text="&#xF06D1;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0" IsVisible="{Binding Stealth}" />
                    </StackPanel>
                </Panel>
            </DataTemplate>

            <!-- A card in our Battlegrounds hand: the full card render; the full card shows on hover -->
            <DataTemplate x:Key="BgHandCard" x:DataType="mt:MatchBgCardItem">
                <Panel Width="66" Height="100" Margin="1,0" ToolTip.Tip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <Border Margin="4,8,4,4" CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <TextBlock Text="{Binding Name}" Classes="caption" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4" VerticalAlignment="Center" />
                    </Border>
                    <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                </Panel>
            </DataTemplate>

            <!-- A Battlegrounds hero power or trinket: a small round card -->
            <DataTemplate x:Key="BgChip" x:DataType="mt:MatchBgCardItem">
                <Panel Width="40" Height="40" Margin="4,0,0,0" ToolTip.Tip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <Border CornerRadius="20" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5" ClipToBounds="True"
                            i:CardArt.Portrait="{Binding CardId}" />
                </Panel>
            </DataTemplate>

            <!-- A Battlegrounds hero line (as the Constructed one): trinkets, the portrait with health and its hero powers,
                 the hero's name, tavern tier and, in the tavern, our gold. A Tag on the host rims the portrait in the
                 opponent's accent. -->
            <DataTemplate x:Key="BgHeroLine" x:DataType="mt:MatchBgTableHero">
                <Grid Margin="0,8" ColumnDefinitions="*,Auto,*">
                    <ItemsControl ItemsSource="{Binding Trinkets}" ItemTemplate="{StaticResource BgChip}" ItemsPanel="{StaticResource RowPanel}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Panel Width="62" Height="62" ToolTip.Tip="{Binding Name}">
                            <Border Classes="portrait" Classes.theirs="{Binding $parent[ContentControl].Tag, Converter={StaticResource Truthy}}" CornerRadius="31"
                                    Background="{StaticResource Surface4}" BorderThickness="2" ClipToBounds="True" i:CardArt.Portrait="{Binding HeroCardId}" />
                            <!-- Health by a heart and armor by a shield, apart: "30 + 15" read as a sum -->
                            <Border CornerRadius="9" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" Padding="5,1,6,1"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-40,0,-40,-8" ToolTip.Tip="{Binding HealthTip}"
                                    AutomationProperties.Name="{Binding HealthTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF02D1;" Classes="icon" FontSize="11" Foreground="{StaticResource Negative}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                    <TextBlock Text="{Binding HealthText}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xF0498;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,2,0"
                                               IsVisible="{Binding ArmorText, Converter={StaticResource Truthy}}" />
                                    <TextBlock Text="{Binding ArmorText}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                               IsVisible="{Binding ArmorText, Converter={StaticResource Truthy}}" />
                                </StackPanel>
                            </Border>
                        </Panel>
                        <ItemsControl ItemsSource="{Binding HeroPowers}" ItemTemplate="{StaticResource BgChip}" ItemsPanel="{StaticResource RowPanel}" Margin="10,0,0,0"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Classes="pill" Background="{StaticResource SecondaryContainer}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{i:Loc Match.Player.Table.Tavern}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource OnSecondaryContainer}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="pill" Background="{StaticResource AccentContainer}" Margin="8,0,0,0"
                                    IsVisible="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).BgTable.Gold, Converter={StaticResource Truthy}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{i:Loc Match.Player.Table.Gold}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).BgTable.Gold}" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource OnAccentContainer}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- A leaderboard row: place, hero portrait and name (never a player's), tier, health. Ours in the accent; the
                 combat opponent on a soft plate; heroes out of the game faded (styles Border.leader.*). -->
            <DataTemplate x:Key="LeaderRow" x:DataType="mt:MatchLeaderLine">
                <Border Classes="leader" Classes.fighting="{Binding Fighting}" Classes.dead="{Binding Dead}" Height="34" CornerRadius="6" Padding="6,0" Margin="0,0,0,2"
                        ToolTip.Tip="{Binding Tooltip}">
                    <Grid ColumnDefinitions="18,Auto,*,Auto,Auto">
                        <TextBlock Classes="place" Classes.you="{Binding Local}" Text="{Binding Place}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Margin="6,0,8,0" Background="{StaticResource Surface4}" ClipToBounds="True"
                                i:CardArt.Portrait="{Binding HeroCardId}" />
                        <TextBlock Grid.Column="2" Classes.you="{Binding Local}" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <!-- The tier plate stays empty space before the first tavern (no tier 0) -->
                        <Panel Grid.Column="3" Width="20" Height="20" Margin="8,0">
                            <Border CornerRadius="4" Background="{StaticResource Surface3}" IsVisible="{Binding Tier, Converter={StaticResource Truthy}}">
                                <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <!-- Health, then armor by a shield; the tooltip says both in words -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding HealthTip}"
                                    AutomationProperties.Name="{Binding HealthTip}">
                            <TextBlock Text="{Binding Health}" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock Text="&#xF0498;" Classes="icon" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,2,0"
                                       IsVisible="{Binding Armor, Converter={StaticResource Truthy}}" />
                            <TextBlock Text="{Binding Armor}" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" IsVisible="{Binding Armor, Converter={StaticResource Truthy}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.turnLabel">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.replaced">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Border.art.taunt">
            <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
            <Setter Property="BorderThickness" Value="4" />
        </Style>
        <Style Selector="Border.art.golden">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.hp.damaged">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="TextBlock.glyph">
            <Setter Property="Foreground" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Border.edge">
            <Setter Property="Background" Value="{StaticResource Accent2Line}" />
        </Style>
        <Style Selector="Border.edge.mine">
            <Setter Property="Background" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Border.disc">
            <Setter Property="Background" Value="{StaticResource Accent2Soft}" />
        </Style>
        <Style Selector="Border.disc.mine">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="Border.step.key">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <!-- The step bar: whose step it is shows in the edge and turn colour -->
        <Style Selector="Border.stepBar">
            <Setter Property="Background" Value="{StaticResource Accent2Soft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent2Line}" />
        </Style>
        <Style Selector="Border.stepBar.mine">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Border.stepBar TextBlock.stepTurn">
            <Setter Property="Foreground" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Border.stepBar.mine TextBlock.stepTurn">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- The result plate: green for a win (top half in Battlegrounds), red for a loss, neutral otherwise -->
        <Style Selector="Border.resultPlate">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="Border.resultPlate.win">
            <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.resultPlate.loss">
            <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Border.resultPlate TextBlock.resultGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.resultPlate TextBlock.resultGlyph.neutral">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.resultPlate.win TextBlock.resultGlyph.neutral, Border.resultPlate.loss TextBlock.resultGlyph.neutral">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.resultPlate.win TextBlock.resultGlyph.win, Border.resultPlate.loss TextBlock.resultGlyph.loss">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.glyph.mine">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.step.current">
            <Setter Property="Background" Value="{StaticResource SelectedFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
        </Style>
        <Style Selector="StackPanel.unusedTile">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="StackPanel.dimmed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="StackPanel.heroChoice.picked TextBlock.heroName">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.caption.revealed">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBlock.you">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- A Battlegrounds minion's rim: later styles win - the step's state over golden over taunt -->
        <Style Selector="Border.oval">
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.oval.taunt">
            <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
            <Setter Property="BorderThickness" Value="4" />
        </Style>
        <Style Selector="Border.oval.golden">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.oval.golden.taunt">
            <Setter Property="BorderThickness" Value="4" />
        </Style>
        <Style Selector="Border.oval.frozen">
            <Setter Property="BorderBrush" Value="{StaticResource Info}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.oval.acting">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.oval.defending">
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Border.oval.attacking">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Panel.bgCell.dying">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.portrait">
            <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
        </Style>
        <Style Selector="Border.portrait.theirs">
            <Setter Property="BorderBrush" Value="{StaticResource Accent2Line}" />
        </Style>
        <!-- The Battlegrounds step bar: tavern in the accent, combat neutral, the end of a combat in its result's colour -->
        <Style Selector="Border.bgStep">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Border.bgStep.combat">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
        </Style>
        <Style Selector="Border.bgStep.over">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="Border.bgStep.won">
            <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.bgStep.lost">
            <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Border.bgStep TextBlock.stepTitle">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.bgStep.combat TextBlock.stepTitle">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <!-- A leaderboard row: the combat opponent on a soft plate, heroes out of the game faded -->
        <Style Selector="Border.leader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.leader.fighting">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        </Style>
        <Style Selector="Border.leader.dead">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="TextBlock.place">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.place.you">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- The "Turn" list's marker: the stretch's colour (MatchTimelineLayout.MarkerBrush) -->
        <Style Selector="Border.marker">
            <Setter Property="Background" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="Border.marker.mine">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.marker.theirs">
            <Setter Property="Background" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Border.marker.won">
            <Setter Property="Background" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="Border.marker.lost">
            <Setter Property="Background" Value="{StaticResource Negative}" />
        </Style>
        <!-- Plan R2, the Constructed table's marks (Panel.mark: a minion, a hero portrait, a chip). The table's classes say
             whose step it is (mine: the accent, else the second accent) and its kind (attack, else a play); later styles
             win, so an attack target's Negative comes last. -->
        <Style Selector="Panel.mark Ellipse.halo, Panel.mark Border.frame, Panel.mark Ellipse.ring, Panel.mark Rectangle.aim, Panel.mark Border.badge, Panel.mark TextBlock.skull">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel.mark.acting Ellipse.halo, Panel.mark.acting Border.frame.act, Panel.mark.acting Ellipse.ring.act">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.ctTable.attack Panel.mark.acting Border.badge.attacker">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.ctTable.attack Panel.mark.acting Border.frame.act">
            <Setter Property="ToolTip.Tip" Value="{i:Loc Match.Mark.Attacker}" />
        </Style>
        <Style Selector="StackPanel.ctTable.attack Panel.mark.targeted Border.frame.hit, StackPanel.ctTable.attack Panel.mark.targeted Ellipse.ring.hit, StackPanel.ctTable.attack Panel.mark.targeted Border.badge.hit">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.ctTable:not(.attack) Panel.mark.targeted Rectangle.aim, StackPanel.ctTable:not(.attack) Panel.mark.targeted Ellipse.ring.aim, StackPanel.ctTable:not(.attack) Panel.mark.targeted Border.badge.aim">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Panel.mark.dying Panel.body">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Panel.mark.dying TextBlock.skull">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Panel.mark Border.badge">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Panel.mark Border.badge TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Panel.mark Border.frame">
            <Setter Property="BorderBrush" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Panel.mark Ellipse.ring, Panel.mark Rectangle.aim">
            <Setter Property="Stroke" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="StackPanel.ctTable.mine Panel.mark Border.frame, StackPanel.ctTable.mine Panel.mark Border.badge">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="StackPanel.ctTable.mine Panel.mark Ellipse.ring, StackPanel.ctTable.mine Panel.mark Rectangle.aim">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="StackPanel.ctTable.mine Panel.mark Border.badge TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Panel.mark Border.frame.hit, Panel.mark Border.badge.hit">
            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Panel.mark Ellipse.ring.hit">
            <Setter Property="Stroke" Value="{StaticResource Negative}" />
        </Style>
        <Style Selector="Panel.mark Border.badge.hit TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Negative}" />
        </Style>
        <!-- The change badge: the health a card or hero gained or lost on the step (its colour from the sign) -->
        <Style Selector="Border.change">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource OverlayBadgeShade}" />
        </Style>
        <Style Selector="Border.change TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A side's counters: glyph and number, the tooltip on the whole pair -->
        <Style Selector="StackPanel.counter">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.counter TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.counter TextBlock.icon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
        <!-- The side's name, mana and counters right of the portrait (under it at phone width) -->
        <Style Selector="Grid.heroLine StackPanel.sideInfo">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="18,0,0,0" />
        </Style>
        <!-- The event feed: right of the table; a turn's header with its marker (yours, theirs, the mulligan) -->
        <Style Selector="Border.feed">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Button.feedHeader">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style Selector="Button.feedHeader.first">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Button.feedHeader Border.marker">
            <Setter Property="Background" Value="{StaticResource Accent2}" />
        </Style>
        <Style Selector="Button.feedHeader Border.marker.mine">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.feedHeader Border.marker.neutral">
            <Setter Property="Background" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.feedTurn">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.feedTurn.current">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- The bookmark toggle on a bookmarked step, the header's star of a saved game: the accent -->
        <Style Selector="Button.bookmark.on, Button.headerStar.starred">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- Phone width: "Turn" over the bookmarks ("Bookmarks" drops its word: the window's .wide rule) -->
        <Style Selector="m|MainView.compact Grid.playerNav ComboBox.turns">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="m|MainView.compact Grid.playerNav StackPanel.bookmarks">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- Phone width: the turn's actions go under the table, the decks stack -->
        <Style Selector="m|MainView.compact Border.actions">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Border.table">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact Border.second">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="m|MainView.compact Border.first">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact Border.result">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <!-- Phone width, plan R2: the event feed under the table, 360 at most; a side's name and counters under its portrait -->
        <Style Selector="m|MainView.compact Border.feed">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="m|MainView.compact ScrollViewer.feed">
            <Setter Property="MaxHeight" Value="360" />
        </Style>
        <Style Selector="m|MainView.compact Grid.heroLine StackPanel.sideInfo">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="m|MainView.compact DockPanel.opponent">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <Button Classes="ghost" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,7" ToolTip.Tip="{i:Loc Match.View.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Classes="icon" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                <TextBlock Text="{i:Loc Match.View.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- While the game's replay is read -->
        <ContentControl Classes="emptyState" Tag="&#xF051F;" Content="{i:Loc Match.View.Loading}" Margin="0,48,0,0" IsVisible="{Binding Loading}" />

        <StackPanel IsVisible="{Binding !Loading}">
            <!-- Header: you, the result, the opponent; then the game's facts -->
            <DockPanel>
                <!-- The same star and Share as the game's library card; only with a replay file -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding ShowHeaderActions}">
                    <Button Classes="icon headerStar" Classes.starred="{Binding HeaderCard.Starred, FallbackValue=False}" Content="{Binding HeaderCard.StarGlyph}"
                            Command="{Binding ToggleHeaderStar}" ToolTip.Tip="{Binding HeaderCard.StarTip}" AutomationProperties.Name="{Binding HeaderCard.StarTip}" />
                    <Button Classes="icon" Content="&#xF0497;" Margin="4,0,0,0" Command="{Binding ShareHeader}" ToolTip.Tip="{i:Loc Library.Share}"
                            AutomationProperties.Name="{i:Loc Library.Share}" />
                </StackPanel>
                <!-- The player's deck of the game as a picture (proposal C1): a list or a 16:9 cover -->
                <Button Name="DeckImageButton" DockPanel.Dock="Right" Classes="icon" Content="&#xF0638;" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnDeckImage"
                        ToolTip.Tip="{i:Loc Growth.Deck.ButtonTip}" AutomationProperties.Name="{i:Loc Growth.Deck.Button}" IsVisible="{Binding CanShareDeck}" />
                <!-- The step on screen as a PNG picture (plan R4): either mode's table card, as the page shows it -->
                <Button DockPanel.Dock="Right" Classes="icon" Content="&#xF0100;" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnExportStep"
                        ToolTip.Tip="{i:Loc Match.Export.Tip}" AutomationProperties.Name="{i:Loc Match.Export.Tip}" IsVisible="{Binding CanExportStep}" />
                <StackPanel>
                    <TextBlock Text="{Binding Header.Title}" Classes="display pageTitle" FontSize="30" TextWrapping="Wrap" />
                    <c:Wave Classes="pageRule" Margin="2,0,0,10" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Header.Subtitle}" Classes="caption" FontSize="13.5" Margin="2,0,0,18" TextWrapping="Wrap" />
            <!-- The header's status (star, Share, bookmark) or the "only copy" question: one slot, nothing when empty -->
            <DockPanel Margin="2,0,0,12" IsVisible="{Binding HeaderStatus, Converter={StaticResource Truthy}}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderStatusGlyph}" Classes="icon" FontSize="14" VerticalAlignment="Center"
                           Foreground="{Binding HeaderStatusKey, Converter={StaticResource KeyBrush}}" />
                <Button DockPanel.Dock="Right" Classes="bare" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenHeaderStatusFolder}"
                        IsVisible="{Binding HasHeaderStatusFolder}">
                    <TextBlock Text="{i:Loc Library.OpenFolder}" Classes="caption" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
                </Button>
                <TextBlock Text="{Binding HeaderStatus}" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <Border Margin="0,0,0,12" CornerRadius="8" Padding="12,8" Background="{StaticResource NegativeSoft}" BorderBrush="{StaticResource Negative}" BorderThickness="1"
                    IsVisible="{Binding HeaderConfirming}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="12,5" Margin="8,0,0,0" Content="{i:Loc Library.ConfirmNo}" Command="{Binding CancelHeader}" />
                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="12,5" Foreground="{StaticResource Negative}" Content="{Binding HeaderCard.ConfirmLabel}"
                            Command="{Binding ConfirmHeader}" />
                    <TextBlock Text="&#xF05D6;" Classes="icon" FontSize="16" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderCard.ConfirmText, FallbackValue=''}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2"
                                    ClipToBounds="True" i:CardArt.Portrait="{Binding Header.Local.HeroCardId}" ToolTip.Tip="{Binding Header.Local.Hero}" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Local.Name}" FontWeight="Bold" FontSize="17" TextTrimming="CharacterEllipsis" />
                                <DockPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <Border DockPanel.Dock="Left" Classes="pill" Background="{StaticResource AccentContainer}" Margin="0,0,8,0" VerticalAlignment="Center"
                                            IsVisible="{Binding Header.Local.Class, Converter={StaticResource Truthy}}">
                                        <TextBlock Text="{Binding Header.Local.Class}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                                    </Border>
                                    <TextBlock Text="{Binding Header.Local.Hero}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" IsVisible="{Binding Header.Local.Rank, Converter={StaticResource Truthy}}">
                                    <TextBlock Text="&#xF04CE;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header.Local.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <!-- The result: a plate in the result's colour (styles resultPlate.win / .loss) -->
                        <Border Grid.Column="1" Classes="result resultPlate" Classes.win="{Binding Header.Won}" Classes.loss="{Binding Header.Lost}"
                                MinWidth="150" CornerRadius="12" BorderThickness="1.5" Padding="22,8,22,10" Margin="18,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Panel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xF023B;" Classes="icon resultGlyph neutral" FontSize="20" Foreground="{Binding Header.ResultKey, Converter={StaticResource KeyBrush}}" />
                                    <TextBlock Text="&#xF0538;" Classes="icon resultGlyph win" FontSize="20" Foreground="{StaticResource Positive}" />
                                    <TextBlock Text="&#xF068C;" Classes="icon resultGlyph loss" FontSize="20" Foreground="{StaticResource Negative}" />
                                </Panel>
                                <TextBlock Text="{Binding Header.Result}" FontFamily="{DynamicResource DisplayFont}" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{Binding Header.ResultKey, Converter={StaticResource KeyBrush}}" />
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Column="2" Classes="opponent" VerticalAlignment="Center" IsVisible="{Binding ShowOpponent}">
                            <Border DockPanel.Dock="Right" Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Accent2Line}" BorderThickness="2"
                                    ClipToBounds="True" i:CardArt.Portrait="{Binding Header.Opponent.HeroCardId}" ToolTip.Tip="{Binding Header.Opponent.Hero}" />
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Opponent.Name}" FontWeight="Bold" FontSize="17" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <DockPanel Margin="0,4,0,0" HorizontalAlignment="Right">
                                    <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource SecondaryContainer}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding Header.Opponent.Class, Converter={StaticResource Truthy}}">
                                        <TextBlock Text="{Binding Header.Opponent.Class}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                    </Border>
                                    <TextBlock Text="{Binding Header.Opponent.Hero}" Classes="caption" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0" IsVisible="{Binding Header.Opponent.Rank, Converter={StaticResource Truthy}}">
                                    <TextBlock Text="&#xF04CE;" Classes="icon" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header.Opponent.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <!-- Facts (duration, turns, coin, decks...): one strip, values in the display face; wraps at phone width -->
                    <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,10,2,2" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding Header.Facts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="r:MatchFact">
                                    <StackPanel Width="160" Margin="0,0,14,8">
                                        <TextBlock Text="{Binding Label}" Classes="label" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,16" IsVisible="{Binding Missing, Converter={StaticResource Truthy}}">
                <ContentControl Classes="emptyState" Tag="&#xF02FC;" Content="{Binding Missing}" />
            </Border>

            <!-- Tabs -->
            <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,16" IsVisible="{Binding IsConstructed}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabReplay}" GroupName="MatchTab" IsChecked="{Binding ShowReplay}" />
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabDecks}" GroupName="MatchTab" IsChecked="{Binding ShowDecks}" />
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabAnalysis}" GroupName="MatchTab" IsChecked="{Binding ShowAnalysis}" />
                </StackPanel>
            </Border>
            <Border Classes="segmentBar" HorizontalAlignment="Left" Margin="0,0,0,16" IsVisible="{Binding IsBattlegrounds}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabReplay}" GroupName="MatchBgTab" IsChecked="{Binding ShowReplay}"
                                 IsVisible="{Binding HasBattlegroundsSteps}" />
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabRounds}" GroupName="MatchBgTab" IsChecked="{Binding ShowRounds}" />
                    <RadioButton Classes="segment" Content="{i:Loc Match.View.TabLobby}" GroupName="MatchBgTab" IsChecked="{Binding ShowLobby}" />
                </StackPanel>
            </Border>
            <!-- A Battlegrounds file of format 3: rounds and lobby only -->
            <DockPanel Margin="2,0,0,12" IsVisible="{Binding ShowBattlegroundsOldNote}">
                <TextBlock DockPanel.Dock="Left" Text="&#xF02FD;" Classes="icon" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{i:Loc Match.Player.BgOldFile}" Classes="caption" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <!-- ===== Replay: the player (timeline over the bar), then the table of the mode ===== -->
            <StackPanel IsVisible="{Binding ShowReplay}">
                <Border Classes="card" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- "Turn" (G) on the left; the bookmark, ‹ "Bookmarks" › on the right (two lines at phone width) -->
                        <Grid Classes="playerNav" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                            <ComboBox Name="TurnBox" Classes="turns" Width="168" MinHeight="32" Padding="10,5" VerticalAlignment="Center" ItemsSource="{Binding Jumps}"
                                      SelectedIndex="{Binding JumpIndex, Mode=TwoWay}" IsDropDownOpen="{Binding TurnsOpen, Mode=TwoWay}" MaxDropDownHeight="320"
                                      ToolTip.Tip="{i:Loc Match.Player.TurnTip}" AutomationProperties.Name="{i:Loc Match.Player.Turn}" DropDownClosed="OnTurnsClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="mt:MatchJumpRow">
                                        <DockPanel ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                                            <Border DockPanel.Dock="Left" Classes="marker" Classes.mine="{Binding MarkMine}" Classes.theirs="{Binding MarkTheirs}"
                                                    Classes.won="{Binding MarkWon}" Classes.lost="{Binding MarkLost}" Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Classes="bookmarks" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding CanBookmark}">
                                <Button Classes="icon bookmark" Classes.on="{Binding IsBookmarked}" Focusable="False" Content="{Binding BookmarkGlyph}"
                                        Command="{Binding ToggleBookmark}" ToolTip.Tip="{Binding BookmarkTip}" AutomationProperties.Name="{Binding BookmarkTip}" />
                                <Button Classes="icon" Focusable="False" Width="28" Height="28" FontSize="15" Margin="8,0,0,0" Content="&#xF0141;"
                                        Command="{Binding PreviousBookmark}" IsEnabled="{Binding HasPreviousBookmark}" ToolTip.Tip="{i:Loc Match.Player.PreviousBookmark}"
                                        ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{i:Loc Match.Player.PreviousBookmark}" />
                                <Button Name="BookmarksButton" Classes="ghost" Focusable="False" Padding="10,4" Margin="4,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding BookmarksTip}" AutomationProperties.Name="{Binding BookmarksTip}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnBookmarksOpening" />
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0E15;" Classes="icon" FontSize="15" Foreground="{StaticResource OnSecondaryContainer}" VerticalAlignment="Center" />
                                        <TextBlock Text="{i:Loc Match.Player.Bookmarks}" Classes="wide" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BookmarkCountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" IsVisible="{Binding BookmarkCountText, Converter={StaticResource Truthy}}" />
                                        <TextBlock Text="&#xF0140;" Classes="icon" FontSize="14" Foreground="{StaticResource OnSecondaryContainer}" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="icon" Focusable="False" Width="28" Height="28" FontSize="15" Content="&#xF0142;"
                                        Command="{Binding NextBookmark}" IsEnabled="{Binding HasNextBookmark}" ToolTip.Tip="{i:Loc Match.Player.NextBookmark}"
                                        ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{i:Loc Match.Player.NextBookmark}" />
                            </StackPanel>
                        </Grid>
                        <mt:MatchTimeline Segments="{Binding TimelineSegments}" Ticks="{Binding TimelineTicks}" Current="{Binding TimelineCurrent}"
                                          Position="{Binding TimelinePosition}" FrameMax="{Binding FrameMax}" Bookmarks="{Binding BookmarkMarks}" Command="{Binding GoFrame}" />
                        <!-- Turn ‹ event ‹ step ‹ play › step › event › turn; speed, position; side (Constructed) and the keys. Wraps at phone width. -->
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Button Classes="icon" Focusable="False" Content="&#xF04AE;" Command="{Binding PreviousTurn}" ToolTip.Tip="{i:Loc Match.Player.PreviousTurn}" AutomationProperties.Name="{i:Loc Match.Player.PreviousTurn}" />
                                <Button Classes="icon" Focusable="False" Content="&#xF0141;" Command="{Binding PreviousEvent}" ToolTip.Tip="{i:Loc Match.Player.PreviousEvent}" AutomationProperties.Name="{i:Loc Match.Player.PreviousEvent}" Margin="4,0,0,0" />
                                <Button Classes="icon" Focusable="False" Content="&#xF04D5;" Command="{Binding Previous}" ToolTip.Tip="{i:Loc Match.Player.PreviousStep}" AutomationProperties.Name="{i:Loc Match.Player.PreviousStep}" Margin="4,0,0,0" />
                                <Button Classes="ghost primary" Focusable="False" Width="44" Height="32" Padding="0" Margin="12,0" Command="{Binding TogglePlay}" ToolTip.Tip="{Binding PlayTip}" AutomationProperties.Name="{Binding PlayTip}">
                                    <TextBlock Text="{Binding PlayGlyph}" Classes="icon" FontSize="18" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="icon" Focusable="False" Content="&#xF04D7;" Command="{Binding Next}" ToolTip.Tip="{i:Loc Match.Player.NextStep}" AutomationProperties.Name="{i:Loc Match.Player.NextStep}" />
                                <Button Classes="icon" Focusable="False" Content="&#xF0142;" Command="{Binding NextEvent}" ToolTip.Tip="{i:Loc Match.Player.NextEvent}" AutomationProperties.Name="{i:Loc Match.Player.NextEvent}" Margin="4,0,0,0" />
                                <Button Classes="icon" Focusable="False" Content="&#xF04AD;" Command="{Binding NextTurn}" ToolTip.Tip="{i:Loc Match.Player.NextTurn}" AutomationProperties.Name="{i:Loc Match.Player.NextTurn}" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Button Classes="ghost" Focusable="False" Padding="10,4" MinWidth="44" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding CycleSpeed}"
                                        ToolTip.Tip="{i:Loc Match.Player.SpeedTip}">
                                    <TextBlock Text="{Binding SpeedText}" FontFamily="{DynamicResource DisplayFont}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Button>
                                <TextBlock Text="{Binding Position}" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Classes="segmentBar" Margin="0,0,8,0" ToolTip.Tip="{i:Loc Match.View.SideTip}" IsVisible="{Binding ShowSide}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Classes="segment" Content="{i:Loc Match.View.MySide}" GroupName="MatchSide" IsChecked="{Binding BottomLocal}" />
                                        <RadioButton Classes="segment" Content="{i:Loc Match.View.TheirSide}" GroupName="MatchSide" IsChecked="{Binding BottomOpponent}" />
                                    </StackPanel>
                                </Border>
                                <Button Classes="icon" Focusable="False" Content="&#xF0625;" VerticalAlignment="Center" ToolTip.Tip="{Binding HelpText}" AutomationProperties.Name="{i:Loc Match.Player.HelpName}" ToolTip.ShowDelay="200" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Constructed: both sides, the step, the game's event feed (plan R2: the feed's column 260-320, its height
                     the table's, set by the code-behind so the list never stretches the row; under the table at phone width) -->
                <StackPanel IsVisible="{Binding ShowConstructedTable}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.5*" MinWidth="260" MaxWidth="320" />
                        </Grid.ColumnDefinitions>
                        <!-- The table, the step's arrow over it (it never takes the pointer) -->
                        <Border Name="TableCard" Classes="card table" Padding="18,14" VerticalAlignment="Top">
                            <Panel DataContext="{Binding Table}" x:DataType="mt:MatchTable">
                                <StackPanel Classes="ctTable" Classes.attack="{Binding IsAttack}" Classes.mine="{Binding LocalActs}">
                                    <ItemsControl ItemsSource="{Binding Top.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                                    <ContentControl Content="{Binding Top}" ContentTemplate="{StaticResource HeroLine}" />
                                    <ItemsControl ItemsSource="{Binding Top.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                                    <Border Classes="stepBar" Classes.mine="{Binding LocalActs}" CornerRadius="8" Padding="12,7" Margin="0,8" BorderThickness="3,0,0,0" mt:MatchArrowLayer.Middle="True">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Turn}" Classes="stepTurn" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" Margin="0,0,12,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Detail}" />
                                        </DockPanel>
                                    </Border>
                                    <!-- The step's choice: the Discover options, or both mulligans -->
                                    <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" Margin="0,0,0,6"
                                                  IsVisible="{Binding Choices.Count}" />
                                    <ItemsControl ItemsSource="{Binding Bottom.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                                    <ContentControl Content="{Binding Bottom}" ContentTemplate="{StaticResource HeroLine}" />
                                    <ItemsControl ItemsSource="{Binding Bottom.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                                </StackPanel>
                                <mt:MatchArrowLayer Name="Arrow" From="{Binding ActorRef}" To="{Binding TargetRef}" IsAttack="{Binding IsAttack}" Local="{Binding LocalActs}"
                                                    Version="{Binding Version}" />
                            </Panel>
                        </Border>
                        <!-- The game's event feed: every action under its turn's header, the step on screen kept in view. Only
                             the rows near the view are built (a whole game is 100-300 rows). Its column comes from the styles
                             (Border.feed): at phone width it goes under the table. -->
                        <Border Name="FeedCard" Classes="card feed" Padding="16,14" VerticalAlignment="Top">
                            <DockPanel>
                                <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Match.View.Feed}" Icon="&#xF0279;" Size="13" Margin="0,0,0,8" />
                                <ScrollViewer Name="FeedScroll" Classes="feed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl Name="Feed" ItemsSource="{Binding FeedRows}" ItemTemplate="{StaticResource FeedRow}" AutomationProperties.Name="{i:Loc Match.View.FeedName}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TableNote}" Classes="caption" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Battlegrounds (format 4): the step's table, ours at the bottom; the leaderboard and the stretch's events
                     (under the table at phone width) -->
                <Grid x:Name="BattlegroundsTable" ColumnDefinitions="*,16,300" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowBattlegroundsTable}">
                    <Border x:Name="BattlegroundsCard" Classes="card table" Padding="18,14" VerticalAlignment="Top">
                        <StackPanel x:Name="BattlegroundsStepCard" DataContext="{Binding BgTable}" x:DataType="mt:MatchBgTable">
                            <!-- Top: Bob's offer in the tavern, the combat opponent in combat, the hero choice before the first
                                 tavern (no Bob yet); one height, so the step bar stays put -->
                            <Panel MinHeight="168">
                                <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" VerticalAlignment="Center" IsVisible="{Binding ChoicesOnTop}" />
                                <StackPanel IsVisible="{Binding ShowShop}">
                                    <StackPanel Orientation="Horizontal" Height="28">
                                        <TextBlock Text="{i:Loc Match.Player.Table.BobOffer}" Classes="label" VerticalAlignment="Center" />
                                        <Border Classes="pill" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Info}" BorderThickness="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center" IsVisible="{Binding ShopFrozen}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xF0717;" Classes="icon" FontSize="12" Foreground="{StaticResource Info}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{i:Loc Match.Keyword.FROZEN}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Info}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Panel MinHeight="96">
                                        <ItemsControl ItemsSource="{Binding Shop}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                        <TextBlock Text="{i:Loc Match.Player.Table.EmptyShop}" Classes="caption" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsVisible="{Binding !Shop.Count}" />
                                    </Panel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding InCombat}">
                                    <ContentControl Content="{Binding Opponent}" ContentTemplate="{StaticResource BgHeroLine}" Tag="Opponent"
                                                    IsVisible="{Binding Opponent, Converter={StaticResource Truthy}}" />
                                    <Panel MinHeight="96">
                                        <ItemsControl ItemsSource="{Binding OpponentBoard}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                        <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Classes="caption" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsVisible="{Binding !OpponentBoard.Count}" />
                                    </Panel>
                                </StackPanel>
                            </Panel>
                            <!-- The step (styles Border.bgStep.*): tavern in the accent, combat neutral, a combat's end in its result's colour -->
                            <Border Classes="bgStep" Classes.combat="{Binding InCombat}"
                                    Classes.over="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).BattlegroundsCombatOver}"
                                    Classes.won="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).BattlegroundsWon}"
                                    Classes.lost="{Binding $parent[mt:MatchView].((mt:MatchViewModel)DataContext).BattlegroundsLost}"
                                    CornerRadius="8" Padding="12,7" Margin="0,8" BorderThickness="3,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Classes="stepTitle" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" Margin="0,0,12,0"
                                               VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource Surface3}" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding ResultKey, Converter={StaticResource Truthy}}">
                                        <TextBlock Text="{Binding Action}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="caption" MaxWidth="260" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Action}" />
                                </DockPanel>
                            </Border>
                            <!-- The step's choice in the game: Discover, trinket, quest (the hero choice is on top) -->
                            <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" Margin="0,0,0,6" IsVisible="{Binding ChoicesBelow}" />
                            <!-- Bottom: our board, hero and hand; in a Duos combat our partner's board and hero while their table fights -->
                            <StackPanel IsVisible="{Binding !PartnerFighting}">
                                <Panel MinHeight="96">
                                    <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                    <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Classes="caption" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding ShowEmptyBoard}" />
                                </Panel>
                                <ContentControl Content="{Binding Hero}" ContentTemplate="{StaticResource BgHeroLine}" IsVisible="{Binding Hero, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                            <StackPanel x:Name="BattlegroundsPartner" IsVisible="{Binding PartnerFighting}">
                                <StackPanel Orientation="Horizontal" Height="28">
                                    <TextBlock Text="{i:Loc Match.Player.Table.Partner}" Classes="label" VerticalAlignment="Center" />
                                </StackPanel>
                                <Panel MinHeight="96">
                                    <ItemsControl ItemsSource="{Binding PartnerBoard}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                    <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Classes="caption" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding !PartnerBoard.Count}" />
                                </Panel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Hand}" ItemTemplate="{StaticResource BgHandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="100" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="actions">
                        <StackPanel>
                            <Border Classes="card" Padding="16,14">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Match.Player.Leaderboard}" Icon="&#xF0D25;" Size="13" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Leaders}" ItemTemplate="{StaticResource LeaderRow}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Padding="16,14" Margin="0,16,0,0">
                                <DockPanel>
                                    <c:Ornament DockPanel.Dock="Top" Text="{Binding ActionsTitle}" Icon="{Binding ActionsIcon}" Size="13" Margin="0,0,0,8" />
                                    <ScrollViewer x:Name="BgActionsScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="BgActions" ItemsSource="{Binding ActionRows}" ItemTemplate="{StaticResource ActionRow}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="2,8,0,0" IsVisible="{Binding Truncated}">
                    <TextBlock DockPanel.Dock="Left" Text="&#xF05D6;" Classes="icon" FontSize="13" Foreground="{StaticResource Negative}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{i:Loc Match.Player.Truncated}" Classes="caption" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <!-- ===== Decks ===== -->
            <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowDecks}">
                <Border Classes="card first" VerticalAlignment="Top">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.YourDeck}" Icon="&#xF0638;" Size="13" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding LocalDeckNote}" Classes="caption" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding LocalDeck}" ItemTemplate="{StaticResource DeckRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="second" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Classes="card">
                            <StackPanel>
                                <c:Ornament Text="{i:Loc Match.View.OpponentCards}" Icon="&#xF06D0;" Size="13" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OpponentCardsNote}" Classes="caption" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Border Classes="pill" HorizontalAlignment="Left" Margin="0,0,0,10" Background="{StaticResource AccentContainer}"
                                        IsVisible="{Binding ArchetypeLine, Converter={StaticResource Truthy}}">
                                    <TextBlock Text="{Binding ArchetypeLine}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding OpponentCards}" ItemTemplate="{StaticResource DeckRow}" />
                                <ContentControl Classes="emptyState" Tag="&#xF06D0;" Content="{Binding OpponentCardsEmpty}"
                                                IsVisible="{Binding OpponentCards, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                            </StackPanel>
                        </Border>
                        <!-- The archetype's most played meta list: a guess, and says so -->
                        <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding OpponentPredicted, Converter={StaticResource Truthy}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource SecondaryContainer}" VerticalAlignment="Center">
                                        <TextBlock Text="{i:Loc Match.View.PredictedBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                    </Border>
                                    <c:Ornament Text="{i:Loc Match.View.Predicted}" Icon="&#xF0638;" Size="13" HorizontalAlignment="Left" />
                                </DockPanel>
                                <TextBlock Text="{Binding OpponentPredictedNote}" Classes="caption" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding OpponentPredicted}" ItemTemplate="{StaticResource DeckRow}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ===== Analysis (Core MatchAnalysis) ===== -->
            <StackPanel IsVisible="{Binding ShowAnalysis}">
                <Border Classes="card" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Analysis.Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="r:AnalysisTile">
                                <StackPanel Width="200" Margin="0,0,18,8" ToolTip.Tip="{Binding Detail}">
                                    <TextBlock Text="{Binding Label}" Classes="label" />
                                    <TextBlock Text="{Binding Value}" Classes="stat" FontSize="25" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
                    <Border Classes="card first">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.HealthChart}" Icon="&#xF02D1;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip.Tip="{i:Loc Match.View.HealthChartNote}" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalHealth}" Compare="{Binding Analysis.OpponentHealth}" Maximum="{Binding Analysis.HealthMaximum}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card second">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.BoardChart}" Icon="&#xF0787;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip.Tip="{i:Loc Match.View.BoardChartNote}" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalBoard}" Compare="{Binding Analysis.OpponentBoard}" Maximum="{Binding Analysis.BoardMaximum}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
                    <Border Classes="card first" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.KeyCards}" Icon="&#xF01A5;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip.Tip="{i:Loc Match.View.KeyCardsNote}" />
                            <ItemsControl ItemsSource="{Binding Analysis.KeyCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="r:KeyCardRow">
                                        <Border Classes="row" Padding="10,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" Background="{StaticResource Surface4}" ClipToBounds="True"
                                                        VerticalAlignment="Center" i:CardArt.Portrait="{Binding CardId}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Reason}" Classes="caption" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{i:Loc Match.You}" Classes="you" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding Local}" />
                                                <TextBlock Grid.Column="2" Text="{i:Loc Match.Opponent}" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding !Local}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Classes="emptyState" Tag="&#xF01A5;" Content="{i:Loc Match.View.NoKeyCards}"
                                            IsVisible="{Binding Analysis.KeyCards, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card second" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.Mulligan}" Icon="&#xF0450;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Analysis.MulliganNote}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="*,86,64,58" Margin="10,0,10,4">
                                <TextBlock Grid.Column="1" Text="{i:Loc Match.You}" Classes="label" />
                                <TextBlock Grid.Column="2" Text="{i:Loc Match.View.MetaKeep}" Classes="label" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Match.View.MetaKeepTip}" />
                                <TextBlock Grid.Column="3" Text="{i:Loc Match.View.HeldWinRate}" Classes="label" HorizontalAlignment="Right" ToolTip.Tip="{i:Loc Match.View.HeldWinRateTip}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Analysis.Mulligan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="r:MulliganCardRow">
                                        <Border Classes="row" Padding="10,6">
                                            <Grid ColumnDefinitions="Auto,*,86,64,58">
                                                <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0" Background="{StaticResource Surface4}" ClipToBounds="True"
                                                        VerticalAlignment="Center" i:CardArt.Portrait="{Binding CardId}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xF012C;" Classes="icon" FontSize="13" Foreground="{StaticResource Positive}" Margin="0,0,4,0" VerticalAlignment="Center"
                                                               IsVisible="{Binding Agrees}" />
                                                    <TextBlock Text="&#xF0026;" Classes="icon" FontSize="13" Foreground="{StaticResource Negative}" Margin="0,0,4,0" VerticalAlignment="Center"
                                                               IsVisible="{Binding Differs}" />
                                                    <TextBlock Text="{Binding Choice}" FontWeight="SemiBold" Classes.replaced="{Binding !Kept}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding MetaKeep}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding MetaWinRate}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="caption" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="{Binding Analysis.MulliganReceived, Converter={StaticResource Truthy}}">
                                <Run Text="{i:Loc Match.View.CameInstead}" /><Run Text="{Binding Analysis.MulliganReceivedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
                    <Border Classes="card first" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.ManaChart}" Icon="&#xF05E0;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip.Tip="{i:Loc Match.View.ManaChartNote}" />
                            <c:MiniBars Height="80" Values="{Binding Analysis.LocalMana}" Compare="{Binding Analysis.ManaFull}" ShowLabels="True" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card second" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.AgainstMeta}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Analysis.Meta}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="r:MatchFact">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" Classes="label" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Analysis.MetaNote}" Classes="caption" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.TurnByTurn}" Icon="&#xF0467;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel MinWidth="640">
                                <Grid ColumnDefinitions="120,70,70,86,86,60,*" Margin="10,0,10,4">
                                    <TextBlock Text="{i:Loc Match.View.ColTurn}" Classes="label" />
                                    <TextBlock Grid.Column="1" Text="{i:Loc Match.View.ColYourHp}" Classes="label" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="2" Text="{i:Loc Match.View.ColTheirHp}" Classes="label" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="3" Text="{i:Loc Match.View.YourBoard}" Classes="label" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="4" Text="{i:Loc Match.View.ColTheirBoard}" Classes="label" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="5" Text="{i:Loc Match.View.ColMana}" Classes="label" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="6" Text="{i:Loc Match.View.ColPlayed}" Classes="label" Margin="6,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Analysis.TurnRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="r:AnalysisTurnRow">
                                            <Border Classes="row" Padding="10,5">
                                                <Grid ColumnDefinitions="120,70,70,86,86,60,*">
                                                    <TextBlock Text="{Binding Label}" Classes="turnLabel" Classes.you="{Binding Local}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LocalHealth}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding OpponentHealth}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding LocalBoard}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding OpponentBoard}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Mana}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Played}" Classes="caption" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Played}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Battlegrounds rounds ===== -->
            <ItemsControl ItemsSource="{Binding Rounds}" IsVisible="{Binding ShowRounds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="r:MatchRoundView">
                        <Border Classes="card" Margin="0,0,0,12" Padding="20,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontWeight="Bold" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" Classes="caption" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="{i:Loc Match.View.YourBoard}" Classes="label" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsVisible="{Binding OpponentHeroCardId, Converter={StaticResource Truthy}}">
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                                                    ClipToBounds="True" i:CardArt.Portrait="{Binding OpponentHeroCardId}" ToolTip.Tip="{Binding OpponentHero}" />
                                            <TextBlock Text="{i:Loc Match.View.Versus}" Classes="caption" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OpponentHero}" Classes="label" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding OpponentBoard}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Margin="0,6,0,0" IsVisible="{Binding Shop, Converter={StaticResource Truthy}}">
                                    <TextBlock Text="{i:Loc Match.View.TavernOffers}" Classes="label" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Shop}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Battlegrounds lobby ===== -->
            <Border Classes="card" IsVisible="{Binding ShowLobby}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Match.View.TabLobby}" Icon="&#xF0849;" Size="13" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Lobby}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="r:MatchLobbyRow">
                                <Border Classes="row" Padding="10,6">
                                    <Grid ColumnDefinitions="48,Auto,*">
                                        <TextBlock Text="{Binding Place}" Classes.you="{Binding Local}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0" Background="{StaticResource Surface4}" ClipToBounds="True"
                                                i:CardArt.Portrait="{Binding HeroCardId}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hero}" Classes.you="{Binding Local}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
