<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:core="using:Hearthpulse.Core"
             xmlns:s="using:Hearthpulse.UI.Main.Stats"
             xmlns:mm="using:Hearthpulse.UI.Main.Meta"
             xmlns:dk="using:Hearthpulse.UI.Main.Decks"
             xmlns:mt="using:Hearthpulse.UI.Main.Match"
             xmlns:mg="using:Hearthpulse.UI.Main.Migration"
             xmlns:cs="using:Hearthpulse.Core.Stats"
             xmlns:pg="using:Hearthpulse.UI.Main.Pages"
             xmlns:st="using:Hearthpulse.UI.Main.SettingsTabs"
             x:Class="Hearthpulse.UI.Main.SettingsTabs.AboutSettings"
             x:DataType="m:MainViewModel">
    <!-- Settings, About: version, updates, licences. Same tree as the WPF AboutSettings.xaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/MainPages.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Classes="card">
        <StackPanel>
            <c:Ornament Text="{i:Loc Settings.About.Title}" Icon="&#xF02FD;" Size="13" Margin="0,0,0,10" />
            <TextBlock TextWrapping="Wrap" Classes="caption" Text="{i:Loc Settings.About.TextCrossPlatform}" />
            <TextBlock Text="{i:Loc Settings.About.FontsCrossPlatform}" Classes="caption" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{i:Loc Settings.About.Icons}" Classes="caption" FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{i:Loc Settings.Sources.Text}" Classes="caption" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{i:Loc Settings.About.NotAffiliated}" Classes="caption" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding VersionText}" Classes="caption" FontSize="11" Margin="0,10,0,0" />
            <TextBlock x:Name="UpdateStatusLine" Text="{Binding UpdateStatus}" Classes="caption" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            <Button Classes="ghost" x:Name="UpdateCheckButton" Content="{i:Loc Settings.About.CheckNow}" Command="{Binding CheckUpdatesNow}" IsEnabled="{Binding CanCheckUpdates}"
                    ToolTip.Tip="{i:Loc Settings.About.CheckNowTip}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    IsVisible="{Binding UpdateCheckSupported}" />
            <Button x:Name="ReleaseNotesToggle" Classes="bare" Command="{Binding ToggleReleaseNotes}" HorizontalAlignment="Left" Margin="0,8,0,0" IsVisible="{Binding HasReleaseNotes}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ReleaseNotesTitle}" Foreground="{StaticResource Accent}" TextDecorations="Underline" FontSize="12" />
                    <TextBlock Text="{Binding ReleaseNotesGlyph}" Classes="icon" FontSize="14" Foreground="{StaticResource Accent}" Margin="2,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,4,0,0" IsVisible="{Binding ReleaseNotesShown}">
                <TextBlock x:Name="ReleaseNotesText" Text="{Binding ReleaseNotesText}" Classes="caption" FontSize="11" TextWrapping="Wrap" />
                <Button x:Name="ReleasePageLink" Classes="bare" Command="{Binding OpenReleasePage}" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding ReleasePageShown}">
                    <TextBlock Text="{i:Loc Settings.About.AllChanges}" Foreground="{StaticResource Accent}" TextDecorations="Underline" FontSize="11" />
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding ParseErrorsText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource Negative}"
                       IsVisible="{Binding ParseErrorsText, Converter={StaticResource Truthy}}" />
        </StackPanel>
    </Border>
</UserControl>
