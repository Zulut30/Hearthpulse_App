<UserControl x:Class="Hearthpulse.UI.Main.SettingsTabs.StreamSessionSettings"
             x:DataType="m:MainViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- Settings → Stream, in the windows' group: the "Session" window (proposal B1) and "Start a new session", as WPF's
         StreamSessionSettings.xaml. A file of its own so the Settings rework does not touch it. -->
    <StackPanel Margin="0,0,0,14">
        <CheckBox Name="StreamSessionSetting" Classes="switch" Content="{i:Loc Stream.Window.Session}" IsChecked="{Binding StreamSessionWindow}"
                  ToolTip.Tip="{i:Loc Stream.Window.SessionTip}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding StreamSessionWindow}">
            <Button Name="StreamSessionReset" Classes="ghost" Content="{i:Loc Stream.Session.Reset}" Padding="12,4" FontSize="{StaticResource FontSizeLabel}"
                    Click="OnReset" ToolTip.Tip="{i:Loc Stream.Session.ResetTip}" AutomationProperties.Name="{i:Loc Stream.Session.Reset}" />
            <TextBlock Text="{Binding StreamSessionStartText}" Classes="caption" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
