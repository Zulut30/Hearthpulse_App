<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="using:Hearthlens.UI.Main"
        x:Class="Hearthlens.Desktop.MainWindow"
        Title="Hearthlens" Width="1260" Height="840" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Hearthlens.UI/Assets/hearthlens.ico"
        Background="{StaticResource Bg}">
    <main:MainView Name="View" />
</Window>
