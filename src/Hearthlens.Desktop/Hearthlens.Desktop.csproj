<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform desktop app: Windows, macOS and Linux, with the in-game overlay. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hearthlens.Desktop</RootNamespace>
    <AssemblyName>Hearthlens</AssemblyName>
    <Version>0.7.8</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Hearthlens.UI\Assets\hearthlens.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Avalonia's native libraries are resolved per runtime identifier at publish time. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- Off-screen rendering (the render-ui switch) without touching the screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearthlens.UI\Hearthlens.UI.csproj" />
  </ItemGroup>

</Project>
