<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform desktop app: Windows, macOS and Linux, with the in-game overlay. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hearthpulse.Desktop</RootNamespace>
    <AssemblyName>Hearthpulse</AssemblyName>
    <Version>0.13.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Hearthpulse.UI\Assets\hearthpulse.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's native libraries are resolved per runtime identifier at publish time. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- Off-screen rendering (the render-ui switch) without touching the screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearthpulse.UI\Hearthpulse.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GC compacts sooner instead of keeping freed heap committed (same setting as the Windows app). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the exe so every installer carries the licence and the third-party notices. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
