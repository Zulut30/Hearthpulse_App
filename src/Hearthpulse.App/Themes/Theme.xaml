<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette: Hearthstone menus - dark wood and leather, parchment text, gold trim ===== -->
    <Color x:Key="BgColor">#140D08</Color>
    <Color x:Key="SurfaceColor">#21160E</Color>
    <Color x:Key="Surface2Color">#2B1D12</Color>
    <Color x:Key="Surface3Color">#3A2817</Color>
    <Color x:Key="Surface4Color">#4A331E</Color>
    <Color x:Key="BorderColor">#3D2A19</Color>
    <Color x:Key="OutlineColor">#6E4E2C</Color>
    <Color x:Key="TextColor">#F4E7C9</Color>
    <Color x:Key="MutedColor">#CDB894</Color>
    <Color x:Key="FaintColor">#8F7A5C</Color>
    <Color x:Key="AccentColor">#E9B949</Color>
    <Color x:Key="AccentDeepColor">#C48E2C</Color>
    <Color x:Key="AccentContainerColor">#5A3D17</Color>
    <Color x:Key="SecondaryContainerColor">#3F2C19</Color>
    <Color x:Key="PositiveColor">#8CCF63</Color>
    <Color x:Key="NegativeColor">#EC6A52</Color>
    <Color x:Key="InfoColor">#6FB8F2</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Surface4" Color="{StaticResource Surface4Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1FE9B949" />
    <SolidColorBrush x:Key="AccentLine" Color="#99E9B949" />
    <SolidColorBrush x:Key="AccentContainer" Color="{StaticResource AccentContainerColor}" />
    <SolidColorBrush x:Key="OnAccentContainer" Color="#FBE3A6" />
    <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainer" Color="#EBDDBD" />
    <SolidColorBrush x:Key="OnAccent" Color="#2A1906" />
    <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
    <SolidColorBrush x:Key="PositiveSoft" Color="#228CCF63" />
    <SolidColorBrush x:Key="Negative" Color="{StaticResource NegativeColor}" />
    <SolidColorBrush x:Key="NegativeSoft" Color="#24EC6A52" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="Hover" Color="#12F4E7C9" />
    <SolidColorBrush x:Key="Pressed" Color="#1FF4E7C9" />
    <SolidColorBrush x:Key="Decor" Color="#0EE9B949" />
    <SolidColorBrush x:Key="DecorStrong" Color="#16E9B949" />
    <SolidColorBrush x:Key="OverlayPanel" Color="#F0201510" />
    <LinearGradientBrush x:Key="OverlayPanelSolid" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FA2C1F14" Offset="0" />
        <GradientStop Color="#FA1C130C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBorder" Color="#40E9B949" />
    <SolidColorBrush x:Key="Row" Color="#2E1F13" />
    <LinearGradientBrush x:Key="TileFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2E1F13" Offset="0" />
        <GradientStop Color="#FF2E1F13" Offset="0.42" />
        <GradientStop Color="#662E1F13" Offset="0.8" />
        <GradientStop Color="#142E1F13" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBadgeShade" Color="#CC140D08" />
    <SolidColorBrush x:Key="OverlayPlaceholder" Color="#E6201510" />

    <!-- Selection and primary action: a raised leather plate with a gold edge, and a polished gold button -->
    <LinearGradientBrush x:Key="SelectedFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5C4120" Offset="0" />
        <GradientStop Color="#3C2A18" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedEdge" Color="#A27839" />
    <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE79E" Offset="0" />
        <GradientStop Color="#EFC253" Offset="0.45" />
        <GradientStop Color="#C88F2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0C2" Offset="0" />
        <GradientStop Color="#F6CD66" Offset="0.45" />
        <GradientStop Color="#D69C3C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelEdge" Color="{StaticResource BorderColor}" />

    <!-- ===== Gilded Tavern: light falls from above, so every plate is lit on top and trimmed in gold ===== -->
    <LinearGradientBrush x:Key="GildedText" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6D8" Offset="0" />
        <GradientStop Color="#F3CF72" Offset="0.55" />
        <GradientStop Color="#D29A35" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatText" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFAEE" Offset="0" />
        <GradientStop Color="#EDD6A4" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="WindowFill" GradientOrigin="0.1,0" Center="0.1,0" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#22160C" Offset="0" />
        <GradientStop Color="#110B07" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ContentEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#86602F" Offset="0" />
        <GradientStop Color="#3A2919" Offset="0.35" />
        <GradientStop Color="#2A1C12" Offset="1" />
    </LinearGradientBrush>
    <!-- Plates are lit on top: a lighter band fades into the body, and the rim catches the accent -->
    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#352516" Offset="0" />
        <GradientStop Color="#2C1F13" Offset="0.45" />
        <GradientStop Color="#23180F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8A6436" Offset="0" />
        <GradientStop Color="#4A331D" Offset="0.3" />
        <GradientStop Color="#2E1F13" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GhostFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#47321C" Offset="0" />
        <GradientStop Color="#34241A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GhostEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#86603A" Offset="0" />
        <GradientStop Color="#4E3720" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryEdge" Color="#8A5E22" />
    <LinearGradientBrush x:Key="BestEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0C2" Offset="0" />
        <GradientStop Color="#E9B949" Offset="0.45" />
        <GradientStop Color="#A87526" Offset="1" />
    </LinearGradientBrush>
    <!-- A soft gold light behind the recommended option; a gradient, not a bitmap effect, so the overlay stays cheap -->
    <RadialGradientBrush x:Key="BestHalo">
        <GradientStop Color="#4DE9B949" Offset="0.6" />
        <GradientStop Color="#00E9B949" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Sheen" Color="#80FFF4D6" />
    <SolidColorBrush x:Key="GrooveFill" Color="#1A110B" />
    <SolidColorBrush x:Key="GrooveEdge" Color="#36261A" />
    <LinearGradientBrush x:Key="NavSelectedFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#42E9B949" Offset="0" />
        <GradientStop Color="#14E9B949" Offset="0.55" />
        <GradientStop Color="#06E9B949" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelectedEdge" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#AAE9B949" Offset="0" />
        <GradientStop Color="#40E9B949" Offset="0.5" />
        <GradientStop Color="#14E9B949" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayCardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F22E2015" Offset="0" />
        <GradientStop Color="#F01B120B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6E9B949" Offset="0" />
        <GradientStop Color="#45E9B949" Offset="0.35" />
        <GradientStop Color="#2AE9B949" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Character of the theme: a second accent, soft glows and a backdrop motif ===== -->
    <!-- The second accent (patina teal here) takes each preset's own hue (ThemePalette). It decorates; it never
         carries meaning, so results, tiers and rarities keep their own tokens. -->
    <Color x:Key="Accent2Color">#4FC2A8</Color>
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="Accent2Soft" Color="#1F4FC2A8" />
    <SolidColorBrush x:Key="Accent2Line" Color="#994FC2A8" />
    <!-- Halos are gradients, not bitmap effects: free to draw on the overlay -->
    <RadialGradientBrush x:Key="Glow">
        <GradientStop Color="#3DE9B949" Offset="0" />
        <GradientStop Color="#14E9B949" Offset="0.55" />
        <GradientStop Color="#00E9B949" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Accent2Glow">
        <GradientStop Color="#334FC2A8" Offset="0" />
        <GradientStop Color="#0F4FC2A8" Offset="0.55" />
        <GradientStop Color="#004FC2A8" Offset="1" />
    </RadialGradientBrush>
    <!-- A lit hairline for the top edge of a raised plate (selected chips, the primary button) -->
    <LinearGradientBrush x:Key="EdgeLight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFE9B0" Offset="0" />
        <GradientStop Color="#8CFFE9B0" Offset="0.5" />
        <GradientStop Color="#00FFE9B0" Offset="1" />
    </LinearGradientBrush>

    <!-- Backdrop motifs: original line art in a 1000x1000 box, one per preset (Motif<Name> is stroked,
         Motif<Name>Alt is filled with the second accent). ThemeEngine points every use of MotifTavern at the
         theme's own motif. Generated by tools/themes/motifs.py. -->
    <SolidColorBrush x:Key="MotifInk" Color="#17E9B949" />
    <SolidColorBrush x:Key="MotifInk2" Color="#244FC2A8" />
