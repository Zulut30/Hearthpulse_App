<UserControl x:Class="Hearthpulse.App.Main.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core">
    <!-- Home: setup warning, migration card, getting started, tiles, ladder session, BG rating and placements, recent
         games. Same tree as the Avalonia OverviewPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <StackPanel Orientation="Horizontal">
                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Home}" />
                <TextBlock Text="{i:Loc Main.Nav.Home}" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <c:Wave Style="{StaticResource PageRule}" />

            <Border x:Name="SetupBanner" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" CornerRadius="12" Padding="17,13" Margin="0,0,0,16"
                    Visibility="{Binding SetupWarning, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xF002A;" Style="{StaticResource Icon}" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,12,0" />
                    <TextBlock x:Name="SetupWarningText" Grid.Column="1" Text="{Binding SetupWarning}" TextWrapping="Wrap" Foreground="{StaticResource OnAccentContainer}" />
                </Grid>
            </Border>

            <!-- First start: games and decks of HDT / Firestone found on this PC (Main/Migration) -->
            <mg:MigrationCard DataContext="{Binding Migration}" Margin="0,0,0,16"
                              Visibility="{Binding ShowOnHome, Converter={StaticResource Vis}}" />

            <!-- Until the first game is recorded: three steps (the first two follow the app's state) and the two things
                 worth doing before a match. The buttons are the existing import and layout actions. -->
            <Border x:Name="GettingStartedCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding ShowGettingStarted, Converter={StaticResource Vis}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Main.Home.Start.Title}" Icon="&#xF040A;" Size="13" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Top"
                                   Visibility="{Binding HearthstoneRunning, Converter={StaticResource Vis}}" />
                        <TextBlock Text="&#xF0766;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Visibility="{Binding HearthstoneRunning, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step1}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Top"
                                   Visibility="{Binding LogsReady, Converter={StaticResource Vis}}" />
                        <TextBlock Text="&#xF0766;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Visibility="{Binding LogsReady, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step2}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{i:Loc Main.Home.Start.Step2Tip}" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF0766;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Home.Start.Step3}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="GettingStartedSetup" Style="{StaticResource PrimaryButton}" Content="{i:Loc Setup.Open}" Command="{Binding OpenSetup}"
                                ToolTip="{i:Loc Setup.OpenTip}" Margin="0,0,8,0" />
                        <Button x:Name="GettingStartedImport" Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Data.Import}" Click="OnImport" Margin="0,0,8,0"
                                ToolTip="{i:Loc Settings.Data.ImportTip}" />
                        <Button x:Name="GettingStartedArrange" Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Layout.Arrange}" Click="OnArrange" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding OverviewTiles}" ItemTemplate="{StaticResource StatTileTemplate}" ItemsPanel="{StaticResource TilesPanel}"
                          Margin="0,0,-14,16" />

            <!-- Ranked ladder session: Standard and Wild apart (the overlay shows it in the game's menus) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding ShowLadder, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Widgets.Ladder.Title}" Icon="&#xF0538;" Size="13" Margin="0,0,120,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LadderSince}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LadderLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type cs:LadderSessionLine}">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Format}" Style="{StaticResource Label}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Change}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{Binding ChangeValue, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Text="{Binding Ranks}" FontFamily="{StaticResource DisplayFont}" FontSize="18" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{i:Loc Widgets.Ladder.RankNote}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Games, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Faint}" /><Run Text="{Binding Record, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" · " Foreground="{StaticResource Faint}" /><Run Text="{Binding WinRate, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Streak}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"
                                               Foreground="{Binding StreakValue, Converter={StaticResource SignBrush}}" Visibility="{Binding Streak, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The last games first: what a player opens Home for -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Main.Home.RecentGames}" Icon="&#xF02DA;" Size="13" Margin="0,0,120,0" VerticalAlignment="Center" />
                        <Button Content="{i:Loc Main.Home.ViewAll}" Style="{StaticResource GhostButton}" Padding="14,6" FontSize="12" HorizontalAlignment="Right" Click="OnViewHistory" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource OpenGameRow}" />
                    <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF02DA;" Content="{i:Loc Main.Home.NoGames}"
                                    Visibility="{Binding Recent, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Setup.Open}" Command="{Binding OpenSetup}" ToolTip="{i:Loc Setup.OpenTip}"
                            HorizontalAlignment="Center" Margin="0,4,0,8" Visibility="{Binding ShowGettingStarted, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- Your decks (V3): the three decks played last as banners over their class hero's art; a click opens the deck -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HomeDecks, Converter={StaticResource Vis}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Main.Home.YourDecks}" Icon="&#xF063A;" Size="13" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding HomeDecks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:HomeDeck}">
                                <Button Style="{StaticResource BareRow}" Margin="0,0,12,0" ToolTip="{i:Loc Main.Home.OpenDeckTip}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.OpenDeck, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}">
                                    <!-- The key card's art in a square at its own proportions (256 px art in 104): never stretched -->
                                    <Border Height="104" CornerRadius="{StaticResource RadiusLarge}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1"
                                            Background="{StaticResource CardFill}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="102" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="12,0,0,12" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding ArtCardId}" />
                                            <StackPanel Grid.Column="1" Margin="12,8,12,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="{StaticResource RadiusLarge}" Margin="0,0,8,0"
                                                            BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Background="{StaticResource Surface3}"
                                                            i:CardArt.Portrait="{Binding HeroCardId}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                                                <!-- The mana curve, 0 to 7+ -->
                                                <ItemsControl ItemsSource="{Binding Curve}" Height="24" HorizontalAlignment="Left" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type m:HomeDeckBar}">
                                                            <Border Width="8" Height="{Binding Height}" Margin="0,0,4,0" VerticalAlignment="Bottom" CornerRadius="{StaticResource RadiusSmall}"
                                                                    Background="{StaticResource Accent}" ToolTip="{Binding Tip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Battlegrounds rating over time; where you finish is on the Battlegrounds page (My stats) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasBgGames, Converter={StaticResource Vis}}">
                <DockPanel>
                    <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Main.Home.BgRating}" Icon="&#xF012A;" Size="13" Margin="0,0,0,12" />
                    <c:RatingChart Points="{Binding RatingPoints}" Height="200" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
