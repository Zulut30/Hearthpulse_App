<UserControl x:Class="Hearthpulse.App.Main.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core">
    <!-- History: the filter bar and the replay library (Recent, Saved, Imported). Same tree as the Avalonia HistoryPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <Grid Margin="40,0,40,110">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.History}" />
                    <TextBlock Text="{i:Loc Main.Nav.History}" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <c:Wave Style="{StaticResource PageRule}" Margin="2,0,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Orientation="Horizontal">
            <Button x:Name="TimestampsButton" Style="{StaticResource GhostButton}" Content="{i:Loc Growth.Timestamps.Button}" Padding="12,6" Margin="0,0,16,0"
                    FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" Click="OnTimestamps" ToolTip="{i:Loc Growth.Timestamps.ButtonTip}"
                    AutomationProperties.Name="{i:Loc Growth.Timestamps.Button}" />
            <Border Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.History.FilterTip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HistoryAll" Style="{StaticResource Segment}" Content="{i:Loc Main.History.All}" GroupName="Hist" IsChecked="True" Command="{Binding SetHistoryFilter}" CommandParameter="All" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Battlegrounds}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Battlegrounds" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Duos}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Duos" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Ranked}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Ranked" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.History.Other}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Other" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
        <!-- Tabs Recent / Saved / Imported, status, game cards (Main/Match/ReplayLibraryView) -->
        <mt:ReplayLibraryView x:Name="LibraryView" Grid.Row="1" DataContext="{Binding Library}" />
    </Grid>
</UserControl>
