<UserControl x:Class="Hearthpulse.App.Main.Pages.BattlegroundsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core">
    <!-- Battlegrounds: community tiers (heroes, comps, trinkets, cards) and the player's own stats, with the bracket picker. Same tree as the Avalonia BattlegroundsPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Battlegrounds}" />
                        <TextBlock Text="{i:Loc Main.Mode.Battlegrounds}" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <c:Wave Style="{StaticResource PageRule}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Style="{StaticResource SegmentBar}"
                        ToolTip="{i:Loc Main.Bg.ModeTip}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Bg.Solo}" GroupName="BgMode" IsChecked="True" Command="{Binding SetBgMode}" CommandParameter="Battlegrounds" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Duos}" GroupName="BgMode" Command="{Binding SetBgMode}" CommandParameter="Duos" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One tab row: My stats first (as Standard and Wild), then the community tier lists; on its right the period
                 (My stats) or the bracket (the tier lists, only when the stats have a choice) -->
            <Grid Margin="0,0,0,14">
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabMine" Style="{StaticResource Tab}" Content="{i:Loc Stats.Title}" GroupName="BgTab" IsChecked="True" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.MyHeroesTip}" />
                        <RadioButton x:Name="TabHeroes" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Heroes}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.HeroesTip}" />
                        <RadioButton x:Name="TabComps" Style="{StaticResource Tab}" Content="{Binding CompTabLabel}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{Binding CompCaption}" />
                        <RadioButton x:Name="TabTrinkets" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Trinkets}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.TrinketsTip}" />
                        <RadioButton x:Name="TabCards" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Cards}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.CardsCaption}" />
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Stats.Period.Tip}"
                        Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.All}" GroupName="BgPeriod" IsChecked="True" Command="{Binding SetBgPeriod}" CommandParameter="All" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.Week}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Week" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.Month}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Month" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.ThisMonth}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Season"
                                     ToolTip="{i:Loc Stats.Period.ThisMonthBgTip}" />
                    </StackPanel>
                </Border>
                <!-- The brackets the loaded stats have (the API: top 50/20/5/1%); hidden when there is no choice; the window shows it on the tier list tabs -->
                <Grid HorizontalAlignment="Right" Visibility="{Binding HasBracketChoice, Converter={StaticResource Vis}}">
                    <Border x:Name="BracketPicker" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Bg.BracketTip}" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding BracketOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:BracketOption}">
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="Bracket" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding Select}" CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>

            <!-- My stats (Main/Stats): header numbers, MMR over time, hero performance -->
            <s:BattlegroundsStatsView x:Name="BgStats" Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}}" />

            <!-- Tier lists (Main/Meta): heroes and trinkets by tier, comps, cards -->
            <mm:BattlegroundsTiersView x:Name="BgTiers" Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}, ConverterParameter=!}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
