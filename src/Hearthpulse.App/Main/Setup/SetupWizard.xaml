<UserControl x:Class="Hearthpulse.App.Main.Setup.SetupWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration">
    <!-- The setup wizard (D4, MainViewModel.Setup.cs) over the page: a card with round gold step numbers, the step's
         engraved glyph, its few words and one action, then Back / Next. Same tree as the Avalonia SetupWizard.axaml. -->
    <!-- Its own resources: it is built before the window takes it in, so the window's dictionaries (the logo) are not found yet -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource SetupScrim}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" MaxWidth="760" Margin="40,32" Padding="32,24" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header: the logo, the wizard's name and Skip -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{i:Loc Setup.Skip}" Command="{Binding CloseSetup}" VerticalAlignment="Top" />
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource HearthpulseLogo}" Width="40" Height="40" VerticalAlignment="Center" />
                            <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{i:Loc Setup.Title}" Style="{StaticResource H2}" Foreground="{StaticResource GildedText}" />
                                <TextBlock Text="{i:Loc Setup.Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Round gold step numbers on one hairline: the open one lit, the passed ones ticked; each opens its step -->
                    <Grid Margin="0,24,0,24">
                        <Border Height="36" Margin="40,0" VerticalAlignment="Top">
                            <Border Height="1" VerticalAlignment="Center" Background="{StaticResource AccentLine}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SetupSteps}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SetupStepItem}">
                                    <Button Style="{StaticResource BareRow}" HorizontalAlignment="Center" CommandParameter="{Binding Index}"
                                            Command="{Binding DataContext.SetupGo, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                                <Ellipse x:Name="Dot" Fill="{StaticResource Surface3}" Stroke="{StaticResource AccentLine}" StrokeThickness="1.5" />
                                                <TextBlock x:Name="Number" Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Tick" Text="&#xF012C;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource OnAccentContainer}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock x:Name="Name" Text="{Binding Title}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentContainer}" />
                                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource GlyphGoldLit}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource OnAccent}" />
                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- The step: its engraved glyph on a soft glow, then its words and action -->
                    <Grid MinHeight="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="96" Margin="0,0,24,0" VerticalAlignment="Top">
                            <Ellipse Fill="{StaticResource Glow}" />
                            <c:GoldGlyph Width="64" Height="64" Glyph="{x:Static c:GameIcons.Settings}" Visibility="{Binding SetupOnLogs, Converter={StaticResource Vis}}" />
                            <c:GoldGlyph Width="64" Height="64" Glyph="{x:Static c:GameIcons.History}" Visibility="{Binding SetupOnMigration, Converter={StaticResource Vis}}" />
                            <c:GoldGlyph Width="64" Height="64" Glyph="{x:Static c:GameIcons.Standard}" Visibility="{Binding SetupOnLayout, Converter={StaticResource Vis}}" />
                            <c:GoldGlyph Width="64" Height="64" Glyph="{x:Static c:GameIcons.Wild}" Visibility="{Binding SetupOnLook, Converter={StaticResource Vis}}" />
                            <c:GoldGlyph Width="64" Height="64" Glyph="{x:Static c:GameIcons.Home}" Visibility="{Binding SetupOnDone, Converter={StaticResource Vis}}" />
                        </Grid>

                        <!-- 1. Game logs: what they are for, whether they are on, one button that turns them on -->
                        <StackPanel Grid.Column="1" Visibility="{Binding SetupOnLogs, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Setup.Logs.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Setup.Logs.Text}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource Positive}" Margin="0,0,8,0"
                                           Visibility="{Binding SetupLogsOk, Converter={StaticResource Vis}}" />
                                <TextBlock Text="&#xF0028;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource Accent}" Margin="0,0,8,0"
                                           Visibility="{Binding SetupLogsOk, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                <TextBlock Text="{Binding SetupLogsStatus}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Setup.Logs.Fix}" Command="{Binding FixLogs}" HorizontalAlignment="Left"
                                    Visibility="{Binding SetupCanFixLogs, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding SetupLogsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding SetupLogsNote, Converter={StaticResource Vis}}" />
                        </StackPanel>

                        <!-- 2. Moving from HDT or Firestone: the existing migration card, as in Settings > Data -->
                        <StackPanel Grid.Column="1" Visibility="{Binding SetupOnMigration, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Setup.Migration.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Setup.Migration.Text}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <mg:MigrationCard DataContext="{Binding Migration}" Full="True" />
                        </StackPanel>

                        <!-- 3. The overlay panels: what they show, one button into the layout mode -->
                        <StackPanel Grid.Column="1" Visibility="{Binding SetupOnLayout, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Setup.Layout.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Setup.Layout.Text}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <Button x:Name="ArrangeButton" Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Layout.Arrange}" Click="OnArrange" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- 4. The look: the theme presets and the background characters -->
                        <StackPanel Grid.Column="1" Visibility="{Binding SetupOnLook, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Setup.Look.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Setup.Look.Text}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <ItemsControl ItemsSource="{Binding Themes}" Focusable="False" Margin="0,0,-10,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:ThemeChoice}">
                                        <Button Style="{StaticResource ThemeSwatch}" Content="{Binding}" ContentTemplate="{StaticResource ThemeTile}" ToolTip="{Binding Name}"
                                                AutomationProperties.Name="{Binding Name}" CommandParameter="{Binding Key}"
                                                Command="{Binding DataContext.SelectTheme, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Theme.PageHeroes}" IsChecked="{Binding SetupPageHeroes}"
                                      ToolTip="{i:Loc Settings.Theme.PageHeroesTip}" />
                        </StackPanel>

                        <!-- 5. Done: what happens next -->
                        <StackPanel Grid.Column="1" Visibility="{Binding SetupOnDone, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Setup.Done.Title}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                            <TextBlock Text="{i:Loc Setup.Done.Text}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                        </StackPanel>
                    </Grid>

                    <!-- Back / Next, and Start on the last step -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{i:Loc Setup.Back}" Command="{Binding SetupBack}" Margin="0,0,8,0"
                                Visibility="{Binding SetupCanGoBack, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Setup.Next}" Command="{Binding SetupNext}"
                                Visibility="{Binding SetupOnDone, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Setup.Start}" Command="{Binding CloseSetup}"
                                Visibility="{Binding SetupOnDone, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
