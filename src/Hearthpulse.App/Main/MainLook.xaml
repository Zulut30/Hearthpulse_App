<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Main-window look on top of the theme: page headers, tiles with depth, empty states. Theme tokens only;
         the Avalonia twin is Main/MainLook.axaml. -->

    <!-- Page header: the title, then a gold rule under it -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Display}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PageRule" TargetType="c:Wave">
        <Setter Property="Width" Value="168" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="2,0,0,22" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Stat tiles: a card lifted off the page (neutral black shadow, not themed); the edge warms on hover -->
    <Style x:Key="TileCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.3" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- An empty list: the section's glyph in a cookie over one short line, centred. Tag = glyph, Content = text. -->
    <Style x:Key="EmptyState" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,14,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <Grid Width="48" Height="48" HorizontalAlignment="Center">
                            <c:Scallop Fill="{StaticResource AccentContainer}" Lobes="9" Depth="0.12" />
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Icon}" FontSize="22"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Caption}" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="440" Margin="0,10,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
