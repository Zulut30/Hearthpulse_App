<UserControl x:Class="Hearthpulse.App.Main.Share.SessionRecapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Share"
             Width="640">
    <!-- The session recap picture (proposal A1). DataContext: ShareViewModel; Card is a SessionRecapCard. Opaque on Bg: the
         clipboard keeps no transparency. Only the player's own numbers; the BattleTag only when the player turns it on. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Share/ShareLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}" Padding="16">
        <Border Style="{StaticResource Card}" Padding="32,24">
            <StackPanel>
                <ContentControl Template="{StaticResource ShareHeader}" Tag="{i:Loc Growth.Recap.Title}" Content="{Binding Card.When}" Focusable="False" />

                <ItemsControl ItemsSource="{Binding Card.Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type s:RecapSection}">
                            <StackPanel Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <Border Width="40" Height="40" Margin="0,0,12,0" Style="{StaticResource SharePortrait}" i:CardArt.Portrait="{Binding HeroCardId}"
                                            Visibility="{Binding HeroCardId, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="{StaticResource FontSizeSubhead}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource ShareStatTile}" ItemsPanel="{StaticResource ShareTiles3}" Focusable="False" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasPlaces, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{i:Loc Growth.Recap.Places}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource SharePlaceChip}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Card.Empty}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLead}" Margin="0,24" HorizontalAlignment="Center"
                           Visibility="{Binding Card.IsEmpty, Converter={StaticResource Vis}}" />

                <ContentControl Template="{StaticResource ShareFooter}" Focusable="False" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
