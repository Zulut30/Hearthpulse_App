<UserControl x:Class="Hearthpulse.App.Main.Share.DeckListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             Width="420">
    <!-- The deck picture, vertical list (proposal C1): class portrait and name, the rows as the tracker lists them, the
         curve, the code. DataContext: ShareViewModel; Card is a DeckPictureCard. Art from the card art cache, free. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Share/ShareLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}" Padding="16">
        <Border Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Width="56" Height="56" Margin="0,0,12,0" Style="{StaticResource SharePortrait}" i:CardArt.Portrait="{Binding Card.HeroCardId}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Card.Name}" Style="{StaticResource H2}" FontSize="{StaticResource FontSizeSubhead}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Card.Facts}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Card.Rows}" ItemTemplate="{StaticResource ShareDeckRow}" Focusable="False">
                    <!-- The list keeps its rows 28 high (and the gap); only the cover stretches them -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Height" Value="30" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <TextBlock Text="{i:Loc Growth.Deck.Curve}" Style="{StaticResource Label}" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding Card.Curve}" ItemTemplate="{StaticResource ShareCurveBar}" ItemsPanel="{StaticResource ShareCurvePanel}" Focusable="False" />

                <TextBlock Text="{Binding Card.Code}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,16,0,0" />
                <c:Wave Style="{StaticResource PageRule}" Margin="2,12,0,12" />
                <ContentControl Template="{StaticResource ShareBrandFooter}" Focusable="False" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
