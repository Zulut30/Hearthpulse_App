<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
                    xmlns:d="clr-namespace:Hearthpulse.App.Main.Decks"
                    xmlns:s="clr-namespace:Hearthpulse.App.Main.Share">
    <!-- What the share pictures have in common (TASK-2026-11-07-growth-app): the header with the logo, the footer with the
         site, number tiles, place chips, deck rows and the curve. Theme tokens only, so a picture follows the theme. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
        <ResourceDictionary Source="/Hearthpulse;component/Main/Logo.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SharePortrait" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Logo, wordmark and tagline on the left; the picture's title (Tag) and its line (Content) on the right -->
    <ControlTemplate x:Key="ShareHeader" TargetType="ContentControl">
        <StackPanel>
            <DockPanel>
                <Image Source="{StaticResource HearthpulseLogo}" Width="40" Height="40" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource H2}" FontSize="{StaticResource FontSizeSubhead}" HorizontalAlignment="Right" />
                    <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hearthpulse" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="Bold"
                               Foreground="{StaticResource GildedText}" />
                    <TextBlock Text="{i:Loc Growth.Share.Tagline}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
            <c:Wave Style="{StaticResource PageRule}" Margin="2,12,0,0" />
        </StackPanel>
    </ControlTemplate>

    <!-- The BattleTag (only when the player shows it) and the site -->
    <ControlTemplate x:Key="ShareFooter" TargetType="ContentControl">
        <DockPanel Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{i:Loc Growth.Share.Site}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BattleTag}" Style="{StaticResource Label}" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </ControlTemplate>

    <ItemsPanelTemplate x:Key="ShareTiles3">
        <UniformGrid Columns="3" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="ShareTiles4">
        <UniformGrid Columns="4" />
    </ItemsPanelTemplate>

    <!-- A number: label, value (coloured by its sign), a line under it -->
    <DataTemplate x:Key="ShareStatTile" DataType="{x:Type s:ShareStat}">
        <Border Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}"
                Padding="16,12" Margin="0,0,8,8">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="{StaticResource FontSizeHeadline}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Sign}" Value="1">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Sign}" Value="-1">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A Battlegrounds place: gold-edged in the top half -->
    <DataTemplate x:Key="SharePlaceChip" DataType="{x:Type s:SharePlace}">
        <Border x:Name="Chip" MinWidth="28" Height="28" CornerRadius="{StaticResource RadiusPill}" Padding="8,0" Margin="0,0,4,0"
                Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1">
            <TextBlock x:Name="Place" Text="{Binding Text}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLead}"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Top}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Place" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A deck card as the tracker lists it: cost gem, name over the art, copies or the legendary star, rarity edge -->
    <DataTemplate x:Key="ShareDeckRow" DataType="{x:Type d:DeckListRow}">
        <Grid Height="28" Margin="0,0,0,2">
            <Border Background="{StaticResource Row}" CornerRadius="{StaticResource RadiusPill}" c:RoundClip.Radius="14">
                <Grid>
                    <Grid Width="180" HorizontalAlignment="Right">
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                    </Grid>
                    <DockPanel Margin="1,0,4,0">
                        <c:ManaCost Width="26" Height="26" Text="{Binding Cost}" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" MinWidth="24" Height="20" CornerRadius="{StaticResource RadiusPill}" Padding="8,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource OverlayBadgeShade}" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="CountText" Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="CardName" Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
            <Border CornerRadius="{StaticResource RadiusPill}" BorderThickness="1" BorderBrush="{Binding Rarity, Converter={StaticResource KeyBrush}, ConverterParameter=edge}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Rarity}" Value="LEGENDARY">
                <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource RarityLegendary}" />
                <Setter TargetName="CardName" Property="Foreground" Value="{StaticResource RarityLegendary}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One cost of the mana curve: count, bar (share of the tallest), the cost in a gem -->
    <DataTemplate x:Key="ShareCurveBar" DataType="{x:Type d:ManaCurveBar}">
        <StackPanel Margin="2,0" VerticalAlignment="Bottom">
            <TextBlock x:Name="Count" Text="{Binding Count}" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" />
            <Grid Height="64">
                <Border x:Name="Bar" VerticalAlignment="Bottom" MinHeight="2" CornerRadius="2,2,1,1" Background="{StaticResource Accent}"
                        Height="{Binding Fraction, Converter={StaticResource Fraction}, ConverterParameter=64}" />
            </Grid>
            <Border Height="1" Background="{StaticResource Outline}" />
            <c:ManaCost Width="20" Height="20" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Outline}" />
                <Setter TargetName="Count" Property="Foreground" Value="{StaticResource Faint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ShareCurvePanel">
        <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

    <!-- The deck pictures' footer: logo and wordmark (with the BattleTag when shown) and the site -->
    <ControlTemplate x:Key="ShareBrandFooter" TargetType="ContentControl">
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{i:Loc Growth.Share.Site}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <Image Source="{StaticResource HearthpulseLogo}" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="Hearthpulse" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLead}" FontWeight="Bold"
                       Foreground="{StaticResource GildedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BattleTag}" Style="{StaticResource Label}" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </ControlTemplate>

    <!-- Dims the cover's class art under the text and fades it into the background: alpha only, so it follows every theme -->
    <LinearGradientBrush x:Key="ShareArtMask" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#59000000" Offset="0" />
        <GradientStop Color="#80000000" Offset="0.4" />
        <GradientStop Color="#FF000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
