<UserControl x:Class="Hearthpulse.App.Main.Share.YearCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             Width="720">
    <!-- The year in review picture (proposal A3): the favourite class, hero and card as portraits, then the year's numbers.
         DataContext: ShareViewModel; Card is a YearCard. Only the player's own history. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Share/ShareLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}" Padding="16">
        <Border Style="{StaticResource Card}" Padding="32,24">
            <StackPanel>
                <ContentControl Template="{StaticResource ShareHeader}" Tag="{Binding Card.Title}" Content="" Focusable="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,16" Visibility="{Binding Card.IsEmpty, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <Border Width="88" Height="88" Margin="8,0" Style="{StaticResource SharePortrait}" i:CardArt.Portrait="{Binding Card.ClassHeroCardId}"
                            Visibility="{Binding Card.ClassHeroCardId, Converter={StaticResource Vis}}" />
                    <Border Width="88" Height="88" Margin="8,0" Style="{StaticResource SharePortrait}" i:CardArt.Portrait="{Binding Card.HeroCardId}"
                            Visibility="{Binding Card.HasHero, Converter={StaticResource Vis}}" />
                    <Border Width="88" Height="88" Margin="8,0" Style="{StaticResource SharePortrait}" i:CardArt.Portrait="{Binding Card.TopCardId}"
                            Visibility="{Binding Card.HasTopCard, Converter={StaticResource Vis}}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Card.Stats}" ItemTemplate="{StaticResource ShareStatTile}" ItemsPanel="{StaticResource ShareTiles3}" Focusable="False" />

                <TextBlock Text="{Binding Card.Empty}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLead}" Margin="0,24" HorizontalAlignment="Center"
                           TextWrapping="Wrap" Visibility="{Binding Card.IsEmpty, Converter={StaticResource Vis}}" />

                <ContentControl Template="{StaticResource ShareFooter}" Focusable="False" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
