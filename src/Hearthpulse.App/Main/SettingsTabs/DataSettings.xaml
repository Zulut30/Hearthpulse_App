<UserControl x:Class="Hearthpulse.App.Main.SettingsTabs.DataSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core"
             xmlns:pg="clr-namespace:Hearthpulse.App.Main.Pages"
             xmlns:st="clr-namespace:Hearthpulse.App.Main.SettingsTabs">
    <!-- Settings, Data: history, the data folder, where the numbers come from. Same tree as the Avalonia DataSettings.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <!-- Moving over from HDT / Firestone (Main/Migration) -->
        <mg:MigrationCard DataContext="{Binding Migration}" Full="True" Margin="0,0,0,16" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="{i:Loc Settings.Data.Title}" Icon="&#xF01BC;" Size="13" Margin="0,0,0,14" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Data.PoolSharing}" IsChecked="{Binding PoolSharing}"
                          Visibility="{Binding PoolAvailable, Converter={StaticResource Vis}}" Margin="0,0,0,18"
                          ToolTip="{i:Loc Settings.Data.PoolSharingTip}" />
                <!-- Game records of every mode for Hearthpulse's statistics (docs/game-stats.md); off until the player agrees -->
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Data.GameStats}" IsChecked="{Binding GameStatsSharing}"
                          Visibility="{Binding GameStatsAvailable, Converter={StaticResource Vis}}" Margin="0,0,0,4"
                          ToolTip="{i:Loc Settings.Data.GameStatsTip}" />
                <TextBlock Text="{i:Loc Settings.Data.GameStatsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18"
                           Visibility="{Binding GameStatsAvailable, Converter={StaticResource Vis}}" />
                <!-- Plan 0.5: crash reports without asking; off by default -->
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Data.CrashReports}" IsChecked="{Binding CrashReports}" Margin="0,0,0,4" />
                <TextBlock Text="{i:Loc Settings.Data.CrashReportsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Data.Import}" Click="RaiseReimportClicked" Margin="0,0,8,0"
                            ToolTip="{i:Loc Settings.Data.ImportTip}" />
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Data.OpenFolder}" Click="RaiseOpenDataClicked" ToolTip="{i:Loc Settings.Data.OpenFolderTip}" />
                </StackPanel>
                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                <!-- The replay rule was only in the folder path's tip: it decides what is deleted, so it is a visible line -->
                <TextBlock x:Name="ReplayLimitNote" Text="{i:Loc Match.Settings.ReplayLimit}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
