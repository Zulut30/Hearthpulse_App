<UserControl x:Class="Hearthpulse.App.Main.SettingsTabs.SettingsSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Settings search over every tab: the box, and while a query is typed the matches in place of the tabs (Enter or a
         click jumps to the first / the clicked one, Esc clears). Same tree as the Avalonia SettingsSearchBox.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/SettingsTabs/SettingsLook.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Width="420" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBox x:Name="Query" Text="{Binding SettingsQuery, UpdateSourceTrigger=PropertyChanged, Delay=120}" Padding="24,8,40,8" MinWidth="320"
                     AutomationProperties.Name="{i:Loc Settings.Search.Name}" PreviewKeyDown="OnQueryKey" />
            <TextBlock Text="&#xF0349;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource Muted}"
                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="{i:Loc Settings.Search.Placeholder}" Style="{StaticResource Caption}" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding Text, ElementName=Query, Converter={StaticResource Vis}, ConverterParameter=!}" />
            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xF0156;" HorizontalAlignment="Right" Margin="0,0,4,0"
                    Command="{Binding ClearSettingsQuery}" ToolTip="{i:Loc Settings.Search.Clear}" AutomationProperties.Name="{i:Loc Settings.Search.Clear}"
                    Visibility="{Binding SettingsSearching, Converter={StaticResource Vis}}" />
        </Grid>

        <Border Style="{StaticResource Card}" Visibility="{Binding SettingsSearching, Converter={StaticResource Vis}}" MinWidth="420" HorizontalAlignment="Left" Margin="0,0,0,24">
        <StackPanel>
            <ItemsControl x:Name="Hits" ItemsSource="{Binding SettingsHits}" Focusable="False" AutomationProperties.Name="{i:Loc Settings.Search.Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:SettingsEntry}">
                        <Button Style="{StaticResource BareRow}" Command="{Binding DataContext.JumpToSetting, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Path}">
                            <Border Style="{StaticResource RowBorder}" Padding="16,8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xF0142;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{i:Loc Settings.Search.None}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Visibility="{Binding SettingsNoHits, Converter={StaticResource Vis}}" />
        </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
