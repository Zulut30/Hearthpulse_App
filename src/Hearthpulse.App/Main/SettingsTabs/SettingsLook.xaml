<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Hearthpulse.App.Main"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- What the Settings tabs share beyond MainPages.xaml: the "Advanced" disclosure, the per-group reset button, the
         theme gallery's tile and preview, and the accent swatch. The Avalonia twin is SettingsLook.axaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- "Дополнительно": a muted chevron line that opens the rare options of a card under it -->
    <Style x:Key="AdvancedToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="Chevron" Text="&#xF0142;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Сбросить" at the right of a card's heading: puts that card's settings back to their defaults -->
    <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Content" Value="{i:Loc Settings.Reset.Group}" />
        <Setter Property="ToolTip" Value="{i:Loc Settings.Reset.GroupTip}" />
    </Style>

    <!-- An accent swatch: a gem of the colour, a ring when chosen -->
    <Style x:Key="AccentSwatch" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="AccentChip" DataType="{x:Type m:AccentChoice}">
        <Border x:Name="Ring" Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="Transparent" Padding="3">
            <Ellipse Fill="{Binding Fill}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The gallery: each theme as a small main window with its hero, line art, sidebar, a plate with a button in the
         accent, and an overlay panel over the corner with a win/loss mark (meaning colours stay). -->
    <DataTemplate x:Key="GalleryTile" DataType="{x:Type m:ThemeChoice}">
        <Border Width="172" CornerRadius="12" Background="{Binding Background}" BorderBrush="{Binding Frame}" BorderThickness="2" c:RoundClip.Radius="12" SnapsToDevicePixels="True">
            <StackPanel>
                <Grid Height="96" ClipToBounds="True">
                    <Border Width="112" HorizontalAlignment="Right" i:CardArt.Portrait="{Binding Hero}" Opacity="0.6" OpacityMask="{StaticResource PageHeroFade}" />
                    <Path Data="{Binding Motif}" Stretch="Uniform" Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="-24,0,0,-32" Stroke="{Binding Accent}" StrokeThickness="1" Opacity="0.35" />
                    <Grid Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,2,4,0">
                            <Border Height="8" CornerRadius="4" Background="{Binding Surface}">
                                <Border Width="2" Margin="0,1" HorizontalAlignment="Left" Background="{Binding Accent}" />
                            </Border>
                            <Border Height="8" CornerRadius="4" Background="{Binding Surface}" Opacity="0.45" Margin="0,4,0,0" />
                            <Border Height="8" CornerRadius="4" Background="{Binding Surface}" Opacity="0.45" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="78" CornerRadius="4" Background="{Binding Card}" BorderBrush="{Binding Edge}" BorderThickness="1"
                                Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Text}" />
                                <Border Width="56" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Muted}" Margin="0,4,0,0" />
                                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Width="28" Height="8" CornerRadius="4" Background="{Binding Accent}" />
                                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding Secondary}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Width="58" CornerRadius="4" Background="{Binding Panel}" BorderBrush="{Binding Accent}" BorderThickness="1" Padding="4"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                        <StackPanel>
                            <Border Height="4" CornerRadius="2" Background="{Binding Text}" />
                            <Border Height="4" CornerRadius="2" Background="{Binding Muted}" Margin="0,4,8,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="16" Height="4" CornerRadius="2" Background="{StaticResource Positive}" />
                                <Border Width="8" Height="4" CornerRadius="2" Background="{StaticResource Negative}" Margin="2,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <DockPanel Margin="8,4,8,8">
                    <TextBlock DockPanel.Dock="Right" Text="&#xF012C;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{Binding Accent}"
                               Visibility="{Binding Selected, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Name}" Foreground="{Binding Text}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- The preview over the gallery: the theme under the pointer or focus, larger, with its full art -->
    <DataTemplate x:Key="GalleryPreview" DataType="{x:Type m:ThemeChoice}">
        <Border CornerRadius="12" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="2" Height="200" c:RoundClip.Radius="12" SnapsToDevicePixels="True">
            <Grid>
                <Border Width="300" HorizontalAlignment="Right" i:CardArt.Splash="{Binding Hero}" Opacity="0.8" OpacityMask="{StaticResource PageHeroFade}" />
                <Path Data="{Binding Motif}" Stretch="Uniform" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Margin="-48,0,0,-72" Stroke="{Binding Accent}" StrokeThickness="1.2" Opacity="0.3" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,4,12,0">
                        <Border Height="14" CornerRadius="4" Background="{Binding Surface}">
                            <Border Width="3" Margin="0,2" HorizontalAlignment="Left" Background="{Binding Accent}" />
                        </Border>
                        <Border Height="14" CornerRadius="4" Background="{Binding Surface}" Opacity="0.45" Margin="0,8,0,0" />
                        <Border Height="14" CornerRadius="4" Background="{Binding Surface}" Opacity="0.45" Margin="0,8,0,0" />
                        <Border Height="14" CornerRadius="4" Background="{Binding Surface}" Opacity="0.45" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Text}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeHeadline}" TextTrimming="CharacterEllipsis" />
                        <Border Width="200" CornerRadius="8" Background="{Binding Card}" BorderBrush="{Binding Edge}" BorderThickness="1" Padding="12"
                                HorizontalAlignment="Left" Margin="0,12,0,0">
                            <StackPanel>
                                <Border Width="110" Height="8" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding Text}" />
                                <Border Width="150" Height="6" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding Muted}" Margin="0,8,0,0" />
                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Width="64" Height="20" CornerRadius="4" Background="{Binding Accent}" />
                                    <Ellipse DockPanel.Dock="Right" Width="14" Height="14" Fill="{Binding Secondary}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Width="120" CornerRadius="4" Background="{Binding Panel}" BorderBrush="{Binding Accent}" BorderThickness="1" Padding="8"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
                    <StackPanel>
                        <Border Height="6" CornerRadius="4" Background="{Binding Text}" />
                        <Border Height="6" CornerRadius="4" Background="{Binding Muted}" Margin="0,4,24,0" />
                        <Border Height="6" CornerRadius="4" Background="{Binding Muted}" Margin="0,4,40,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="36" Height="8" CornerRadius="4" Background="{StaticResource Positive}" />
                            <Border Width="20" Height="8" CornerRadius="4" Background="{StaticResource Negative}" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
