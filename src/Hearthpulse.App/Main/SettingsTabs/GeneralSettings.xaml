<UserControl x:Class="Hearthpulse.App.Main.SettingsTabs.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core"
             xmlns:pg="clr-namespace:Hearthpulse.App.Main.Pages"
             xmlns:st="clr-namespace:Hearthpulse.App.Main.SettingsTabs">
    <!-- Settings, General: language, theme, app. Same tree as the Avalonia GeneralSettings.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="{i:Loc Settings.Language.Title}" Icon="&#xF05CA;" Size="13" Margin="0,0,0,14" />
                <TextBlock Text="{i:Loc Settings.Note.Language}" Style="{StaticResource CardNote}" />
                <Grid DataContext="{Binding Settings}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Language.Label}" Style="{StaticResource SettingLabel}" ToolTip="{i:Loc Settings.Language.Caption}" />
                    <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Language.System}" GroupName="Language" IsChecked="{Binding LanguageAuto}" />
                            <RadioButton Style="{StaticResource Segment}" Content="English" GroupName="Language" IsChecked="{Binding LanguageEnglish}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Русский" GroupName="Language" IsChecked="{Binding LanguageRussian}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding LanguageRestartHint}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding LanguageRestartHint, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="{i:Loc Settings.Theme.Title}" Icon="&#xF03D8;" Size="13" Margin="0,0,0,14" />
                <TextBlock Text="{i:Loc Settings.Note.Theme}" Style="{StaticResource CardNote}" />
                <TextBlock Text="{i:Loc Settings.Theme.Presets}" Style="{StaticResource SettingGroup}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Themes}" Focusable="False" Margin="0,0,-10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:ThemeChoice}">
                            <!-- The preset's key, not its localized name: the settings keep the key -->
                            <Button Style="{StaticResource ThemeSwatch}" Content="{Binding}" ContentTemplate="{StaticResource ThemeTile}" ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}" CommandParameter="{Binding Key}"
                                    Command="{Binding DataContext.SelectTheme, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{i:Loc Settings.Theme.MakeOwn}" Style="{StaticResource SettingGroup}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding CustomPreview}" ContentTemplate="{StaticResource ThemeTile}" VerticalAlignment="Top" Focusable="False" />
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Settings.Theme.Accent}" Style="{StaticResource SettingLabel}" />
                            <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="10,0,10,-24" VerticalAlignment="Center" Background="{StaticResource HueStrip}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding AccentHue}" SmallChange="5" LargeChange="30"
                                    AutomationProperties.Name="{i:Loc Settings.Theme.Accent}" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Settings.Theme.Background}" Style="{StaticResource SettingLabel}" />
                            <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="10,0,10,-24" VerticalAlignment="Center" Background="{StaticResource HueStrip}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding BaseHue}" SmallChange="5" LargeChange="30"
                                    AutomationProperties.Name="{i:Loc Settings.Theme.Background}" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Settings.Theme.Tint}" Style="{StaticResource SettingLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.5" Value="{Binding BaseTint}" SmallChange="0.05" LargeChange="0.25"
                                    AutomationProperties.Name="{i:Loc Settings.Theme.Tint}" ToolTip="{i:Loc Settings.Theme.TintTip}" />
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Theme.UseMine}" Command="{Binding ApplyCustomTheme}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:Ornament Text="{i:Loc Settings.App.Title}" Icon="&#xF0614;" Size="13" Margin="0,0,0,14" />
                <TextBlock Text="{i:Loc Settings.Note.App}" Style="{StaticResource CardNote}" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.Tray}" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,14" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.AutoUpdate}" IsChecked="{Binding Settings.AutoUpdate}" Click="RaiseSettingClicked"
                          ToolTip="{i:Loc Settings.App.AutoUpdateTip}" Margin="0,0,0,14" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.StartWithWindows}" IsChecked="{Binding Settings.StartWithWindows}" Click="RaiseSettingClicked" Margin="0,0,0,14" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.StartMinimized}" IsChecked="{Binding Settings.StartMinimized}" />
            </StackPanel>
        </Border>

        <!-- Every shortcut in one place (they were only in tips); the keys match App.xaml.cs and MainWindow.xaml.cs -->
        <Border x:Name="ShortcutsCard" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <c:Ornament Text="{i:Loc Settings.Shortcuts.Title}" Icon="&#xF030C;" Size="13" Margin="0,0,0,14" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Shortcuts.Pages}" Style="{StaticResource SettingLabel}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Settings.Shortcuts.PagesKeys}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Shortcuts.Back}" Style="{StaticResource SettingLabel}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Settings.Shortcuts.BackKeys}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Shortcuts.Hide}" Style="{StaticResource SettingLabel}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Settings.Shortcuts.HideKeys}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Shortcuts.Layout}" Style="{StaticResource SettingLabel}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Settings.Shortcuts.LayoutKeys}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Settings.Shortcuts.Refresh}" Style="{StaticResource SettingLabel}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Settings.Shortcuts.RefreshKeys}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
