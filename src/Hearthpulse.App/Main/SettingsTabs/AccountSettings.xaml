<UserControl x:Class="Hearthpulse.App.Main.SettingsTabs.AccountSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core"
             xmlns:pg="clr-namespace:Hearthpulse.App.Main.Pages"
             xmlns:st="clr-namespace:Hearthpulse.App.Main.SettingsTabs">
    <!-- Settings, Account: the hearthpulse.net sign-in and the account center (TASK-2026-11-05-account-center): connection,
         games in the profile, replays on the site, subscription and limits, crash reports. Same tree as the Avalonia
         AccountSettings.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <c:Ornament Text="{i:Loc Settings.Account.Title}" Icon="&#xF0004;" Size="13" Margin="0,0,0,14" />
            <TextBlock Text="{i:Loc Settings.Note.Account}" Style="{StaticResource CardNote}" Margin="0,-6,0,8" />
            <!-- Signed in -->
            <StackPanel Visibility="{Binding AccountShowProfile, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Settings.Account.SignedInAs}" Style="{StaticResource Caption}" Margin="0,4,0,2" />
                <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xF01A5;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,6,0"
                               Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding AccountSubscription}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding AccountSubscription}" Style="{StaticResource Caption}"
                               Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </DockPanel>
                <TextBlock Text="{Binding AccountSessionNote}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}, ConverterParameter=!}" />
                <TextBlock Text="{Binding AccountSessionNote}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}}" />

                <!-- Connection: the one state line (as the main window's indicator) and "Check now" -->
                <TextBlock Text="{i:Loc Account.Center.Connection}" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource Positive}" Visibility="{Binding AccountLinkOk, Converter={StaticResource Vis}}" />
                        <Ellipse Fill="{StaticResource InfoCaution}" Visibility="{Binding AccountLinkWarn, Converter={StaticResource Vis}}" />
                        <Ellipse Fill="{StaticResource Negative}" Visibility="{Binding AccountLinkBad, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock Text="{Binding AccountLinkText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Account.Center.CheckNow}" Command="{Binding CheckAccountNow}" Margin="0,0,12,0"
                            ToolTip="{i:Loc Account.Center.CheckNowTip}" />
                    <TextBlock Text="{i:Loc Account.Center.Checking}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Visibility="{Binding AccountChecking, Converter={StaticResource Vis}}" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0">
                    <Hyperlink Command="{Binding OpenAccountProfile}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Settings.Account.OpenProfile}" /></Hyperlink>
                    <Run Text="&#xF03CC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" />
                </TextBlock>

                <!-- Games to the profile on the site ("My statistics") -->
                <TextBlock Text="{i:Loc Account.Center.Games}" Style="{StaticResource Label}" Margin="0,16,0,0" />
                <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Upload.Switch}" IsChecked="{Binding UploadGames}" Margin="0,8,0,4">
                    <CheckBox.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{i:Loc Upload.Intro}" />
                            <TextBlock Text="{i:Loc Upload.What}" Margin="0,6,0,0" />
                        </StackPanel>
                    </CheckBox.ToolTip>
                </CheckBox>
                <!-- Turning sending off while games wait: they would not be sent, so ask first -->
                <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12" Margin="0,4,0,4" Visibility="{Binding UploadOffConfirming, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding UploadOffConfirmText}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="{i:Loc Account.Center.TurnOff}" Command="{Binding ConfirmUploadOff}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Account.Center.KeepOn}" Command="{Binding KeepUploadOn}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <Hyperlink Command="{Binding OpenPrivacy}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Upload.Privacy}" /></Hyperlink>
                    <Run Text="  &#xB7;  " />
                    <Hyperlink Command="{Binding OpenTrackerData}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Upload.YourData}" /></Hyperlink>
                </TextBlock>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding UploadGames, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding AccountGamesSent}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AccountGamesWaiting}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding AccountGamesWaiting, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding AccountGamesPause}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding AccountGamesPause, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding AccountGamesProblems}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding AccountGamesProblems, Converter={StaticResource Vis}}" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding UploadGames, Converter={StaticResource Vis}}">
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Upload.PastGames}" Command="{Binding UploadPastGames}" Margin="0,0,12,0"
                            ToolTip="{i:Loc Upload.PastGamesTip}" />
                    <TextBlock Text="{Binding UploadStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </WrapPanel>
                <TextBlock Text="{Binding UploadMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding UploadMessage, Converter={StaticResource Vis}}" />

                <!-- Replays on the site -->
                <TextBlock Text="{i:Loc Account.Center.Replays}" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <TextBlock Text="{Binding AccountReplaysText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <TextBlock Text="{i:Loc Account.Center.NotAvailable}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding AccountReplaysUnavailable, Converter={StaticResource Vis}}" />
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink Command="{Binding OpenAccountReplays}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Account.Center.ReplaysOpen}" /></Hyperlink>
                    <Run Text="&#xF03CC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" />
                </TextBlock>

                <!-- Subscription and limits: plan 3.1, the daily free limit of the pool's stats in a game -->
                <TextBlock Text="{i:Loc Account.Center.Limits}" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <TextBlock Text="{Binding AccountLimitsText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding AccountLimitsText, Converter={StaticResource Vis}}" />
                <TextBlock Text="{i:Loc Account.Center.NotAvailable}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding AccountLimitsUnavailable, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding AccountSubscriptionChecked}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Visibility="{Binding AccountSubscriptionChecked, Converter={StaticResource Vis}}" />
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink Command="{Binding OpenAccountSubscription}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Settings.Account.Subscription}" /></Hyperlink>
                    <Run Text="&#xF03CC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" />
                </TextBlock>

                <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Account.SignInAgain}" Command="{Binding SignIn}" Margin="0,0,8,0"
                            Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Account.SignOut}" Command="{Binding SignOut}" />
                </WrapPanel>
            </StackPanel>
            <!-- Signed out -->
            <StackPanel Visibility="{Binding AccountSignedOut, Converter={StaticResource Vis}}">
                <!-- The site ended the sign-in: the same red line as the indicator, above the button -->
                <DockPanel Margin="0,4,0,0" Visibility="{Binding AccountLinkBad, Converter={StaticResource Vis}}">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource Negative}" />
                    <TextBlock Text="{Binding AccountLinkText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Account.SignIn}" Command="{Binding SignIn}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="{i:Loc Settings.Account.SignedOutCaption}" />
            </StackPanel>
            <!-- Signing in: getting a code, then waiting for the player to confirm it on the site -->
            <StackPanel Visibility="{Binding AccountWaiting, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Settings.Account.GettingCode}" Style="{StaticResource Caption}" Margin="0,4,0,14"
                           Visibility="{Binding AccountHasCode, Converter={StaticResource Vis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding AccountHasCode, Converter={StaticResource Vis}}">
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="{i:Loc Settings.Account.Open}" />
                        <Hyperlink Command="{Binding OpenSignInPage}" Foreground="{StaticResource Accent}"><Run Text="{Binding AccountCodeUri, Mode=OneWay}" /></Hyperlink>
                        <Run Text="{i:Loc Settings.Account.EnterCode}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="18,6">
                            <TextBlock Text="{Binding AccountUserCode}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="28"
                                       Foreground="{StaticResource Accent}" />
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CopyAccountCode}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF018F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                                <TextBlock Text="{i:Loc Settings.Account.Copy}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding AccountWaitingHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Account.Cancel}" Command="{Binding CancelSignIn}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Crash reports: no sign-in needed, so shown in every state; the switch itself is in Settings, Data -->
            <TextBlock Text="{i:Loc Account.Center.Crash}" Style="{StaticResource Label}" Margin="0,16,0,4" />
            <TextBlock Text="{Binding AccountCrashText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AccountCrashWaiting}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding AccountCrashWaiting, Converter={StaticResource Vis}}" />
            <TextBlock Text="{i:Loc Account.Center.NotAvailable}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding AccountCrashUnavailable, Converter={StaticResource Vis}}" />

            <TextBlock Text="{Binding AccountMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding AccountMessage, Converter={StaticResource Vis}}" />
        </StackPanel>
    </Border>
</UserControl>
