<UserControl x:Class="Hearthpulse.App.Main.Decks.DeckDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:d="clr-namespace:Hearthpulse.App.Main.Decks">
    <!-- The deck page: one deck family. DataContext is MainViewModel.DeckPage. Colours are theme tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Card cell: cost gem, round art, name, "few games" tag -->
            <DataTemplate x:Key="CardCell" DataType="{x:Type d:DeckCardStatRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ManaGem}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Cost}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Width="28" Height="28" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Copies}" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="Num" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- "+2 / −2 cards ▾": opens a list of card differences (Tag = open) -->
            <Style x:Key="DiffToggle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource Surface4}" CornerRadius="6" Padding="8,2,5,2">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" />
                                    <TextBlock Text="&#xF0140;" Style="{StaticResource Icon}" FontSize="14" Margin="3,0,0,0" Foreground="{TemplateBinding Foreground}"
                                               Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    <TextBlock Text="&#xF0143;" Style="{StaticResource Icon}" FontSize="14" Margin="3,0,0,0" Foreground="{TemplateBinding Foreground}"
                                               Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Outline}" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A card that differs: "+2" / "−1" and its tile; the full card shows on hover -->
            <DataTemplate x:Key="DiffTile" DataType="{x:Type d:CardDiffRow}">
                <Grid Height="28" Margin="0,0,0,3" Background="Transparent" c:CardPreview.CardId="{Binding CardId}" c:CardPreview.Placement="Below">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{Binding Sign, Converter={StaticResource SignBrush}}" />
                    <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                        <Grid>
                            <!-- The art's own edge hides under the fade, as in the overlay's deck rows -->
                            <Grid Width="180" HorizontalAlignment="Right">
                                <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                <Rectangle Fill="{StaticResource TileFade}" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" Margin="9,0,6,0" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- A deck in the "add a deck" list; the picked one is filled -->
            <Style x:Key="CandidateRow" TargetType="Button" BasedOn="{StaticResource RowButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource StatsHead}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: back, portrait, name, class/format/versions, meta archetype -->
        <Button Style="{StaticResource GhostButton}" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,7"
                ToolTip="{i:Loc Deck.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                <TextBlock Text="{i:Loc Deck.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="64" Height="64" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                    i:CardArt.Portrait="{Binding HeroCardId}" />
            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Display}" FontSize="30" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13.5" Margin="2,2,0,0" />
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{StaticResource AccentContainer}"
                        Visibility="{Binding ArchetypeLine, Converter={StaticResource Vis}}" ToolTip="{i:Loc Deck.ArchetypeTip}">
                    <TextBlock Text="{Binding ArchetypeLine}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                </Border>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xF03EB;" VerticalAlignment="Center" Click="OnRename"
                    ToolTip="{i:Loc Deck.Versions.Rename}" />
        </Grid>

        <!-- Matchup filter -->
        <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" Padding="12,6" Margin="0,0,0,14" HorizontalAlignment="Left"
                Visibility="{Binding FilterText, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF0233;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding FilterText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                <Button Style="{StaticResource IconButton}" Content="&#xF0156;" Width="24" Height="24" FontSize="14" Margin="8,0,0,0"
                        Command="{Binding ClearMatchup}" ToolTip="{i:Loc Deck.ClearFilterTip}" />
            </StackPanel>
        </Border>

        <!-- Header numbers -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,0,-14">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,14" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Border>

        <!-- Win rate over time + results by game length -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Deck.Chart.Title}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                        <TextBlock Text="{i:Loc Deck.Chart.Caption}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <c:StatsLineChart x:Name="WinRateChart" Height="200" Points="{Binding Chart}" EmptyText="{i:Loc Deck.Chart.Empty}">
                        <c:StatsLineChart.HoverTemplate>
                            <DataTemplate DataType="{x:Type d:DeckGamePoint}">
                                <Border Width="260" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Style="{StaticResource StatsPortrait}" VerticalAlignment="Top" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                                                i:CardArt.Portrait="{Binding OpponentHeroCardId}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ResultText}" FontWeight="Bold" Foreground="{Binding Result, Converter={StaticResource KeyBrush}}" />
                                                <TextBlock Text=" · " Foreground="{StaticResource Faint}" />
                                                <TextBlock Text="{Binding ChartLabel}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SoFar}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </c:StatsLineChart.HoverTemplate>
                    </c:StatsLineChart>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <c:Ornament Text="{i:Loc Deck.Length.Title}" Icon="&#xF0128;" Size="13" HorizontalAlignment="Left" />
                        <TextBlock Text="{i:Loc Deck.Length.Caption}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <c:ResultBars Height="200" Wins="{Binding LengthWins}" Losses="{Binding LengthLosses}" Labels="{Binding LengthLabels}"
                                  ToolTip="{i:Loc Deck.Length.Tip}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Matchups (the filter) and versions -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <c:Ornament Text="{i:Loc Deck.Matchups.Title}" Icon="&#xF04E5;" Size="13" HorizontalAlignment="Left" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Deck.Matchups.SortTip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Deck.Matchups.SortGames}" GroupName="DeckMatchupSort" IsChecked="True" Command="{Binding SortMatchups}" CommandParameter="Games" />
                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Deck.Matchups.SortWinRate}" GroupName="DeckMatchupSort" Command="{Binding SortMatchups}" CommandParameter="WinRate" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{i:Loc Deck.Matchups.Hint}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Matchups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type d:DeckMatchupRow}">
                                <Button Style="{StaticResource RowButton}" Padding="10,6" Margin="0,0,0,2" Command="{Binding DataContext.SelectMatchup, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}">
                                    <Border x:Name="Plate" CornerRadius="6" Margin="-10,-6" Padding="10,6" BorderThickness="1" BorderBrush="Transparent">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="118" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Portrait" Width="28" Height="28" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Games}" Style="{StaticResource Caption}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="60" Height="7" CornerRadius="3" Background="{StaticResource NegativeSoft}" VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Positive}"
                                                            Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=60}" />
                                                </Border>
                                                <TextBlock Text="{Binding WinRate}" Width="46" TextAlignment="Right" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsArchetype}" Value="True">
                                        <Setter TargetName="Row" Property="Margin" Value="38,0,0,0" />
                                        <Setter TargetName="Portrait" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Few}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="{StaticResource SelectedFill}" />
                                        <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i:Loc Deck.Matchups.Empty}" Style="{StaticResource Caption}" Visibility="{Binding Matchups, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>

            <Border x:Name="VersionsCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Ornament Text="{i:Loc Deck.Versions.Title}" Icon="&#xF062C;" Size="13" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xF03EB;" Width="30" Height="30" FontSize="15" Margin="10,0,0,0"
                                Command="{Binding StartRename}" ToolTip="{i:Loc Deck.Versions.Rename}" />
                    </Grid>

                    <!-- Rename: the deck's own name; empty goes back to the main version's name -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding Renaming, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="6,4"
                                 ToolTip="{i:Loc Deck.Versions.RenameTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding Rename}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRename}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{i:Loc Deck.Versions.Save}" Command="{Binding Rename}"
                                Padding="12,6" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{i:Loc Deck.Versions.Cancel}" Command="{Binding CancelRename}"
                                Padding="10,6" Margin="6,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Versions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type d:DeckVersionRow}">
                                <Border Style="{StaticResource StatsRow}" Margin="-10,0,-10,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="6,1,8,1" Background="{StaticResource AccentContainer}" VerticalAlignment="Center"
                                                            Visibility="{Binding IsMain, Converter={StaticResource Vis}}" ToolTip="{i:Loc Deck.Versions.MainChipTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,4,0" />
                                                            <TextBlock Text="{i:Loc Deck.Versions.MainChip}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Record}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,10,0" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{i:Loc Deck.Versions.WinRateTip}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <c:WinBar Width="64" Height="8" VerticalAlignment="Center" Fraction="{Binding WinFraction}" Games="{Binding Games}" Few="{Binding Few}" />
                                                    <TextBlock Text="{Binding WinRate}" Width="44" TextAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Few}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{i:Loc Deck.Versions.FewGames}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                                                           Visibility="{Binding Few, Converter={StaticResource Vis}}" ToolTip="{Binding FewGamesTip}" />
                                            </StackPanel>
                                            <!-- ⋯ menu: make main, take out, show differences (only in a family of two or more) -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xF01D8;" Width="28" Height="28" FontSize="16" Margin="6,0,-4,0"
                                                    VerticalAlignment="Center" ToolTip="{i:Loc Deck.Versions.MoreTip}" Click="OnMore"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanManage, Converter={StaticResource Vis}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom">
                                                        <MenuItem Header="{i:Loc Deck.Versions.MakeMain}" Visibility="{Binding CanMakeMain, Converter={StaticResource Vis}}"
                                                                  Command="{Binding PlacementTarget.Tag.SetMain, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Key}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="15" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding DiffAction}" Visibility="{Binding HasDiff, Converter={StaticResource Vis}}"
                                                                  Command="{Binding PlacementTarget.Tag.ToggleDiff, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Key}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xF0208;" Style="{StaticResource Icon}" FontSize="15" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{i:Loc Deck.Versions.SplitOff}" ToolTip="{i:Loc Deck.Versions.SplitOffTip}"
                                                                  Command="{Binding PlacementTarget.Tag.Split, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Key}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xF0156;" Style="{StaticResource Icon}" FontSize="15" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                        <Button Style="{StaticResource DiffToggle}" Margin="0,5,0,0" Visibility="{Binding HasDiff, Converter={StaticResource Vis}}"
                                                Command="{Binding DataContext.ToggleDiff, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                                Content="{Binding Changes}" Tag="{Binding DiffOpen}" ToolTip="{i:Loc Deck.Versions.DiffTip}" />
                                        <ItemsControl ItemsSource="{Binding Diff}" ItemTemplate="{StaticResource DiffTile}" Margin="0,6,0,0"
                                                      Visibility="{Binding DiffOpen, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Right after a merge into this deck: undo -->
                    <Border Background="{StaticResource SecondaryContainer}" CornerRadius="8" Padding="12,4,6,4" Margin="0,2,0,8"
                            Visibility="{Binding UndoText, Converter={StaticResource Vis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xF012C;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Positive}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding UndoText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding UndoMerge}" Padding="10,5" Margin="8,0,0,0" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF054C;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,5,0" />
                                    <TextBlock Text="{i:Loc Deck.Versions.Undo}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Decks that look like versions of this one -->
                    <StackPanel Visibility="{Binding Suggestions, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                        <TextBlock Text="{i:Loc Deck.Versions.SuggestionsTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type d:DeckSuggestionRow}">
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource DiffToggle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding Changes, Converter={StaticResource Vis}}"
                                                        Command="{Binding DataContext.ToggleDiff, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SecondKey}"
                                                        Content="{Binding Changes}" Tag="{Binding DiffOpen}" ToolTip="{i:Loc Deck.Versions.ShowCards}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Deck.Versions.Merge}" Padding="12,5" FontSize="12" Margin="8,0,6,0"
                                                            ToolTip="{i:Loc Deck.Versions.MergeTip}"
                                                            Command="{Binding DataContext.Merge, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Deck.Versions.NotSame}" Padding="10,5" FontSize="12"
                                                            ToolTip="{i:Loc Deck.Versions.NotSameTip}"
                                                            Command="{Binding DataContext.Dismiss, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Diff}" ItemTemplate="{StaticResource DiffTile}" Margin="0,8,0,0"
                                                          Visibility="{Binding DiffOpen, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Add another deck of this class and format by hand -->
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0" Command="{Binding TogglePicker}"
                            ToolTip="{i:Loc Deck.Versions.AddDeckTip}" Visibility="{Binding PickerOpen, Converter={StaticResource Vis}, ConverterParameter=!}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0415;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                            <TextBlock Text="{i:Loc Deck.Versions.AddDeck}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="Picker" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12"
                            Margin="0,8,0,0" Visibility="{Binding PickerOpen, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{i:Loc Deck.Versions.PickerTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xF0156;" Width="26" Height="26" FontSize="14"
                                        Command="{Binding TogglePicker}" ToolTip="{i:Loc Deck.Versions.Cancel}" />
                            </Grid>
                            <Grid>
                                <!-- The theme's text box applies Padding twice (frame and text view): 17,4 reads as 34,8 -->
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="17,4,6,4" />
                                <TextBlock Text="&#xF0349;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Faint}" Margin="12,0,0,0"
                                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock Text="{i:Loc Deck.Versions.SearchPlaceholder}" Foreground="{StaticResource Faint}" Margin="36,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource Vis}, ConverterParameter=!}" />
                            </Grid>
                            <ScrollViewer MaxHeight="264" Margin="-4,8,-4,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding Candidates, Converter={StaticResource Vis}}">
                                <ItemsControl ItemsSource="{Binding Candidates}" Margin="4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type d:MergeCandidateRow}">
                                            <Button Style="{StaticResource CandidateRow}" Padding="10,7" Margin="0,0,0,2"
                                                    Command="{Binding DataContext.Choose, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="22" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{i:Loc Deck.Versions.MarkedDifferent}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Faint}"
                                                                   Visibility="{Binding Dismissed, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Shared}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                               Margin="10,0,0,0" ToolTip="{i:Loc Deck.Versions.SharedTip}" />
                                                    <TextBlock Grid.Column="3" Text="&#xF012C;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}"
                                                               HorizontalAlignment="Right" Visibility="{Binding Selected, Converter={StaticResource Vis}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding CandidatesEmpty}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,2,2"
                                       Visibility="{Binding CandidatesEmpty, Converter={StaticResource Vis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{i:Loc Deck.Versions.Cancel}" Command="{Binding TogglePicker}" Padding="12,6" />
                                <Button Content="{i:Loc Deck.Versions.AddChosen}" Command="{Binding AddChosen}" Padding="12,6" Margin="8,0,0,0"
                                        IsEnabled="{Binding CanAddChosen}" ToolTipService.ShowOnDisabled="True">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="ToolTip" Value="{i:Loc Deck.Versions.PickFirst}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Personal mulligan -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="{i:Loc Deck.Mulligan.Title}" Icon="&#xF04E1;" Size="13" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Deck.Mulligan.Card}" Style="{StaticResource StatsHead}" />
                    <TextBlock Grid.Column="1" Text="{i:Loc Deck.Mulligan.Offered}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Mulligan.OfferedTip}" />
                    <TextBlock Grid.Column="2" Text="{i:Loc Deck.Mulligan.Kept}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Mulligan.KeptTip}" />
                    <TextBlock Grid.Column="3" Text="{i:Loc Deck.Mulligan.WrKept}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Mulligan.WrKeptTip}" />
                    <TextBlock Grid.Column="4" Text="{i:Loc Deck.Mulligan.WrReplaced}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Mulligan.WrReplacedTip}" />
                    <TextBlock Grid.Column="6" Text="{i:Loc Deck.Mulligan.MetaKept}" Style="{StaticResource Head}" Foreground="{StaticResource Faint}" ToolTip="{i:Loc Deck.Mulligan.MetaKeptTip}" />
                    <TextBlock Grid.Column="7" Text="{i:Loc Deck.Mulligan.MetaWr}" Style="{StaticResource Head}" Foreground="{StaticResource Faint}" ToolTip="{i:Loc Deck.Mulligan.MetaWrTip}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CardRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckCardStatRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCell}" Focusable="False" />
                                    <TextBlock Grid.Column="1" Text="{Binding Offered}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="3" Text="{Binding KeptWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding KeptSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReplacedWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding ReplacedSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="6" Text="{Binding MetaKeep}" Style="{StaticResource Num}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="7" Text="{Binding MetaWinRate}" Style="{StaticResource Num}" Foreground="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding FewMulligan}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Row" Property="ToolTip" Value="{i:Loc Deck.Mulligan.FewTip}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MulliganNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Card performance -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="{i:Loc Deck.Cards.Title}" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i:Loc Deck.Mulligan.Card}" Style="{StaticResource StatsHead}" />
                    <TextBlock Grid.Column="1" Text="{i:Loc Deck.Cards.Drawn}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Cards.DrawnTip}" />
                    <TextBlock Grid.Column="2" Text="{i:Loc Deck.Cards.WrDrawn}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Cards.WrTip}" />
                    <TextBlock Grid.Column="3" Text="{i:Loc Deck.Cards.Played}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Cards.PlayedTip}" />
                    <TextBlock Grid.Column="4" Text="{i:Loc Deck.Cards.WrPlayed}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Cards.WrTip}" />
                    <TextBlock Grid.Column="5" Text="{i:Loc Deck.Cards.AvgTurn}" Style="{StaticResource Head}" ToolTip="{i:Loc Deck.Cards.AvgTurnTip}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CardRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckCardStatRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCell}" Focusable="False" />
                                    <TextBlock Grid.Column="1" Text="{Binding Drawn}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DrawnWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding DrawnSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Played}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PlayedWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding PlayedSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="5" Text="{Binding AverageTurn}" Style="{StaticResource Num}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding FewDrawn}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Row" Property="ToolTip" Value="{i:Loc Deck.Cards.FewTip}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardsNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Recent games -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Deck.Recent.Title}" Icon="&#xF02DA;" Size="13" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckGameRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding OpponentHeroCardId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Opponent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ResultText}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Result, Converter={StaticResource KeyBrush}}" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xF02DA;" Margin="10,0,0,0" ToolTip="{i:Loc Deck.Recent.ShowInHistory}"
                                            Command="{Binding DataContext.OpenGame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{i:Loc Deck.Recent.Empty}" Style="{StaticResource Caption}" Visibility="{Binding Games, Converter={StaticResource Vis}, ConverterParameter=!}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
