<UserControl x:Class="Hearthpulse.App.Main.Decks.DeckDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:d="clr-namespace:Hearthpulse.App.Main.Decks">
    <!-- The deck page: one deck family. DataContext is MainViewModel.DeckPage. Colours are theme tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Card cell: cost gem, round art, name, "few games" tag -->
            <DataTemplate x:Key="CardCell" DataType="{x:Type d:DeckCardStatRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ManaGem}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Cost}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Width="28" Height="28" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Copies}" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="Num" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource StatsHead}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: back, portrait, name, class/format/versions, meta archetype -->
        <Button Style="{StaticResource GhostButton}" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,7"
                ToolTip="Back to your decks">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                <TextBlock Text="Your decks" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="64" Height="64" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                    i:CardArt.Portrait="{Binding HeroCardId}" />
            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Display}" FontSize="30" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13.5" Margin="2,2,0,0" />
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{StaticResource AccentContainer}"
                        Visibility="{Binding ArchetypeLine, Converter={StaticResource Vis}}" ToolTip="The meta archetype the main version matches, and its community win rate">
                    <TextBlock Text="{Binding ArchetypeLine}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Name the deck (empty: the main version's name)">
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Content="Rename" Command="{Binding Rename}" Margin="8,0,0,0" Padding="14,7" />
            </StackPanel>
        </Grid>

        <!-- Matchup filter -->
        <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" Padding="12,6" Margin="0,0,0,14" HorizontalAlignment="Left"
                Visibility="{Binding FilterText, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF0233;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding FilterText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                <Button Style="{StaticResource IconButton}" Content="&#xF0156;" Width="24" Height="24" FontSize="14" Margin="8,0,0,0"
                        Command="{Binding ClearMatchup}" ToolTip="Show every game again" />
            </StackPanel>
        </Border>

        <!-- Header numbers -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,0,-14">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,14" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Border>

        <!-- Win rate over time + results by game length -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <c:Ornament Text="Win rate over time" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                        <TextBlock Text="After each game" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <c:StatsLineChart x:Name="WinRateChart" Height="200" Points="{Binding Chart}" EmptyText="Finish a game with this deck to start the line.">
                        <c:StatsLineChart.HoverTemplate>
                            <DataTemplate DataType="{x:Type d:DeckGamePoint}">
                                <Border Width="260" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Style="{StaticResource StatsPortrait}" VerticalAlignment="Top" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                                                i:CardArt.Portrait="{Binding OpponentHeroCardId}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Result}" FontWeight="Bold" Foreground="{Binding Result, Converter={StaticResource KeyBrush}}" />
                                                <TextBlock Text=" · " Foreground="{StaticResource Faint}" />
                                                <TextBlock Text="{Binding ChartLabel}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SoFar}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </c:StatsLineChart.HoverTemplate>
                    </c:StatsLineChart>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <c:Ornament Text="Results by length" Icon="&#xF0128;" Size="13" HorizontalAlignment="Left" />
                        <TextBlock Text="Your turns" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <c:ResultBars Height="200" Wins="{Binding LengthWins}" Losses="{Binding LengthLosses}" Labels="{Binding LengthLabels}"
                                  ToolTip="Wins (green) and losses (red) by how many turns you had" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Matchups (the filter) and versions -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <c:Ornament Text="Matchups" Icon="&#xF04E5;" Size="13" HorizontalAlignment="Left" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="Sort">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Games" GroupName="DeckMatchupSort" IsChecked="True" Command="{Binding SortMatchups}" CommandParameter="Games" />
                                <RadioButton Style="{StaticResource Segment}" Content="Win rate" GroupName="DeckMatchupSort" Command="{Binding SortMatchups}" CommandParameter="WinRate" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Click a matchup to see only those games below. Archetypes show when the opponent's cards told." Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Matchups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type d:DeckMatchupRow}">
                                <Button Style="{StaticResource RowButton}" Padding="10,6" Margin="0,0,0,2" Command="{Binding DataContext.SelectMatchup, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}">
                                    <Border x:Name="Plate" CornerRadius="6" Margin="-10,-6" Padding="10,6" BorderThickness="1" BorderBrush="Transparent">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="118" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Portrait" Width="28" Height="28" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Games}" Style="{StaticResource Caption}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="60" Height="7" CornerRadius="3" Background="{StaticResource NegativeSoft}" VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Positive}"
                                                            Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=60}" />
                                                </Border>
                                                <TextBlock Text="{Binding WinRate}" Width="46" TextAlignment="Right" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsArchetype}" Value="True">
                                        <Setter TargetName="Row" Property="Margin" Value="38,0,0,0" />
                                        <Setter TargetName="Portrait" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Few}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="{StaticResource SelectedFill}" />
                                        <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No opponents recorded yet." Style="{StaticResource Caption}" Visibility="{Binding Matchups, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Versions" Icon="&#xF062C;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Versions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type d:DeckVersionRow}">
                                <Border Style="{StaticResource StatsRow}" Margin="-10,0,-10,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="7,1" Background="{StaticResource AccentContainer}"
                                                            Visibility="{Binding IsMain, Converter={StaticResource Vis}}" ToolTip="The main version: its name, cards and archetype stand for the deck">
                                                        <TextBlock Text="main" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="56" Height="7" CornerRadius="3" Background="{StaticResource NegativeSoft}" VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Positive}"
                                                            Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                                                </Border>
                                                <TextBlock Text="{Binding WinRate}" Width="46" TextAlignment="Right" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Diff}" Margin="0,6,0,0" Visibility="{Binding Diff, Converter={StaticResource Vis}}"
                                                      ToolTip="Cards against the main version">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type d:CardDiffRow}">
                                                    <Border Style="{StaticResource Pill}" Margin="0,0,5,5" Padding="7,1">
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Sign, Converter={StaticResource SignBrush}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding CanManage, Converter={StaticResource Vis}}">
                                            <Button Style="{StaticResource GhostButton}" Content="Make main" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.SetMain, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                                    Visibility="{Binding IsMain, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                            <Button Style="{StaticResource GhostButton}" Content="Split off" Padding="10,4" FontSize="12"
                                                    Command="{Binding DataContext.Split, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                                    ToolTip="Make this version a deck of its own again" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Suggested merges with this deck, and a merge by hand -->
                    <StackPanel Visibility="{Binding Suggestions, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                        <TextBlock Text="Looks like the same deck" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type d:DeckSuggestionRow}">
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Merge" Padding="12,5" FontSize="12" Margin="8,0,6,0"
                                                        Command="{Binding DataContext.Merge, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource GhostButton}" Content="Not the same" Padding="10,5" FontSize="12"
                                                        Command="{Binding DataContext.Dismiss, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Margin="0,8,0,0" Visibility="{Binding MergeChoices, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding MergeChoices}" SelectedItem="{Binding MergeChoice}" DisplayMemberPath="Label" VerticalAlignment="Center"
                                  ToolTip="Another deck of this class that is a version of this one" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Merge in" Padding="12,6" Margin="8,0,0,0" Command="{Binding MergeChosen}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Personal mulligan -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="Your mulligan" Icon="&#xF04E1;" Size="13" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Card" Style="{StaticResource StatsHead}" />
                    <TextBlock Grid.Column="1" Text="Offered" Style="{StaticResource Head}" ToolTip="Games the card was in your opening hand before the mulligan" />
                    <TextBlock Grid.Column="2" Text="Kept" Style="{StaticResource Head}" ToolTip="How often you kept it when it was offered" />
                    <TextBlock Grid.Column="3" Text="WR kept" Style="{StaticResource Head}" ToolTip="Your win rate when you kept it" />
                    <TextBlock Grid.Column="4" Text="WR replaced" Style="{StaticResource Head}" ToolTip="Your win rate when you sent it back" />
                    <TextBlock Grid.Column="6" Text="Meta kept" Style="{StaticResource Head}" Foreground="{StaticResource Faint}" ToolTip="How often players of the archetype keep it" />
                    <TextBlock Grid.Column="7" Text="Meta WR" Style="{StaticResource Head}" Foreground="{StaticResource Faint}" ToolTip="Community win rate when it stays in the opening hand" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CardRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckCardStatRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCell}" Focusable="False" />
                                    <TextBlock Grid.Column="1" Text="{Binding Offered}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="3" Text="{Binding KeptWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding KeptSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReplacedWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding ReplacedSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="6" Text="{Binding MetaKeep}" Style="{StaticResource Num}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="7" Text="{Binding MetaWinRate}" Style="{StaticResource Num}" Foreground="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding FewMulligan}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Row" Property="ToolTip" Value="Few games: too few offers to tell" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MulliganNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Card performance -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <c:Ornament Text="Card performance" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Card" Style="{StaticResource StatsHead}" />
                    <TextBlock Grid.Column="1" Text="Drawn" Style="{StaticResource Head}" ToolTip="Games you had it in hand" />
                    <TextBlock Grid.Column="2" Text="WR drawn" Style="{StaticResource Head}" ToolTip="Your win rate in those games" />
                    <TextBlock Grid.Column="3" Text="Played" Style="{StaticResource Head}" ToolTip="Games you played it" />
                    <TextBlock Grid.Column="4" Text="WR played" Style="{StaticResource Head}" ToolTip="Your win rate in those games" />
                    <TextBlock Grid.Column="5" Text="Avg. turn" Style="{StaticResource Head}" ToolTip="The turn you first played it, on average" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CardRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckCardStatRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCell}" Focusable="False" />
                                    <TextBlock Grid.Column="1" Text="{Binding Drawn}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DrawnWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding DrawnSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Played}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PlayedWinRate}" Style="{StaticResource Num}" FontWeight="Bold" Foreground="{Binding PlayedSign, Converter={StaticResource SignBrush}}" />
                                    <TextBlock Grid.Column="5" Text="{Binding AverageTurn}" Style="{StaticResource Num}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding FewDrawn}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Row" Property="ToolTip" Value="Few games: drawn too rarely to tell" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardsNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Recent games -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="Recent games" Icon="&#xF02DA;" Size="13" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type d:DeckGameRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding OpponentHeroCardId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Opponent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Result}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Result, Converter={StaticResource KeyBrush}}" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xF02DA;" Margin="10,0,0,0" ToolTip="Show in History"
                                            Command="{Binding DataContext.OpenGame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No games in this matchup." Style="{StaticResource Caption}" Visibility="{Binding Games, Converter={StaticResource Vis}, ConverterParameter=!}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
