<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Shared by the tier-list views (Main/Meta): Constructed meta, matchups, Battlegrounds tiers. Theme tokens only. -->
    <i:VisibleWhen x:Key="Vis" />
    <i:KeyBrush x:Key="KeyBrush" />
    <i:SignBrush x:Key="SignBrush" />
    <i:FractionWidth x:Key="Fraction" />

    <!-- Long lists of equal-height rows inside a page: only the rows near the page's viewport are built -->
    <ItemsPanelTemplate x:Key="PageRows">
        <c:PageRowsPanel />
    </ItemsPanelTemplate>

    <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A sortable column head: its label and the sort arrow; it brightens under the mouse -->
    <Style x:Key="SortHead" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTip" Value="{i:Loc Main.Meta.SortHeadTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SortLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style x:Key="SortArrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- List rows: no rules, a soft highlight on hover -->
    <Style x:Key="RowBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="-8,0,-8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TierBadge" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A tier's head: the big letter on its colour, "Tier S" and its bound; the tier colour runs down the left edge -->
    <Style x:Key="TierHead" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="-8,8,-8,4" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style x:Key="TierLetter" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- A win rate on hearthpulse.net's scale: green from 51 %, red up to 49 %, plain text between (WinSign) -->
    <Style x:Key="WinRateText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WinSign}" Value="1">
                <Setter Property="Foreground" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding WinSign}" Value="-1">
                <Setter Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A clickable archetype row; the chosen one keeps the selected plate -->
    <Style x:Key="ArchetypeRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="-10,0,-10,3">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                        <Border x:Name="State" CornerRadius="8" Background="{StaticResource Hover}" Opacity="0" />
                        <ContentPresenter Margin="10,6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of a flat tier list as one plate, 46 high (49 with the gap under it): hover and the choice recolour the
         plate itself, so a row is a button, its plate and its content with nothing in between. The plate stands 10 px
         out of the content on each side, as FocusRingRow expects, so the columns stay under the list's head.
         The chosen row does not change under the mouse. -->
    <Style x:Key="MetaRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Height="46" Margin="-10,0,-10,3" Padding="9,4" CornerRadius="8" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tier's letter of a row, in the tier's colour. On the chosen row it takes the text colour: the tier colours
         are too close to the selected plate there (D is about 3:1), and in the table the letter alone names the tier. -->
    <Style x:Key="TierInk" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Tier, Converter={StaticResource KeyBrush}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A tier's head as a row of the same flat list: the height, overhang and gap of MetaRow, the tier colour down the
         left edge (BorderBrush from the row's tier). Its letter is TierLetter. -->
    <Style x:Key="TierRow" TargetType="Border">
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="-10,0,-10,3" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>

    <!-- A segment bar of choices from the view model (rank, period, class, minimum games) -->
    <ItemsPanelTemplate x:Key="ChoiceRow">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ChoiceWrap">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
</ResourceDictionary>
