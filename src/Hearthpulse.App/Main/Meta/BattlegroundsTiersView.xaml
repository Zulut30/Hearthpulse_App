<UserControl x:Class="Hearthpulse.App.Main.Meta.BattlegroundsTiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Battlegrounds tier tabs from the site's service: heroes, comps, trinkets and cards by tavern tier. Each tab
         is one card with a line "source · slice · date", the column heads and one flat list (a tier's head is a row);
         without rows the card shows one empty state instead. A card is built when its tab is first opened (ShowTab):
         the cards are templates here, not elements. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainLook.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Meta/MetaResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A data row as one plate with the geometry of TierRow (46 high, 49 with the gap, 10 out of the content on
                 each side, so the columns stay under the heads). Not a button: the rows take no click and no focus. -->
            <Style x:Key="BgRow" TargetType="Border">
                <Setter Property="Height" Value="46" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="-10,0,-10,3" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Hover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- A comp: the same plate, as high as its texts -->
            <Style x:Key="BgCompRow" TargetType="Border" BasedOn="{StaticResource BgRow}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <!-- The line above a list: source, slice and date of the shown rows, or the slice being loaded -->
            <Style x:Key="BgSource" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- A tier's head as a row of the list, of the same height as a data row -->
            <DataTemplate DataType="{x:Type m:TierHeadRow}">
                <Border Style="{StaticResource TierRow}" BorderBrush="{Binding Tier, Converter={StaticResource KeyBrush}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TierLetter}" Background="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                                   Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Caption}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- One hero, 11 visuals: rank, portrait, name, average place as a number and a bar, the top share, first
                 places, pick rate, the player's own games -->
            <DataTemplate DataType="{x:Type m:MetaHeroRow}">
                <Border Style="{StaticResource BgRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                i:CardArt.Portrait="{Binding CardId}" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="{Binding AveragePlace}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" />
                        <Border Grid.Column="3" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="44,0,0,0"
                                Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=100}" />
                        <TextBlock Grid.Column="4" Text="{Binding Top}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Width="56" TextAlignment="Right" Text="{Binding FirstPlace}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Width="72" TextAlignment="Right" Text="{Binding PickRate}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="{Binding Personal}" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- One trinket, 9 visuals: rank, art, name over its size and cost, average place as a number and a bar, pick rate -->
            <DataTemplate DataType="{x:Type m:MetaTrinketRow}">
                <Border Style="{StaticResource BgRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="192" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <!-- The square portrait crop as the frame's own fill: it covers the frame, centred; a card without art keeps the plain surface -->
                        <Border Grid.Column="1" Width="54" Height="38" CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                i:CardArt.Portrait="{Binding CardId}" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Placement}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" />
                        <Border Grid.Column="3" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="44,0,0,0"
                                Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=140}" />
                        <TextBlock Grid.Column="4" Text="{Binding PickRate}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- One minion or tavern spell, 10 visuals: rank, art, name over its tribes and games, impact with its sign's
                 colour, combat win rate, placement with and without the card, popularity. The three stat columns are
                 there only when the list has numbers (ShowsStats, the same on every row). -->
            <DataTemplate DataType="{x:Type m:MetaCardRow}">
                <Border Style="{StaticResource BgRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <!-- The square portrait crop as the frame's own fill: it covers the frame, centred; a card without art keeps the plain surface -->
                        <Border Grid.Column="1" Width="54" Height="38" CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                i:CardArt.Portrait="{Binding CardId}" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Width="72" TextAlignment="Right" Text="{Binding Impact}" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{Binding ImpactSign, Converter={StaticResource SignBrush}}"
                                   Visibility="{Binding ShowsStats, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Column="4" Width="112" TextAlignment="Right" Text="{Binding CombatWinRate}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                   Visibility="{Binding ShowsStats, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Column="5" Width="112" TextAlignment="Right" Text="{Binding PlacementSplit}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                   Visibility="{Binding ShowsStats, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Column="6" Width="96" TextAlignment="Right" Text="{Binding Popularity}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- One comp (or one tribe of the stand-in list), 6 visuals: name, the line on its right, core cards, tip -->
            <DataTemplate DataType="{x:Type m:MetaCompRow}">
                <Border Style="{StaticResource BgCompRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Side}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Core}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Core, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Tip}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Tip, Converter={StaticResource Vis}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Heroes: a click on a column head sorts the heroes inside their tiers -->
            <DataTemplate x:Key="HeroesCard">
                <Border x:Name="HeroTierCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HeroTab.HasRows, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding HeroTab.Source}" Style="{StaticResource BgSource}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource TableHead}" />
                                <Button Grid.Column="2" Style="{StaticResource SortHead}" Command="{Binding SetHeroSort}" CommandParameter="Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i:Loc Main.Table.Hero}" Style="{StaticResource SortLabel}" />
                                        <TextBlock Text="{Binding HeroArrows.Name}" Style="{StaticResource SortArrow}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource SortHead}" Command="{Binding SetHeroSort}" CommandParameter="Placement">
                                    <StackPanel Orientation="Horizontal" ToolTip="{i:Loc Main.Table.AvgPlacementTip}">
                                        <TextBlock Text="{i:Loc Main.Table.AvgPlacement}" Style="{StaticResource SortLabel}" />
                                        <TextBlock Text="{Binding HeroArrows.Placement}" Style="{StaticResource SortArrow}" />
                                    </StackPanel>
                                </Button>
                                <!-- "Top 4", or "Top 2" while a Duos list is shown -->
                                <Button Grid.Column="4" Style="{StaticResource SortHead}" HorizontalAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="Top4">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding HeroTopTip}">
                                        <TextBlock Text="{Binding HeroTopLabel}" Style="{StaticResource SortLabel}" />
                                        <TextBlock Text="{Binding HeroArrows.Top4}" Style="{StaticResource SortArrow}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Style="{StaticResource SortHead}" HorizontalAlignment="Right" Width="56" HorizontalContentAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="First">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.FirstTip}">
                                        <TextBlock Text="{i:Loc Main.Table.First}" Style="{StaticResource SortLabel}" />
                                        <TextBlock Text="{Binding HeroArrows.First}" Style="{StaticResource SortArrow}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Style="{StaticResource SortHead}" HorizontalAlignment="Right" Width="72" HorizontalContentAlignment="Right" Command="{Binding SetHeroSort}" CommandParameter="Pick">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.PickRateTip}">
                                        <TextBlock Text="{i:Loc Main.Table.PickRate}" Style="{StaticResource SortLabel}" />
                                        <TextBlock Text="{Binding HeroArrows.Pick}" Style="{StaticResource SortArrow}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="7" Text="{i:Loc Main.Table.You}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.YouTip}" />
                            </Grid>
                            <ItemsControl x:Name="HeroTierList" ItemsSource="{Binding HeroTierRows}" ItemsPanel="{StaticResource PageRows}" Focusable="False" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding HeroTab.EmptyGlyph}" Content="{Binding HeroTab.EmptyText}"
                                        Visibility="{Binding HeroTab.HasRows, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Comps by tier, or the pool's tribes: rows as high as their texts, so a plain list -->
            <DataTemplate x:Key="CompsCard">
                <Border x:Name="CompTierCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding CompTab.HasRows, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding CompTab.Source}" Style="{StaticResource BgSource}" />
                            <ItemsControl x:Name="CompTierList" ItemsSource="{Binding CompTiers}" Focusable="False" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding CompTab.EmptyGlyph}" Content="{Binding CompTab.EmptyText}"
                                        Visibility="{Binding CompTab.HasRows, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Trinkets by tier -->
            <DataTemplate x:Key="TrinketsCard">
                <Border x:Name="TrinketTierCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding TrinketTab.HasRows, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding TrinketTab.Source}" Style="{StaticResource BgSource}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="192" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{i:Loc Main.Table.Trinket}" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.AvgPlacement}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Table.TrinketPlacementTip}" />
                                <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.PickRate}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.TrinketPickTip}" />
                            </Grid>
                            <ItemsControl x:Name="TrinketTierList" ItemsSource="{Binding TrinketTierRows}" ItemsPanel="{StaticResource PageRows}" Focusable="False" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding TrinketTab.EmptyGlyph}" Content="{Binding TrinketTab.EmptyText}"
                                        Visibility="{Binding TrinketTab.HasRows, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Cards: the tavern tier picker is always there; under it the minions of the tier, or the tavern spells -->
            <DataTemplate x:Key="CardsCard">
                <Border x:Name="CardStatsCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Bg.CardTierTip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="1" GroupName="CardTier" IsChecked="True" Command="{Binding SetCardTier}" CommandParameter="1" />
                                <RadioButton Style="{StaticResource Segment}" Content="2" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="2" />
                                <RadioButton Style="{StaticResource Segment}" Content="3" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="3" />
                                <RadioButton Style="{StaticResource Segment}" Content="4" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="4" />
                                <RadioButton Style="{StaticResource Segment}" Content="5" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="5" />
                                <RadioButton Style="{StaticResource Segment}" Content="6" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="6" />
                                <RadioButton Style="{StaticResource Segment}" Content="7" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="7" />
                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Bg.Spells}" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding CardTab.HasRows, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding CardTab.Source}" Style="{StaticResource BgSource}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="3" Width="72" TextAlignment="Right" Text="{i:Loc Main.Bg.Impact}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Bg.ImpactTip}"
                                           Visibility="{Binding CardStatsShown, Converter={StaticResource Vis}}" />
                                <TextBlock Grid.Column="4" Width="112" TextAlignment="Right" Text="{i:Loc Main.Bg.CombatWinRate}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Bg.CombatWinRateTip}"
                                           Visibility="{Binding CardStatsShown, Converter={StaticResource Vis}}" />
                                <TextBlock Grid.Column="5" Width="112" TextAlignment="Right" Text="{i:Loc Main.Bg.PlacementSplit}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Bg.PlacementSplitTip}"
                                           Visibility="{Binding CardStatsShown, Converter={StaticResource Vis}}" />
                                <TextBlock Grid.Column="6" Width="96" TextAlignment="Right" Text="{i:Loc Main.Table.Popularity}" Style="{StaticResource TableHead}" />
                            </Grid>
                            <ItemsControl x:Name="CardTierList" ItemsSource="{Binding CardTierRows}" ItemsPanel="{StaticResource PageRows}" Focusable="False" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding CardTab.EmptyGlyph}" Content="{Binding CardTab.EmptyText}"
                                        Visibility="{Binding CardTab.HasRows, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The cards of the tabs opened so far; one is shown at a time -->
    <Grid x:Name="Cards" />
</UserControl>
