<UserControl x:Class="Hearthpulse.App.Main.Meta.ConstructedMetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Standard/Wild community tabs, as hearthpulse.net lays them out: filters, the tier list (tiers or one sortable
         table) beside the chosen archetype's mulligan guide and lists, the top decks, and the matchup heat map. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainLook.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Meta/MetaResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One archetype, 14 visuals from the button down: rank, portrait, name over its detail (English name, class,
                 games) in one cell, the tier's letter in its colour, win rate and popularity as a number and a bar, the
                 play split in one text. No key: both lists (tiers and table) pick it by the row's type. -->
            <DataTemplate DataType="{x:Type m:MetaArchetypeRow}">
                <Button Style="{StaticResource MetaRow}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.SelectArchetype, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                i:CardArt.Portrait="{Binding HeroId}" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Tier}" Width="30" HorizontalAlignment="Left" TextAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Grid.Column="4" Text="{Binding WinRate}" Width="56" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Style="{StaticResource WinRateText}" ToolTip="{Binding WinRateTip}" />
                        <Border Grid.Column="4" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="56,0,0,0"
                                Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                        <TextBlock Grid.Column="5" Text="{Binding Popularity}" Width="48" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" />
                        <Border Grid.Column="5" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"
                                Background="{StaticResource Accent}"
                                Width="{Binding PopularityFraction, Converter={StaticResource Fraction}, ConverterParameter=44}" />
                        <!-- Shown only when the source splits games by who went first -->
                        <TextBlock Grid.Column="6" Width="96" Text="{Binding PlaySplit}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.MetaHasPlaySplit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" />
                    </Grid>
                </Button>
            </DataTemplate>

            <!-- A tier's head as a row of the same list and of the same height: the letter on its colour, "Tier S", then
                 its bound and count, or that the tier is empty. Not a button. -->
            <DataTemplate DataType="{x:Type m:TierHeadRow}">
                <Border Style="{StaticResource TierRow}" BorderBrush="{Binding Tier, Converter={StaticResource KeyBrush}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TierLetter}" Background="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                                   Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Caption}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MetaDeckTemplate" DataType="{x:Type m:MetaDeckRow}">
                <Border Style="{StaticResource RowBorder}" Padding="8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                i:CardArt.Portrait="{Binding HeroId}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Class}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" ToolTip="{i:Loc Main.Table.WinRate}" />
                        <TextBlock Grid.Column="3" Text="{Binding Games}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="{i:Loc Main.Meta.ExactListTip}" />
                        <TextBlock Grid.Column="4" Text="{Binding Dust}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="{i:Loc Main.Meta.DustTip}" />
                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="{i:Loc Main.Meta.Copy}" Padding="12,4" FontSize="{StaticResource FontSizeLabel}" Margin="12,0,0,0"
                                Command="{Binding DataContext.CopyDeck, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="{i:Loc Main.Meta.CopyTip}" />
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Filters: rank and period, then class and minimum games (hearthpulse.net's "Рейтинг", "Период", "Минимум игр") -->
        <StackPanel x:Name="MetaFilters" Margin="0,0,0,12">
            <!-- Plan 2.4: eight rank chips; the periods move below them when the row is too narrow, as in Avalonia -->
            <WrapPanel Margin="0,0,0,2">
                <Border Margin="0,0,12,8" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.RankTip}">
                    <ItemsControl ItemsSource="{Binding MetaRanks}" ItemsPanel="{StaticResource ChoiceWrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaRank" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetMetaRank, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Margin="0,0,0,8" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.PeriodTip}">
                    <ItemsControl ItemsSource="{Binding MetaPeriods}" ItemsPanel="{StaticResource ChoiceRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaPeriod" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetMetaPeriod, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </WrapPanel>
            <DockPanel>
                <Border x:Name="MinGamesPicker" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Meta.MinGamesTip}">
                    <ItemsControl ItemsSource="{Binding MetaMinGames}" ItemsPanel="{StaticResource ChoiceRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaMinGames" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetMetaMinGames, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.ClassTip}">
                    <ItemsControl ItemsSource="{Binding MetaClasses}" ItemsPanel="{StaticResource ChoiceWrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaClass" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetMetaClass, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </StackPanel>

        <!-- Meta tier list: archetypes on the left, the chosen one's mulligan guide and best lists on the right -->
        <Grid x:Name="MetaTiersPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MaxWidth="420" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <c:Ornament Text="{Binding ConstructedTitle}" Icon="&#xF11D0;" Size="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="{i:Loc Main.Meta.TierTip}" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Meta.ViewTip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Meta.ViewTiers}" GroupName="MetaView" IsChecked="{Binding MetaTierView, Mode=OneWay}"
                                             Command="{Binding SetMetaView}" CommandParameter="Tiers" />
                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Meta.ViewTable}" GroupName="MetaView" IsChecked="{Binding MetaTableView, Mode=OneWay}"
                                             Command="{Binding SetMetaView}" CommandParameter="Table" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Column heads: a click sorts by the column, again turns the order round -->
                    <Grid x:Name="MetaHead" Margin="0,0,0,4" Visibility="{Binding HasMetaArchetypes, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource TableHead}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource SortHead}" Command="{Binding SetMetaSort}" CommandParameter="Name">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{i:Loc Main.Table.Archetype}" Style="{StaticResource SortLabel}" />
                                    <TextBlock Text="{Binding MetaArrows.Name}" Style="{StaticResource SortArrow}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text=" · " Style="{StaticResource TableHead}" />
                            <Button Style="{StaticResource SortHead}" Command="{Binding SetMetaSort}" CommandParameter="Games">
                                <StackPanel Orientation="Horizontal" ToolTip="{i:Loc Main.Meta.GamesTip}">
                                    <TextBlock Text="{i:Loc Main.Table.Games}" Style="{StaticResource SortLabel}" />
                                    <TextBlock Text="{Binding MetaArrows.Games}" Style="{StaticResource SortArrow}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource SortHead}" Command="{Binding SetMetaSort}" CommandParameter="Tier">
                            <StackPanel Orientation="Horizontal" ToolTip="{i:Loc Main.Meta.TierTip}">
                                <TextBlock Text="{i:Loc Main.Table.Tier}" Style="{StaticResource SortLabel}" />
                                <TextBlock Text="{Binding MetaArrows.Tier}" Style="{StaticResource SortArrow}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource SortHead}" Command="{Binding SetMetaSort}" CommandParameter="WinRate">
                            <StackPanel Orientation="Horizontal" ToolTip="{i:Loc Main.Meta.WinRateTip}">
                                <TextBlock Text="{i:Loc Main.Table.WinRate}" Style="{StaticResource SortLabel}" />
                                <TextBlock Text="{Binding MetaArrows.WinRate}" Style="{StaticResource SortArrow}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource SortHead}" Command="{Binding SetMetaSort}" CommandParameter="Popularity">
                            <StackPanel Orientation="Horizontal" ToolTip="{i:Loc Main.Meta.PopularityTip}">
                                <TextBlock Text="{i:Loc Main.Table.Popularity}" Style="{StaticResource SortLabel}" />
                                <TextBlock Text="{Binding MetaArrows.Popularity}" Style="{StaticResource SortArrow}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="6" Width="96" Text="{i:Loc Main.Meta.PlaySplit}" Style="{StaticResource TableHead}" TextAlignment="Right"
                                   ToolTip="{i:Loc Main.Meta.PlaySplitTip}" Visibility="{Binding MetaHasPlaySplit, Converter={StaticResource Vis}}" />
                    </Grid>

                    <!-- Tiers: S to D in one flat list, a tier's head and then its archetypes; an empty tier is its head alone,
                         saying so (as on the site). The list is changed in place, so the rows that stay keep their visuals. -->
                    <ItemsControl x:Name="MetaTierList" ItemsSource="{Binding MetaTierRows}" ItemsPanel="{StaticResource PageRows}" Focusable="False"
                                  Visibility="{Binding MetaTierView, Converter={StaticResource Vis}}" />

                    <!-- Table: the archetypes alone, in the chosen order -->
                    <ItemsControl x:Name="MetaTable" ItemsSource="{Binding MetaArchetypes}" ItemsPanel="{StaticResource PageRows}" Focusable="False"
                                  Visibility="{Binding MetaTableView, Converter={StaticResource Vis}}" />

                    <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}"
                                    Visibility="{Binding MetaLoading, Converter={StaticResource Vis}}" />
                    <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}"
                                    Visibility="{Binding MetaUnavailable, Converter={StaticResource Vis}}" />
                    <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF0233;" Content="{i:Loc Main.Meta.Empty}"
                                    Visibility="{Binding MetaEmpty, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding ConstructedMetaStatus}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                               TextWrapping="Wrap" Visibility="{Binding MetaStatusShown, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <Border x:Name="ArchetypeCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedArchetypeTitle}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArchetypeSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <!-- The sections come in one step after the list is ready for input (ArchetypeDetailScheduler, set in the
                         code-behind); until the first build nothing stands here, not a false "not enough games". -->
                    <StackPanel x:Name="ArchetypeSections" Visibility="{Binding ArchetypeDetailReady, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding DetailArchetype.HasPlaySplit, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <Border Style="{StaticResource SegmentBar}" Padding="12,4" Margin="0,0,8,0" ToolTip="{i:Loc Main.Meta.FirstTip}">
                            <TextBlock><Run Text="{i:Loc Main.Meta.GoingFirst}" Foreground="{StaticResource Muted}" /><Run Text="{Binding DetailArchetype.First, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                        </Border>
                        <Border Style="{StaticResource SegmentBar}" Padding="12,4" ToolTip="{i:Loc Main.Meta.CoinTip}">
                            <TextBlock><Run Text="{i:Loc Main.Meta.OnCoin}" Foreground="{StaticResource Muted}" /><Run Text="{Binding DetailArchetype.Coin, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                        </Border>
                    </StackPanel>

                    <c:Ornament Text="{i:Loc Main.Meta.MulliganGuide}" Icon="&#xF012C;" Size="13" Margin="0,16,0,8"
                                ToolTip="{i:Loc Main.Meta.MulliganCaption}" />
                    <!-- Plan 2.4: the mulligan's own rank (Legend by default); the overlay follows it -->
                    <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" Margin="0,0,0,4" ToolTip="{i:Loc Main.Meta.MulliganRankTip}">
                        <ItemsControl ItemsSource="{Binding MulliganRanks}" ItemsPanel="{StaticResource ChoiceWrap}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:MetaChoice}">
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MulliganRank" IsChecked="{Binding Selected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetMulliganRank, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding MulliganSource}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding MulliganSource, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Mulligan}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MulliganRow}">
                                <Border Style="{StaticResource RowBorder}" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <!-- Fixed, so every row's "kept N%" and name trim line up -->
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                i:CardArt.Portrait="{Binding CardId}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0" ToolTip="{i:Loc Main.Meta.KeepRateTip}" />
                                        <TextBlock Grid.Column="3" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}">
                                            <TextBlock.ToolTip>
                                                <TextBlock Text="{Binding Seen}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i:Loc Main.Meta.MulliganEmpty}" Style="{StaticResource Caption}" Margin="0,4"
                               Visibility="{Binding Mulligan, Converter={StaticResource Vis}, ConverterParameter=!}" />

                    <c:Ornament Text="{i:Loc Main.Meta.BestLists}" Icon="&#xF0639;" Size="13" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding ArchetypeDecks}" ItemTemplate="{StaticResource MetaDeckTemplate}" Focusable="False" />
                    <TextBlock Text="{i:Loc Main.Meta.ListsEmpty}" Style="{StaticResource Caption}" Margin="0,4"
                               Visibility="{Binding ArchetypeDecks, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    <TextBlock Text="{Binding CopyNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding CopyNote, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top decks -->
        <Border x:Name="MetaDecksPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="8,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{i:Loc Main.Table.Deck}" Style="{StaticResource TableHead}" />
                    <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.WinRate}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.Games}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.Dust}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MetaDecks}" ItemTemplate="{StaticResource MetaDeckTemplate}" ItemsPanel="{StaticResource PageRows}" Focusable="False" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}"
                                Visibility="{Binding MetaLoading, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}"
                                Visibility="{Binding MetaUnavailable, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF0639;" Content="{i:Loc Main.Meta.DecksEmpty}"
                                Visibility="{Binding MetaDecksEmpty, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding CopyNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding CopyNote, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding ConstructedMetaStatus}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="{Binding MetaStatusShown, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>

        <!-- Matchups: a heat map of the most played archetypes, the row's win rate against the column -->
        <Border x:Name="MetaMatchupsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <c:Ornament Text="{i:Loc Main.Ct.MetaMatchups}" Icon="&#xF04E5;" Size="13" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <!-- Legend: red loses, plain is even, green wins -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Negative}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendLose}" Style="{StaticResource Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Surface3}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendEven}" Style="{StaticResource Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="2" Background="{StaticResource Positive}" />
                        <TextBlock Text="{i:Loc Main.Meta.LegendWin}" Style="{StaticResource Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{i:Loc Main.Meta.MatchupsCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding MatchupsRankNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-8,0,12"
                           Visibility="{Binding MatchupsRankNote, Converter={StaticResource Vis}}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasMatchupMatrix, Converter={StaticResource Vis}}">
                    <StackPanel x:Name="MatchupGrid">
                        <!-- Column heads: the opponent's portrait and short name, the full name on hover -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="190" />
                            <TextBlock Width="62" Text="{i:Loc Main.Meta.MatchupsOverall}" Style="{StaticResource TableHead}" TextAlignment="Center" VerticalAlignment="Bottom"
                                       ToolTip="{i:Loc Main.Meta.MatchupsOverallTip}" />
                            <ItemsControl ItemsSource="{Binding MatchupHeads}" ItemsPanel="{StaticResource ChoiceRow}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:MatchupHead}">
                                        <StackPanel Width="50" ToolTip="{Binding Tip}">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" HorizontalAlignment="Center"
                                                    i:CardArt.Portrait="{Binding HeroId}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeMicro}" TextAlignment="Center" TextWrapping="Wrap"
                                                       Height="28" Margin="1,2,1,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MatchupMatrix}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:MatchupMatrixRow}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <StackPanel Width="190" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" Margin="0,0,8,0"
                                                    i:CardArt.Portrait="{Binding HeroId}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock Width="62" Text="{Binding WinRate}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource ChoiceRow}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MatchupCellView}">
                                                    <Grid Width="48" Height="32" Margin="1,0" ToolTip="{Binding Tip}">
                                                        <Border CornerRadius="4" Background="{StaticResource Surface2}" />
                                                        <Border CornerRadius="4" Background="{Binding Edge, Converter={StaticResource SignBrush}}" Opacity="{Binding Heat}" />
                                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF051F;" Content="{i:Loc Main.Meta.Loading}"
                                Visibility="{Binding MetaLoading, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF002A;" Content="{i:Loc Main.Meta.Unavailable}"
                                Visibility="{Binding MetaUnavailable, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF04E5;" Content="{i:Loc Main.Meta.MatchupsEmpty}"
                                Visibility="{Binding MetaMatchupsEmpty, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding ConstructedMetaStatus}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="{Binding MetaStatusShown, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
