<UserControl x:Class="Hearthpulse.App.Main.Stats.BattlegroundsStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Battlegrounds "My stats": header numbers, rating over time with a hover card, hero performance -->
    <UserControl.Resources>
        <ResourceDictionary Source="StatsResources.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <c:Ornament Text="My stats" Icon="&#xF0128;" Size="15" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="Time frame">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="All time" GroupName="BgPeriod" IsChecked="True" Command="{Binding SetBgPeriod}" CommandParameter="All" />
                    <RadioButton Style="{StaticResource Segment}" Content="7 days" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Week" />
                    <RadioButton Style="{StaticResource Segment}" Content="30 days" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Month" />
                    <RadioButton Style="{StaticResource Segment}" Content="This month" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Season"
                                 ToolTip="Since the 1st of this month (Battlegrounds season dates are not in the data)" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Highest MMR, average placement, games, time played, and where you finish -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding BgStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" ToolTip="Share of your games per final place; the line is your average">
                    <TextBlock Text="Placements" Style="{StaticResource Label}" />
                    <c:MiniBars Width="190" Height="62" Margin="0,10,0,0" Values="{Binding BgPlaceShares}" Marker="{Binding BgAveragePlace}" ShowLabels="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <c:Ornament Text="MMR over time" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                    <TextBlock Text="Hover a game to see it" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <c:StatsLineChart x:Name="RatingChart" Height="250" Points="{Binding BgRatingChart}" HoverTemplate="{StaticResource BgHoverCard}"
                                  EmptyText="Play a few rated Battlegrounds games to see your rating curve." />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="Hero performance" Icon="&#xF01A5;" Size="13" HorizontalAlignment="Left" />
                <Grid Margin="0,10,0,14">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Min. games" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Style="{StaticResource SegmentBar}" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="1" GroupName="BgMin" IsChecked="True" Command="{Binding SetBgMinGames}" CommandParameter="1" />
                                <RadioButton Style="{StaticResource Segment}" Content="3" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="3" />
                                <RadioButton Style="{StaticResource Segment}" Content="5" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="5" />
                                <RadioButton Style="{StaticResource Segment}" Content="10" GroupName="BgMin" Command="{Binding SetBgMinGames}" CommandParameter="10" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Sort by" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Games" GroupName="BgSort" IsChecked="True" Command="{Binding SetBgSort}" CommandParameter="Games" />
                                <RadioButton Style="{StaticResource Segment}" Content="Avg. place" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="AveragePlacement" />
                                <RadioButton Style="{StaticResource Segment}" Content="Net MMR" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="NetRating" />
                                <RadioButton Style="{StaticResource Segment}" Content="Pick rate" GroupName="BgSort" Command="{Binding SetBgSort}" CommandParameter="PickRate" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Hero" Style="{StaticResource StatsHead}" />
                    <TextBlock Grid.Column="2" Text="Net MMR" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="Rating won or lost with this hero" />
                    <StackPanel Grid.Column="3" Margin="16,0,0,0" ToolTip="Share of combats won on each turn: gold is you, the dashed line the community">
                        <TextBlock Text="Combat winrate" Style="{StaticResource StatsHead}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11">
                            <Run Text="You" Foreground="{StaticResource Accent}" /><Run Text=" vs " /><Run Text="Global" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="16,0,0,0" ToolTip="Your final places 1 to 8 (bars) and the community's (ticks)">
                        <TextBlock Text="Placement distribution" Style="{StaticResource StatsHead}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11">
                            <Run Text="You" Foreground="{StaticResource Accent}" /><Run Text=" vs " /><Run Text="Global" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="5" Text="Avg. placement" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="Pick rate" Style="{StaticResource StatsHead}" HorizontalAlignment="Right"
                               ToolTip="How often you picked the hero when it was offered" />
                </Grid>
                <ItemsControl ItemsSource="{Binding BgHeroPerf}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:BgHeroPerfRow}">
                            <Border Style="{StaticResource StatsRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" MinWidth="100" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                                        <ColumnDefinition Width="*" MinWidth="72" MaxWidth="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Games}" Style="{StaticResource Caption}" FontSize="11.5" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Net}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                               Foreground="{Binding NetValue, Converter={StaticResource SignBrush}}" />
                                    <c:Sparkline Grid.Column="3" Height="32" Margin="16,0,0,0" Values="{Binding CombatYou}" Compare="{Binding CombatGlobal}" />
                                    <c:MiniBars Grid.Column="4" Height="32" Margin="16,0,0,0" Values="{Binding PlacesYou}" Compare="{Binding PlacesGlobal}" />
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Width="56" Height="6" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding AverageFraction, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                                            </Border>
                                            <TextBlock Text="{Binding AveragePlace}" FontWeight="Bold" FontSize="14" />
                                        </StackPanel>
                                        <ContentControl Content="{Binding AverageVs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" Focusable="False" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Width="48" Height="6" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding PickFraction, Converter={StaticResource Fraction}, ConverterParameter=48}" />
                                            </Border>
                                            <TextBlock Text="{Binding PickRate}" FontWeight="Bold" FontSize="14" />
                                        </StackPanel>
                                        <ContentControl Content="{Binding PickVs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" Focusable="False" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No hero has this many games in the time frame yet." Style="{StaticResource Caption}" Margin="0,8"
                           Visibility="{Binding BgHeroPerf, Converter={StaticResource Vis}, ConverterParameter=!}" />
                <TextBlock Text="{Binding BgStatsNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,10,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
