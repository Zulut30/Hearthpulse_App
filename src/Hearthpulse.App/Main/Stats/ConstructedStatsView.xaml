<UserControl x:Class="Hearthpulse.App.Main.Stats.ConstructedStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Constructed "My stats" per format below the decks: rank over time, then «Подробнее» (first/coin, classes, matchups, archetypes, game length) -->
    <UserControl.Resources>
        <ResourceDictionary Source="StatsResources.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <!-- The period bar and the headline tiles sit in the page (ConstructedPageView), above the decks -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <c:Ornament Text="{i:Loc Stats.Ct.RankTitle}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" ToolTip="{i:Loc Stats.Ct.RankHint}" />
                </Grid>
                <c:StatsLineChart x:Name="RankChart" Height="210" Points="{Binding CtRankChart}" HoverTemplate="{StaticResource CtHoverCard}"
                                  EmptyText="{i:Loc Stats.Ct.RankEmpty}" />
            </DockPanel>
        </Border>

        <!-- The rest of My stats, closed until asked for: going first / on the coin, classes, opponents, archetypes, length -->
        <ToggleButton x:Name="CtMore" Style="{StaticResource MoreToggle}" />
        <StackPanel Visibility="{Binding IsChecked, ElementName=CtMore, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding CtMoreTiles}" Style="{StaticResource StatsTiles}" ItemsPanel="{StaticResource StatsTilesPanel}" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.Ct.YourClasses}" Icon="&#xF0004;" Size="13" Margin="0,0,0,8" />
                        <ContentControl Style="{StaticResource StatsTableHead}" Content="{i:Loc Stats.Table.Class}" Tag="{Binding CtClassesSort}" Visibility="{Binding CtClasses, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding CtClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Style="{DynamicResource EmptyState}" Tag="&#xF0004;" Content="{i:Loc Stats.Chart.NoGames}" Visibility="{Binding CtClasses, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.OpponentClasses}" Icon="&#xF04E5;" Size="13" Margin="0,0,0,8" />
                        <ContentControl Style="{StaticResource StatsTableHead}" Content="{i:Loc Stats.Table.Opponent}" Tag="{Binding CtOpponentsSort}" Visibility="{Binding CtOpponents, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding CtOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Style="{DynamicResource EmptyState}" Tag="&#xF04E5;" Content="{i:Loc Stats.NoMatchups}" Visibility="{Binding CtOpponents, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.Ct.Archetypes}" Icon="&#xF0639;" Size="13" Margin="0,0,0,8" />
                        <ContentControl Style="{StaticResource StatsTableHead}" Content="{i:Loc Stats.Table.Archetype}" Tag="{Binding CtArchetypesSort}" Visibility="{Binding CtArchetypes, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding CtArchetypes}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Style="{DynamicResource EmptyState}" Tag="&#xF0639;" Content="{i:Loc Stats.Ct.ArchetypesEmpty}"
                                        Visibility="{Binding CtArchetypes, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Stats.Ct.GameLength}" Icon="&#xF02DA;" Size="13" Margin="0,0,0,8" />
                        <ContentControl Style="{StaticResource StatsTableHead}" Content="{i:Loc Stats.Table.Length}" Visibility="{Binding CtLengths, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding CtLengths}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <ContentControl Style="{DynamicResource EmptyState}" Tag="&#xF0128;" Content="{i:Loc Stats.Chart.NoGames}" Visibility="{Binding CtLengths, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding CtStatsNote}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="2,-12,0,16" TextWrapping="Wrap"
                       Visibility="{Binding CtStatsNote, Converter={StaticResource Vis}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
