<UserControl x:Class="Hearthpulse.App.Main.Stats.ConstructedStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Constructed "My stats" per format: header numbers, rank over time, classes, matchups, archetypes, game length -->
    <UserControl.Resources>
        <ResourceDictionary Source="StatsResources.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" ToolTip="Ranked and Casual games of this format">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Tab}" Content="Standard" GroupName="CtFormat" IsChecked="True" Command="{Binding SetCtFormat}" CommandParameter="FT_STANDARD" />
                    <RadioButton Style="{StaticResource Tab}" Content="Wild" GroupName="CtFormat" Command="{Binding SetCtFormat}" CommandParameter="FT_WILD" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="Time frame">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="All time" GroupName="CtPeriod" IsChecked="True" Command="{Binding SetCtPeriod}" CommandParameter="All" />
                    <RadioButton Style="{StaticResource Segment}" Content="7 days" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Week" />
                    <RadioButton Style="{StaticResource Segment}" Content="30 days" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Month" />
                    <RadioButton Style="{StaticResource Segment}" Content="Season" GroupName="CtPeriod" Command="{Binding SetCtPeriod}" CommandParameter="Season"
                                 ToolTip="This month's ranked season" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding CtStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,0,-14">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,14" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <c:Ornament Text="Rank over time" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" />
                    <TextBlock Text="Rank at the start of each ranked game" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <c:StatsLineChart x:Name="RankChart" Height="210" Points="{Binding CtRankChart}" HoverTemplate="{StaticResource CtHoverCard}"
                                  EmptyText="Play a few ranked games of this format to see your rank climb." />
            </DockPanel>
        </Border>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Your classes" Icon="&#xF0004;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No games in this time frame yet." Style="{StaticResource Caption}" Visibility="{Binding CtClasses, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Opponent classes" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No matchups yet." Style="{StaticResource Caption}" Visibility="{Binding CtOpponents, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Archetypes" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtArchetypes}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="Decks with a saved deck code are matched to a meta archetype here." Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding CtArchetypes, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Game length" Icon="&#xF02DA;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CtLengths}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                    <TextBlock Text="No games in this time frame yet." Style="{StaticResource Caption}" Visibility="{Binding CtLengths, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding CtStatsNote}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,-12,0,20" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
