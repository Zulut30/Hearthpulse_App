<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Hearthpulse.App.Main"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Shared by the My Stats views (Battlegrounds, Constructed, Arena). Colours are theme tokens only. -->
    <i:VisibleWhen x:Key="Vis" />
    <i:KeyBrush x:Key="KeyBrush" />
    <i:SignBrush x:Key="SignBrush" />
    <i:FractionWidth x:Key="Fraction" />

    <!-- A win rate coloured on a scale: green from 53 %, red up to 47 %, plain text between (StatGroupRow.WinSign) -->
    <Style x:Key="WinRateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WinSign}" Value="1">
                <Setter Property="Foreground" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding WinSign}" Value="-1">
                <Setter Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatsHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatsRow" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="-10,0,-10,2" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatsPortrait" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <ItemsPanelTemplate x:Key="StatsTilesPanel">
        <UniformGrid Rows="1" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="StatsTilesPanel3">
        <UniformGrid Columns="3" />
    </ItemsPanelTemplate>

    <!-- A KPI card: label, a short gold rule, big value (green or red with its sign), caption. The page's tile look
         (Main/MainLook TileCard), tighter. Placed in a row with 12 between cards. -->
    <DataTemplate x:Key="StatsTile" DataType="{x:Type m:StatTile}">
        <Border Style="{DynamicResource TileCard}" Padding="18,14,16,14" Margin="0,0,12,12" ToolTip="{Binding Detail}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                <Border Width="22" Height="2" CornerRadius="1" Background="{StaticResource AccentLine}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="25" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Sign}" Value="1">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Sign}" Value="-1">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- A row of KPI cards: the cards' right/bottom gaps are taken back here -->
    <Style x:Key="StatsTiles" TargetType="ItemsControl">
        <Setter Property="ItemTemplate" Value="{StaticResource StatsTile}" />
        <Setter Property="Margin" Value="0,0,-12,4" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Column heads over a StatGroupRowTemplate table: Content names the first column; a hairline under them -->
    <Style x:Key="StatsTableHead" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="1" Text="{i:Loc Stats.Table.Record}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Stats.RecordTip}" />
                            <TextBlock Grid.Column="2" Text="{i:Loc Stats.Table.WinRate}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A share as a flat rounded bar (0..1) on a dark track; Foreground is the bar -->
    <Style x:Key="ShareBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="Foreground" Value="{StaticResource Positive}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A final place in "Where you finish": place, a bar against the most common place (green in the top), share -->
    <DataTemplate x:Key="BgPlaceRowTemplate" DataType="{x:Type m:BgPlaceRow}">
        <Grid Margin="0,0,0,7" Background="Transparent" ToolTip="{Binding Tip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Place}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource ShareBar}" Value="{Binding Fraction, Mode=OneWay}" Foreground="{StaticResource Negative}"
                         Opacity="0.75" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Share}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Top}" Value="True">
                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource Positive}" />
                <Setter TargetName="Bar" Property="Opacity" Value="1" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- "vs Global": arrow and difference, green when it favours you -->
    <DataTemplate x:Key="VsGlobalTemplate" DataType="{x:Type m:VsGlobal}">
        <StackPanel Orientation="Horizontal" Visibility="{Binding Shown, Converter={StaticResource Vis}}" ToolTip="{i:Loc Stats.VsGlobalTip}">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,1,0"
                       Foreground="{Binding Sign, Converter={StaticResource SignBrush}}" />
            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{Binding Sign, Converter={StaticResource SignBrush}}" />
            <TextBlock Text="{i:Loc Stats.VsGlobal}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- A group row: class / opponent / archetype / game length -->
    <DataTemplate x:Key="StatGroupRowTemplate" DataType="{x:Type m:StatGroupRow}">
        <Border Style="{StaticResource StatsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}"
                        Visibility="{Binding CardId, Converter={StaticResource Vis}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Games}" Style="{StaticResource Caption}" FontSize="11.5" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           ToolTip="{i:Loc Stats.RecordTip}" />
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="64" Height="7" CornerRadius="3" Background="{StaticResource NegativeSoft}" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Positive}"
                                    Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=64}" />
                        </Border>
                        <TextBlock Text="{Binding WinRate}" Width="52" TextAlignment="Right" FontWeight="Bold" Style="{StaticResource WinRateText}" />
                    </StackPanel>
                    <ContentControl Content="{Binding Vs}" ContentTemplate="{StaticResource VsGlobalTemplate}" HorizontalAlignment="Right" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Hover card of the Battlegrounds rating chart -->
    <DataTemplate x:Key="BgHoverCard" DataType="{x:Type m:BgGamePoint}">
        <Border Width="316" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                            i:CardArt.Portrait="{Binding HeroCardId}" />
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Stats.Bg.PlayedAs}" Style="{StaticResource Label}" FontSize="11" />
                        <TextBlock Text="{Binding HeroName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{i:Loc Stats.Bg.Place}" Style="{StaticResource Label}" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Place}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Right"
                                   Foreground="{Binding PlaceKey, Converter={StaticResource KeyBrush}}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="MMR" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ChartLabel}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Delta}" FontWeight="Bold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding DeltaValue, Converter={StaticResource SignBrush}}" />
                </StackPanel>
                <TextBlock Text="{i:Loc Stats.Bg.FinalBoard}" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding Board}" Visibility="{Binding Board, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:BoardMinionRow}">
                            <StackPanel Margin="1,0" ToolTip="{Binding Name}">
                                <Border x:Name="Ring" Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{StaticResource Border}"
                                        Background="{StaticResource Surface4}" HorizontalAlignment="Center">
                                    <Border CornerRadius="17" i:CardArt.Portrait="{Binding CardId}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0">
                                    <Run Text="{Binding Attack, Mode=OneWay}" /><Run Text="/" Foreground="{StaticResource Faint}" /><Run Text="{Binding Health, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Golden}" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Ring" Property="BorderThickness" Value="2.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{i:Loc Stats.Bg.NoBoard}" Style="{StaticResource Caption}" FontSize="11.5"
                           Visibility="{Binding Board, Converter={StaticResource Vis}, ConverterParameter=!}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Hover card of the rank chart -->
    <DataTemplate x:Key="CtHoverCard" DataType="{x:Type m:CtGamePoint}">
        <Border Width="270" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" Style="{StaticResource StatsPortrait}" VerticalAlignment="Top" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                        i:CardArt.Portrait="{Binding HeroCardId}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding ResultText}" FontWeight="Bold" Foreground="{Binding Result, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Text=" · " Foreground="{StaticResource Faint}" />
                        <TextBlock Text="{Binding ChartLabel}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
