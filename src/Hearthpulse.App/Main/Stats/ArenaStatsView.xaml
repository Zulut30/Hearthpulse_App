<UserControl x:Class="Hearthpulse.App.Main.Stats.ArenaStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Arena "My stats": header numbers, runs, classes and opponent classes -->
    <UserControl.Resources>
        <ResourceDictionary Source="StatsResources.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <c:Ornament Text="My stats" Icon="&#xF0128;" Size="15" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="Time frame">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="All time" GroupName="ArenaPeriod" IsChecked="True" Command="{Binding SetArenaPeriod}" CommandParameter="All" />
                    <RadioButton Style="{StaticResource Segment}" Content="7 days" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Week" />
                    <RadioButton Style="{StaticResource Segment}" Content="30 days" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Month" />
                    <RadioButton Style="{StaticResource Segment}" Content="Season" GroupName="ArenaPeriod" Command="{Binding SetArenaPeriod}" CommandParameter="Season"
                                 ToolTip="Since the 1st of this month" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding ArenaStatTiles}" ItemTemplate="{StaticResource StatsTile}" ItemsPanel="{StaticResource StatsTilesPanel}" />
        </Border>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <c:Ornament Text="Runs" Icon="&#xF0538;" Size="13" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ArenaRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ArenaRunRow}">
                                <Border Style="{StaticResource StatsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Margin="0,0,12,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Wins – losses; the bar fills at 12 wins">
                                            <Border Width="90" Height="7" CornerRadius="3" Background="{StaticResource AccentContainer}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                        Width="{Binding WinFraction, Converter={StaticResource Fraction}, ConverterParameter=90}" />
                                            </Border>
                                            <TextBlock Text="{Binding Record}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" MinWidth="44" TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Arena runs show up here once you play Arena. Runs are told apart by their deck, or by class and the loss limit."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding ArenaRuns, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <c:Ornament Text="Classes" Icon="&#xF0004;" Size="13" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding ArenaClasses}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <TextBlock Text="No runs yet." Style="{StaticResource Caption}" Visibility="{Binding ArenaClasses, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="Opponent classes" Icon="&#xF04E5;" Size="13" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding ArenaOpponents}" ItemTemplate="{StaticResource StatGroupRowTemplate}" />
                        <TextBlock Text="No matchups yet." Style="{StaticResource Caption}" Visibility="{Binding ArenaOpponents, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
