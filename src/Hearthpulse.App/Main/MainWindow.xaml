<Window x:Class="Hearthpulse.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Hearthpulse.App.Main"
        xmlns:c="clr-namespace:Hearthpulse.App.Controls"
        xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
        xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
        xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
        xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
        xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core"
        xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
        xmlns:pg="clr-namespace:Hearthpulse.App.Main.Pages"
        xmlns:st="clr-namespace:Hearthpulse.App.Main.SettingsTabs"
        xmlns:su="clr-namespace:Hearthpulse.App.Main.Setup"
        Title="Hearthpulse" Width="1260" Height="840" MinWidth="1040" MinHeight="660"
        Background="{StaticResource WindowFill}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource AppWindow}"
        TextOptions.TextFormattingMode="Display" Icon="/Hearthpulse;component/Assets/hearthpulse.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="MainLook.xaml" />
            <ResourceDictionary Source="Logo.xaml" />
            <ResourceDictionary Source="MainPages.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Frame">
        <Grid>
            <!-- Settings → Appearance → Interface size (90-120 %) -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding InterfaceScale}" ScaleY="{Binding InterfaceScale}" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Navigation ================= -->
            <Grid x:Name="Sidebar" SizeChanged="OnSidebarSize">
            <!-- The selected item's pill slides between items -->
            <Canvas IsHitTestVisible="False">
                <Border x:Name="NavPill" Canvas.Left="10" Width="230" Height="42" CornerRadius="8" Opacity="0" SnapsToDevicePixels="True"
                        Background="{StaticResource NavSelectedFill}" BorderBrush="{StaticResource NavSelectedEdge}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavPillShift" />
                    </Border.RenderTransform>
                    <Grid>
                        <!-- A gold glow round the open page's icon -->
                        <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource NavSelectedGlow}" />
                        <Border Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left" Background="{StaticResource Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="18,14,0,0">
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xF0156;" Click="OnClose" ToolTip="{i:Loc Main.Window.Close}" AutomationProperties.Name="{i:Loc Main.Window.CloseName}" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xF05AF;" Click="OnMaximize" ToolTip="{i:Loc Main.Window.Maximize}" AutomationProperties.Name="{i:Loc Main.Window.Maximize}" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xF0374;" Click="OnMinimize" ToolTip="{i:Loc Main.Window.Minimize}" AutomationProperties.Name="{i:Loc Main.Window.Minimize}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="24,22,0,18">
                        <Image Source="{StaticResource HearthpulseLogo}" Width="42" Height="42" />
                        <!-- The wordmark and under it the BETA pill, at its left edge: beside it the 250 px column has no room;
                             together they are the logo's height, so the header does not grow -->
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Hearthpulse" Style="{StaticResource H2}" FontSize="21" FontWeight="ExtraBold" Foreground="{StaticResource GildedText}" />
                            <!-- BETA: a small pill in the accent's soft fill and line; the letters are spaced one by one (WPF has no
                                 letter spacing) -->
                            <Border x:Name="BetaBadge" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusPill}" Padding="8,0" HorizontalAlignment="Left"
                                    ToolTip="{i:Loc Main.BetaTip}" AutomationProperties.Name="{i:Loc Main.BetaName}" Focusable="False">
                                <ItemsControl ItemsSource="{i:Loc Main.Beta}" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,1,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- The game's status (owner's pick B, 2026-11-05): the dot (gold: Hearthstone runs, green: connected), the live
                         line and its detail, two lines at most; the tip has the whole detail, the connection and this session -->
                    <Border x:Name="StatusCard" Margin="14,0,14,14" Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource GrooveEdge}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="12,7" AutomationProperties.Name="{Binding LiveTitle}" AutomationProperties.HelpText="{Binding LiveDetail}">
                        <Border.ToolTip>
                            <StackPanel MaxWidth="360">
                                <TextBlock Text="{Binding MemoryStatus}" FontWeight="SemiBold" />
                                <TextBlock Text="{i:Loc Main.Status.Tip}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{i:Loc Main.Live.SessionTip}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SessionSummary}" />
                                    <TextBlock Text="{Binding SessionDelta}" FontWeight="Bold" Margin="8,0,0,0" Foreground="{Binding SessionDeltaValue, Converter={StaticResource SignBrush}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding LiveTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <!-- The "deck not recognised" tail is the first to go: the tip has it all -->
                                <TextBlock x:Name="LiveDetailLine" Text="{Binding LiveDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="32" LineStackingStrategy="BlockLineHeight" LineHeight="16" ToolTip="{Binding LiveDetail}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Home}" Tag="{x:Static c:GameIcons.Home}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+1" IsChecked="True" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.HomeTip}" />

                    <Grid Style="{StaticResource NavGroup}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Main.Nav.Modes}" Style="{StaticResource Label}" />
                        <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <RadioButton x:Name="NavBattlegrounds" Style="{StaticResource NavItem}" Content="{i:Loc Main.Mode.Battlegrounds}" Tag="{x:Static c:GameIcons.Battlegrounds}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+2" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.BattlegroundsTip}" />
                    <RadioButton x:Name="NavStandard" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Standard}" Tag="{x:Static c:GameIcons.Standard}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+3" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.StandardTip}" />
                    <RadioButton x:Name="NavWild" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Wild}" Tag="{x:Static c:GameIcons.Wild}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+4" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.WildTip}" />
                    <RadioButton x:Name="NavArena" Style="{StaticResource NavItem}" Content="{i:Loc Main.Mode.Arena}" Tag="{x:Static c:GameIcons.Arena}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+5" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.ArenaTip}" />
                    <RadioButton x:Name="NavBrawl" Style="{StaticResource NavItem}" Content="{i:Loc Main.Mode.Brawl}" Tag="{x:Static c:GameIcons.Brawl}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+6" Checked="OnNavigate"
                                 ToolTip="{i:Loc Brawl.NavTip}" />

                    <Grid Style="{StaticResource NavGroup}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Main.Nav.Library}" Style="{StaticResource Label}" />
                        <c:Wave Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.History}" Tag="{x:Static c:GameIcons.History}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+7" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.HistoryTip}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <!-- The overlay (owner's pick B, 2026-11-05): its switch, the main panels as buttons and every panel in the ⋯ menu
                         (the same settings as Settings -> Overlay / Tracker), arrange and streamer mode; the buttons wrap to a
                         second line -->
                    <Border x:Name="OverlayCard" Margin="12,0,12,10" Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource GrooveEdge}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="10,8,8,6">
                        <Border.Resources>
                            <Style x:Key="PanelToggle" TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" />
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsChecked" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <CheckBox x:Name="OverlaySwitch" Style="{StaticResource Switch}" Content="{i:Loc Main.Live.Overlay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                      IsChecked="{Binding Settings.OverlayEnabled, Mode=OneTime}" Click="OnOverlaySwitch" ToolTip="{i:Loc Main.Live.OverlayTip}" />
                            <WrapPanel Margin="-2,6,0,0">
                                <ItemsControl x:Name="QuickPanels" ItemsSource="{Binding QuickPanelToggles}" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource PanelToggle}" Content="{Binding Icon}" IsChecked="{Binding IsOn}" ToolTip="{Binding Tip}"
                                                          AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource IconButton}" Content="&#xF01D8;" Width="28" Height="28" FontSize="15" Margin="0"
                                        Click="OnPanelsMenu" ToolTip="{i:Loc Main.Live.PanelsTip}" AutomationProperties.Name="{i:Loc Main.Live.Panels}">
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding PanelToggles}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Command" Value="{Binding Toggle}" />
                                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                                    <Setter Property="ToolTip" Value="{Binding Tip}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                            <ContextMenu.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" Width="26" Foreground="{StaticResource Accent}" />
                                                        <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsOn}" Value="False">
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Faint}" />
                                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ContextMenu.ItemTemplate>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xF01BE;" Width="28" Height="28" FontSize="15" Margin="0"
                                        Click="OnArrangeOverlay" ToolTip="{i:Loc Main.Live.ArrangeTip}" AutomationProperties.Name="{i:Loc Main.Live.ArrangeTipShort}" />
                                <!-- Streamer mode: on, the glyph sits on a filled circle so the state reads at a glance. Only here, the tray and
                                     Settings: never on the overlay or in the OBS windows. -->
                                <ToggleButton x:Name="StreamerModeButton" Content="&#xF05E9;" IsChecked="{Binding StreamerMode}" ToolTip="{Binding StreamerModeTip}"
                                              AutomationProperties.Name="{i:Loc Stream.Mode.Switch}" AutomationProperties.HelpText="{Binding StreamerModeTip}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelToggle}">
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Settings}" Tag="{x:Static c:GameIcons.Settings}" GroupName="Nav" AutomationProperties.AcceleratorKey="Ctrl+8" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.SettingsTip}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,8,0,0" />
                </StackPanel>
                <Border />
            </DockPanel>
            </Grid>

            <!-- ================= Content ================= -->
            <Border Grid.Column="1" Background="{StaticResource ContentFill}" BorderBrush="{StaticResource ContentEdge}" BorderThickness="1" CornerRadius="16"
                    Margin="0,10,10,10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- The page's material and hero (V3 direction A): stone, the page's hero dissolving towards the text, a vignette
                         and a floor in the plate's colour, then a thin gold frame. Nothing moves; the hero follows the page
                         (MainViewModel.PageHero) and is gone while "Background characters" is off. Same as the Avalonia MainView. -->
                    <Grid Grid.RowSpan="2" IsHitTestVisible="False">
                        <!-- Static while a page scrolls over it: cached as a bitmap instead of re-blending its masks on every frame -->
                        <Grid.CacheMode>
                            <BitmapCache SnapsToDevicePixels="True" />
                        </Grid.CacheMode>
                        <Border Style="{StaticResource PageLayer}" Background="{StaticResource PageStone}" />
                        <Grid Visibility="{Binding PageHero, Converter={StaticResource Vis}}">
                            <!-- The hero's colours light the whole page; the art itself is square, top right, half the plate wide and
                                 at most 640: HearthstoneJSON's largest art is 512, so 1.25 at most, smoothed (the columns), so at the narrowest window it still clears the titles on the left -->
                            <Border Style="{StaticResource PageLayer}" i:CardArt.Glow="{Binding PageHero}" Opacity="0.6" OpacityMask="{StaticResource PageGlowMask}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" MaxWidth="640" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PageHeroArt" Grid.Column="1" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" VerticalAlignment="Top"
                                        Opacity="0.8" OpacityMask="{StaticResource PageHeroFade}">
                                    <Border Style="{StaticResource PageLayer}" i:CardArt.Splash="{Binding PageHero}" OpacityMask="{StaticResource PageHeroFloor}" RenderOptions.BitmapScalingMode="HighQuality"
                                            Opacity="{Binding BackgroundIntensity}" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PageLayer}" Background="{StaticResource PageVignette}" />
                            <Border Style="{StaticResource PageLayer}" Background="{StaticResource PageShade}" />
                        </Grid>
                        <Border Margin="8" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" BorderBrush="{StaticResource PageFrame}" />
                    </Grid>

                    <!-- Top bar: what runs in the background on the left (only while something does), the update and the site link on the right -->
                    <!-- A dock, not a horizontal stack: the stack measures the line at infinite width, so the ellipsis never showed.
                         A long message (Hearthstone not found, startup problem) is read in full in the tip. -->
                    <DockPanel x:Name="BusyLine" Margin="40,0,320,0" VerticalAlignment="Center" Visibility="{Binding Busy, Converter={StaticResource Vis}}">
                        <DockPanel.ToolTip>
                            <StackPanel MaxWidth="420">
                                <TextBlock Text="{Binding Busy}" TextWrapping="Wrap" />
                                <TextBlock Text="{i:Loc Main.Busy.Tip}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel.ToolTip>
                        <TextBlock Text="&#xF04E6;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent2}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Busy}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                        <!-- A downloaded update: one click installs now, otherwise it installs on the next close (Tab reaches it too) -->
                        <Button x:Name="InstallUpdateButton" Command="{Binding InstallUpdate}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                FocusVisualStyle="{StaticResource FocusRing}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}"
                                ToolTip="{Binding UpdateText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="12,5">
                                        <TextBlock Text="{i:Loc Main.Update.Ready}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- The site connection (account center): hidden while signed out; a click opens Settings, Account -->
                        <Button x:Name="AccountLinkButton" Click="OnOpenAccountCenter" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                FocusVisualStyle="{StaticResource FocusRing}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding AccountLinkVisible, Converter={StaticResource Vis}}"
                                ToolTip="{Binding AccountLinkTip}" AutomationProperties.Name="{Binding AccountLinkTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource GrooveFill}" BorderBrush="{StaticResource GrooveEdge}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusPill}">
                                        <!-- Hover and press tint the pill like the other chrome buttons (State over the groove fill) -->
                                        <Border x:Name="State" Background="Transparent" CornerRadius="{StaticResource RadiusPill}" Padding="12,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse Fill="{StaticResource Positive}" Visibility="{Binding AccountLinkOk, Converter={StaticResource Vis}}" />
                                                    <Ellipse Fill="{StaticResource InfoCaution}" Visibility="{Binding AccountLinkWarn, Converter={StaticResource Vis}}" />
                                                    <Ellipse Fill="{StaticResource Negative}" Visibility="{Binding AccountLinkBad, Converter={StaticResource Vis}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding AccountLinkShort}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Text}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="State" Property="Background" Value="{StaticResource Hover}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="State" Property="Background" Value="{StaticResource Pressed}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- ===== Home ===== -->
                    <pg:OverviewPage x:Name="PageOverview" Grid.Row="1" />

                    <!-- ===== Battlegrounds ===== -->
                    <!-- Built on the first visit (MainWindow.PageBattlegrounds), so the start-up window builds only the page it shows. -->
                    <ContentControl x:Name="SlotBattlegrounds" Grid.Row="1" Focusable="False" IsTabStop="False" />

                    <!-- ===== Constructed ===== -->
                    <ContentControl x:Name="SlotConstructed" Grid.Row="1" Focusable="False" IsTabStop="False" />

                    <!-- ===== Deck page (Main/Decks): replaces the Constructed page while a deck is open ===== -->
                    <!-- Its DeckDetailsView is built on the first open (MainWindow.DeckDetailsPage). -->
                    <ScrollViewer x:Name="PageDeck" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />

                    <!-- ===== Arena ===== -->
                    <ScrollViewer x:Name="PageArena" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120">
                            <StackPanel Orientation="Horizontal">
                                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Arena}" />
                                <TextBlock Text="{i:Loc Main.Mode.Arena}" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <c:Wave Style="{StaticResource PageRule}" />
                            <s:ArenaStatsView />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Tavern Brawl ===== -->
                    <ScrollViewer x:Name="PageBrawl" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120">
                            <StackPanel Orientation="Horizontal">
                                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Brawl}" />
                                <TextBlock Text="{i:Loc Main.Mode.Brawl}" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <c:Wave Style="{StaticResource PageRule}" />
                            <s:BrawlView />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== History ===== -->
                    <ContentControl x:Name="SlotHistory" Grid.Row="1" Focusable="False" IsTabStop="False" />

                    <!-- ===== Match page (Main/Match): replaces the History list while a game is open ===== -->
                    <!-- Built with the window, unlike the other pages: built late it opened 3-5x slower (TASK-2026-11-06-perf). -->
                    <ScrollViewer x:Name="PageMatch" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <mt:MatchView x:Name="MatchDetails" DataContext="{Binding MatchPage}" Margin="40,0,40,120" />
                    </ScrollViewer>

                    <!-- ===== Settings: tabs General / Appearance / Overlay / Tracker / Stream / Account / Data / About (the last one shown is kept in AppSettings.SettingsTab) ===== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120" MaxWidth="780" HorizontalAlignment="Left" ToggleButton.Checked="OnSettingChanged" ToggleButton.Unchecked="OnSettingChanged">
                            <StackPanel Orientation="Horizontal">
                                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Settings}" />
                                <TextBlock Text="{i:Loc Settings.Title}" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <c:Wave Style="{StaticResource PageRule}" />

                            <!-- Search over every tab; while a query is typed its matches replace the tabs -->
                            <st:SettingsSearchBox x:Name="SettingsSearchBar" />

                            <StackPanel x:Name="SettingsTabsArea" Visibility="{Binding SettingsSearching, Converter={StaticResource Vis}, ConverterParameter=!}">
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <WrapPanel>
                                    <RadioButton x:Name="SettingsTabGeneral" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.General}" GroupName="SettingsTab" Tag="General" IsChecked="True" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabAppearance" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Appearance}" GroupName="SettingsTab" Tag="Appearance" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabOverlay" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Overlay}" GroupName="SettingsTab" Tag="Overlay" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabTracker" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Tracker}" GroupName="SettingsTab" Tag="Tracker" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabStream" Style="{StaticResource Tab}" Content="{i:Loc Stream.Tab}" GroupName="SettingsTab" Tag="Stream" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabAccount" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Account}" GroupName="SettingsTab" Tag="Account" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabData" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Data}" GroupName="SettingsTab" Tag="Data" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabAbout" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.About}" GroupName="SettingsTab" Tag="About" Checked="OnSettingsTab" />
                                </WrapPanel>
                            </Border>

                            <!-- ===== General: language, app ===== -->
                            <st:GeneralSettings x:Name="SettingsGeneral" />

                            <!-- ===== Appearance: theme gallery, accent, page background, corners, density, size ===== -->
                            <st:AppearanceSettings x:Name="SettingsAppearance" Visibility="Collapsed" />

                            <!-- ===== Overlay: what is drawn over the game, its size, panel layout ===== -->
                            <st:OverlaySettings x:Name="SettingsOverlay" Visibility="Collapsed" />

                            <!-- ===== Tracker: the Constructed deck tracker, counters and mulligan ===== -->
                            <st:TrackerSettings x:Name="SettingsTracker" Visibility="Collapsed" />

                            <!-- ===== Stream: streamer mode and the OBS windows ===== -->
                            <st:StreamSettings x:Name="SettingsStream" Visibility="Collapsed" />

                            <!-- ===== Account: the hearthpulse.net sign-in ===== -->
                            <st:AccountSettings x:Name="SettingsAccount" Visibility="Collapsed" />

                            <!-- ===== Data: history, the data folder, where the numbers come from ===== -->
                            <st:DataSettings x:Name="SettingsData" Visibility="Collapsed" />

                            <!-- ===== About: version, updates, licences ===== -->
                            <st:AboutSettings x:Name="SettingsAbout" Visibility="Collapsed" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Setup wizard (D4): over the whole page and the live bar while open; it opens by itself once for a new player ===== -->
                    <su:SetupWizard x:Name="Setup" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="{Binding SetupOpen, Converter={StaticResource Vis}}" />

                    <!-- ===== First start: ask before sharing results with the stats pool ===== -->
                    <Border Grid.Row="1" VerticalAlignment="Top" Margin="24,2,24,0" CornerRadius="16" Background="{StaticResource Surface3}" Panel.ZIndex="5"
                            BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="12,12,16,12"
                            Visibility="{Binding AskPoolConsent, Converter={StaticResource Vis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="46" Height="46">
                                <c:Scallop Fill="{StaticResource Surface4}" Lobes="9" Depth="0.1" />
                                <TextBlock Text="&#xF0849;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{i:Loc Main.Pool.Title}" FontWeight="Bold" FontSize="14.5" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource Text}"
                                           Text="{i:Loc Main.Pool.What}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{i:Loc Main.Pool.Never}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="{i:Loc Main.Pool.No}" Command="{Binding AnswerPool}" CommandParameter="no" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Main.Pool.Yes}" Command="{Binding AnswerPool}" CommandParameter="yes" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- Card preview on hover (deck page card tiles): top layer, never takes the mouse -->
            <c:CardPreviewHost Grid.ColumnSpan="2" />
        </Grid>
    </Border>
</Window>
