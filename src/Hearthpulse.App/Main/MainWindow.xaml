<Window x:Class="Hearthpulse.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Hearthpulse.App.Main"
        xmlns:c="clr-namespace:Hearthpulse.App.Controls"
        xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
        xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
        xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
        Title="Hearthpulse" Width="1260" Height="840" MinWidth="1040" MinHeight="660"
        Background="{StaticResource WindowFill}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource AppWindow}"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/hearthpulse.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />
        <i:SignBrush x:Key="SignBrush" />
        <i:FractionWidth x:Key="Fraction" />

        <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- List rows: no rules, a soft highlight on hover -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="-10,0,-10,2" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TierBadge" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavGroup" TargetType="Grid">
            <Setter Property="Margin" Value="28,16,20,4" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="2,6,0,24" />
        </Style>

        <DataTemplate x:Key="StatTileTemplate" DataType="{x:Type m:StatTile}">
            <Border Margin="0,0,14,0" Padding="20,16" ToolTip="{Binding Detail}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Stat}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Sign}" Value="1">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Positive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Sign}" Value="-1">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Negative}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type m:GameRow}">
            <Border Style="{StaticResource RowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                            i:CardArt.Portrait="{Binding HeroCardId}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                        <TextBlock Text="{Binding Hero}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Mode}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}" />
                    <TextBlock Grid.Column="3" Text="{Binding When}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Border Grid.Column="4" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Surface3}">
                        <TextBlock Text="{Binding Result}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                    </Border>
                    <TextBlock Grid.Column="5" Text="{Binding Rating}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{Binding RatingValue, Converter={StaticResource SignBrush}}" ToolTip="{i:Loc Main.Game.RatingChange}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Theme picker: each theme is a tile in its own colours, a cookie of its wood with a gem of its accent -->
        <DataTemplate x:Key="ThemeTile" DataType="{x:Type m:ThemeChoice}">
            <Border x:Name="Tile" Width="92" Height="92" CornerRadius="16" Background="{Binding Background}" BorderBrush="{StaticResource Border}"
                    BorderThickness="2" Padding="8,10,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" Foreground="{Binding Text}" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Grid Width="50" Height="50" HorizontalAlignment="Center">
                        <c:Scallop Fill="{Binding Surface}" Lobes="9" Depth="0.12" />
                        <c:Scallop Width="24" Height="24" Fill="{Binding Accent}" Lobes="6" Depth="0.2" Angle="15" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ThemeSwatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingChip}" />
            <Setter Property="ContentTemplate" Value="{StaticResource ThemeTile}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Face" RenderTransformOrigin="0.5,0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The colour wheel laid flat, under the hue sliders -->
        <LinearGradientBrush x:Key="HueStrip" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4D4D" Offset="0" />
            <GradientStop Color="#FFD24D" Offset="0.167" />
            <GradientStop Color="#7DFF4D" Offset="0.333" />
            <GradientStop Color="#4DFFE0" Offset="0.5" />
            <GradientStop Color="#4D7DFF" Offset="0.667" />
            <GradientStop Color="#D24DFF" Offset="0.833" />
            <GradientStop Color="#FF4D4D" Offset="1" />
        </LinearGradientBrush>

        <ItemsPanelTemplate x:Key="TilesPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Frame">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Navigation ================= -->
            <Grid x:Name="Sidebar" SizeChanged="OnSidebarSize">
            <!-- The selected item's pill slides between items -->
            <Canvas IsHitTestVisible="False">
                <Border x:Name="NavPill" Canvas.Left="10" Width="230" Height="42" CornerRadius="8" Opacity="0" SnapsToDevicePixels="True"
                        Background="{StaticResource NavSelectedFill}" BorderBrush="{StaticResource NavSelectedEdge}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavPillShift" />
                    </Border.RenderTransform>
                    <Border Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left" Background="{StaticResource Accent}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                        </Border.Effect>
                    </Border>
                </Border>
            </Canvas>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="18,14,0,0">
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xF0156;" Click="OnClose" ToolTip="{i:Loc Main.Window.Close}" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xF05AF;" Click="OnMaximize" ToolTip="{i:Loc Main.Window.Maximize}" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xF0374;" Click="OnMinimize" ToolTip="{i:Loc Main.Window.Minimize}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="24,22,0,18">
                        <Image Source="/Assets/hearthpulse.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Hearthpulse" Style="{StaticResource H2}" FontSize="21" FontWeight="ExtraBold" Foreground="{StaticResource GildedText}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Home}" Tag="&#xF02DC;" GroupName="Nav" IsChecked="True" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.HomeTip}" />

                    <Grid Style="{StaticResource NavGroup}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Main.Nav.Modes}" Style="{StaticResource Label}" />
                    </Grid>
                    <RadioButton x:Name="NavBattlegrounds" Style="{StaticResource NavItem}" Content="{i:Loc Main.Mode.Battlegrounds}" Tag="&#xF0787;" GroupName="Nav" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.BattlegroundsTip}" />
                    <RadioButton x:Name="NavConstructed" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Constructed}" Tag="&#xF063A;" GroupName="Nav" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.ConstructedTip}" />
                    <RadioButton x:Name="NavArena" Style="{StaticResource NavItem}" Content="{i:Loc Main.Mode.Arena}" Tag="&#xF0538;" GroupName="Nav" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.ArenaTip}" />

                    <Grid Style="{StaticResource NavGroup}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Main.Nav.Library}" Style="{StaticResource Label}" />
                    </Grid>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.History}" Tag="&#xF02DA;" GroupName="Nav" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.HistoryTip}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="{i:Loc Main.Nav.Settings}" Tag="&#xF08BB;" GroupName="Nav" Checked="OnNavigate"
                                 ToolTip="{i:Loc Main.Nav.SettingsTip}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Faint}" Margin="28,8,0,0" />
                </StackPanel>
                <Border />
            </DockPanel>
            </Grid>

            <!-- ================= Content ================= -->
            <Border Grid.Column="1" Background="{StaticResource ContentFill}" BorderBrush="{StaticResource ContentEdge}" BorderThickness="1" CornerRadius="16"
                    Margin="0,10,10,10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- Your last hero, as faded card art behind the page titles -->
                    <Border Grid.RowSpan="2" Width="640" Height="340" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsHitTestVisible="False" Opacity="0.32">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.65" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Border CornerRadius="0,15,0,0" i:CardArt.Splash="{Binding BannerHero}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0.3" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Border>

                    <!-- Top bar: status chips -->
                    <TextBlock Text="{Binding Busy}" Style="{StaticResource Caption}" Margin="40,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                        <!-- A downloaded update: one click installs now, otherwise it installs on the next close -->
                        <Button Command="{Binding InstallUpdate}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" Focusable="False"
                                WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}"
                                ToolTip="{Binding UpdateText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="12,5">
                                        <TextBlock Text="{i:Loc Main.Update.Ready}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource Surface3}" Padding="12,5"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{i:Loc Main.Status.Tip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" />
                                <TextBlock Text="{Binding MemoryStatus}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Home ===== -->
                    <ScrollViewer x:Name="PageOverview" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,0,40,120">
                            <TextBlock Text="{i:Loc Main.Nav.Home}" Style="{StaticResource Display}" />
                            <StackPanel Style="{StaticResource PageSubtitle}">
                                <TextBlock Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center">
                                    <Run Text="{Binding Greeting, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text="{i:Loc Main.Home.Glance}" />
                                </TextBlock>
                            </StackPanel>

                            <Border Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" CornerRadius="12" Padding="17,13" Margin="0,0,0,16"
                                    Visibility="{Binding SetupWarning, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF002A;" Style="{StaticResource Icon}" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding SetupWarning}" TextWrapping="Wrap" Foreground="{StaticResource OnAccentContainer}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding OverviewTiles}" ItemTemplate="{StaticResource StatTileTemplate}" ItemsPanel="{StaticResource TilesPanel}"
                                          Margin="0,0,-14,16" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Main.Home.BgRating}" Icon="&#xF012A;" Size="13" Margin="0,0,0,12" />
                                        <c:RatingChart Points="{Binding RatingPoints}" Height="200" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Main.Home.Placements}" Icon="&#xF0D25;" Size="13" Margin="0,0,0,12" />
                                        <ItemsControl ItemsSource="{Binding Placements}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:PlacementBar}">
                                                    <Grid Height="25">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Place}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Height="12" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                            <Border x:Name="Bar" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Negative}" Opacity="0.85"
                                                                    Width="{Binding Fraction, Converter={StaticResource Fraction}, ConverterParameter=220}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                                                            <Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource Faint}" /><Run Text="{Binding Share, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Top}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Positive}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Place}" Value="1">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TierS}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <c:Ornament Text="{i:Loc Main.Home.RecentGames}" Icon="&#xF02DA;" Size="13" Margin="0,0,120,0" VerticalAlignment="Center" />
                                        <Button Content="{i:Loc Main.Home.ViewAll}" Style="{StaticResource GhostButton}" Padding="14,6" FontSize="12" HorizontalAlignment="Right" Click="OnViewHistory" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource GameRowTemplate}" />
                                    <TextBlock Text="{i:Loc Main.Home.NoGames}" Style="{StaticResource Caption}" Margin="0,8"
                                               Visibility="{Binding Recent, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Battlegrounds ===== -->
                    <ScrollViewer x:Name="PageBattlegrounds" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{i:Loc Main.Mode.Battlegrounds}" Style="{StaticResource Display}" />
                                    <StackPanel Style="{StaticResource PageSubtitle}">
                                        <TextBlock Text="{i:Loc Main.Bg.Subtitle}" Style="{StaticResource Caption}" FontSize="14"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Style="{StaticResource SegmentBar}"
                                        ToolTip="{i:Loc Main.Bg.ModeTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Bg.Solo}" GroupName="BgMode" IsChecked="True" Command="{Binding SetBgMode}" CommandParameter="Battlegrounds" />
                                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Duos}" GroupName="BgMode" Command="{Binding SetBgMode}" CommandParameter="Duos" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- My stats (Main/Stats): header numbers, MMR over time, hero performance -->
                            <s:BattlegroundsStatsView x:Name="BgStats" />

                            <c:Ornament Text="{i:Loc Main.Bg.TierLists}" Icon="&#xF11D0;" Size="15" Margin="0,0,0,14" />
                            <Grid Margin="0,0,0,14">
                                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabHeroes" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Heroes}" GroupName="BgTab" IsChecked="True" Checked="OnBgTab"
                                                     ToolTip="{i:Loc Main.Bg.HeroesTip}" />
                                        <RadioButton x:Name="TabComps" Style="{StaticResource Tab}" Content="{Binding CompTabLabel}" GroupName="BgTab" Checked="OnBgTab"
                                                     ToolTip="{i:Loc Main.Bg.CompsTip}" />
                                        <RadioButton x:Name="TabTrinkets" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Trinkets}" GroupName="BgTab" Checked="OnBgTab"
                                                     ToolTip="{i:Loc Main.Bg.TrinketsTip}" />
                                        <RadioButton x:Name="TabCards" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Cards}" GroupName="BgTab" Checked="OnBgTab"
                                                     ToolTip="{i:Loc Main.Bg.CardsTip}" />
                                        <RadioButton x:Name="TabMine" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.MyHeroes}" GroupName="BgTab" Checked="OnBgTab"
                                                     ToolTip="{i:Loc Main.Bg.MyHeroesTip}" />
                                    </StackPanel>
                                </Border>
                                <!-- The brackets the loaded stats have (the API: top 50/20/5/1%); hidden when there is no choice -->
                                <Grid HorizontalAlignment="Right" Visibility="{Binding HasBracketChoice, Converter={StaticResource Vis}}">
                                    <Border x:Name="BracketPicker" Style="{StaticResource SegmentBar}"
                                            ToolTip="{i:Loc Main.Bg.BracketTip}">
                                        <ItemsControl ItemsSource="{Binding BracketOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:BracketOption}">
                                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="Bracket" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Command="{Binding Select}" CommandParameter="{Binding Value}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Hero tier list -->
                            <Border x:Name="HeroTierCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.Hero}" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.Tier}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Table.TierTip}" />
                                        <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.AvgPlacement}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Table.AvgPlacementTip}" />
                                        <TextBlock Grid.Column="5" Text="{i:Loc Main.Table.Top4}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.Top4Tip}" />
                                        <TextBlock Grid.Column="6" Text="{i:Loc Main.Table.First}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.FirstTip}" />
                                        <TextBlock Grid.Column="7" Text="{i:Loc Main.Table.PickRate}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.PickRateTip}" />
                                        <TextBlock Grid.Column="8" Text="{i:Loc Main.Table.Games}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.GamesTip}" />
                                        <TextBlock Grid.Column="9" Text="{i:Loc Main.Table.You}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.YouTip}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding HeroTiers}" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaHeroRow}">
                                                <Border Style="{StaticResource RowBorder}" Padding="10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{StaticResource Surface3}"
                                                                HorizontalAlignment="Left" i:CardArt.Portrait="{Binding CardId}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="3" Style="{StaticResource TierBadge}" Background="{Binding Tier, Converter={StaticResource KeyBrush}}">
                                                            <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AveragePlace}" Width="44" FontWeight="Bold" />
                                                            <Border Width="128" Height="8" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                                                        Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=128}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="5" Text="{Binding Top4}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding FirstPlace}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7" Text="{Binding PickRate}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="8" Text="{Binding DataPoints}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="9" Text="{Binding Personal}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MetaUpdated}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Comps -->
                            <Border x:Name="CompTierCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompCaption}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding CompTiers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaCompRow}">
                                                <Border Style="{StaticResource RowBorder}" Padding="10,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="230" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                            <TextBlock FontWeight="SemiBold" FontSize="14">
                                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Tribes, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="12" />
                                                            </TextBlock>
                                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding KeyCards, Converter={StaticResource Vis}}">
                                                                <Run Text="{i:Loc Main.Bg.Core}" Foreground="{StaticResource Faint}" /><Run Text="{Binding KeyCards, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Commit}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Text}" Opacity="0.85"
                                                                       Visibility="{Binding Commit, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource TierBadge}" VerticalAlignment="Top" Background="{Binding Power, Converter={StaticResource KeyBrush}}"
                                                                ToolTip="{i:Loc Main.Bg.TierBestTip}">
                                                            <TextBlock Text="{Binding Power}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="{i:Loc Main.Bg.AvgPlacementTip}">
                                                            <TextBlock Text="{Binding Placement}" Width="44" FontWeight="Bold" />
                                                            <Border Width="164" Height="8" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                                        Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=164}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding CompEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8"
                                               Visibility="{Binding HasCompTiers, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    <TextBlock Text="{Binding MetaUpdated}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Trinkets -->
                            <Border x:Name="TrinketTierCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Table.Trinket}" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.Tier}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Table.TierTipShort}" />
                                        <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.AvgPlacement}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Table.TrinketPlacementTip}" />
                                        <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.PickRate}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.TrinketPickTip}" />
                                        <TextBlock Grid.Column="5" Text="{i:Loc Main.Table.Games}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TrinketTiers}" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaTrinketRow}">
                                                <Border Style="{StaticResource RowBorder}" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2" Style="{StaticResource TierBadge}" Background="{Binding Tier, Converter={StaticResource KeyBrush}}">
                                                            <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Placement}" Width="44" FontWeight="Bold" />
                                                            <Border Width="164" Height="8" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                                                        Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=164}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding PickRate}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding DataPoints}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TrinketEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8"
                                               Visibility="{Binding TrinketTiers, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    <TextBlock Text="{Binding MetaUpdated}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Cards -->
                            <Border x:Name="CardStatsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="{i:Loc Main.Bg.CardsCaption}"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,330,0" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Bg.CardTierTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" Content="1" GroupName="CardTier" IsChecked="True" Command="{Binding SetCardTier}" CommandParameter="1" />
                                                <RadioButton Style="{StaticResource Segment}" Content="2" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="2" />
                                                <RadioButton Style="{StaticResource Segment}" Content="3" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="3" />
                                                <RadioButton Style="{StaticResource Segment}" Content="4" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="4" />
                                                <RadioButton Style="{StaticResource Segment}" Content="5" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="5" />
                                                <RadioButton Style="{StaticResource Segment}" Content="6" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="6" />
                                                <RadioButton Style="{StaticResource Segment}" Content="7" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="7" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Bg.Spells}" GroupName="CardTier" Command="{Binding SetCardTier}" CommandParameter="0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CardTiers}" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaCardRow}">
                                                <Border Style="{StaticResource RowBorder}" Padding="10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="54" Height="38" CornerRadius="6" c:RoundClip.Radius="6" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                                                            <Image i:CardArt.Tile="{Binding CardId}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" FontSize="11.5" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{i:Loc Main.Bg.AvgPlacementTip}">
                                                            <TextBlock Text="{Binding Placement}" Width="44" FontWeight="Bold" />
                                                            <Border Width="164" Height="8" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}"
                                                                        Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=164}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding Games}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   ToolTip="{i:Loc Main.Bg.TimesPlayedTip}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding CardEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8"
                                               Visibility="{Binding CardTiers, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    <TextBlock Text="{Binding MetaUpdated}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- My heroes -->
                            <Border x:Name="MyHeroesCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Table.Hero}" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.Games}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.AvgPlace}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.AvgPlaceTip}" />
                                        <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.Top4}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.Top4MineTip}" />
                                        <TextBlock Grid.Column="5" Text="{i:Loc Main.Table.Wins}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.WinsTip}" />
                                        <TextBlock Grid.Column="6" Text="{i:Loc Main.Table.NetMmr}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Table.NetMmrTip}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding MyHeroes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:HeroRow}">
                                                <Border Style="{StaticResource RowBorder}" Padding="10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                                i:CardArt.Portrait="{Binding CardId}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Games}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding AveragePlace}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                                                   Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Top4}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Wins}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Net}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{Binding NetValue, Converter={StaticResource SignBrush}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{i:Loc Main.Bg.MyHeroesEmpty}" Style="{StaticResource Caption}" Margin="0,8"
                                               Visibility="{Binding MyHeroes, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Constructed ===== -->
                    <ScrollViewer x:Name="PageConstructed" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120">
                            <TextBlock Text="{i:Loc Main.Nav.Constructed}" Style="{StaticResource Display}" />
                            <StackPanel Style="{StaticResource PageSubtitle}">
                                <TextBlock Text="{i:Loc Main.Ct.Subtitle}" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource SegmentBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabMyDecks" Style="{StaticResource Tab}" Content="{i:Loc Main.Ct.MyStats}" GroupName="CtTab" IsChecked="True" Checked="OnCtTab"
                                                     ToolTip="{i:Loc Main.Ct.MyStatsTip}" />
                                        <RadioButton x:Name="TabMetaTiers" Style="{StaticResource Tab}" Content="{i:Loc Main.Ct.MetaTiers}" GroupName="CtTab" Checked="OnCtTab"
                                                     ToolTip="{i:Loc Main.Ct.MetaTiersTip}" />
                                        <RadioButton x:Name="TabMetaDecks" Style="{StaticResource Tab}" Content="{i:Loc Main.Ct.TopDecks}" GroupName="CtTab" Checked="OnCtTab"
                                                     ToolTip="{i:Loc Main.Ct.TopDecksTip}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MetaFormatPicker" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SegmentBar}" Visibility="Collapsed"
                                        ToolTip="{i:Loc Main.Ct.FormatTip}">
                                    <ItemsControl ItemsSource="{Binding MetaFormats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaFormat" IsChecked="{Binding Selected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SetMetaFormat, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="MetaFilters" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid Margin="0,0,0,10">
                                    <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.RankTip}">
                                        <ItemsControl ItemsSource="{Binding MetaRanks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaRank" IsChecked="{Binding Selected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SetMetaRank, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Border>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.PeriodTip}">
                                        <ItemsControl ItemsSource="{Binding MetaPeriods}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaPeriod" IsChecked="{Binding Selected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SetMetaPeriod, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Border>
                                </Grid>
                                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Ct.ClassTip}">
                                    <ItemsControl ItemsSource="{Binding MetaClasses}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="MetaClass" IsChecked="{Binding Selected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SetMetaClass, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- My stats (Main/Stats): Standard/Wild results; your decks follow below -->
                            <s:ConstructedStatsView x:Name="CtStats" />
                            <Grid x:Name="MyDecksPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Main.Ct.Decks}" Icon="&#xF0639;" Size="13" Margin="0,0,0,10" />
                                        <TextBlock Text="{i:Loc Main.Ct.DecksHint}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                                   Visibility="{Binding Decks, Converter={StaticResource Vis}}" />
                                        <!-- Decks that look like versions of one -->
                                        <ItemsControl ItemsSource="{Binding DeckSuggestions}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type dk:DeckSuggestionRow}">
                                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xF062C;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{i:Loc Main.Ct.SameDeck}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Main.Ct.Merge}" Padding="12,5" FontSize="12" Margin="8,0,6,0"
                                                                        Command="{Binding DataContext.MergeSuggested, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                        ToolTip="{i:Loc Main.Ct.MergeTip}" />
                                                                <Button Style="{StaticResource GhostButton}" Content="{i:Loc Main.Ct.NotSame}" Padding="10,5" FontSize="12"
                                                                        Command="{Binding DataContext.DismissSuggested, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Decks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:DeckRow}">
                                                    <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenDeck, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="22" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Style="{StaticResource Caption}">
                                                                    <Run Text="{Binding Class, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastPlayed, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Versions}" Style="{StaticResource Caption}" Foreground="{StaticResource Info}"
                                                                           Visibility="{Binding Versions, Converter={StaticResource Vis}}" ToolTip="{i:Loc Main.Ct.VersionsTip}" />
                                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Meta, Converter={StaticResource Vis}}" ToolTip="{i:Loc Main.Ct.MetaTip}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Record}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Caption}"
                                                                       ToolTip="{i:Loc Main.Ct.RecordTip}" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{i:Loc Main.Table.WinRate}">
                                                                <c:WinBar Width="80" Height="8" VerticalAlignment="Center" Fraction="{Binding WinFraction}" Games="{Binding Games}" Few="{Binding Few}" />
                                                                <TextBlock Text="{Binding WinRate}" Width="50" TextAlignment="Right" FontWeight="Bold" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="&#xF0142;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{i:Loc Main.Ct.DecksEmpty}" Style="{StaticResource Caption}" Margin="0,8"
                                                   Visibility="{Binding Decks, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Main.Ct.Matchups}" Icon="&#xF04E5;" Size="13" />
                                        <TextBlock Text="{i:Loc Main.Ct.MatchupsHint}" Style="{StaticResource Caption}" Margin="0,8,0,10" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Matchups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MatchupRow}">
                                                    <Border Style="{StaticResource RowBorder}" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="56" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Class}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{i:Loc Main.Ct.MatchupsEmpty}" Style="{StaticResource Caption}" Visibility="{Binding Matchups, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Meta tier list: archetypes on the left, the chosen one's mulligan guide and best lists on the right -->
                            <Grid x:Name="MetaTiersPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" Margin="0,0,0,14" ToolTip="{i:Loc Main.Meta.SortTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Meta.BestWinRate}" GroupName="MetaSort" IsChecked="True"
                                                             Command="{Binding SetMetaSort}" CommandParameter="WinRate" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Meta.MostPlayed}" GroupName="MetaSort"
                                                             Command="{Binding SetMetaSort}" CommandParameter="Popularity" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="10,0,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="46" />
                                                        </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Main.Table.Tier}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.Meta.TierTip}" />
                                            <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.Archetype}" Style="{StaticResource TableHead}" />
                                            <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.WinRate}" Style="{StaticResource TableHead}" />
                                            <TextBlock Grid.Column="4" Text="{i:Loc Main.Meta.First}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Meta.FirstTip}" />
                                            <TextBlock Grid.Column="5" Text="{i:Loc Main.Meta.Coin}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Main.Meta.CoinTip}" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding MetaArchetypes}" SelectedItem="{Binding SelectedArchetype}" Background="Transparent" BorderThickness="0">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <ItemsPresenter />
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Grid>
                                                                    <Border x:Name="HoverLayer" CornerRadius="8" Margin="0,0,0,3" Background="{StaticResource Hover}" Opacity="0" />
                                                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,6" Margin="0,0,0,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MetaArchetypeRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="46" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource TierBadge}" HorizontalAlignment="Left" Background="{Binding Tier, Converter={StaticResource KeyBrush}}">
                                                            <TextBlock Text="{Binding Tier}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnAccent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                                i:CardArt.Portrait="{Binding HeroId}" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WinRate}" Width="52" FontWeight="Bold" Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                                            <Border Width="80" Height="8" CornerRadius="3" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Tier, Converter={StaticResource KeyBrush}}"
                                                                        Width="{Binding BarFraction, Converter={StaticResource Fraction}, ConverterParameter=80}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding First}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Coin}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding ConstructedMetaStatus}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedArchetypeTitle}" FontSize="20" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArchetypeSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,16" Visibility="{Binding SelectedArchetype, Converter={StaticResource Vis}}">
                                            <Border Style="{StaticResource SegmentBar}" Padding="12,6" Margin="0,0,8,0" ToolTip="{i:Loc Main.Meta.FirstTip}">
                                                <TextBlock><Run Text="{i:Loc Main.Meta.GoingFirst}" Foreground="{StaticResource Muted}" /><Run Text="{Binding SelectedArchetype.First, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource SegmentBar}" Padding="12,6" ToolTip="{i:Loc Main.Meta.CoinTip}">
                                                <TextBlock><Run Text="{i:Loc Main.Meta.OnCoin}" Foreground="{StaticResource Muted}" /><Run Text="{Binding SelectedArchetype.Coin, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <c:Ornament Text="{i:Loc Main.Meta.MulliganGuide}" Icon="&#xF012C;" Size="13" Margin="0,0,0,4" />
                                        <TextBlock Text="{i:Loc Main.Meta.MulliganCaption}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Mulligan}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MulliganRow}">
                                                    <Border Style="{StaticResource RowBorder}" Padding="8,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="48" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                                    i:CardArt.Portrait="{Binding CardId}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       ToolTip="{i:Loc Main.Meta.KeepRateTip}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding Edge, Converter={StaticResource SignBrush}}">
                                                                <TextBlock.ToolTip>
                                                                    <TextBlock Text="{Binding Seen}" />
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{i:Loc Main.Meta.MulliganEmpty}" Style="{StaticResource Caption}" Margin="0,4"
                                                   Visibility="{Binding Mulligan, Converter={StaticResource Vis}, ConverterParameter=!}" />

                                        <c:Ornament Text="{i:Loc Main.Meta.BestLists}" Icon="&#xF0639;" Size="13" Margin="0,18,0,8" />
                                        <ItemsControl ItemsSource="{Binding ArchetypeDecks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MetaDeckRow}">
                                                    <Border Style="{StaticResource RowBorder}" Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                                    i:CardArt.Portrait="{Binding HeroId}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Class}" Style="{StaticResource Caption}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" ToolTip="{i:Loc Main.Table.WinRate}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Games}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       ToolTip="{i:Loc Main.Meta.ExactListTip}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Dust}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       ToolTip="{i:Loc Main.Meta.DustTip}" />
                                                            <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="{i:Loc Main.Meta.Copy}" Padding="12,4" FontSize="12" Margin="12,0,0,0"
                                                                    Command="{Binding DataContext.CopyDeck, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    ToolTip="{i:Loc Main.Meta.CopyTip}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{i:Loc Main.Meta.ListsEmpty}" Style="{StaticResource Caption}" Margin="0,4"
                                                   Visibility="{Binding ArchetypeDecks, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                        <TextBlock Text="{Binding CopyNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding CopyNote, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Top decks -->
                            <Border x:Name="MetaDecksPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="10,0,10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{i:Loc Main.Table.Deck}" Style="{StaticResource TableHead}" />
                                        <TextBlock Grid.Column="2" Text="{i:Loc Main.Table.WinRate}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{i:Loc Main.Table.Games}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{i:Loc Main.Table.Dust}" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding MetaDecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:MetaDeckRow}">
                                                    <Border Style="{StaticResource RowBorder}" Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface3}" HorizontalAlignment="Left"
                                                                    i:CardArt.Portrait="{Binding HeroId}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Class}" Style="{StaticResource Caption}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding WinRate}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" ToolTip="{i:Loc Main.Table.WinRate}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Games}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       ToolTip="{i:Loc Main.Meta.ExactListTip}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Dust}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       ToolTip="{i:Loc Main.Meta.DustTip}" />
                                                            <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="{i:Loc Main.Meta.Copy}" Padding="12,4" FontSize="12" Margin="12,0,0,0"
                                                                    Command="{Binding DataContext.CopyDeck, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    ToolTip="{i:Loc Main.Meta.CopyTip}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{i:Loc Main.Meta.DecksEmpty}" Style="{StaticResource Caption}" Margin="0,8"
                                               Visibility="{Binding MetaDecks, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    <TextBlock Text="{Binding CopyNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Positive}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding CopyNote, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding ConstructedMetaStatus}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Deck page (Main/Decks): replaces the Constructed page while a deck is open ===== -->
                    <ScrollViewer x:Name="PageDeck" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <dk:DeckDetailsView x:Name="DeckDetails" DataContext="{Binding DeckPage}" Margin="40,0,40,120" />
                    </ScrollViewer>

                    <!-- ===== Arena ===== -->
                    <ScrollViewer x:Name="PageArena" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120">
                            <TextBlock Text="{i:Loc Main.Mode.Arena}" Style="{StaticResource Display}" />
                            <StackPanel Style="{StaticResource PageSubtitle}">
                                <TextBlock Text="{i:Loc Main.Arena.Subtitle}" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <s:ArenaStatsView />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== History ===== -->
                    <Grid x:Name="PageHistory" Grid.Row="1" Margin="40,0,40,110" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{i:Loc Main.Nav.History}" Style="{StaticResource Display}" />
                                <StackPanel Style="{StaticResource PageSubtitle}">
                                    <TextBlock Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center">
                                        <Run Text="{Binding HistorySubtitle, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.History.FilterTip}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="HistoryAll" Style="{StaticResource Segment}" Content="{i:Loc Main.History.All}" GroupName="Hist" IsChecked="True" Command="{Binding SetHistoryFilter}" CommandParameter="All" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Battlegrounds}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Battlegrounds" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Duos}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Duos" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Ranked}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Ranked" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.History.Other}" GroupName="Hist" Command="{Binding SetHistoryFilter}" CommandParameter="Other" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,10">
                            <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryRows}" ItemTemplate="{StaticResource GameRowTemplate}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <!-- Selected only when a deck page sends a game here -->
                                                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                                                        <ContentPresenter Margin="10,0" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ===== Settings: tabs General / Overlay / Tracker / Account / Data / About (the last one shown is kept in AppSettings.SettingsTab) ===== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="40,0,40,120" MaxWidth="780" HorizontalAlignment="Left" ToggleButton.Checked="OnSettingChanged" ToggleButton.Unchecked="OnSettingChanged">
                            <TextBlock Text="{i:Loc Settings.Title}" Style="{StaticResource Display}" />
                            <StackPanel Style="{StaticResource PageSubtitle}">
                                <TextBlock Text="{i:Loc Settings.Subtitle}" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <WrapPanel>
                                    <RadioButton x:Name="SettingsTabGeneral" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.General}" GroupName="SettingsTab" Tag="General" IsChecked="True" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabOverlay" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Overlay}" GroupName="SettingsTab" Tag="Overlay" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabTracker" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Tracker}" GroupName="SettingsTab" Tag="Tracker" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabAccount" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Account}" GroupName="SettingsTab" Tag="Account" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabData" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Data}" GroupName="SettingsTab" Tag="Data" Checked="OnSettingsTab" />
                                    <RadioButton x:Name="SettingsTabAbout" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.About}" GroupName="SettingsTab" Tag="About" Checked="OnSettingsTab" />
                                </WrapPanel>
                            </Border>

                            <!-- ===== General: language, theme, app ===== -->
                            <StackPanel x:Name="SettingsGeneral">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.Language.Title}" Icon="&#xF05CA;" Size="13" Margin="0,0,0,14" />
                                        <Grid DataContext="{Binding Settings}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{i:Loc Settings.Language.Label}" FontSize="13.5" />
                                                <TextBlock Text="{i:Loc Settings.Language.Caption}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Language.System}" GroupName="Language" IsChecked="{Binding LanguageAuto}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="English" GroupName="Language" IsChecked="{Binding LanguageEnglish}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="Русский" GroupName="Language" IsChecked="{Binding LanguageRussian}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding LanguageRestartHint}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Visibility="{Binding LanguageRestartHint, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.Theme.Title}" Icon="&#xF03D8;" Size="13" Margin="0,0,0,6" />
                                        <TextBlock Text="{i:Loc Settings.Theme.Caption}" Style="{StaticResource Caption}" Margin="0,0,0,14" />
                                        <ItemsControl ItemsSource="{Binding Themes}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:ThemeChoice}">
                                                    <Button Style="{StaticResource ThemeSwatch}" Content="{Binding}" ToolTip="{Binding Name}" CommandParameter="{Binding Name}"
                                                            Command="{Binding DataContext.SelectTheme, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{i:Loc Settings.Theme.MakeOwn}" Style="{StaticResource Label}" Margin="0,10,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding CustomPreview}" ContentTemplate="{StaticResource ThemeTile}" VerticalAlignment="Top" Focusable="False" />
                                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{i:Loc Settings.Theme.Accent}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="8,0,8,-14" VerticalAlignment="Center" Background="{StaticResource HueStrip}" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding AccentHue}" SmallChange="5" LargeChange="30"
                                                            AutomationProperties.Name="{i:Loc Settings.Theme.Accent}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{i:Loc Settings.Theme.Background}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="8,0,8,-14" VerticalAlignment="Center" Background="{StaticResource HueStrip}" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding BaseHue}" SmallChange="5" LargeChange="30"
                                                            AutomationProperties.Name="{i:Loc Settings.Theme.Background}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{i:Loc Settings.Theme.Tint}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" Value="{Binding BaseTint}" SmallChange="0.05" LargeChange="0.25"
                                                            AutomationProperties.Name="{i:Loc Settings.Theme.Tint}" ToolTip="{i:Loc Settings.Theme.TintTip}" />
                                                </Grid>
                                                <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Theme.UseMine}" Command="{Binding ApplyCustomTheme}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.App.Title}" Icon="&#xF0614;" Size="13" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.Tray}" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.AutoUpdate}" IsChecked="{Binding Settings.AutoUpdate}" Click="OnSettingChanged"
                                                  ToolTip="{i:Loc Settings.App.AutoUpdateTip}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.StartWithWindows}" IsChecked="{Binding Settings.StartWithWindows}" Click="OnSettingChanged" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.App.StartMinimized}" IsChecked="{Binding Settings.StartMinimized}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Overlay: what is drawn over the game, its size, panel layout ===== -->
                            <StackPanel x:Name="SettingsOverlay" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel DataContext="{Binding Settings}">
                                        <c:Ornament Text="{i:Loc Settings.Overlay.Title}" Icon="&#xF0A07;" Size="13" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.Enabled}" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,14"
                                                  ToolTip="{i:Loc Settings.Overlay.EnabledTip}" />
                                        <TextBlock Text="{i:Loc Settings.Overlay.Battlegrounds}" Style="{StaticResource Label}" Margin="0,4,0,10" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.TopBar}" IsChecked="{Binding ShowBattlegroundsBar}" Margin="0,0,0,14"
                                                  ToolTip="{i:Loc Settings.Overlay.TopBarTip}" />
                                        <!-- Pick suggestions: badges over heroes, trinkets, tavern minions and every Discover -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{i:Loc Settings.Overlay.PickHints}" FontSize="13.5" />
                                                <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Setter Property="Text" Value="{i:Loc Settings.Overlay.PickHintsStatsOnlyCaption}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=PickHintsHighlightOption}" Value="True">
                                                                    <Setter Property="Text" Value="{i:Loc Settings.Overlay.PickHintsHighlightCaption}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=PickHintsOffOption}" Value="True">
                                                                    <Setter Property="Text" Value="{i:Loc Settings.Overlay.PickHintsOffCaption}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="PickHintsHighlightOption" Style="{StaticResource Segment}" Content="{i:Loc Settings.Overlay.PickHintsHighlight}" GroupName="PickHints"
                                                                 IsChecked="{Binding PickHintsHighlight}" />
                                                    <RadioButton x:Name="PickHintsStatsOnlyOption" Style="{StaticResource Segment}" Content="{i:Loc Settings.Overlay.PickHintsStatsOnly}" GroupName="PickHints"
                                                                 IsChecked="{Binding PickHintsStatsOnly}" />
                                                    <RadioButton x:Name="PickHintsOffOption" Style="{StaticResource Segment}" Content="{i:Loc Settings.Overlay.PickHintsOff}" GroupName="PickHints"
                                                                 IsChecked="{Binding PickHintsOff}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Game plan comp: who sets the comp the plan, tavern and Discover hints are built around -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <!-- Pick suggestions Off hides the game plan, so this choice has no effect then -->
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PickHintsOffOption}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{i:Loc Settings.Overlay.CompMode}" FontSize="13.5" />
                                                <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Setter Property="Text" Value="{i:Loc Settings.Overlay.CompModeManualCaption}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=CompModeAutoOption}" Value="True">
                                                                    <Setter Property="Text" Value="{i:Loc Settings.Overlay.CompModeAutoCaption}" />
                                                                </DataTrigger>
                                                                <!-- Stats only never shows the comp Hearthpulse picks: only a lock puts one on screen -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=CompModeAutoOption}" Value="True" />
                                                                        <Condition Binding="{Binding IsChecked, ElementName=PickHintsStatsOnlyOption}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="{i:Loc Settings.Overlay.CompModeAutoHiddenCaption}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentBar}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="CompModeManualOption" Style="{StaticResource Segment}" Content="{i:Loc Settings.Overlay.CompModeManual}" GroupName="CompMode"
                                                                 IsChecked="{Binding CompModeManual}" />
                                                    <RadioButton x:Name="CompModeAutoOption" Style="{StaticResource Segment}" Content="{i:Loc Settings.Overlay.CompModeAuto}" GroupName="CompMode"
                                                                 IsChecked="{Binding CompModeAuto}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.Boards}" IsChecked="{Binding ShowOpponentBoards}" Margin="0,0,0,14"
                                                  ToolTip="{i:Loc Settings.Overlay.BoardsTip}" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.Lobby}" IsChecked="{Binding ShowLobbyPanel}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.Odds}" IsChecked="{Binding ShowCombatOdds}" Margin="0,0,0,14"
                                                  ToolTip="{i:Loc Settings.Overlay.OddsTip}" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Overlay.Session}" IsChecked="{Binding ShowSessionPanel}" Margin="0,0,0,18" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Settings.Overlay.Size}" VerticalAlignment="Center" ToolTip="{i:Loc Settings.Overlay.SizeTip}" />
                                            <Slider Grid.Column="1" Minimum="0.7" Maximum="1.4" Value="{Binding OverlayScale}" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnSliderChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayScale, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Settings.Overlay.Opacity}" VerticalAlignment="Center" ToolTip="{i:Loc Settings.Overlay.OpacityTip}" />
                                            <Slider Grid.Column="1" Minimum="0.4" Maximum="1" Value="{Binding OverlayOpacity}" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnSliderChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel DataContext="{Binding Settings}">
                                        <c:Ornament Text="{i:Loc Settings.Layout.Title}" Icon="&#xF01BE;" Size="13" Margin="0,0,0,8" />
                                        <TextBlock Text="{i:Loc Settings.Layout.Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Layout.Arrange}" HorizontalAlignment="Left" Click="OnArrangeOverlay" Margin="0,0,0,24" />
                                        <c:Ornament Text="{i:Loc Settings.Leaderboard.Title}" Icon="&#xF01A3;" Size="13" Margin="0,0,0,8" />
                                        <TextBlock Text="{i:Loc Settings.Leaderboard.Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Leaderboard.Guides}" IsChecked="{Binding ShowLeaderboardGuides}" Margin="0,0,0,14" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Settings.Leaderboard.Top}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.05" Maximum="0.25" Value="{Binding LeaderboardTop}" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Settings.Leaderboard.SlotHeight}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.06" Maximum="0.12" Value="{Binding LeaderboardSlotHeight}" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{i:Loc Settings.Leaderboard.Width}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.04" Maximum="0.2" Value="{Binding LeaderboardWidth}" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Tracker: the Constructed deck tracker, counters and mulligan ===== -->
                            <StackPanel x:Name="SettingsTracker" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel DataContext="{Binding Settings}">
                                        <c:Ornament Text="{i:Loc Settings.Tracker.Title}" Icon="&#xF0639;" Size="13" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Tracker.Deck}" IsChecked="{Binding ShowDeckTracker}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Tracker.DrawChance}" IsChecked="{Binding ShowDrawChance}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Tracker.Opponent}" IsChecked="{Binding ShowOpponentTracker}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Tracker.CardPool}" IsChecked="{Binding ShowCardPool}" Margin="0,0,0,14"
                                                  ToolTip="{i:Loc Settings.Tracker.CardPoolTip}" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Tracker.Summary}" IsChecked="{Binding ShowGameToasts}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.Counters.Title}" Icon="&#xF012C;" Size="13" Margin="0,0,0,6" />
                                        <TextBlock Text="{i:Loc Settings.Counters.Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Counters.Show}" IsChecked="{Binding Settings.ShowCounters}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Counters.Opponent}" IsChecked="{Binding Settings.ShowOpponentCounters}" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Counters.Mulligan}" IsChecked="{Binding Settings.ShowMulligan}" Margin="0,0,0,8"
                                                  ToolTip="{i:Loc Settings.Counters.MulliganTip}" />
                                        <ItemsControl ItemsSource="{Binding CounterRows}" Margin="0,8,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:CounterSettingRow}">
                                                    <Grid Margin="0,0,0,8" ToolTip="{Binding Description}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Style="{StaticResource SegmentBar}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Auto}" GroupName="{Binding Id}" IsChecked="{Binding IsAuto, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Auto}" />
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Always}" GroupName="{Binding Id}" IsChecked="{Binding IsAlways, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Always}" />
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Off}" GroupName="{Binding Id}" IsChecked="{Binding IsOff, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Off}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Battlegrounds counters: same modes, ids start with "bg-" -->
                                        <TextBlock x:Name="BgCountersHeading" Text="{i:Loc Settings.Counters.Battlegrounds}" Style="{StaticResource H2}" Margin="0,14,0,4" />
                                        <TextBlock Text="{i:Loc Settings.Counters.BgCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding BgCounterRows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:CounterSettingRow}">
                                                    <Grid Margin="0,0,0,8" ToolTip="{Binding Description}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Style="{StaticResource SegmentBar}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Auto}" GroupName="{Binding Id}" IsChecked="{Binding IsAuto, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Auto}" />
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Always}" GroupName="{Binding Id}" IsChecked="{Binding IsAlways, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Always}" />
                                                                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Settings.Counters.Off}" GroupName="{Binding Id}" IsChecked="{Binding IsOff, Mode=OneWay}"
                                                                             Command="{Binding DataContext.SetCounterMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             CommandParameter="{Binding Id, StringFormat={}{0}|Off}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Account: the hearthpulse.net sign-in ===== -->
                            <Border x:Name="SettingsAccount" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.Account.Title}" Icon="&#xF0004;" Size="13" Margin="0,0,0,6" />
                                    <!-- Signed in -->
                                    <StackPanel Visibility="{Binding AccountShowProfile, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{i:Loc Settings.Account.SignedInAs}" Style="{StaticResource Caption}" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xF01A5;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,6,0"
                                                       Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding AccountSubscription}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding AccountSubscription}" Style="{StaticResource Caption}"
                                                       Visibility="{Binding AccountHasSubscription, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding AccountSessionNote}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                   Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                        <TextBlock Text="{Binding AccountSessionNote}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}}" />
                                        <TextBlock Margin="0,8,0,0">
                                            <Hyperlink Command="{Binding OpenAccountProfile}" Foreground="{StaticResource Accent}"><Run Text="{i:Loc Settings.Account.OpenProfile}" /></Hyperlink>
                                            <Run Text="&#xF03CC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" />
                                        </TextBlock>
                                        <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Account.SignInAgain}" Command="{Binding SignIn}" Margin="0,0,8,0"
                                                    Visibility="{Binding AccountSessionEndingSoon, Converter={StaticResource Vis}}" />
                                            <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Account.SignOut}" Command="{Binding SignOut}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <!-- Signed out -->
                                    <StackPanel Visibility="{Binding AccountSignedOut, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{i:Loc Settings.Account.SignedOutCaption}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Settings.Account.SignIn}" Command="{Binding SignIn}" />
                                            <TextBlock Text="{i:Loc Settings.Account.OpensBrowser}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Signing in: getting a code, then waiting for the player to confirm it on the site -->
                                    <StackPanel Visibility="{Binding AccountWaiting, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{i:Loc Settings.Account.GettingCode}" Style="{StaticResource Caption}" Margin="0,4,0,14"
                                                   Visibility="{Binding AccountHasCode, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                        <StackPanel Visibility="{Binding AccountHasCode, Converter={StaticResource Vis}}">
                                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Text="{i:Loc Settings.Account.Open}" />
                                                <Hyperlink Command="{Binding OpenSignInPage}" Foreground="{StaticResource Accent}"><Run Text="{Binding AccountCodeUri, Mode=OneWay}" /></Hyperlink>
                                                <Run Text="{i:Loc Settings.Account.EnterCode}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                                <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="18,6">
                                                    <TextBlock Text="{Binding AccountUserCode}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="28"
                                                               Foreground="{StaticResource Accent}" />
                                                </Border>
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding CopyAccountCode}" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xF018F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{i:Loc Settings.Account.Copy}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AccountWaitingHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Account.Cancel}" Command="{Binding CancelSignIn}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AccountMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding AccountMessage, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>

                            <!-- ===== Data: history, the data folder, sharing, where the numbers come from ===== -->
                            <StackPanel x:Name="SettingsData" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.Data.Title}" Icon="&#xF01BC;" Size="13" Margin="0,0,0,14" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{i:Loc Settings.Data.PoolSharing}" IsChecked="{Binding PoolSharing}"
                                                  Visibility="{Binding PoolAvailable, Converter={StaticResource Vis}}" Margin="0,0,0,18"
                                                  ToolTip="{i:Loc Settings.Data.PoolSharingTip}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Data.Import}" Click="OnReimport" Margin="0,0,8,0"
                                                    ToolTip="{i:Loc Settings.Data.ImportTip}" />
                                            <Button Style="{StaticResource GhostButton}" Content="{i:Loc Settings.Data.OpenFolder}" Click="OnOpenData" ToolTip="{i:Loc Settings.Data.OpenFolderTip}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <c:Ornament Text="{i:Loc Settings.Sources.Title}" Icon="&#xF0128;" Size="13" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Attribution}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== About ===== -->
                            <Border x:Name="SettingsAbout" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <c:Ornament Text="{i:Loc Settings.About.Title}" Icon="&#xF02FD;" Size="13" Margin="0,0,0,10" />
                                    <TextBlock Text="{i:Loc Settings.About.Text}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{i:Loc Settings.About.Fonts}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{i:Loc Settings.About.NotAffiliated}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ParseErrorsText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource Negative}"
                                               Visibility="{Binding ParseErrorsText, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== First start: ask before sharing results with the stats pool ===== -->
                    <Border Grid.Row="1" VerticalAlignment="Top" Margin="24,2,24,0" CornerRadius="16" Background="{StaticResource Surface3}" Panel.ZIndex="5"
                            BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="12,12,16,12"
                            Visibility="{Binding AskPoolConsent, Converter={StaticResource Vis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="46" Height="46">
                                <c:Scallop Fill="{StaticResource Surface4}" Lobes="9" Depth="0.1" />
                                <TextBlock Text="&#xF0849;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{i:Loc Main.Pool.Title}" FontWeight="Bold" FontSize="14.5" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource Text}"
                                           Text="{i:Loc Main.Pool.What}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{i:Loc Main.Pool.Never}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="{i:Loc Main.Pool.No}" Command="{Binding AnswerPool}" CommandParameter="no" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Main.Pool.Yes}" Command="{Binding AnswerPool}" CommandParameter="yes" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== Floating live bar (like a now-playing bar) ===== -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,24,18" CornerRadius="12" Background="{StaticResource Surface3}"
                            BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="9,9,15,9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="46" Height="46">
                                <c:Scallop x:Name="LivePulse" Fill="{StaticResource Surface4}" Lobes="9" Depth="0.1" />
                                <TextBlock Text="&#xF0EB7;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LiveTitle}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LiveDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip="{i:Loc Main.Live.SessionTip}">
                                <TextBlock Text="{Binding SessionSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SessionDelta}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="{Binding SessionDeltaValue, Converter={StaticResource SignBrush}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xF01BE;" Width="38" Height="38" Background="{StaticResource Surface4}" Margin="0,0,14,0"
                                        Click="OnArrangeOverlay" ToolTip="{i:Loc Main.Live.ArrangeTip}" />
                                <CheckBox x:Name="OverlaySwitch" Style="{StaticResource Switch}" Content="{i:Loc Main.Live.Overlay}" IsChecked="{Binding Settings.OverlayEnabled, Mode=OneTime}"
                                          Click="OnOverlaySwitch" ToolTip="{i:Loc Main.Live.OverlayTip}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Card preview on hover (deck page card tiles): top layer, never takes the mouse -->
            <c:CardPreviewHost Grid.ColumnSpan="2" />
        </Grid>
    </Border>
</Window>
