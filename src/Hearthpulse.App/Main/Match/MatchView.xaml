<UserControl x:Class="Hearthpulse.App.Main.Match.MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:r="clr-namespace:Hearthpulse.Core.Replay;assembly=Hearthpulse.Core"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match">
    <!-- The match page: one History game. DataContext is MainViewModel.MatchPage. Colours are theme tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A card back: the card's shape in the theme, used for every card the game never showed -->
            <ControlTemplate x:Key="CardBack" TargetType="ContentControl">
                <Border CornerRadius="8" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2">
                    <Border Margin="4" CornerRadius="5" Background="{StaticResource Decor}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid>
                            <c:Scallop Width="40" Height="40" Fill="{StaticResource Surface4}" Lobes="9" Depth="0.12" />
                            <TextBlock Text="&#xF0639;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource GoldTrim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>

            <!-- Under a card render while it loads (or when it cannot): the card body with its name -->
            <ControlTemplate x:Key="CardPlaceholder" TargetType="ContentControl">
                <Border CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>

            <!-- A minion or location on the board: the full card render, the current attack and health over the printed
                 ones, a divine shield halo; the full card shows on hover -->
            <DataTemplate x:Key="Minion" DataType="{x:Type r:MatchCardView}">
                <StackPanel Width="86" Margin="2,0" ToolTip="{Binding Tooltip}">
                    <Grid Height="129" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                        <Border Margin="1,6,1,2" CornerRadius="10" BorderBrush="{StaticResource Info}" BorderThickness="2.5" Opacity="0.85"
                                Visibility="{Binding DivineShield, Converter={StaticResource Vis}}" />
                        <ContentControl Template="{StaticResource CardPlaceholder}" Margin="6,10,6,6" />
                        <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,103,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,103,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="Hp" Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Damaged}" Value="True">
                        <Setter TargetName="Hp" Property="Foreground" Value="{StaticResource Negative}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A card in hand: the full card render (cost and text as in the game), or a card back with how it got there.
                 A card the log revealed later in the game is face up with an eye mark and the turn it was revealed. -->
            <DataTemplate x:Key="HandCard" DataType="{x:Type r:MatchCardView}">
                <StackPanel Width="66" Margin="1,0" ToolTip="{Binding Tooltip}">
                    <Grid Height="100">
                        <Grid x:Name="Face" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                            <ContentControl Template="{StaticResource CardPlaceholder}" Margin="4,8,4,4" />
                            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                        </Grid>
                        <ContentControl x:Name="Back" Template="{StaticResource CardBack}" Margin="4,8,4,4" Visibility="Collapsed" />
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{Binding Revealed, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xF06D0;" Style="{StaticResource Icon}" FontSize="12.5" Foreground="{StaticResource OnAccentContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="10.5" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding CardBack}" Value="True">
                        <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Back" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Revealed}" Value="True">
                        <Setter TargetName="NoteText" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A card offered at a choice (Discover, mulligan): the render, the picked/kept one framed, the others dimmed -->
            <DataTemplate x:Key="ChoiceCard" DataType="{x:Type r:MatchCardView}">
                <StackPanel x:Name="Root" Width="92" Margin="3,0" ToolTip="{Binding Tooltip}">
                    <Grid Height="138">
                        <Border x:Name="Frame" Margin="2,8,2,3" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="2.5" Visibility="Collapsed" />
                        <Grid x:Name="Face" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                            <ContentControl Template="{StaticResource CardPlaceholder}" Margin="6,11,6,6" />
                            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                        </Grid>
                        <ContentControl x:Name="Back" Template="{StaticResource CardBack}" Margin="6,11,6,6" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding CardBack}" Value="True">
                        <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Back" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Picked}" Value="True">
                        <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                        <Setter TargetName="NoteText" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Dimmed}" Value="True">
                        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A choice row: its title, then the offered cards -->
            <DataTemplate x:Key="ChoiceRow" DataType="{x:Type r:MatchChoiceView}">
                <StackPanel Margin="0,4,0,6">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ChoiceCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- A small round card (weapon, hero power, secret) -->
            <DataTemplate x:Key="Chip" DataType="{x:Type r:MatchCardView}">
                <Grid Width="40" Height="40" Margin="4,0,0,0" ToolTip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <Border x:Name="Face" CornerRadius="20" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5" i:CardArt.Portrait="{Binding CardId}" />
                    <Border x:Name="Back" CornerRadius="20" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Visibility="Collapsed">
                        <TextBlock Text="?" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="-2,0,0,-4" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-4" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding CardBack}" Value="True">
                        <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Back" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A side's hero line: portrait with health, weapon, hero power, secrets, mana and deck -->
            <DataTemplate x:Key="HeroLine" DataType="{x:Type r:MatchSideView}">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ItemsControl ItemsSource="{Binding Secrets}" ItemTemplate="{StaticResource Chip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ContentControl Content="{Binding Weapon}" ContentTemplate="{StaticResource Chip}" Visibility="{Binding Weapon, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Grid Width="62" Height="62" ToolTip="{Binding Hero}">
                            <Border CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2" i:CardArt.Portrait="{Binding HeroCardId}" />
                            <Border CornerRadius="9" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" Padding="6,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-4">
                                <TextBlock Text="{Binding HealthText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>
                        <ContentControl Content="{Binding HeroPower}" ContentTemplate="{StaticResource Chip}" Margin="14,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HeroPower, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" Margin="8,0,0,0" ToolTip="{i:Loc Match.View.ManaTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource ManaGem}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Mana}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Deck}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="CardRow">
                <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>

            <!-- An action of the turn: clicking it shows its step -->
            <DataTemplate x:Key="ActionRow" DataType="{x:Type r:MatchActionRow}">
                <Button Style="{StaticResource RowButton}" Padding="10,7" Margin="0,0,0,2"
                        Command="{Binding DataContext.GoFrame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <Grid>
                        <Border x:Name="Mark" CornerRadius="8" Margin="-10,-7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                        <DockPanel>
                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Local}" Value="True">
                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Current}" Value="True">
                        <Setter TargetName="Mark" Property="Background" Value="{StaticResource SelectedFill}" />
                        <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A turn chip: number, gold for your turns, filled while its step is on screen -->
            <DataTemplate x:Key="TurnChip" DataType="{x:Type mt:MatchTurnRow}">
                <Button Command="{Binding DataContext.GoFrame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}"
                        Cursor="Hand" Margin="0,0,5,5" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" MinWidth="30" Height="30" CornerRadius="8" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Local}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldTrim}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentContainer}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="Num" Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}" />
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Local}" Value="True">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource OnAccentContainer}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A deck list row as in the overlay's deck: cost chip, the card's tile art behind its name, copies; the note
                 (drawn, played, revealed...) under it; the full card shows on hover -->
            <DataTemplate x:Key="DeckRow" DataType="{x:Type r:MatchDeckRow}">
                <StackPanel x:Name="Root" Margin="0,0,0,5" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="31" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="25" Height="25" CornerRadius="5" Background="{StaticResource ManaGem}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Cost}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                            <Grid>
                                <Image i:CardArt.Tile="{Binding CardId}" Width="140" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                <Rectangle Fill="{StaticResource TileFade}" />
                                <DockPanel Margin="10,0,4,0">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="26" Height="21" Padding="5,0"
                                            Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="11" Margin="31,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Note, Converter={StaticResource Vis}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Used}" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A Battlegrounds minion (round art with stats) -->
            <DataTemplate x:Key="BgMinion" DataType="{x:Type r:MatchCardView}">
                <Grid Width="52" Height="60" Margin="2,0" ToolTip="{Binding Tooltip}">
                    <Border x:Name="Art" Width="48" Height="56" CornerRadius="24" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Top" i:CardArt.Portrait="{Binding CardId}" />
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Golden}" Value="True">
                        <Setter TargetName="Art" Property="BorderBrush" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="Wrap">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Button Style="{StaticResource GhostButton}" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,7" ToolTip="{i:Loc Match.View.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                <TextBlock Text="{i:Loc Match.View.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <TextBlock Text="{i:Loc Match.View.Loading}" Style="{StaticResource Caption}" FontSize="14" Visibility="{Binding Loading, Converter={StaticResource Vis}}" />

        <!-- Header: you, the result, the opponent -->
        <StackPanel Visibility="{Binding Loading, Converter={StaticResource Vis}, ConverterParameter=!}">
            <TextBlock Text="{Binding Header.Title}" Style="{StaticResource Display}" FontSize="30" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Header.Subtitle}" Style="{StaticResource Caption}" FontSize="13.5" Margin="2,2,0,18" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="60" Height="60" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                    i:CardArt.Portrait="{Binding Header.Local.HeroCardId}" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Local.Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Header.Local.Hero}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Header.Local.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,3,0,0"
                                           Visibility="{Binding Header.Local.Rank, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="18,6" Background="{StaticResource Surface3}" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="{Binding Header.Result}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="17"
                                       Foreground="{Binding Header.ResultKey, Converter={StaticResource KeyBrush}}" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ShowOpponent, Converter={StaticResource Vis}}">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Opponent.Name}" FontWeight="Bold" FontSize="16" TextAlignment="Right" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Header.Opponent.Hero}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Header.Opponent.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" Margin="0,3,0,0"
                                           Visibility="{Binding Header.Opponent.Rank, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <Border Width="60" Height="60" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                                    i:CardArt.Portrait="{Binding Header.Opponent.HeroCardId}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,16,0,12" />
                    <ItemsControl ItemsSource="{Binding Header.Facts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type r:MatchFact}">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Missing, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF02FC;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Missing}" Style="{StaticResource Caption}" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding IsConstructed, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabReplay" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabReplay}" GroupName="MatchTab" IsChecked="{Binding ShowReplay}" />
                    <RadioButton x:Name="TabDecks" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabDecks}" GroupName="MatchTab" IsChecked="{Binding ShowDecks}" />
                    <RadioButton x:Name="TabAnalysis" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabAnalysis}" GroupName="MatchTab" IsChecked="{Binding ShowAnalysis}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding IsBattlegrounds, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabRounds}" GroupName="MatchBgTab" IsChecked="{Binding ShowRounds}" />
                    <RadioButton x:Name="TabLobby" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabLobby}" GroupName="MatchBgTab" IsChecked="{Binding ShowLobby}" />
                </StackPanel>
            </Border>

            <!-- ===== Replay ===== -->
            <StackPanel Visibility="{Binding ShowReplay, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Turns}" ItemTemplate="{StaticResource TurnChip}" ItemsPanel="{StaticResource Wrap}" Margin="0,0,0,2" />
                <TextBlock Text="{i:Loc Match.View.TurnsLegend}" Style="{StaticResource Caption}" FontSize="11.5" Margin="2,0,0,10" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xF0600;" Command="{Binding First}" ToolTip="{i:Loc Match.View.First}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xF04AE;" Command="{Binding PreviousTurn}" ToolTip="{i:Loc Match.View.PreviousTurn}" Margin="4,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xF0141;" Command="{Binding Previous}" ToolTip="{i:Loc Match.View.Previous}" Margin="4,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xF0142;" Command="{Binding Next}" ToolTip="{i:Loc Match.View.Next}" Margin="4,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xF04AD;" Command="{Binding NextTurn}" ToolTip="{i:Loc Match.View.NextTurn}" Margin="4,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xF0601;" Command="{Binding Last}" ToolTip="{i:Loc Match.View.Last}" Margin="4,0,0,0" />
                    </StackPanel>
                    <DockPanel Grid.Column="1" Margin="16,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Slider Minimum="0" Maximum="{Binding FrameMax}" Value="{Binding Frame}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center" ToolTip="{i:Loc Match.View.SliderTip}" />
                    </DockPanel>
                    <Border Grid.Column="2" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Match.View.SideTip}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Match.View.MySide}" GroupName="MatchSide" IsChecked="{Binding BottomLocal}" />
                            <RadioButton x:Name="SideOpponent" Style="{StaticResource Segment}" Content="{i:Loc Match.View.TheirSide}" GroupName="MatchSide" IsChecked="{Binding BottomOpponent}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <!-- The table -->
                    <Border Style="{StaticResource Card}" Padding="18,14" DataContext="{Binding Step}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Top.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                            <ContentControl Content="{Binding Top}" ContentTemplate="{StaticResource HeroLine}" />
                            <ItemsControl ItemsSource="{Binding Top.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,7" Margin="0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Turn}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
                                </DockPanel>
                            </Border>
                            <!-- The step's choice: the Discover options, or both mulligans -->
                            <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" Margin="0,0,0,6"
                                          Visibility="{Binding Choices.Count, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Bottom.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                            <ContentControl Content="{Binding Bottom}" ContentTemplate="{StaticResource HeroLine}" />
                            <ItemsControl ItemsSource="{Binding Bottom.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                        </StackPanel>
                    </Border>
                    <!-- The turn's actions -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <DockPanel>
                            <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Match.View.ThisTurn}" Icon="&#xF0467;" Size="13" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionRow}" />
                        </DockPanel>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding TableNote}" Style="{StaticResource Caption}" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===== Decks ===== -->
            <Grid Visibility="{Binding ShowDecks, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.YourDeck}" Icon="&#xF0638;" Size="13" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding LocalDeckNote}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding LocalDeck}" ItemTemplate="{StaticResource DeckRow}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.OpponentCards}" Icon="&#xF06D0;" Size="13" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OpponentCardsNote}" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,0,0,10" Background="{StaticResource AccentContainer}"
                                    Visibility="{Binding ArchetypeLine, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ArchetypeLine}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding OpponentCards}" ItemTemplate="{StaticResource DeckRow}" />
                            <TextBlock Text="{Binding OpponentCardsEmpty}" Style="{StaticResource Caption}" Visibility="{Binding OpponentCards, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <!-- The archetype's most played meta list: a guess, and says so -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding OpponentPredicted, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" VerticalAlignment="Center">
                                    <TextBlock Text="{i:Loc Match.View.PredictedBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                </Border>
                                <c:Ornament Text="{i:Loc Match.View.Predicted}" Icon="&#xF0638;" Size="13" HorizontalAlignment="Left" />
                            </DockPanel>
                            <TextBlock Text="{Binding OpponentPredictedNote}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OpponentPredicted}" ItemTemplate="{StaticResource DeckRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- ===== Analysis (Core MatchAnalysis) ===== -->
            <StackPanel Visibility="{Binding ShowAnalysis, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Analysis.Tiles}" ItemsPanel="{StaticResource StatsTilesPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type r:AnalysisTile}">
                                <StackPanel Margin="0,0,18,0" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="25" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.HealthChart}" Icon="&#xF02D1;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{i:Loc Match.View.HealthChartNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalHealth}" Compare="{Binding Analysis.OpponentHealth}" Maximum="{Binding Analysis.HealthMaximum}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.BoardChart}" Icon="&#xF0787;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{i:Loc Match.View.BoardChartNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalBoard}" Compare="{Binding Analysis.OpponentBoard}" Maximum="{Binding Analysis.BoardMaximum}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.KeyCards}" Icon="&#xF01A5;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{i:Loc Match.View.KeyCardsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Analysis.KeyCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:KeyCardRow}">
                                        <Border Style="{StaticResource StatsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock x:Name="Who" Grid.Column="2" Text="{i:Loc Match.Opponent}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Local}" Value="True">
                                                <Setter TargetName="Who" Property="Text" Value="{i:Loc Match.You}" />
                                                <Setter TargetName="Who" Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{i:Loc Match.View.NoKeyCards}" Style="{StaticResource Caption}" Visibility="{Binding Analysis.KeyCards, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.Mulligan}" Icon="&#xF0450;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Analysis.MulliganNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{i:Loc Match.You}" Style="{StaticResource StatsHead}" />
                                <TextBlock Grid.Column="2" Text="{i:Loc Match.View.MetaKeep}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Match.View.MetaKeepTip}" />
                                <TextBlock Grid.Column="3" Text="{i:Loc Match.View.HeldWinRate}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Match.View.HeldWinRateTip}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Analysis.Mulligan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:MulliganCardRow}">
                                        <Border Style="{StaticResource StatsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Mark" Text="" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Choice" Text="{Binding Choice}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding MetaKeep}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding MetaWinRate}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kept}" Value="False">
                                                <Setter TargetName="Choice" Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Agreement}" Value="1">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xF012C;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Positive}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Agreement}" Value="-1">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xF0026;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Negative}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Analysis.MulliganReceived, Converter={StaticResource Vis}}">
                                <Run Text="{i:Loc Match.View.CameInstead}" /><Run Text="{Binding Analysis.MulliganReceivedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.ManaChart}" Icon="&#xF05E0;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{i:Loc Match.View.ManaChartNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <c:MiniBars Height="80" Values="{Binding Analysis.LocalMana}" Compare="{Binding Analysis.ManaFull}" ShowLabels="True" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.AgainstMeta}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Analysis.Meta}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:MatchFact}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Analysis.MetaNote}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.TurnByTurn}" Icon="&#xF0467;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <Grid Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Match.View.ColTurn}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="1" Text="{i:Loc Match.View.ColYourHp}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="2" Text="{i:Loc Match.View.ColTheirHp}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="3" Text="{i:Loc Match.View.YourBoard}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="4" Text="{i:Loc Match.View.ColTheirBoard}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="5" Text="{i:Loc Match.View.ColMana}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="6" Text="{i:Loc Match.View.ColPlayed}" Style="{StaticResource StatsHead}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Analysis.TurnRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type r:AnalysisTurnRow}">
                                    <Border Style="{StaticResource StatsRow}" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LocalHealth}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding OpponentHealth}" />
                                            <TextBlock Grid.Column="3" Text="{Binding LocalBoard}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding OpponentBoard}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Mana}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Played}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Played}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Local}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Battlegrounds rounds ===== -->
            <ItemsControl ItemsSource="{Binding Rounds}" Visibility="{Binding ShowRounds, Converter={StaticResource Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type r:MatchRoundView}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontWeight="Bold" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{i:Loc Match.View.YourBoard}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding OpponentHeroCardId, Converter={StaticResource Vis}}">
                                        <Border Width="44" Height="44" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Center" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                                                i:CardArt.Portrait="{Binding OpponentHeroCardId}" ToolTip="{Binding OpponentHero}" />
                                        <TextBlock Text="{i:Loc Match.View.Versus}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding OpponentHero}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding OpponentBoard}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding Shop, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{i:Loc Match.View.TavernOffers}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Shop}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Battlegrounds lobby ===== -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowLobby, Converter={StaticResource Vis}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Match.View.TabLobby}" Icon="&#xF0849;" Size="13" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Lobby}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type r:MatchLobbyRow}">
                                <Border Style="{StaticResource StatsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Place" Text="{Binding Place}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                        <TextBlock Grid.Column="2" x:Name="Name" Text="{Binding Hero}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Local}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Place" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
