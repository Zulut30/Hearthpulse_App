<UserControl x:Class="Hearthpulse.App.Main.Match.ReplayLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match">
    <!-- The History page as the replay library (docs/replay-library.md): tabs Recent / Saved / Imported, the search and
         the result filter, the status line, the game cards. DataContext is MainViewModel.Library. Colours are theme
         tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
                <!-- Empty states (the window's copy is not visible while this view is parsed) -->
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainLook.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A card that opens the match page: no button look of its own -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small card button of a card (star, Share, delete): does not take the focus from the list -->
            <Style x:Key="CardIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource Faint}" />
            </Style>

            <!-- A hero power or trinket: a round portrait, the full card on hover -->
            <DataTemplate x:Key="Chip" DataType="{x:Type mt:LibraryChip}">
                <Border Width="22" Height="22" Margin="0,0,3,0" CornerRadius="11" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}"
                        BorderThickness="1" i:CardArt.Portrait="{Binding CardId}" c:CardPreview.CardId="{Binding CardId}" ToolTip="{Binding Tooltip}" />
            </DataTemplate>

            <!-- A minion of the final board: a small oval (golden: accent rim, taunt: thick rim, divine shield: outer
                 ring) and its stats under it. 48 wide and 1 apart (LibrarySummary.MinionRoom): "736/639" fits in tabular
                 digits; longer stats trim, the tooltip has them whole. -->
            <DataTemplate x:Key="Minion" DataType="{x:Type mt:LibraryMinion}">
                <StackPanel Width="48" Margin="0,0,1,0" Background="Transparent" ToolTip="{Binding Tooltip}" c:CardPreview.CardId="{Binding CardId}">
                    <Grid Width="28" Height="34" HorizontalAlignment="Center">
                        <Border x:Name="Shield" CornerRadius="14" BorderBrush="{StaticResource Info}" BorderThickness="1.5" Visibility="Collapsed" />
                        <Border x:Name="Oval" Width="26" Height="32" CornerRadius="13" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" i:CardArt.Portrait="{Binding CardId}" />
                    </Grid>
                    <TextBlock Text="{Binding Stats}" FontFamily="{StaticResource DisplayFont}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Taunt}" Value="True">
                        <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Muted}" />
                        <Setter TargetName="Oval" Property="BorderThickness" Value="2.5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Golden}" Value="True">
                        <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="Oval" Property="BorderThickness" Value="1.5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DivineShield}" Value="True">
                        <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="RowPanel">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <i:BoardFit x:Key="BoardFit" />

            <!-- The final board as its room shows it: whole minions, then "+N" naming the rest in its tooltip -->
            <DataTemplate x:Key="BoardRow" DataType="{x:Type mt:LibraryBoardView}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource RowPanel}" Focusable="False"
                                  VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="{Binding MoreTip}" AutomationProperties.Name="{Binding MoreTip}"
                            Visibility="{Binding More, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding More}" FontSize="11" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The right end of a card: star and Share (or the "no replay" mark), delete on Imported -->
            <DataTemplate x:Key="CardActions" DataType="{x:Type mt:LibraryCard}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="Star" Style="{StaticResource CardIcon}" Content="&#xF04D2;" ToolTip="{Binding StarTip}"
                            Command="{Binding DataContext.ToggleStar, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding StarTip}" Visibility="{Binding HasReplay, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource CardIcon}" Content="&#xF0497;" ToolTip="{i:Loc Library.Share}" AutomationProperties.Name="{i:Loc Library.Share}"
                            Command="{Binding DataContext.Share, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding HasReplay, Converter={StaticResource Vis}}" />
                    <!-- Plan 2.2: upload to the site / delete from it, after the confirmation in the card -->
                    <Button Style="{StaticResource CardIcon}" Content="{Binding SiteGlyph}" ToolTip="{Binding SiteTip}" AutomationProperties.Name="{Binding SiteTip}"
                            Command="{Binding DataContext.SiteAction, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanUpload, Converter={StaticResource Vis}}" />
                    <TextBlock Text="&#xF1036;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Faint}" Margin="7,0" VerticalAlignment="Center"
                               ToolTip="{i:Loc Library.NoReplay}" Visibility="{Binding NoReplay, Converter={StaticResource Vis}}" />
                    <Button x:Name="Delete" Style="{StaticResource CardIcon}" Content="&#xF09E7;" ToolTip="{i:Loc Library.Delete}" AutomationProperties.Name="{i:Loc Library.Delete}"
                            Command="{Binding DataContext.Delete, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanDelete, Converter={StaticResource Vis}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Starred}" Value="True">
                        <Setter TargetName="Star" Property="Content" Value="&#xF04CE;" />
                        <Setter TargetName="Star" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                    <Trigger SourceName="Delete" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Delete" Property="Foreground" Value="{StaticResource Negative}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The result plate (BG: the place) and the rating change, then when and how long -->
            <DataTemplate x:Key="CardResult" DataType="{x:Type mt:LibraryCard}">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="6" Padding="10,3" Background="{StaticResource Surface3}">
                            <TextBlock Text="{Binding Result}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding Rating}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding RatingValue, Converter={StaticResource SignBrush}}" ToolTip="{i:Loc Main.Game.RatingChange}" />
                    </StackPanel>
                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding When}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="LibraryCard" DataType="{x:Type mt:LibraryCard}">
                <Button Style="{StaticResource CardButton}" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{i:Loc Match.View.OpenTip}">
                    <Border x:Name="Plate" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Background="{StaticResource Row}">
                        <StackPanel>
                            <!-- Both kinds share the outer columns (hero 56 · ... · result 150 · actions 98): the result, the date
                                 and the buttons line up down the list. The result column fits the longest date and duration
                                 ("Сегодня 12:49 · 27 мин", "04 нояб. 12:49 · 27 мин": about 131-140 px), the actions column three
                                 buttons. A card is about 666 px wide at the minimum window (1040) and 886 at the default (1260):
                                 window - nav 250 - page margins 80 - list card border 2 and padding 32 - list chrome 2 - scroll
                                 bar 6 - item border 2; its row is 24 less (the plate's padding). -->
                            <!-- Battlegrounds: hero · name and caption (120; the caption wraps to two lines, "Уровень 5 · 14 ходов")
                                 · chips and the board · result · actions. The board shows the minions that fit whole and "+N" for
                                 the rest: at 1040 its room is about 99 px (one minion and "+6"), at 1260 about 319 (five and "+2");
                                 all seven (343) from a window of about 1285. -->
                            <Grid Visibility="{Binding IsBattlegrounds, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="98" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding HeroCardId}"
                                        c:CardPreview.CardId="{Binding HeroCardId}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock x:Name="BgCaption" Text="{Binding Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="32" LineStackingStrategy="BlockLineHeight" LineHeight="16" ToolTip="{Binding Caption}" />
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="11" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Summary.Chips}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource RowPanel}" Focusable="False" />
                                        <Border Style="{StaticResource Pill}" ToolTip="{Binding Summary.ChipsMoreTip}" AutomationProperties.Name="{Binding Summary.ChipsMoreTip}"
                                                VerticalAlignment="Center" Visibility="{Binding Summary.ChipsMore, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Summary.ChipsMore}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Height="28" Margin="5,0" Background="{StaticResource Border}" />
                                    <!-- An empty border measures the board's room; the board itself never widens it -->
                                    <Border x:Name="BoardRoom" Grid.Column="2" />
                                    <ContentControl Grid.Column="2" ContentTemplate="{StaticResource BoardRow}" Focusable="False" IsTabStop="False">
                                        <ContentControl.Content>
                                            <MultiBinding Converter="{StaticResource BoardFit}">
                                                <Binding ElementName="BoardRoom" Path="ActualWidth" />
                                                <Binding Path="Summary" />
                                            </MultiBinding>
                                        </ContentControl.Content>
                                    </ContentControl>
                                </Grid>
                                <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource CardResult}" />
                                <ContentPresenter Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource CardActions}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Constructed, Arena and the rest: heroes · deck and caption · opponent · result · actions. The caption
                                 takes the room; the opponent ("vs Охотник на демонов" and the archetype) up to 120 with a tooltip.
                                 The longest caption ("Паладин · Рейтинговая · Стандартный · 12 ходов · Платина 4", about 366 px)
                                 fits at 1260 (about 414 px); at 1040 (about 194) it trims from the end, the rank first, whole in
                                 the tooltip. -->
                            <Grid Visibility="{Binding IsConstructed, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="98" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="44" HorizontalAlignment="Left">
                                    <Border Width="40" Height="40" Style="{StaticResource StatsPortrait}" VerticalAlignment="Top" i:CardArt.Portrait="{Binding HeroCardId}" />
                                    <Border Width="24" Height="24" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            BorderBrush="{StaticResource Accent2Line}" BorderThickness="1.5" i:CardArt.Portrait="{Binding OpponentHeroCardId}"
                                            ToolTip="{Binding Opponent}" Visibility="{Binding OpponentHeroCardId, Converter={StaticResource Vis}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MaxWidth="120" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Opponent}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Opponent}" />
                                    <TextBlock Text="{Binding OpponentArchetype}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OpponentArchetype}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource CardResult}" />
                                <ContentPresenter Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource CardActions}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- The question before a delete, inside the card -->
                            <Border Margin="0,8,0,0" CornerRadius="8" Padding="12,8" Background="{StaticResource NegativeSoft}" BorderBrush="{StaticResource Negative}"
                                    BorderThickness="1" Visibility="{Binding Confirming, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0" Content="{i:Loc Library.ConfirmNo}"
                                            Command="{Binding DataContext.Cancel, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Foreground="{StaticResource Negative}"
                                            Content="{i:Loc Library.ConfirmYes}"
                                            Command="{Binding DataContext.Confirm, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="&#xF05D6;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConfirmText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Plate" Property="Background" Value="{StaticResource Hover}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,7" IsEnabled="{Binding CanImport}" ToolTip="{i:Loc Library.ImportTip}"
                    Command="{Binding Import}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF02FA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnSecondaryContainer}" VerticalAlignment="Center" />
                    <TextBlock Text="{i:Loc Library.Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0DCF;" Margin="0,0,8,0" ToolTip="{i:Loc Library.OpenFolder}"
                    AutomationProperties.Name="{i:Loc Library.OpenFolder}" Command="{Binding OpenFolder}" Visibility="{Binding ShowFolder, Converter={StaticResource Vis}}" />
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Library" IsChecked="{Binding IsRecent, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Recent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Recent}" />
                            <TextBlock Text="{Binding RecentCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Tab}" GroupName="Library" IsChecked="{Binding IsSaved, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Saved">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Saved}" />
                            <TextBlock Text="{Binding SavedCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Tab}" GroupName="Library" IsChecked="{Binding IsImported, Mode=OneWay}" Command="{Binding SetTab}" CommandParameter="Imported">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Library.Tab.Imported}" />
                            <TextBlock Text="{Binding ImportedCount}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Search (up to 420 wide, on the left) and the result filter (on the right); both apply to every tab -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="420" />
                <ColumnDefinition Width="*" MinWidth="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <!-- The theme's text box applies Padding twice (frame and text view): 17,4,15,4 reads as 34 left, 30 right -->
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="17,4,15,4" ToolTip="{i:Loc Library.Search.Tip}"
                         AutomationProperties.Name="{i:Loc Library.Search.Name}" PreviewKeyDown="OnSearchKey" />
                <TextBlock Text="&#xF0349;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Faint}" Margin="12,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock Text="{i:Loc Library.Search.Placeholder}" Foreground="{StaticResource Faint}" Margin="36,0,34,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                           Visibility="{Binding Search, Converter={StaticResource Vis}, ConverterParameter=!}" />
                <Button Style="{StaticResource IconButton}" Content="&#xF0156;" Width="26" Height="26" FontSize="14" Focusable="False" HorizontalAlignment="Right"
                        Margin="0,0,4,0" Click="OnClearSearchText" ToolTip="{i:Loc Library.Search.ClearTip}"
                        AutomationProperties.Name="{i:Loc Library.Search.ClearTip}" Visibility="{Binding Search, Converter={StaticResource Vis}}" />
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource SegmentBar}" VerticalAlignment="Center" ToolTip="{i:Loc Library.Search.ResultTip}"
                    AutomationProperties.Name="{i:Loc Library.Search.ResultTip}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.History.All}" GroupName="LibraryResult" IsChecked="{Binding ResultAll, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="All" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Library.Search.Wins}" GroupName="LibraryResult" IsChecked="{Binding ResultWins, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="Win" />
                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Library.Search.Losses}" GroupName="LibraryResult" IsChecked="{Binding ResultLosses, Mode=OneWay}"
                                 Command="{Binding SetResultFilter}" CommandParameter="Loss" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status of the last action; it goes at the next tab, filter, opened match or action -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,10" Visibility="{Binding Status, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Center"
                       Foreground="{Binding StatusKey, Converter={StaticResource KeyBrush}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding EmptyGlyph}" Content="{Binding EmptyText}" />
                    <!-- Nothing passes the search: one click back to every game of the tab -->
                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,4,0,8" HorizontalAlignment="Center" Content="{i:Loc Library.Search.Clear}"
                            Click="OnClearSearch" Visibility="{Binding IsSearchEmpty, Converter={StaticResource Vis}}" />
                </StackPanel>
                <ListBox x:Name="List" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource LibraryCard}" SelectedItem="{Binding SelectedCard, Mode=OneWay}"
                         SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Selected only when a game was just imported or a deck page sends one here -->
                                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
