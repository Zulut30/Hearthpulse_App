<UserControl x:Class="Hearthpulse.App.Overlay.OpponentHandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             Width="{x:Static o:OverlayViewModel.HandPanelWidth}" Height="{x:Static o:OverlayViewModel.HandPanelHeight}">
    <!-- Marks on the opponent's hand fan: the turn each card came in ("M" = opening hand), the Coin, and the portrait
         of the card when it is known or of the card that created it. The panel hangs from the top of the window and the
         view model puts each mark on the visible edge of its card, following the fan as it grows (OpponentHandFan). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding HandMarks}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type o:HandMark}">
                <Border Width="{x:Static o:OverlayViewModel.HandMarkWidth}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding Offset}"
                        Padding="0,1,0,2" CornerRadius="6" Background="{StaticResource OverlayPanel}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
                        o:OverlayHit.Interactive="True" c:CardPreview.Caption="{Binding Hint}" c:CardPreview.CardId="{Binding PreviewCardId}"
                        c:CardPreview.Placement="Below">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                   Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                        <Grid Width="20" Height="20" Margin="0,1,0,0" Visibility="{Binding PortraitId, Converter={StaticResource Vis}}">
                            <Border Margin="1.5" CornerRadius="8.5" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding PortraitId}" />
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Accent}" StrokeThickness="1.25" />
                            <!-- Created by this card: the portrait is the creator's, marked with the same glyph as created deck cards -->
                            <Border Width="11" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3"
                                    Background="{StaticResource OverlayBadgeShade}" Visibility="{Binding Created, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xF0674;" Style="{StaticResource Icon}" FontSize="8" Foreground="{StaticResource Info}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Created}" Value="True">
                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Info}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
