<UserControl x:Class="Hearthpulse.App.Overlay.OddsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Simulated combat odds (MovablePanel "odds" and the OBS window "Hearthpulse — Combat odds", docs/streaming.md): win, tie
         and loss with the damage either way, the share bar, lethal both ways and how the odds were found; a red edge while
         the fight can kill the player. DataContext: OverlayViewModel (inherited). Tokens only. -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Base}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="OddsCard" Background="{StaticResource OverlayPanelSolid}" Padding="14,7,14,8" Width="250">
        <Border.Style>
            <!-- Red edge while the fight can kill the player -->
            <Style TargetType="Border" BasedOn="{StaticResource OverlayCard}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LethalDanger}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OddsWin}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Positive}" HorizontalAlignment="Center" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Win}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OddsDamageWin}" ToolTip="{Binding OddsDamageWinTip}" Style="{StaticResource Number}" FontSize="11" Foreground="{StaticResource Positive}"
                               HorizontalAlignment="Center" Visibility="{Binding OddsDamageWin, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OddsTie}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Tie}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OddsLoss}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" />
                    <TextBlock Text="{i:Loc Overlay.Odds.Loss}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OddsDamageLoss}" ToolTip="{Binding OddsDamageLossTip}" Style="{StaticResource Number}" FontSize="11" Foreground="{StaticResource Negative}"
                               HorizontalAlignment="Center" Visibility="{Binding OddsDamageLoss, Converter={StaticResource Vis}}" />
                </StackPanel>
            </UniformGrid>
            <Border Height="4" CornerRadius="1" ClipToBounds="True" Margin="0,6,0,5" Background="{StaticResource Surface3}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WinShare}" />
                        <ColumnDefinition Width="{Binding TieShare}" />
                        <ColumnDefinition Width="{Binding LossShare}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Positive}" />
                    <Border Grid.Column="1" Background="{StaticResource Faint}" />
                    <Border Grid.Column="2" Background="{StaticResource Negative}" />
                </Grid>
            </Border>
            <!-- Lethal: the share of fights that kill either hero -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="{i:Loc Overlay.Odds.LethalTip}" Visibility="{Binding OddsLethal, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xF068C;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Negative}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OddsLethal}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding OddsKill}" ToolTip="{i:Loc Overlay.Odds.KillTip}" FontSize="11" Foreground="{StaticResource Positive}" Margin="5,0" VerticalAlignment="Center"
                           Visibility="{Binding OddsKill, Converter={StaticResource Vis}}" />
            </StackPanel>
            <TextBlock Text="{Binding OddsNote}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
