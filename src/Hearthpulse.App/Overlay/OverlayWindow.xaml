<Window x:Class="Hearthpulse.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
        xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
        xmlns:c="clr-namespace:Hearthpulse.App.Controls"
        Title="{i:Loc Pool.OverlayWindow.Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        Left="0" Top="0" Width="1" Height="1"
        UseLayoutRounding="True" Style="{StaticResource AppWindow}" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />
        <i:SignBrush x:Key="SignBrush" />
        <i:FractionWidth x:Key="Fraction" />

        <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Base}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- Mana gem cost badge for card rows -->
        <Style x:Key="CostChip" TargetType="c:ManaCost">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Deck row: cost, name over card art with the copy count, then the draw chance in its own column so it never
             runs into the name -->
        <DataTemplate x:Key="DeckTileTemplate" DataType="{x:Type o:DeckTile}">
            <Grid x:Name="RowRoot" Height="24" Margin="0,0,0,2" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:ManaCost Style="{StaticResource CostChip}" Text="{Binding Cost}" HorizontalAlignment="Left" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Width="2" HorizontalAlignment="Left" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,3,0">
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="20" Height="18" Padding="5,0"
                                    Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowCount, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#xF0674;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" Visibility="{Binding Created, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Chance}" Width="31" TextAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Visibility="{Binding DataContext.ShowChance, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Empty}" Value="True">
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.32" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlayedTemplate" DataType="{x:Type o:PlayedTile}">
            <Grid Height="22" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:ManaCost Style="{StaticResource CostChip}" Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="8,0,3,0">
                            <!-- Copies and turn on a dark plate, like the deck's copy count, so they stay readable over bright art -->
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" Height="16" Padding="5,0"
                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,5,0"
                                               VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Turn}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HandTemplate" DataType="{x:Type o:HandTile}">
            <Grid Height="22" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface3}" CornerRadius="5">
                    <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Turn}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Detail" Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="True">
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unknown}" Value="True">
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Faint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Counter tooltip strip: card art behind the name, count on the right; a part of a goal gets a done mark -->
        <DataTemplate x:Key="CounterCardTemplate" DataType="{x:Type o:CounterTipCard}">
            <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2">
                <Border Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="7,0,7,0">
                            <TextBlock x:Name="Mark" DockPanel.Dock="Left" Text="&#xF0766;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Faint}"
                                       Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsPart, Converter={StaticResource Vis}}" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="20" Height="16" Padding="4,0"
                                    Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPart}" Value="True" />
                        <Condition Binding="{Binding Done}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Mark" Property="Text" Value="&#xF05E0;" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Positive}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="False">
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- What a counter's tooltip and its opened row list: the goal's parts, what was counted, the cards that need it -->
        <DataTemplate x:Key="CounterCardsTemplate" DataType="{x:Type o:CounterChip}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" Margin="0,0,0,2" Visibility="{Binding Details, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding Parts, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Goal}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Counted, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                    <TextBlock Text="{Binding MoreCounted}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding MoreCounted, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Related, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                    <TextBlock Text="{Binding MoreRelated}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding MoreRelated, Converter={StaticResource Vis}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The opened Battlegrounds chip: its cards only, under the details the row already shows -->
        <DataTemplate x:Key="BgCounterCardsTemplate" DataType="{x:Type o:CounterChip}">
            <StackPanel>
                <StackPanel Visibility="{Binding Counted, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Related, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Counter tooltip: title and value, what the counter is, then its cards -->
        <DataTemplate x:Key="CounterTipTemplate" DataType="{x:Type o:CounterChip}">
            <StackPanel Width="232" Margin="0,2,0,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}" FontSize="14" Foreground="{StaticResource Accent}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,2" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Segments of a goal counted in steps, lit up to the count -->
        <DataTemplate x:Key="CounterSegmentTemplate">
            <Border x:Name="Segment" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{StaticResource Surface4}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="Segment" Property="Background" Value="{StaticResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Counter row: card art (the cross over it on hover hides the counter), title with its progress under it, value
             right-aligned; hover shows the cards, a click opens them under the row -->
        <DataTemplate x:Key="CounterTemplate" DataType="{x:Type o:CounterChip}">
            <Border x:Name="Chip" Background="Transparent" CornerRadius="5" Padding="3,1,4,1" Cursor="Hand"
                    ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Right" ToolTipService.HorizontalOffset="8">
                <Border.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
                </Border.ToolTip>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                                  Command="{Binding DataContext.ToggleCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="CounterValue" />
                        </Grid.ColumnDefinitions>
                        <!-- The art is drawn a little larger than the circle: some portraits have light edges that WPF shows as a rim -->
                        <Grid Width="20" Height="20">
                            <Grid.Clip>
                                <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" />
                            </Grid.Clip>
                            <Border Background="{StaticResource Surface3}" />
                            <Border Margin="-3" i:CardArt.Portrait="{Binding IconCardId}" />
                        </Grid>
                        <Ellipse Width="20" Height="20" Stroke="{StaticResource OverlayBorder}" StrokeThickness="1" />
                        <Button x:Name="HideButton" Style="{StaticResource IconButton}" Content="&#xF0156;" FontSize="11" Width="20" Height="20"
                                Background="{StaticResource Surface3}" Visibility="Hidden" ToolTip="{i:Loc Overlay.Counter.HideTip}"
                                CommandParameter="{Binding Id}" Command="{Binding DataContext.HideCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource CounterSegmentTemplate}" Margin="0,3,-2,0"
                                          Visibility="{Binding Segments, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource Surface4}" Margin="0,3,0,0" Visibility="{Binding HasBar, Converter={StaticResource Vis}}">
                                <Border CornerRadius="1.5" Background="{StaticResource Accent}" RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Progress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Number}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" Focusable="False" Margin="27,0,0,6"
                                    Visibility="{Binding Expanded, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                    <Setter TargetName="Chip" Property="ToolTipService.IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                    <Setter TargetName="HideButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Battlegrounds counter chip: art, title over value; a click opens its details under the row, the cross hides it -->
        <DataTemplate x:Key="BgCounterTemplate" DataType="{x:Type o:CounterChip}">
            <Border x:Name="Chip" Background="{StaticResource Surface2}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="5,4,6,4" Margin="0,0,6,6" Cursor="Hand" ToolTipService.InitialShowDelay="250">
                <Border.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
                </Border.ToolTip>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                                  Command="{Binding DataContext.ToggleBgCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" VerticalAlignment="Center" i:CardArt.Portrait="{Binding IconCardId}" />
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="{StaticResource Muted}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" FontSize="15" />
                        <Border Height="2" CornerRadius="1" Background="{StaticResource Surface4}" Width="56" HorizontalAlignment="Left" Margin="0,2,0,0"
                                Visibility="{Binding HasProgress, Converter={StaticResource Vis}}">
                            <Border HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource Accent}"
                                    Width="{Binding Progress, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="HideButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xF0156;" FontSize="10" Width="18" Height="18"
                            Margin="4,0,0,0" VerticalAlignment="Top" Visibility="Hidden" ToolTip="{i:Loc Overlay.BgCounter.HideTip}"
                            CommandParameter="{Binding Id}" Command="{Binding DataContext.HideBgCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                </DataTrigger>
                <!-- Raised plate on hover (the Hover wash would make the chip see-through against the panel) -->
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Surface3}" />
                    <Setter TargetName="HideButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TierTemplate" DataType="{x:Type o:TierButton}">
            <Button Command="{Binding DataContext.SelectTier, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Tier}"
                    Cursor="Hand" Margin="0,0,3,0" ToolTip="{i:Loc Overlay.Bar.TierTip}" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}"
                                BorderBrush="Transparent" BorderThickness="1.5">
                            <TextBlock x:Name="Num" Text="{Binding Tier}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource OnAccent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Text}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CombatTemplate" DataType="{x:Type o:CombatDot}">
            <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="0,0,4,0" Background="{StaticResource Faint}" ToolTip="{Binding Tooltip}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="Win">
                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource Positive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="Loss">
                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource Negative}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Hero pick: compact badge centred above each hero portrait (slot = HDT hero pitch, 340 units) -->
        <DataTemplate x:Key="HeroPickTemplate" DataType="{x:Type o:HeroPickCard}">
            <Grid Width="340">
                <Border x:Name="Halo" Width="268" HorizontalAlignment="Center" Margin="0,-6,0,-14" CornerRadius="18"
                        Background="{StaticResource BestHalo}" IsHitTestVisible="False" Visibility="Collapsed" />
                <Border x:Name="Card" Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        Width="232" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Place}" Style="{StaticResource Number}" FontSize="18" />
                                <TextBlock Text="{Binding Delta}" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                           Foreground="{Binding DeltaValue, Converter={StaticResource SignBrush}}" />
                                <TextBlock Text="{Binding PlaceNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,3" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Personal}" FontSize="11" Foreground="{StaticResource Text}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Personal, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                        Padding="8,1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Only "Mark the best" (Settings > Pick suggestions) singles one option out -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Recommended}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Best" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasMeta}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Trinket pick: compact badge above each offered trinket (slot = HDT trinket pitch, 277 units) -->
        <DataTemplate x:Key="TrinketBadgeTemplate" DataType="{x:Type o:TrinketBadge}">
            <Grid Width="277">
                <Border x:Name="Halo" Width="232" HorizontalAlignment="Center" Margin="0,-6,0,-14" CornerRadius="18"
                        Background="{StaticResource BestHalo}" IsHitTestVisible="False" Visibility="Collapsed" />
                <Border x:Name="Card" Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        Width="196" Padding="9,7" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Place}" Style="{StaticResource Number}" FontSize="16" />
                                <TextBlock Text="{i:Loc Overlay.Badge.AvgPlace}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,2" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                        Padding="8,1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Only "Mark the best" (Settings > Pick suggestions) singles one option out -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Recommended}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Best" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasMeta}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tavern: hint pinned above a shop minion: its tags, plus how players who bought it placed.
             "Mark the best" turns the best buy gold with BUY; "Stats only" keeps every badge neutral. -->
        <DataTemplate x:Key="ShopBadgeTemplate" DataType="{x:Type o:ShopBadge}">
            <Border x:Name="Bd" Width="126" MinHeight="26" CornerRadius="6" Padding="8,3" Background="{StaticResource OverlayPanelSolid}"
                    BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" VerticalAlignment="Bottom">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="Buy" Text="{i:Loc Overlay.Badge.Buy}" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Lbl" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="100" Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <TextBlock x:Name="Data" Text="{Binding Placement}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                               Visibility="{Binding Placement, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- A badge with no tags (stats only) shows its placement at a readable size -->
                <DataTrigger Binding="{Binding Label}" Value="">
                    <Setter TargetName="Data" Property="FontSize" Value="10.5" />
                    <Setter TargetName="Data" Property="Foreground" Value="{StaticResource Text}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Best}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Buy" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Buy" Property="Foreground" Value="{StaticResource OnAccent}" />
                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource OnAccent}" />
                    <Setter TargetName="Data" Property="Foreground" Value="{StaticResource OnAccent}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Discover-style choice (hero power, spell, triple reward, Dark Gift…): one badge above each option (slot = 340 units) -->
        <DataTemplate x:Key="DiscoverBadgeTemplate" DataType="{x:Type o:DiscoverBadge}">
            <Grid Width="340">
                <Border x:Name="Card" Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" HorizontalAlignment="Center"
                        MinWidth="150" MaxWidth="236" Padding="9,7,12,7" Margin="0,9,0,0" Opacity="0.85">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Rank among the options: "Mark the best" only -->
                        <Grid x:Name="RankCookie" Width="32" Height="32" VerticalAlignment="Center" Visibility="Collapsed">
                            <c:Scallop x:Name="Cookie" Fill="{StaticResource Surface4}" Lobes="8" Depth="0.1" />
                            <TextBlock x:Name="RankText" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Run Text="#" FontSize="10" /><Run Text="{Binding Rank, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <!-- Otherwise the option's tavern tier, when it has one: nothing is ranked -->
                        <Border x:Name="TierChip" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface3}" VerticalAlignment="Center"
                                ToolTip="{i:Loc Overlay.Common.TavernTier}" Visibility="{Binding Tier, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Tier}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="Info" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Placement}" Style="{StaticResource Number}" FontSize="16" />
                                <TextBlock Text="{Binding PlacementNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="5,0,0,2" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Gift}" FontSize="10.5" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Gift, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                        Padding="8,1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                        <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- "Mark the best": ranked options, the others dimmed a little next to the best one -->
                <DataTrigger Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="RankCookie" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TierChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- "Stats only": every option at full strength, only the ones without data dimmed -->
                <DataTrigger Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                        <Condition Binding="{Binding HasData}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                        <Condition Binding="{Binding Tier}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Info" Property="Margin" Value="0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Best}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Card" Property="Opacity" Value="1" />
                    <Setter TargetName="Cookie" Property="Fill" Value="{StaticResource Accent}" />
                    <Setter TargetName="RankText" Property="Foreground" Value="{StaticResource OnAccent}" />
                    <Setter TargetName="Best" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Card art answers the mouse: the tile grows so small card text can be read -->
        <Style x:Key="ZoomImage" TargetType="{x:Type Image}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="2.2" ScaleY="2.2" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Comp card list row -->
        <DataTemplate x:Key="CompCardTemplate" DataType="{x:Type o:CompCardTile}">
            <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2" Opacity="0.7" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                <Grid.ToolTip>
                    <ToolTip Placement="Mouse">
                        <StackPanel Width="248">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,4" />
                            <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Width="2" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,6,0">
                            <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xF012C;" Style="{StaticResource Icon}" FontSize="12"
                                       Foreground="{StaticResource Positive}" Visibility="Collapsed" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource KeyBrush}}" />
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Owned}" Value="True">
                    <Setter TargetName="RowRoot" Property="Opacity" Value="1" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Comp list row: a click chooses (I choose) or locks (Automatic) this comp; the advisor never highlights one here -->
        <DataTemplate x:Key="AlternativeTemplate" DataType="{x:Type o:CompRow}">
            <Button Command="{Binding DataContext.Pin, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                    Cursor="Hand" Focusable="False" Margin="0,0,0,3" Foreground="{StaticResource Text}"
                    ToolTip="{Binding DataContext.CompRowTooltip, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,6" Background="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- "I choose": an empty radio mark on every comp; the chosen one sits above with a filled mark -->
                                <TextBlock x:Name="Choose" Text="&#xF043D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Faint}" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.CompManual, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Placement}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Power}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Power, Converter={StaticResource KeyBrush}}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryContainer}" />
                                <Setter TargetName="Choose" Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BrowserCardTemplate" DataType="{x:Type o:BrowserCard}">
            <Grid Width="92" Margin="2" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="30000">
                <Grid.ToolTip>
                    <ToolTip Placement="Mouse">
                        <StackPanel Width="248">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,4" />
                            <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="92" Height="128" Stretch="Uniform"
                       Style="{StaticResource ZoomImage}" RenderTransformOrigin="1,0.5" />
                <Border x:Name="Tag" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{StaticResource Accent}" CornerRadius="5"
                        Padding="6,0" Margin="0,0,0,2" Visibility="Collapsed">
                    <TextBlock Text="{i:Loc Overlay.Browser.InPlan}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding InComp}" Value="True">
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LobbyMinionTemplate" DataType="{x:Type o:LobbyMinion}">
            <Grid Width="78" Margin="2,0" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="30000">
                <Grid.ToolTip>
                    <ToolTip Placement="Mouse">
                        <StackPanel Width="248">
                            <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="248" Height="340" Stretch="Uniform" />
                            <TextBlock Text="{Binding Keywords}" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="78" Height="108" Stretch="Uniform"
                       Style="{StaticResource ZoomImage}" RenderTransformOrigin="1,0.5" />
                <Border x:Name="Gold" Width="78" Height="108" BorderBrush="{StaticResource TierS}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Attack}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TierS}" />
                    <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource Faint}" />
                    <TextBlock Text="{Binding Health}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Negative}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Golden}" Value="True">
                    <Setter TargetName="Gold" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Movable panel host: frame, label and placeholder in layout mode -->
        <Style TargetType="{x:Type o:MovablePanel}">
            <Setter Property="IsEditing" Value="{Binding LayoutEditing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type o:MovablePanel}">
                        <Grid>
                            <Border x:Name="Placeholder" Visibility="Collapsed" MinWidth="200" MinHeight="56" Background="{StaticResource OverlayPlaceholder}" CornerRadius="8"
                                    BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,10">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DefaultHint" Text="{i:Loc Overlay.Layout.AppearsDuringMatches}" FontSize="11" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="PlaceholderScale" Text="{TemplateBinding ScaleText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter x:Name="Body" />
                            <Border x:Name="Shield" Background="#01000000" Visibility="Collapsed" />
                            <Rectangle x:Name="Frame" Visibility="Collapsed" Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}"
                                       StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False" />
                            <Border x:Name="Tag" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-26,0,0"
                                    Background="{StaticResource Accent}" CornerRadius="5" Padding="7,2" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                    <!-- The size the player scrolled to, so two panels can be given the same one -->
                                    <TextBlock x:Name="ScaleTag" Text="{TemplateBinding ScaleText}" FontSize="10.5" Foreground="{StaticResource OnAccent}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Most panels show during matches; menu and draft panels name their scene in Hint -->
                            <Trigger Property="Hint" Value="">
                                <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DefaultHint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="ScaleText" Value="">
                                <Setter TargetName="ScaleTag" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PlaceholderScale" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- A placeholder already carries the title; the tag would only repeat it and pile up over its neighbours -->
                            <Trigger Property="ShowPlaceholder" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Tag" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LobbyRowTemplate" DataType="{x:Type o:LobbyRow}">
            <Grid x:Name="RowRoot" Height="28" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Bg" Grid.ColumnSpan="5" CornerRadius="6" Background="Transparent" Margin="-5,0" />
                <TextBlock Text="{Binding Place}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding HeroCardId}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <Border Height="2" CornerRadius="1" Background="{StaticResource Surface3}" Margin="0,3,0,0">
                        <Border HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource Positive}"
                                Width="{Binding HealthFraction, Converter={StaticResource Fraction}, ConverterParameter=96}" />
                    </Border>
                </StackPanel>
                <Border Grid.Column="3" Width="19" Height="18" CornerRadius="4" Background="{StaticResource Surface3}" VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Common.TavernTier}">
                    <TextBlock Text="{Binding Tier}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Health}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Last}" FontSize="9.5" HorizontalAlignment="Right" Foreground="{Binding LastKey, Converter={StaticResource KeyBrush}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Next}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}" />
                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                    <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding You}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dead}" Value="True">
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HRow">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapRow">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PillTemplate">
            <Border Style="{StaticResource Pill}" Margin="0,0,4,4" Padding="7,1">
                <TextBlock Text="{Binding}" FontSize="11" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1920" Height="1080">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- ============ Constructed: your deck (right) ============ -->
            <o:MovablePanel Id="deck" Title="{i:Loc Overlay.Panel.Deck}" Shown="{Binding ShowConstructed}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,12,0">
                <Border Style="{StaticResource OverlayCard}" Width="252">
                    <StackPanel>
                        <StackPanel Margin="12,10,12,8">
                            <TextBlock Text="{Binding DeckName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeckRecord}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                       Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.Caption="{Binding DeckRecordTip}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Deck}" ItemTemplate="{StaticResource DeckTileTemplate}" Margin="8,0,8,4" o:OverlayHit.Interactive="True" />
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,7,12,9">
                            <StackPanel>
                                <TextBlock Text="{Binding DeckCounts}" FontSize="11" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding NextDraw}" FontSize="11" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding NextDraw, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Constructed: opponent (left) ============ -->
            <o:MovablePanel Id="opponent" Title="{i:Loc Overlay.Common.Opponent}" Shown="{Binding ShowOpponent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,64,0,0">
                <Border Style="{StaticResource OverlayCard}" Width="214">
                    <StackPanel Margin="12,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding OpponentHeroId}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OpponentTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OpponentSubtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{i:Loc Overlay.Opponent.Hand}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OpponentHand}" Style="{StaticResource Number}" FontSize="17" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{i:Loc Overlay.Opponent.Deck}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OpponentDeck}" Style="{StaticResource Number}" FontSize="17" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{i:Loc Overlay.Opponent.Secrets}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OpponentSecrets}" Style="{StaticResource Number}" FontSize="17" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding OpponentMatchup}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding OpponentMatchup, Converter={StaticResource Vis}}" />

                        <c:Ornament Text="{i:Loc Overlay.Opponent.Played}" Size="10.5" Margin="0,12,0,6" Visibility="{Binding Played, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Played}" ItemTemplate="{StaticResource PlayedTemplate}" />

                        <c:Ornament Text="{i:Loc Overlay.Opponent.CardsInHand}" Size="10.5" Margin="0,12,0,6" Visibility="{Binding Hand, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Hand}" ItemTemplate="{StaticResource HandTemplate}" />
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Constructed: opponent's likely archetype (left, beside the opponent tracker and under the card pool; the right side holds the deck and secrets) ============ -->
            <o:MovablePanel Id="opponent-archetype" Title="{i:Loc Widgets.Archetype.Panel}" Shown="{Binding ShowArchetype}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="248,520,0,0">
                <o:OpponentArchetypePanel />
            </o:MovablePanel>

            <!-- ============ Menus: ranked ladder session (top right, outside games only) ============ -->
            <o:MovablePanel Id="ladder-session" Title="{i:Loc Widgets.Ladder.Panel}" Hint="{i:Loc Overlay.Layout.AppearsInMenus}" Shown="{Binding ShowLadder}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,276,0">
                <o:LadderSessionPanel />
            </o:MovablePanel>

            <!-- ============ Constructed: turn timers, left of each hero portrait (weapon slot side, clear of the hero power) ============ -->
            <o:MovablePanel Id="turn-timer-opponent" Title="{i:Loc Widgets.Turn.OpponentPanel}" Shown="{Binding ShowTurnTimer}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,660,0">
                <o:TurnTimerPanel DataContext="{Binding OpponentTimer}" />
            </o:MovablePanel>
            <o:MovablePanel Id="turn-timer" Title="{i:Loc Widgets.Turn.Panel}" Shown="{Binding ShowTurnTimer}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,660,200">
                <o:TurnTimerPanel DataContext="{Binding MyTimer}" />
            </o:MovablePanel>

            <!-- ============ Constructed: marks under the opponent's hand fan (top centre; move and scale it onto the cards) ============ -->
            <o:MovablePanel Id="opponent-hand" Title="{i:Loc Overlay.Panel.OpponentHand}" MinWidth="{x:Static o:OverlayViewModel.HandPanelWidth}" Shown="{Binding ShowHandMarks}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0">
                <o:OpponentHandPanel />
            </o:MovablePanel>

            <!-- ============ Constructed and Arena: the opponent's Secrets (x 1180-1390 right of their Hero Power, above the board, folded to 4 rows; rows take clicks) ============ -->
            <o:MovablePanel Id="secrets" Title="{i:Loc Overlay.Panel.Secrets}" GameAnchored="True" Shown="{Binding ShowSecrets}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="650,140,0,0">
                <o:SecretsPanel />
            </o:MovablePanel>

            <!-- ============ Constructed: counters (bottom-left) ============ -->
            <o:MovablePanel Id="counters" Title="{i:Loc Overlay.Panel.Counters}" Shown="{Binding ShowCounters}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,170">
                <Border x:Name="CountersCard" Style="{StaticResource OverlayCard}" Width="214" o:OverlayHit.Interactive="True">
                    <!-- One value column for every row, so the progress under each title ends at the same place -->
                    <StackPanel Margin="9,8,9,7" Grid.IsSharedSizeScope="True">
                        <StackPanel Visibility="{Binding OpponentCounters, Converter={StaticResource Vis}}">
                            <c:Ornament Text="{i:Loc Overlay.Common.Opponent}" Size="10.5" Margin="3,0,0,3" />
                            <ItemsControl ItemsSource="{Binding OpponentCounters}" ItemTemplate="{StaticResource CounterTemplate}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding MyCounters, Converter={StaticResource Vis}}">
                            <c:Ornament Text="{i:Loc Overlay.Counters.You}" Size="10.5" Margin="3,6,0,3" />
                            <ItemsControl ItemsSource="{Binding MyCounters}" ItemTemplate="{StaticResource CounterTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: counters row (bottom-left) ============ -->
            <o:MovablePanel Id="bg-counters" Title="{i:Loc Overlay.Panel.BgCounters}" Shown="{Binding ShowBgCounters}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,250">
                <Border Style="{StaticResource OverlayCard}" Padding="8,8,2,2" MaxWidth="560" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding BgCounters}" ItemTemplate="{StaticResource BgCounterTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Margin="2,0,8,8" MaxWidth="520" HorizontalAlignment="Left" Visibility="{Binding BgCounterDetails, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding BgCounterDetailTitle}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding BgCounterDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Content="{Binding BgCounterOpen}" ContentTemplate="{StaticResource BgCounterCardsTemplate}" Focusable="False" Width="232"
                                            HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Constructed: card pool of a Discover / random generator ============ -->
            <o:MovablePanel Id="card-pool" Title="{i:Loc Overlay.Panel.CardPool}" Shown="{Binding ShowCardPoolPanel}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="248,64,0,0">
                <o:CardPoolPanel />
            </o:MovablePanel>

            <!-- ============ Constructed: card pool browser (every card; right-click on the pool panel) ============ -->
            <!-- Left edge by default: on the right it would cover the End Turn button. -->
            <o:MovablePanel Id="card-pool-browser" Title="{i:Loc Overlay.Panel.CardPoolBrowser}" Shown="{Binding CardPoolBrowserOpen}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                <o:CardPoolBrowser />
            </o:MovablePanel>

            <!-- ============ Constructed: the same card pool panel next to its card (hand, board, Discover options) ============ -->
            <!-- Not a MovablePanel: it follows the card, placed by PoolPlacement in CardPoolPanel.xaml.cs. -->
            <Canvas>
                <o:CardPoolPanel Anchored="True" Visibility="{Binding ShowCardPoolPopup, Converter={StaticResource Vis}}" />
            </Canvas>

            <!-- ============ Constructed: mulligan bars over the offered cards (card row centred, card tops at ~310 of 1080; the panel hangs from 300 up) ============ -->
            <o:MovablePanel Id="mulligan-bars" Title="{i:Loc Overlay.Panel.MulliganStrip}" GameAnchored="True" Shown="{Binding ShowMulligan}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,0,780">
                <o:MulliganPanel />
            </o:MovablePanel>

            <!-- The mulligan summary under the cards (card bottoms at ~690), above the Confirm button -->
            <o:MovablePanel Id="mulligan-summary" Title="{i:Loc Overlay.Panel.MulliganSummary}" GameAnchored="True" Shown="{Binding ShowMulligan}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,700,0,0">
                <o:MulliganSummary />
            </o:MovablePanel>

            <!-- ============ Battlegrounds: slim top bar + minion browser (top-left) ============ -->
            <o:MovablePanel Id="bgbar" Title="{i:Loc Overlay.Panel.BgBar}" Shown="{Binding ShowBattlegrounds}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                <StackPanel>
                    <Border Style="{StaticResource OverlayCard}" Padding="12,7" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.TurnTip}">
                                <TextBlock Text="{i:Loc Overlay.Bar.Turn}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Turn}" Style="{StaticResource Number}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <ItemsControl ItemsSource="{Binding Tiers}" ItemTemplate="{StaticResource TierTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Divider}" />
                            <Grid VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.TribesTip}">
                                <ItemsControl ItemsSource="{Binding Tribes}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}" Margin="0,0,4,0" Padding="7,1">
                                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                           Visibility="{Binding Tribes, Converter={StaticResource Vis}, ConverterParameter=!}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.RatingTip}">
                                <TextBlock Text="{Binding Rating}" Style="{StaticResource Number}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RatingDelta}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding RatingDeltaValue, Converter={StaticResource SignBrush}}" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Visibility="{Binding Combats, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Combats}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}"
                                          VerticalAlignment="Center" Visibility="{Binding Combats, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OverlayCard}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding Anomaly, Converter={StaticResource Vis}}">
                        <TextBlock FontSize="11">
                            <Run Text="{i:Loc Overlay.Bar.Anomaly}" Foreground="{StaticResource Muted}" />
                            <Run Text="  " /><Run Text="{Binding Anomaly, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <!-- Minion browser for the selected tier -->
                    <Border Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" Margin="0,6,0,0" Padding="12,10"
                            HorizontalAlignment="Left" MaxWidth="900" o:OverlayHit.Interactive="True"
                            Visibility="{Binding Browser, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="{i:Loc Overlay.Browser.Tier}" /> <Run Text="{Binding SelectedTier, Mode=OneWay}" /> <Run Text="{i:Loc Overlay.Browser.MinionsInLobby}" Foreground="{StaticResource Muted}" FontWeight="Normal" />
                                </TextBlock>
                                <Button Style="{StaticResource IconButton}" Content="&#xF0156;" HorizontalAlignment="Right" Command="{Binding CloseBrowser}" ToolTip="{i:Loc Overlay.Common.Close}" />
                            </Grid>
                            <ScrollViewer MaxHeight="760" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Browser}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type o:BrowserGroup}">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="2,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BrowserCardTemplate}" ItemsPanel="{StaticResource WrapRow}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: hero pick badges, one above each hero (HDT: pitch 340, +7 x) ============ -->
            <o:MovablePanel Id="hero-row" Title="{i:Loc Overlay.Panel.HeroPick}" MinWidth="1360" Shown="{Binding ShowHeroPick}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,212,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding MetaSource}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding HeroPicks}" ItemTemplate="{StaticResource HeroPickTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                </StackPanel>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: trinket pick badges (HDT: pitch 277, +10 x) ============ -->
            <o:MovablePanel Id="trinket-row" Title="{i:Loc Overlay.Panel.TrinketPick}" MinWidth="1108" Shown="{Binding ShowTrinkets}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,226,0,0">
                <StackPanel>
                    <TextBlock Text="{i:Loc Overlay.Trinket.Source}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding TrinketPicks}" ItemTemplate="{StaticResource TrinketBadgeTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                </StackPanel>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: buy hints over the tavern row (HDT: row top 0.297H, pitch 138) ============ -->
            <o:MovablePanel Id="tavern-row" Title="{i:Loc Overlay.Panel.TavernRow}" MinWidth="966" Shown="{Binding ShowShop}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,274,0,0">
                <ItemsControl ItemsSource="{Binding ShopBadges}" ItemTemplate="{StaticResource ShopBadgeTemplate}" Width="966" Height="40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: simulated combat odds (top centre, during combat) ============ -->
            <o:MovablePanel Id="odds" Title="{i:Loc Overlay.Panel.Odds}" Shown="{Binding ShowOdds}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                <Border x:Name="OddsCard" Background="{StaticResource OverlayPanelSolid}" Padding="14,7,14,8" Width="250">
                    <Border.Style>
                        <!-- Red edge while the fight can kill the player -->
                        <Style TargetType="Border" BasedOn="{StaticResource OverlayCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LethalDanger}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OddsWin}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Positive}" HorizontalAlignment="Center" />
                                <TextBlock Text="{i:Loc Overlay.Odds.Win}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding OddsDamageWin}" ToolTip="{Binding OddsDamageWinTip}" Style="{StaticResource Number}" FontSize="11" Foreground="{StaticResource Positive}"
                                           HorizontalAlignment="Center" Visibility="{Binding OddsDamageWin, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OddsTie}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{i:Loc Overlay.Odds.Tie}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OddsLoss}" Style="{StaticResource Number}" FontSize="17" Foreground="{StaticResource Negative}" HorizontalAlignment="Center" />
                                <TextBlock Text="{i:Loc Overlay.Odds.Loss}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding OddsDamageLoss}" ToolTip="{Binding OddsDamageLossTip}" Style="{StaticResource Number}" FontSize="11" Foreground="{StaticResource Negative}"
                                           HorizontalAlignment="Center" Visibility="{Binding OddsDamageLoss, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </UniformGrid>
                        <Border Height="4" CornerRadius="1" ClipToBounds="True" Margin="0,6,0,5" Background="{StaticResource Surface3}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding WinShare}" />
                                    <ColumnDefinition Width="{Binding TieShare}" />
                                    <ColumnDefinition Width="{Binding LossShare}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Positive}" />
                                <Border Grid.Column="1" Background="{StaticResource Faint}" />
                                <Border Grid.Column="2" Background="{StaticResource Negative}" />
                            </Grid>
                        </Border>
                        <!-- Lethal: the share of fights that kill either hero -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="{i:Loc Overlay.Odds.LethalTip}" Visibility="{Binding OddsLethal, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xF068C;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Negative}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OddsLethal}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding OddsKill}" ToolTip="{i:Loc Overlay.Odds.KillTip}" FontSize="11" Foreground="{StaticResource Positive}" Margin="5,0" VerticalAlignment="Center"
                                       Visibility="{Binding OddsKill, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding OddsNote}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: Discover pick hints (Dark Gift, triple reward…) ============ -->
            <o:MovablePanel Id="choice-row" Title="{i:Loc Overlay.Panel.Choice}" MinWidth="1360" Shown="{Binding ShowDiscover}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,222,0,0">
                <StackPanel>
                    <Border HorizontalAlignment="Center" CornerRadius="6" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" Padding="11,2"
                            Visibility="{Binding DiscoverTitle, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0674;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DiscoverTitle}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding DiscoverBadges}" ItemTemplate="{StaticResource DiscoverBadgeTemplate}" ItemsPanel="{StaticResource HRow}" HorizontalAlignment="Center" />
                </StackPanel>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: game plan (right) ============ -->
            <o:MovablePanel Id="plan" Title="{i:Loc Overlay.Plan.Title}" Shown="{Binding ShowComp}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,12,0">
                <Border Style="{StaticResource OverlayCard}" Width="252" o:OverlayHit.Interactive="True">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,9,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <StackPanel.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="260" TextWrapping="Wrap" Text="{Binding PlanTooltip}" />
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <TextBlock Text="&#xF08C9;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                <TextBlock Text="{i:Loc Overlay.Plan.Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xF02FD;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Faint}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Bracket}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,2,0"
                                           ToolTip="{i:Loc Overlay.Plan.BracketTip}" Background="Transparent" />
                                <Button x:Name="CollapseButton" Width="24" Height="24" Command="{Binding ToggleComp}" ToolTip="{i:Loc Overlay.Plan.ToggleTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Content" Value="&#xF0143;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CompCollapsed}" Value="True">
                                                    <Setter Property="Content" Value="&#xF0140;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Target comp: the one the player chose (I choose) or the advisor's / locked one (Automatic), why, and what to look for next -->
                        <StackPanel DockPanel.Dock="Top" Margin="12,6,12,8" Visibility="{Binding Target, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Target.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Command="{Binding Pin}" CommandParameter="{Binding Target.Id}" Cursor="Hand" Focusable="False" VerticalAlignment="Top"
                                        Margin="6,0,0,0">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <TextBlock MaxWidth="250" TextWrapping="Wrap" Text="{Binding PinTooltip}" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="7,2" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Glyph" Text="&#xF0FC7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Txt" Text="{Binding PinText}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface4}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Target.IsPinned}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentContainer}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldTrim}" />
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xF033E;" />
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource OnAccentContainer}" />
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource OnAccentContainer}" />
                                                </DataTrigger>
                                                <!-- I choose: the player's own pick reads "Chosen" with a filled radio mark, not a lock -->
                                                <DataTrigger Binding="{Binding CompManual}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xF043E;" />
                                                </DataTrigger>
                                                <!-- Hovering a locked button still answers: the gold trim brightens -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Target.IsPinned}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Grid Margin="0,6,0,0" Visibility="{Binding Target.Why, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xF06E9;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,1,6,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Target.Why}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Background="Transparent">
                                <StackPanel.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="250" TextWrapping="Wrap"
                                                   Text="{i:Loc Overlay.Plan.PowerTip}" />
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <c:Scallop Fill="{Binding Target.Power, Converter={StaticResource KeyBrush}}" Lobes="8" Depth="0.1" />
                                    <TextBlock Text="{Binding Target.Power}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding Target.Placement, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /><Run Text="{i:Loc Overlay.Plan.AvgPlaceSep}" /><Run Text="{Binding Target.OwnedCore, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /><Run Text="/" /><Run Text="{Binding Target.CoreCount, Mode=OneWay}" /><Run Text="{i:Loc Overlay.Plan.CoreSuffix}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Target.Tribes}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{StaticResource SecondaryContainer}"
                                    Visibility="{Binding Target.LookFor, Converter={StaticResource Vis}}"
                                    ToolTip="{i:Loc Overlay.Plan.LookForTip}">
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource OnSecondaryContainer}">
                                    <Run Text="{i:Loc Overlay.Plan.LookFor}" FontWeight="Bold" /><Run Text="{Binding Target.LookFor, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- No comp targeted: how to choose one (or why the chosen one is missing from this lobby) -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PlanHint}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="12,6,12,8"
                                   Visibility="{Binding PlanHint, Converter={StaticResource Vis}}" />

                        <!-- Advisor's turn budget plan -->
                        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="10,8" CornerRadius="8"
                                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1"
                                Visibility="{Binding ShopPlan, Converter={StaticResource Vis}}"
                                ToolTip="{i:Loc Overlay.Plan.ShopPlanTip}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShopPlan.ActionLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                    </Border>
                                    <TextBlock Text="{Binding ShopPlan.Title}" FontSize="12.5" FontWeight="Bold" Margin="7,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ShopPlan.Reason}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Dark Gift (Rinvenimento Oscuro) timing -->
                        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="9,6" CornerRadius="6" Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Visibility="{Binding DarkGift, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding DarkGift}" FontSize="11.5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Freeze reminder -->
                        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="9,6" CornerRadius="6" Background="{StaticResource Surface3}"
                                Visibility="{Binding Freeze, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Freeze}" FontSize="11.5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Pairs one copy away from a triple -->
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" Visibility="{Binding Pairs, Converter={StaticResource Vis}}">
                            <c:Ornament Text="{i:Loc Overlay.Plan.Pairs}" Size="10.5" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding Pairs}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" />
                        </StackPanel>

                        <!-- Owned trinkets -->
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" Visibility="{Binding OwnedTrinkets, Converter={StaticResource Vis}}">
                            <c:Ornament Text="{i:Loc Overlay.Plan.Trinkets}" Size="10.5" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding OwnedTrinkets}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MetaSource}" FontSize="9.5" Foreground="{StaticResource Faint}" Margin="12,0,12,8" TextWrapping="Wrap" />

                        <ScrollViewer x:Name="PlanBody" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="12,0,12,8">
                            <StackPanel>
                                <c:Ornament Text="{i:Loc Overlay.Plan.CompCards}" Size="10.5" Margin="0,0,0,6" Visibility="{Binding TargetCards, Converter={StaticResource Vis}}"
                                            ToolTip="{i:Loc Overlay.Plan.CompCardsTip}" />
                                <ItemsControl ItemsSource="{Binding TargetCards}" ItemTemplate="{StaticResource CompCardTemplate}" Margin="0,0,0,6" />

                                <StackPanel Visibility="{Binding CompCollapsed, Converter={StaticResource Vis}, ConverterParameter=!}">
                                    <c:Ornament Text="{i:Loc Overlay.Plan.YourBoard}" Size="10.5" Margin="0,4,0,6" Visibility="{Binding BoardTribes, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding BoardTribes}" ItemsPanel="{StaticResource WrapRow}" ItemTemplate="{StaticResource PillTemplate}" Margin="0,0,0,6" />

                                    <c:Ornament Text="{i:Loc Overlay.Plan.WhenToCommit}" Size="10.5" Margin="0,4,0,6" Visibility="{Binding CommitHint, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding CommitHint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding CommitHint, Converter={StaticResource Vis}}" />

                                    <c:Ornament Text="{i:Loc Overlay.Plan.HowToPlay}" Size="10.5" Margin="0,4,0,6" Visibility="{Binding CompTip, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding CompTip}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               MaxHeight="120" TextTrimming="WordEllipsis" Visibility="{Binding CompTip, Converter={StaticResource Vis}}" />
                                </StackPanel>

                                <!-- Comps to choose from: shown while expanded, and always while no comp is targeted (it is how the player picks one) -->
                                <StackPanel Visibility="{Binding ShowCompList, Converter={StaticResource Vis}}">
                                    <c:Ornament Text="{Binding CompListTitle}" Size="10.5" Margin="0,4,0,6" />
                                    <!-- Build around a tribe: its comps come first, the rest follow -->
                                    <ItemsControl ItemsSource="{Binding FocusChoices}" Margin="0,0,0,4" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type o:FocusChoice}">
                                                <Button Command="{Binding DataContext.FocusTribe, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}"
                                                        Cursor="Hand" Focusable="False" Margin="0,0,4,4" ToolTip="{i:Loc Overlay.Plan.FocusTip}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Chip" CornerRadius="9" Padding="8,2" Background="{StaticResource Surface3}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentContainer}" />
                                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OnAccentContainer}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Alternatives}" ItemTemplate="{StaticResource AlternativeTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: leaderboard hover ============ -->
            <Canvas x:Name="LobbyLayer" IsHitTestVisible="False">
                <Border x:Name="LobbyCard" Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" Padding="12,10"
                        Canvas.Left="{Binding LobbyLeft}" Canvas.Top="{Binding LobbyTop}"
                        Visibility="{Binding Lobby, Converter={StaticResource Vis}}">
                    <StackPanel DataContext="{Binding Lobby}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding HeroCardId}" />
                            <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroName}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}">
                                    <Run Text="#" /><Run Text="{Binding Place, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                    <Run Text=" ·  " /><Run Text="{Binding Health, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text="{i:Loc Overlay.LobbyPopup.Hp}" />
                                    <Run Text="{i:Loc Overlay.LobbyPopup.Tier}" /><Run Text="{Binding Tier, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                    <Run Text="{i:Loc Overlay.LobbyPopup.Triples}" /><Run Text="{Binding Triples, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="5" Padding="8,1" VerticalAlignment="Top"
                                    Visibility="{Binding NextOpponent, Converter={StaticResource Vis}}">
                                <TextBlock Text="{i:Loc Overlay.LobbyPopup.Next}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                            </Border>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,6">
                            <Run Text="{Binding LastSeen, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding LastResult, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource LobbyMinionTemplate}" ItemsPanel="{StaticResource HRow}" />
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- ============ Leaderboard calibration guides ============ -->
            <Canvas x:Name="GuideLayer" IsHitTestVisible="False" />

            <!-- ============ Arena draft: a score badge over each offered card or hero (centred on the play area left of the client's
                 deck list: right margin 339 shifts the centre 170 left; anchors from HdtArenaHelper, MIT) ============ -->
            <o:MovablePanel Id="arena-picks" Title="{i:Loc Arena.Panel.Picks}" Hint="{i:Loc Overlay.Layout.AppearsInArenaDraft}" GameAnchored="True" Shown="{Binding ShowArenaPicks}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,566,339,0">
                <o:ArenaPicksPanel />
            </o:MovablePanel>

            <!-- ============ Arena draft: deck so far, curve, average score, class win rates (left) ============ -->
            <o:MovablePanel Id="arena-draft" Title="{i:Loc Arena.Panel.Title}" Hint="{i:Loc Overlay.Layout.AppearsInArenaDraft}" Shown="{Binding ShowArenaDraft}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,64,0,0">
                <o:ArenaDraftPanel />
            </o:MovablePanel>

            <!-- ============ Battlegrounds: session (top-right) ============ -->
            <o:MovablePanel Id="session" Title="{i:Loc Overlay.Session.Title}" Shown="{Binding ShowSession}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                <Border Style="{StaticResource OverlayCard}" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{i:Loc Overlay.Session.Title}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SessionRating}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RatingDelta}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding RatingDeltaValue, Converter={StaticResource SignBrush}}" />
                        <ItemsControl ItemsSource="{Binding SessionPlaces}" Margin="10,0,0,0" VerticalAlignment="Center" ItemsPanel="{StaticResource HRow}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type o:PlaceChip}">
                                    <Border x:Name="Chip" Width="19" Height="19" CornerRadius="5" Margin="0,0,3,0" Background="{StaticResource NegativeSoft}">
                                        <TextBlock x:Name="Num" Text="{Binding Place}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Negative}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Top}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource PositiveSoft}" />
                                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Positive}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Battlegrounds: lobby list (bottom-right) ============ -->
            <o:MovablePanel Id="lobby" Title="{i:Loc Overlay.Lobby.Title}" Shown="{Binding ShowLobby}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,14">
                <Border Style="{StaticResource OverlayCard}" Width="230" Padding="12,9,12,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{i:Loc Overlay.Lobby.Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{i:Loc Overlay.Lobby.Header}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LobbyRows}" ItemTemplate="{StaticResource LobbyRowTemplate}" />
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Layout mode banner (centre band, clear of the default spots of the top-row panels) ============ -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,400,0,0" Style="{StaticResource OverlayCard}"
                    Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource Accent}" Padding="16,10" o:OverlayHit.Interactive="True"
                    Visibility="{Binding LayoutEditing, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Overlay.Layout.Title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{i:Loc Overlay.Layout.Hint}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{i:Loc Overlay.Layout.Shortcuts}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="{i:Loc Overlay.Layout.ResetAll}" Margin="18,0,8,0" Command="{Binding ResetLayout}" Focusable="False" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{i:Loc Overlay.Layout.Done}" Command="{Binding FinishLayout}" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- ============ End of game toast ============ -->
            <o:MovablePanel Id="toast" Title="{i:Loc Overlay.Panel.Toast}" Shown="{Binding ShowToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120">
                <Border x:Name="Toast" Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" CornerRadius="7,0,0,7" Background="{Binding ToastResult, Converter={StaticResource KeyBrush}}" />
                        <StackPanel Margin="16,11,22,12">
                            <TextBlock Text="{Binding ToastTitle}" Style="{StaticResource Number}" FontSize="22" />
                            <TextBlock Text="{Binding ToastDetail}" FontSize="12.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </o:MovablePanel>

            <!-- ============ Card preview on hover (top layer, never takes the mouse) ============ -->
            <c:CardPreviewHost x:Name="PreviewHost" />
        </Grid>
    </Grid>
</Window>
