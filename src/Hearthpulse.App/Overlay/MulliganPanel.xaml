<UserControl x:Class="Hearthpulse.App.Overlay.MulliganPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- Mulligan strip: a slim badge under each offered card (Keep / Replace, one number, small flags; click = keep or
         replace), lined up with the cards of the mulligan screen, and one summary line. Details are in the tooltips.
         DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />

        <Style x:Key="Flag" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Info}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>

        <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type o:MulliganPlate}">
            <Button Command="{Binding DataContext.ToggleMulliganCard, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding EntityId}"
                    HorizontalAlignment="Center" Cursor="Hand" Focusable="False" ToolTip="{Binding Tooltip}" o:OverlayHit.Interactive="True"
                    ToolTipService.InitialShowDelay="200">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Badge" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1.5"
                                CornerRadius="15" Padding="9,4,11,4" MinWidth="124">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="CallIcon" Text="&#xF0625;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CallText" Text="{Binding Call}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <TextBlock x:Name="Number" Text="{Binding Number}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                           Margin="9,0,0,0" Visibility="{Binding Number, Converter={StaticResource Vis}}" />
                                <TextBlock Text="&#xF0339;" Style="{StaticResource Flag}" Visibility="{Binding Synergy, Converter={StaticResource Vis}}" />
                                <TextBlock Text="×2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="5,0,0,0"
                                           Visibility="{Binding Duplicate, Converter={StaticResource Vis}}" />
                                <TextBlock Text="&#xF0150;" Style="{StaticResource Flag}" Visibility="{Binding Late, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding KeepCall}" Value="True">
                                <Setter TargetName="CallIcon" Property="Text" Value="&#xF05E0;" />
                                <Setter TargetName="CallIcon" Property="Foreground" Value="{StaticResource Positive}" />
                                <Setter TargetName="CallText" Property="Foreground" Value="{StaticResource Positive}" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Positive}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MulliganCall}" Value="True">
                                <Setter TargetName="CallIcon" Property="Text" Value="&#xF006A;" />
                                <Setter TargetName="CallIcon" Property="Foreground" Value="{StaticResource Negative}" />
                                <Setter TargetName="CallText" Property="Foreground" Value="{StaticResource Negative}" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Negative}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Good}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Positive}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Bad}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Negative}" />
                            </DataTrigger>
                            <!-- The player replaces it (a click on the badge): dimmed until they keep it again -->
                            <DataTrigger Binding="{Binding Kept}" Value="False">
                                <Setter TargetName="Badge" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Badge" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One slot per offered card across the width of the mulligan card row, so each badge sits under its card -->
    <StackPanel Width="{x:Static o:OverlayViewModel.MulliganRowWidth}">
        <ItemsControl ItemsSource="{Binding MulliganCards}" ItemTemplate="{StaticResource BadgeTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Border Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="12"
                HorizontalAlignment="Center" Padding="12,3,12,4" Margin="0,8,0,0" ToolTip="{Binding MulliganDetails}" o:OverlayHit.Interactive="True"
                ToolTipService.InitialShowDelay="200">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MulliganSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Base}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MulliganImpactGood}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MulliganImpactBad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#xF02FD;" Style="{StaticResource Flag}" Visibility="{Binding MulliganHasWarnings, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding MulliganSource}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding MulliganSource, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
