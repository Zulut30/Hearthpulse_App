<UserControl x:Class="Hearthpulse.App.Overlay.MulliganPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Mulligan bars: a bar over each offered card in the HSReplay style (Keep / Replace, a
         gauge from replace to keep with the edge in points, keep rate and drawn win rate; click = keep or replace),
         lined up with the cards of the mulligan screen. Details are in the tooltips.
         DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />

        <Style x:Key="Flag" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Info}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <DataTemplate x:Key="BarTemplate" DataType="{x:Type o:MulliganPlate}">
            <Button Command="{Binding DataContext.ToggleMulliganCard, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding EntityId}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand" Focusable="False" ToolTip="{Binding Tooltip}" o:OverlayHit.Interactive="True"
                    ToolTipService.InitialShowDelay="200">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- 156 wide: the edge number keeps a gap after the gauge at "+10,4"; four bars still fit the row at overlay scale 1.6 -->
                        <Grid>
                            <Border x:Name="Bar" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1.5"
                                    CornerRadius="10" Padding="10,6,10,7" Width="156">
                                <StackPanel>
                                    <!-- Call and flags -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CallIcon" Text="&#xF0625;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <!-- The keep tier (S to D) leads when there are numbers; without them, the call's icon -->
                                        <Grid x:Name="TierChip" Width="22" Height="22" VerticalAlignment="Center" Visibility="Collapsed">
                                            <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                                            <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="CallText" Grid.Column="1" Text="{Binding Call}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xF0339;" Style="{StaticResource Flag}" Visibility="{Binding Synergy, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="×2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Visibility="{Binding Duplicate, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="&#xF0150;" Style="{StaticResource Flag}" Visibility="{Binding Late, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Gauge (replace on the left, keep on the right, the fill grows from the middle) and the edge -->
                                    <Grid Margin="0,4,0,0" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="78" Height="8" VerticalAlignment="Center">
                                            <Border Background="{StaticResource OverlayBadgeShade}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="4" />
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="FillLeft" HorizontalAlignment="Right" Width="{Binding FillLeft}" CornerRadius="3,0,0,3" Background="{StaticResource Accent}" />
                                                <Border x:Name="FillRight" Grid.Column="1" HorizontalAlignment="Left" Width="{Binding FillRight}" CornerRadius="0,3,3,0" Background="{StaticResource Accent}" />
                                            </Grid>
                                            <Rectangle Width="2" Height="12" Margin="0,-2" HorizontalAlignment="Center" Fill="{StaticResource Muted}" />
                                        </Grid>
                                        <TextBlock x:Name="Number" Grid.Column="1" Text="{Binding Number}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" Visibility="{Binding Number, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" Visibility="{Binding Details, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <!-- Hover wash over the solid plate, so the card art never shows through the numbers -->
                            <Border x:Name="HoverLayer" Background="{StaticResource Hover}" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasTier}" Value="True">
                                <Setter TargetName="CallIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TierChip" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KeepCall}" Value="True">
                                <Setter TargetName="CallIcon" Property="Text" Value="&#xF05E0;" />
                                <Setter TargetName="CallIcon" Property="Foreground" Value="{StaticResource Positive}" />
                                <Setter TargetName="CallText" Property="Foreground" Value="{StaticResource Positive}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource Positive}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MulliganCall}" Value="True">
                                <Setter TargetName="CallIcon" Property="Text" Value="&#xF006A;" />
                                <Setter TargetName="CallIcon" Property="Foreground" Value="{StaticResource Negative}" />
                                <Setter TargetName="CallText" Property="Foreground" Value="{StaticResource Negative}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource Negative}" />
                            </DataTrigger>
                            <!-- Bad to good: Negative, Accent for a close call, Positive -->
                            <DataTrigger Binding="{Binding Good}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Positive}" />
                                <Setter TargetName="FillRight" Property="Background" Value="{StaticResource Positive}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Bad}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Negative}" />
                                <Setter TargetName="FillLeft" Property="Background" Value="{StaticResource Negative}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Close}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <!-- The player replaces it (a click on the bar): dimmed until they keep it again -->
                            <DataTrigger Binding="{Binding Kept}" Value="False">
                                <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One slot per offered card across the width of the mulligan card row, so each bar sits over its card (the summary
         line is MulliganSummary, under the cards). The panel hangs from the top edge of the cards (OverlayWindow), so it grows upwards. -->
    <StackPanel Width="{Binding MulliganRowWidth}">
        <ItemsControl ItemsSource="{Binding MulliganCards}" ItemTemplate="{StaticResource BarTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
