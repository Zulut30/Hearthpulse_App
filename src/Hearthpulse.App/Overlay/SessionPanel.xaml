<UserControl x:Class="Hearthpulse.App.Overlay.SessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Battlegrounds session ("session", top right, DataContext: the overlay view model): "Session  MMR 6,751 → 6,779 +28",
         then the places of the session's games. Same tree as SessionPanel.axaml. Tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Overlay/OverlayPanels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayCard}" Padding="12,8" MaxWidth="520">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{i:Loc Overlay.Session.Title}" Style="{StaticResource OverlayHeaderNote}" VerticalAlignment="Center" Margin="0" />
                <TextBlock Text="{i:Loc Overlay.Session.Mmr}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           Margin="12,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SessionRating}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SessionDelta}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding SessionDeltaValue, Converter={StaticResource SignBrush}}"
                           Visibility="{Binding SessionDelta, Converter={StaticResource Vis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding SessionPlaces, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Session.Places}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding SessionPlaces}" VerticalAlignment="Center" ItemsPanel="{StaticResource HRow}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PlaceChip}">
                            <Border x:Name="Chip" Width="19" Height="19" CornerRadius="5" Margin="0,0,3,0" Background="{StaticResource NegativeSoft}">
                                <TextBlock x:Name="Num" Text="{Binding Place}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Negative}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Top}" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource PositiveSoft}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Positive}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
