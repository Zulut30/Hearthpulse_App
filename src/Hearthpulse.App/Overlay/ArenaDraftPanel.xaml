<UserControl x:Class="Hearthpulse.App.Overlay.ArenaDraftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Arena draft panel: the run's class and picks, the average ArenaSmith score, the mana curve, class win rates at
         the hero pick and the cards picked so far. Read-only, takes no clicks. DataContext: OverlayViewModel.
         Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <i:VisibleWhen x:Key="Vis" />
            <i:KeyBrush x:Key="KeyBrush" />
            <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />

            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Margin" Value="0,10,0,5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCard}" Width="244" IsHitTestVisible="False">
        <StackPanel>
            <!-- Header: what the panel is and how far the draft got, then the run's class -->
            <Border Style="{StaticResource OverlayHeader}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xF0538;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{i:Loc Arena.Panel.Title}" Style="{StaticResource Label}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ArenaDraftPicks}" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding ArenaDraftTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArenaMode}" FontSize="10.5" Foreground="{StaticResource Muted}" Visibility="{Binding ArenaMode, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

        <StackPanel Margin="12,0,12,9">
            <!-- The run's class: win rate, place among the classes, 7+ wins - one figure per column, never wrapped mid-number -->
            <Border Style="{StaticResource OverlayStatPlate}" Margin="0,8,0,0" Visibility="{Binding ArenaClassStats, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding ArenaClassStats}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ArenaStat}">
                            <StackPanel>
                                <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource OverlayStatValue}"
                                           Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource OverlayStatLabel}" />
                            </StackPanel>
                            <!-- Only the win rate has a tier colour; the other figures stay plain text -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tier}" Value="">
                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Text}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Average score of the deck so far and the mana curve, once a card is picked -->
            <StackPanel Visibility="{Binding ArenaHasPicks, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Grid Width="38" Height="38" VerticalAlignment="Center">
                        <c:Scallop Fill="{Binding ArenaAverageTier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                        <TextBlock Text="{Binding ArenaAverageTier}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArenaAverage}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding ArenaAverageTier, Converter={StaticResource KeyBrush}}" />
                        <TextBlock Text="{i:Loc Arena.Panel.Average}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Mana curve: 0 .. 7+ -->
                <TextBlock Text="{i:Loc Arena.Panel.Curve}" Style="{StaticResource Section}" />
                <ItemsControl ItemsSource="{Binding ArenaCurve}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ArenaCurveBar}">
                            <StackPanel Margin="2,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Count}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <Grid Height="34">
                                    <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource AccentDeep}" />
                                </Grid>
                                <TextBlock x:Name="Cost" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- The costs of the offered cards are lit, so the curve shows where each would go -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Offered}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Cost" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ArenaTypes}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ArenaTypes, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- Hero pick: classes by community win rate, the offered ones in gold -->
            <StackPanel Visibility="{Binding ArenaClasses, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Arena.Panel.Classes}" Style="{StaticResource Section}" />
                <ItemsControl ItemsSource="{Binding ArenaClasses}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ArenaClassRow}">
                            <Grid Height="19">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding WinRate}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Tier}" Style="{StaticResource TierLetter}" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="3" Text="{Binding SevenPlus}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Offered}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Cards picked so far, by cost -->
            <StackPanel Visibility="{Binding ArenaDeck, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Arena.Panel.Deck}" Style="{StaticResource Section}" />
                <ItemsControl ItemsSource="{Binding ArenaDeck}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ArenaDeckRow}">
                            <Grid Height="21" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <!-- A plate behind name, copies and score, lifted by a hairline -->
                                <Border Grid.Column="1" Grid.ColumnSpan="4" Background="{StaticResource Row}" CornerRadius="4">
                                    <Border Style="{StaticResource OverlayRowSheen}" />
                                </Border>
                                <c:ManaCost Width="20" Height="20" Text="{Binding Cost}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Copies}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Score}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" FontWeight="Bold" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Grid.Column="4" Text="{Binding Tier}" Style="{StaticResource TierLetter}" Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding ArenaNoData}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding ArenaNoData, Converter={StaticResource Vis}}" />
            <!-- What the letters mean: the class scale at the hero pick, the card scale after it -->
            <TextBlock Text="{Binding ArenaTierLegend}" FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding ArenaTierLegend, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding ArenaSource}" Style="{StaticResource OverlayFooter}" Margin="0,9,0,0" />
        </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
