<UserControl x:Class="Hearthpulse.App.Overlay.BattlegroundsBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Content of the "bgbar" overlay panel: rating, turn, anomaly and combat history,
         and the tavern tiers and tribes that open the minion browser. Same tree as the Avalonia BattlegroundsBarPanel.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Overlay/OverlayPanels.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource OverlayCard}" Padding="10,5" HorizontalAlignment="Left" o:OverlayHit.Interactive="True">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.TurnTip}">
                    <TextBlock Text="{i:Loc Overlay.Bar.Turn}" Style="{StaticResource OverlayHeaderNote}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Turn}" Style="{StaticResource Number}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Divider}" />
                <ItemsControl ItemsSource="{Binding Tiers}" ItemTemplate="{StaticResource TierTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Divider}" />
                <Grid VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.TribesTip}">
                    <!-- Each tribe filters the tier list below; the chosen one is filled -->
                    <ItemsControl ItemsSource="{Binding TribeChips}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type o:TribeChip}">
                                <Button Command="{Binding DataContext.SelectTribe, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}"
                                        Cursor="Hand" Margin="0,0,4,0" Focusable="False" ToolTip="{i:Loc Overlay.Bar.TribeFilterTip}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" Height="22" CornerRadius="11" Padding="9,0" Background="{StaticResource Surface3}"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource OnAccent}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i:Loc Overlay.Bar.ReadingLobby}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Visibility="{Binding TribeChips, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{i:Loc Overlay.Bar.RatingTip}">
                    <TextBlock Text="{Binding Rating}" Style="{StaticResource Number}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RatingDelta}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding RatingDeltaValue, Converter={StaticResource SignBrush}}" />
                </StackPanel>
                <Border Style="{StaticResource Divider}" Visibility="{Binding Combats, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Combats}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}"
                              VerticalAlignment="Center" Visibility="{Binding Combats, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource OverlayCard}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                Visibility="{Binding Anomaly, Converter={StaticResource Vis}}">
            <TextBlock FontSize="11">
                <Run Text="{i:Loc Overlay.Bar.Anomaly}" Foreground="{StaticResource Muted}" />
                <Run Text="  " /><Run Text="{Binding Anomaly, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <!-- Minion browser for the selected tier -->
        <Border Style="{StaticResource OverlayCard}" Background="{DynamicResource OverlayPanelSolid}" Margin="0,6,0,0" Padding="10,7,10,8"
                HorizontalAlignment="Left" MaxWidth="880" o:OverlayHit.Interactive="True"
                Visibility="{Binding Browser, Converter={StaticResource Vis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0143;" Width="24" Height="24" Command="{Binding CloseBrowser}"
                            ToolTip="{i:Loc Overlay.Browser.Collapse}" AutomationProperties.Name="{i:Loc Overlay.Browser.Collapse}" Focusable="False" />
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding BrowserTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" /><Run Text="  ·  " FontSize="11" Foreground="{StaticResource Faint}" /><Run Text="{Binding BrowserScope, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                    </TextBlock>
                </DockPanel>
                <ScrollViewer MaxHeight="760" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Browser}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type o:BrowserGroup}">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="1,0,0,1" />
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BrowserCardTemplate}" ItemsPanel="{StaticResource WrapRow}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
