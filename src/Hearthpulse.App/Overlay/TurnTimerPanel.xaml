<UserControl x:Class="Hearthpulse.App.Overlay.TurnTimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- One player's turn timer (DataContext: a TurnTimerSide). While the turn runs: the time spent over the limit,
         red with the time left once the rope burns; otherwise the last turn. The average turn underneath. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <i:VisibleWhen x:Key="Vis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The card keeps its solid fill; the rope's red wash goes on an inner plate so the time stays readable over the board -->
    <Border MinWidth="150">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource OverlayCard}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Active}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rope}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border CornerRadius="7" Padding="11,6,11,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rope}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource OverlayHeaderNote}" Margin="0" />
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}" FontSize="20" VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rope}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" FontSize="11" VerticalAlignment="Bottom" Margin="7,0,0,3">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rope}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding Average}" FontSize="10.5" Foreground="{StaticResource Muted}" Visibility="{Binding Average, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
