<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- The overlay's converters, row and badge templates, panel host style and row panels. The window merges it;
         a panel control (Overlay/*Panel) that needs these keys merges it too, as it is built before it joins the
         window. Same keys as the Avalonia OverlayPanels.axaml (its styles are in OverlayPanelStyles.axaml). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Hearthpulse;component/Overlay/OverlayLook.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <i:VisibleWhen x:Key="Vis" />
    <i:KeyBrush x:Key="KeyBrush" />
    <i:SignBrush x:Key="SignBrush" />
    <i:FractionWidth x:Key="Fraction" />

    <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Base}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Mana gem cost badge for card rows -->
    <Style x:Key="CostChip" TargetType="c:ManaCost">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Opponent's played card: hover shows the whole card beside the panel, as in the deck tracker (the full name too) -->
    <DataTemplate x:Key="PlayedTemplate" DataType="{x:Type o:PlayedTile}">
        <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2" Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.CardId="{Binding CardId}">
            <Border Style="{StaticResource OverlayCapsule}" c:RoundClip.Radius="11">
                <Grid>
                    <Image x:Name="Art" i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                    <Rectangle x:Name="Fade" Fill="{StaticResource TileFade}" />
                    <DockPanel Margin="1,0,3,0">
                        <c:ManaCost x:Name="Gem" Style="{StaticResource CostChip}" Text="{Binding Cost}" Width="21" Height="21" DockPanel.Dock="Left" Margin="0,0,4,0" />
                        <!-- Copies and turn on a dark plate, like the deck's copy count, so they stay readable over bright art -->
                        <Border DockPanel.Dock="Right" Background="{DynamicResource OverlayBadgeShade}" CornerRadius="8" Height="16" Padding="4,0"
                                Margin="4,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,4,0"
                                           VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding Turn}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="RowRoot" Property="o:MovablePanel.Compact" Value="True">
                <Setter TargetName="RowRoot" Property="Height" Value="18" />
                <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Fade" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Gem" Property="Width" Value="18" />
                <Setter TargetName="Gem" Property="Height" Value="18" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Opponent's hand row: hover shows the card once revealed, else the card that created it -->
    <DataTemplate x:Key="HandTemplate" DataType="{x:Type o:HandTile}">
        <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2" Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.CardId="{Binding PreviewCardId}" c:CardPreview.ShowRelated="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface3}" CornerRadius="5">
                <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Turn}" FontSize="11" Foreground="{StaticResource Muted}" Margin="6,0,2,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Detail" Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="RowRoot" Property="o:MovablePanel.Compact" Value="True">
                <Setter TargetName="RowRoot" Property="Height" Value="18" />
            </Trigger>
            <DataTrigger Binding="{Binding Highlight}" Value="True">
                <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Unknown}" Value="True">
                <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Faint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Counter tooltip strip: card art behind the name, count on the right; a part of a goal gets a done mark -->
    <DataTemplate x:Key="CounterCardTemplate" DataType="{x:Type o:CounterTipCard}">
        <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2">
            <Border Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                <Grid>
                    <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                    <Rectangle Fill="{StaticResource TileFade}" />
                    <DockPanel Margin="7,0,7,0">
                        <TextBlock x:Name="Mark" DockPanel.Dock="Left" Text="&#xF0766;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Faint}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsPart, Converter={StaticResource Vis}}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource OverlayBadgeShade}" CornerRadius="4" MinWidth="20" Height="16" Padding="4,0"
                                Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPart}" Value="True" />
                    <Condition Binding="{Binding Done}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Mark" Property="Text" Value="&#xF05E0;" />
                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Positive}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Done}" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.6" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- What a counter's tooltip and its opened row list: the goal's parts, what was counted, the cards that need it -->
    <DataTemplate x:Key="CounterCardsTemplate" DataType="{x:Type o:CounterChip}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Details}" Margin="0,0,0,2" Visibility="{Binding Details, Converter={StaticResource Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding Parts, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Counter.Goal}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource CounterCardTemplate}" />
            </StackPanel>
            <StackPanel Visibility="{Binding Counted, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                <TextBlock Text="{Binding MoreCounted}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding MoreCounted, Converter={StaticResource Vis}}" />
            </StackPanel>
            <StackPanel Visibility="{Binding Related, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
                <TextBlock Text="{Binding MoreRelated}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding MoreRelated, Converter={StaticResource Vis}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- The opened Battlegrounds chip: its cards only, under the details the row already shows -->
    <DataTemplate x:Key="BgCounterCardsTemplate" DataType="{x:Type o:CounterChip}">
        <StackPanel>
            <StackPanel Visibility="{Binding Counted, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Counter.Counted}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Counted}" ItemTemplate="{StaticResource CounterCardTemplate}" />
            </StackPanel>
            <StackPanel Visibility="{Binding Related, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.Counter.NeededFor}" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource CounterCardTemplate}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Counter tooltip: title and value, what the counter is, then its cards -->
    <DataTemplate x:Key="CounterTipTemplate" DataType="{x:Type o:CounterChip}">
        <StackPanel Width="232" Margin="0,2,0,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}" FontSize="14" Foreground="{StaticResource Accent}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,2" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Segments of a goal counted in steps, lit up to the count -->
    <DataTemplate x:Key="CounterSegmentTemplate">
        <Border x:Name="Segment" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{StaticResource Surface4}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="True">
                <Setter TargetName="Segment" Property="Background" Value="{StaticResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Counter row: card art, title with its progress under it, value right-aligned, and on hover a cross in its own
         column that hides the counter (not over the art: a click there opens the cards); hover shows the cards, a click
         opens them under the row -->
    <DataTemplate x:Key="CounterTemplate" DataType="{x:Type o:CounterChip}">
        <Border x:Name="Chip" Background="Transparent" CornerRadius="5" Padding="3,1,4,1" Cursor="Hand"
                ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Right" ToolTipService.HorizontalOffset="8">
            <Border.ToolTip>
                <ToolTip Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
            </Border.ToolTip>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                              Command="{Binding DataContext.ToggleCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border.InputBindings>
            <StackPanel>
                <Grid Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="CounterValue" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <!-- The art is drawn a little larger than the circle: some portraits have light edges that WPF shows as a rim -->
                    <Grid Width="20" Height="20">
                        <Grid.Clip>
                            <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" />
                        </Grid.Clip>
                        <Border Background="{StaticResource Surface3}" />
                        <Border Margin="-3" i:CardArt.Portrait="{Binding IconCardId}" />
                    </Grid>
                    <Ellipse Width="20" Height="20" Stroke="{StaticResource OverlayBorder}" StrokeThickness="1" />
                    <Button x:Name="HideButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xF0156;" FontSize="11" Width="20" Height="20"
                            HorizontalAlignment="Right" Visibility="Hidden" ToolTip="{i:Loc Overlay.Counter.HideTip}" AutomationProperties.Name="{i:Loc Overlay.Counter.HideName}"
                            CommandParameter="{Binding Id}" Command="{Binding DataContext.HideCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource CounterSegmentTemplate}" Margin="0,3,-2,0"
                                      Visibility="{Binding Segments, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Height="3" CornerRadius="1.5" Background="{StaticResource Surface4}" Margin="0,3,0,0" Visibility="{Binding HasBar, Converter={StaticResource Vis}}">
                            <Border CornerRadius="1.5" Background="{StaticResource Accent}" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Number}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterCardsTemplate}" Focusable="False" Margin="27,0,0,6"
                                Visibility="{Binding Expanded, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Expanded}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                <Setter TargetName="Chip" Property="ToolTipService.IsEnabled" Value="False" />
            </DataTrigger>
            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                <Setter TargetName="HideButton" Property="Visibility" Value="Visible" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Battlegrounds counter chip: art, title over value; a click opens its details under the row, the cross hides it -->
    <DataTemplate x:Key="BgCounterTemplate" DataType="{x:Type o:CounterChip}">
        <Border x:Name="Chip" Background="{StaticResource Surface2}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="8"
                Padding="5,4,6,4" Margin="0,0,6,6" Cursor="Hand" ToolTipService.InitialShowDelay="250">
            <Border.ToolTip>
                <ToolTip Content="{Binding}" ContentTemplate="{StaticResource CounterTipTemplate}" />
            </Border.ToolTip>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                              Command="{Binding DataContext.ToggleBgCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Surface3}" VerticalAlignment="Center" i:CardArt.Portrait="{Binding IconCardId}" />
                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="{StaticResource Muted}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" FontSize="15" />
                    <Border Height="2" CornerRadius="1" Background="{StaticResource Surface4}" Width="56" HorizontalAlignment="Left" Margin="0,2,0,0"
                            Visibility="{Binding HasProgress, Converter={StaticResource Vis}}">
                        <Border HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource Accent}"
                                Width="{Binding Progress, Converter={StaticResource Fraction}, ConverterParameter=56}" />
                    </Border>
                </StackPanel>
                <Button x:Name="HideButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xF0156;" FontSize="10" Width="18" Height="18"
                        Margin="4,0,0,0" VerticalAlignment="Top" Visibility="Hidden" ToolTip="{i:Loc Overlay.BgCounter.HideTip}" AutomationProperties.Name="{i:Loc Overlay.Counter.HideName}"
                        CommandParameter="{Binding Id}" Command="{Binding DataContext.HideBgCounter, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Expanded}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
            </DataTrigger>
            <!-- Raised plate on hover (the Hover wash would make the chip see-through against the panel) -->
            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Surface3}" />
                <Setter TargetName="HideButton" Property="Visibility" Value="Visible" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TierTemplate" DataType="{x:Type o:TierButton}">
        <Button Command="{Binding DataContext.SelectTier, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Tier}"
                Cursor="Hand" Margin="0,0,3,0" ToolTip="{i:Loc Overlay.Bar.TierTip}" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}"
                            BorderBrush="Transparent" BorderThickness="1.5">
                        <TextBlock x:Name="Num" Text="{Binding Tier}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource OnAccent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Text}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Text}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="CombatTemplate" DataType="{x:Type o:CombatDot}">
        <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="0,0,4,0" Background="{StaticResource Faint}" ToolTip="{Binding Tooltip}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Result}" Value="Win">
                <Setter TargetName="Dot" Property="Background" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Result}" Value="Loss">
                <Setter TargetName="Dot" Property="Background" Value="{StaticResource Negative}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Hero pick: compact badge centred above each hero portrait (slot = HDT hero pitch, 340 units) -->
    <DataTemplate x:Key="HeroPickTemplate" DataType="{x:Type o:HeroPickCard}">
        <Grid Width="340">
            <Border x:Name="Halo" Width="268" HorizontalAlignment="Center" Margin="0,-6,0,-14" CornerRadius="18"
                    Background="{StaticResource BestHalo}" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border x:Name="Card" Style="{StaticResource OverlayCardSolid}" HorizontalAlignment="Center"
                    Width="232" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding TierTip}" o:OverlayHit.Interactive="True">
                        <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Place}" Style="{StaticResource Number}" FontSize="18" />
                            <TextBlock Text="{Binding Delta}" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                       Foreground="{Binding DeltaValue, Converter={StaticResource SignBrush}}" />
                            <TextBlock Text="{Binding PlaceNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Personal}" FontSize="11" Foreground="{StaticResource Text}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Personal, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                    Padding="8,1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                    <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- Only "Mark the best" (Settings > Pick suggestions) singles one option out -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Recommended}" Value="True" />
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                <Setter TargetName="Best" Property="Visibility" Value="Visible" />
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding HasMeta}" Value="False">
                <Setter TargetName="Card" Property="Opacity" Value="0.7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Trinket pick: compact badge above each offered trinket (slot = HDT trinket pitch, 277 units) -->
    <DataTemplate x:Key="TrinketBadgeTemplate" DataType="{x:Type o:TrinketBadge}">
        <Grid Width="277">
            <Border x:Name="Halo" Width="232" HorizontalAlignment="Center" Margin="0,-6,0,-14" CornerRadius="18"
                    Background="{StaticResource BestHalo}" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border x:Name="Card" Style="{StaticResource OverlayCardSolid}" HorizontalAlignment="Center"
                    Width="196" Padding="9,7" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding TierTip}" o:OverlayHit.Interactive="True">
                        <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Place}" Style="{StaticResource Number}" FontSize="16" />
                            <TextBlock Text="{i:Loc Overlay.Badge.AvgPlace}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,2" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding PickRate}" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                    Padding="8,1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                    <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- Only "Mark the best" (Settings > Pick suggestions) singles one option out -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Recommended}" Value="True" />
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                <Setter TargetName="Best" Property="Visibility" Value="Visible" />
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding HasMeta}" Value="False">
                <Setter TargetName="Card" Property="Opacity" Value="0.7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Tavern: hint pinned above a shop minion: its tags, plus how players who bought it placed.
         "Mark the best" turns the best buy gold with BUY; "Stats only" keeps every badge neutral. -->
    <DataTemplate x:Key="ShopBadgeTemplate" DataType="{x:Type o:ShopBadge}">
        <Border x:Name="Bd" Width="126" MinHeight="26" CornerRadius="6" Padding="8,3" Background="{DynamicResource OverlayPanelSolid}"
                BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" VerticalAlignment="Bottom">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="Buy" Text="{i:Loc Overlay.Badge.Buy}" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" Visibility="Collapsed" />
                    <TextBlock x:Name="Lbl" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis" MaxWidth="100" Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                </StackPanel>
                <TextBlock x:Name="Data" Text="{Binding Placement}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                           Visibility="{Binding Placement, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <!-- A badge with no tags (stats only) shows its placement at a readable size -->
            <DataTrigger Binding="{Binding Label}" Value="">
                <Setter TargetName="Data" Property="FontSize" Value="10.5" />
                <Setter TargetName="Data" Property="Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Best}" Value="True" />
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Buy" Property="Visibility" Value="Visible" />
                <Setter TargetName="Buy" Property="Foreground" Value="{StaticResource OnAccent}" />
                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource OnAccent}" />
                <Setter TargetName="Data" Property="Foreground" Value="{StaticResource OnAccent}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Discover-style choice (hero power, spell, triple reward, Dark Gift…): one badge above each option (slot = 340 units) -->
    <DataTemplate x:Key="DiscoverBadgeTemplate" DataType="{x:Type o:DiscoverBadge}">
        <Grid Width="340">
            <Border x:Name="Card" Style="{StaticResource OverlayCardSolid}" HorizontalAlignment="Center"
                    MinWidth="150" MaxWidth="236" Padding="9,7,12,7" Margin="0,9,0,0" Opacity="0.85">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Rank among the options: "Mark the best" only -->
                    <Grid x:Name="RankCookie" Width="32" Height="32" VerticalAlignment="Center" Visibility="Collapsed">
                        <c:Scallop x:Name="Cookie" Fill="{StaticResource Surface4}" Lobes="8" Depth="0.1" />
                        <TextBlock x:Name="RankText" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="#" FontSize="10" /><Run Text="{Binding Rank, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!-- Otherwise the option's tavern tier, when it has one: nothing is ranked -->
                    <Border x:Name="TierChip" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface3}" VerticalAlignment="Center"
                            ToolTip="{i:Loc Overlay.Common.TavernTier}" Visibility="{Binding Tier, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Tier}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="Info" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Placement}" Style="{StaticResource Number}" FontSize="16" />
                            <TextBlock Text="{Binding PlacementNote}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="5,0,0,2" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Gift}" FontSize="10.5" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Gift, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Best" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource PrimaryFill}" CornerRadius="5"
                    Padding="8,1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF0AE2;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource OnAccent}" Margin="0,0,4,0" />
                    <TextBlock Text="{i:Loc Overlay.Badge.BestPick}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- "Mark the best": ranked options, the others dimmed a little next to the best one -->
            <DataTrigger Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="RankCookie" Property="Visibility" Value="Visible" />
                <Setter TargetName="TierChip" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- "Stats only": every option at full strength, only the ones without data dimmed -->
            <DataTrigger Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter TargetName="Card" Property="Opacity" Value="1" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    <Condition Binding="{Binding HasData}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Card" Property="Opacity" Value="0.7" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    <Condition Binding="{Binding Tier}" Value="0" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Info" Property="Margin" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Best}" Value="True" />
                    <Condition Binding="{Binding DataContext.ShowBestBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                <Setter TargetName="Card" Property="Opacity" Value="1" />
                <Setter TargetName="Cookie" Property="Fill" Value="{StaticResource Accent}" />
                <Setter TargetName="RankText" Property="Foreground" Value="{StaticResource OnAccent}" />
                <Setter TargetName="Best" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Tier list card: every card the same size; hover opens one large render right against it (CardPreview) -->
    <DataTemplate x:Key="BrowserCardTemplate" DataType="{x:Type o:BrowserCard}">
        <Grid Width="84" Height="116" Margin="1" Background="Transparent"
              c:CardPreview.CardId="{Binding CardId}" c:CardPreview.Battlegrounds="True" c:CardPreview.Placement="Adjacent">
            <Image i:CardArt.BattlegroundsCard="{Binding CardId}" Width="84" Height="116" Stretch="Uniform" />
        </Grid>
    </DataTemplate>

    <!-- A button on a panel's name tag (size, opacity, compact, reset): an icon on the accent plate -->
    <Style x:Key="TagButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" Width="20" Height="18" CornerRadius="4" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Icon}" FontSize="12" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource OverlayBadgeShade}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panels' lock on a name tag: "Unlock panels" / "Lock panels", an icon and a word on the accent plate. Under
         the mouse the primary button's hover fill: the tag buttons' dark shade left the word at 1.3:1 -->
    <Style x:Key="LockButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource Accent}" CornerRadius="5" Height="19">
                        <Border x:Name="Plate" CornerRadius="5" Background="Transparent" Padding="6,0,7,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource PrimaryFillHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Movable panel host: frame, label and placeholder in layout mode -->
    <Style TargetType="{x:Type o:MovablePanel}">
        <Setter Property="IsEditing" Value="{Binding LayoutEditing}" />
        <Setter Property="IsUnlocked" Value="{Binding PanelsUnlocked}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type o:MovablePanel}">
                    <Grid>
                        <!-- Placeholder: its own dashed frame, so a wide pick row frames only its label, not the whole card row -->
                        <Grid x:Name="Placeholder" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding PlaceholderAlignment}">
                            <Border MinWidth="200" MinHeight="36" Background="{StaticResource OverlayPlaceholder}" CornerRadius="8"
                                    BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,8">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PlaceholderScale" Text="{TemplateBinding ScaleText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Rectangle Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}" StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False" />
                        </Grid>
                        <!-- The player's opacity fades the content only; the frame and tag stay readable -->
                        <ContentPresenter x:Name="Body" Opacity="{TemplateBinding PanelOpacity}" />
                        <!-- Takes the drag over the panel's gaps. The window's pixels decide where the mouse goes, and the overlay's
                             opacity (down to 0.3) multiplies this alpha: 1/255 rounded to 0 at 50 % and let the click into the game -->
                        <Border x:Name="Shield" Background="#04000000" Visibility="Collapsed" />
                        <Rectangle x:Name="Frame" Visibility="Collapsed" Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}"
                                   StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False" />
                        <!-- Name tag and, under the mouse, the panel's buttons. The strip reaches down to the panel so the mouse
                             can travel from the panel to the buttons without leaving it. -->
                        <!-- The strip keeps the tag out of the panel's size: wider than the panel, it widened and moved it when armed -->
                        <o:PanelTagStrip>
                            <Grid x:Name="PART_Chrome" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26">
                                <!-- Above the panel the buttons keep to the strip's top, under it (no room at the top of the screen) to its bottom -->
                                <StackPanel x:Name="PART_TagRow" Orientation="Horizontal" VerticalAlignment="Top">
                                    <!-- The panels' lock, first so it stays under the pointer when the tag and tools appear beside it; on a
                                         locked panel the only part that takes the mouse -->
                                    <Button x:Name="PART_Lock" Style="{StaticResource LockButton}" Visibility="Collapsed" Margin="0,0,4,0" o:OverlayHit.Interactive="True"
                                            ToolTip="{i:Loc Overlay.Lock.UnlockTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="LockIcon" Text="&#xF033F;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource OnAccent}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="UnlockLabel" Text="{i:Loc Overlay.Lock.Unlock}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LockLabel" Text="{i:Loc Overlay.Lock.Lock}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Border x:Name="Tag" Background="{StaticResource Accent}" CornerRadius="5" Padding="7,2" Height="19" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{TemplateBinding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                                            <!-- The size and opacity the player gave it, so two panels can be given the same -->
                                            <TextBlock x:Name="ScaleTag" Text="{TemplateBinding ScaleText}" FontSize="10.5" Foreground="{StaticResource OnAccent}" Margin="6,0,0,0" />
                                            <TextBlock x:Name="OpacityTag" FontSize="10.5" Foreground="{StaticResource OnAccent}" Margin="6,0,0,0">
                                                <Run Text="&#xF05CC;" FontFamily="{StaticResource IconFont}" /><Run Text="{Binding OpacityText, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                            </TextBlock>
                                            <!-- Ctrl held during a game: what the mouse does now -->
                                            <TextBlock x:Name="ArmedHint" Text="{i:Loc Overlay.Move.Hint}" FontSize="10.5" Foreground="{StaticResource OnAccent}" Margin="8,0,0,0"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Tools" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="5" Padding="2,0" Height="19" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PART_Smaller" Style="{StaticResource TagButton}" Content="&#xF0374;" ToolTip="{i:Loc Overlay.Layout.Smaller}" AutomationProperties.Name="{i:Loc Overlay.Layout.Smaller}" />
                                            <Button x:Name="PART_Larger" Style="{StaticResource TagButton}" Content="&#xF0415;" ToolTip="{i:Loc Overlay.Layout.Larger}" AutomationProperties.Name="{i:Loc Overlay.Layout.Larger}" />
                                            <Button x:Name="PART_Fade" Style="{StaticResource TagButton}" Content="&#xF05CC;" ToolTip="{i:Loc Overlay.Layout.Fade}" AutomationProperties.Name="{i:Loc Overlay.Layout.FadeName}" />
                                            <Button x:Name="PART_Compact" Style="{StaticResource TagButton}" Content="&#xF0451;" ToolTip="{i:Loc Overlay.Layout.Compact}" AutomationProperties.Name="{i:Loc Overlay.Layout.CompactName}" Visibility="Collapsed" />
                                            <Button x:Name="PART_Reset" Style="{StaticResource TagButton}" Content="&#xF099B;" ToolTip="{i:Loc Overlay.Layout.ResetPanel}" AutomationProperties.Name="{i:Loc Overlay.Layout.ResetPanelName}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </o:PanelTagStrip>
                        <!-- Corner marker: dragged, it resizes the panel like the wheel (layout mode, or Ctrl held during a game).
                             MovablePanel undoes the panel's scale on it (size and margin), so it is one size at every scale. -->
                        <Border x:Name="PART_Grip" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                                Width="14" Height="14" CornerRadius="4" Background="{StaticResource Accent}" Cursor="SizeNWSE" ToolTip="{i:Loc Overlay.Move.Grip}">
                            <TextBlock Text="&#xF045D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Most panels show during matches and need no note; menu and draft panels name their scene in Hint -->
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ScaleText" Value="">
                            <Setter TargetName="ScaleTag" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlaceholderScale" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="OpacityText" Value="">
                            <Setter TargetName="OpacityTag" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CanCompact" Value="True">
                            <Setter TargetName="PART_Compact" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Chrome" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Grip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Ctrl over a panel during a game: the same frame and tag, and the shield takes the whole panel for the drag -->
                        <Trigger Property="IsDragArmed" Value="True">
                            <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Chrome" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ArmedHint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tools" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Chrome" Property="Background" Value="Transparent" />
                            <Setter TargetName="PART_Grip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Panels unlocked: every free panel shows its frame, and the one under the pointer arms as with Ctrl -->
                        <Trigger Property="IsFree" Value="True">
                            <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- The pointer rests on the panel, or arms it: the lock button on the tag -->
                        <Trigger Property="OffersLock" Value="True">
                            <Setter TargetName="PART_Chrome" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Lock" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsUnlocked" Value="True">
                            <Setter TargetName="LockIcon" Property="Text" Value="&#xF033E;" />
                            <Setter TargetName="UnlockLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LockLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Lock" Property="ToolTip" Value="{i:Loc Overlay.Lock.LockTip}" />
                        </Trigger>
                        <!-- Resting on a locked panel: the button alone, without the name tag, so the panel does not look armed -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="OffersLock" Value="True" />
                                <Condition Property="IsDragArmed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tag" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <!-- A placeholder already carries the title; the tag would only repeat it and pile up over its neighbours.
                             Only the placeholder itself takes the mouse, so a wide row's empty width never hides its neighbours. -->
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Tag" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Shield" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Grip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Layout mode: the buttons show over the panel the mouse is on, so they never pile up over the neighbours -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditing" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tools" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Chrome" Property="Background" Value="Transparent" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="HRow">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="WrapRow">
        <WrapPanel />
    </ItemsPanelTemplate>
</ResourceDictionary>
