<UserControl x:Class="Hearthpulse.App.Overlay.LobbyPopupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The opponent under the mouse on the leaderboard ("lobby-popup", top centre, DataContext: the overlay view model):
         portrait, hero, place and health, the player's last fight with them, the board last seen as round portraits with
         attack, health and tavern tier. No card text, no tribe glyphs. Same tree as LobbyPopupPanel.axaml. Tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Overlay/OverlayPanels.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A minion of the last seen board: portrait 64, attack and health on its lower edge, the tier shield top left -->
            <DataTemplate x:Key="PopupMinionTemplate" DataType="{x:Type o:LobbyMinion}">
                <Grid Width="64" Height="72" Margin="0,0,4,0">
                    <Border x:Name="Ring" Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top" Background="{StaticResource Surface4}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1.5" Padding="1.5">
                        <Border CornerRadius="31" i:CardArt.Portrait="{Binding CardId}" />
                    </Border>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="17" Visibility="{Binding HasTier, Converter={StaticResource Vis}}">
                        <Path Data="M0.5,0.5 H19.5 V11 C19.5,17 15.5,21.5 10,23.5 C4.5,21.5 0.5,17 0.5,11 Z" Stretch="Fill"
                              Fill="{DynamicResource OverlayBadgeShade}" Stroke="{StaticResource AccentDeep}" StrokeThickness="1" />
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                    </Grid>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" MinWidth="20" Height="18" CornerRadius="9" Padding="3,0"
                            Background="{DynamicResource OverlayBadgeShade}" BorderBrush="{StaticResource TierS}" BorderThickness="1">
                        <TextBlock Text="{Binding Attack}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource TierS}"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="20" Height="18" CornerRadius="9" Padding="3,0"
                            Background="{DynamicResource OverlayBadgeShade}" BorderBrush="{StaticResource Negative}" BorderThickness="1">
                        <TextBlock Text="{Binding Health}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Negative}"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Golden}" Value="True">
                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource TierS}" />
                        <Setter TargetName="Ring" Property="BorderThickness" Value="2.5" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCardSolid}" Width="502" Padding="12,12,12,8">
        <StackPanel DataContext="{Binding Lobby}">
            <!-- Header: portrait, hero (two lines at most), place and health; "Next opponent" or "Out" on the right -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Out: the portrait fades, the name turns muted (a faded text would drop below AA) -->
                <Border x:Name="Hero" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding HeroCardId}"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dead}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroName" Text="{Binding HeroName}" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dead}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="4" Padding="8,2" VerticalAlignment="Top"
                        Visibility="{Binding NextOpponent, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.Next}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top" Visibility="{Binding Dead, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.Out}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                </Border>
            </Grid>

            <!-- The player's last fight with them, from the player's side, and every fight as dots once there are two -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasFight, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Overlay.LobbyPopup.LastFight}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastResult}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding History, Converter={StaticResource Vis}}">
                    <TextBlock Text="{i:Loc Overlay.LobbyPopup.AllFights}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource CombatTemplate}" ItemsPanel="{StaticResource HRow}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- How long ago the board was seen, and its main tribe in words -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding LastSeen, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding LastSeen}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" />
                <TextBlock Text=" · " FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Visibility="{Binding Tribe, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Tribe}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Text}" Visibility="{Binding Tribe, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- The board last seen, or why there is none -->
            <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource PopupMinionTemplate}" ItemsPanel="{StaticResource HRow}" Margin="0,8,0,0"
                          HorizontalAlignment="Left" Visibility="{Binding Board, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding BoardNote}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" MinHeight="24"
                       Visibility="{Binding BoardNote, Converter={StaticResource Vis}}" />
        </StackPanel>
    </Border>
</UserControl>
