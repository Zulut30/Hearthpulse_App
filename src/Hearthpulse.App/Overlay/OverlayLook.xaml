<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Overlay-only look shared by the overlay window and its panels (Avalonia: Overlay/OverlayLook.axaml, same names as
         classes). Theme tokens only, no hex: the theme engine recolours Theme.xaml alone. Nothing here loops, blurs or casts a
         shadow: the overlay draws over the game. The one motion is the row flash, started once by the row template. -->

    <!-- Panel header: a warm gold band with a hairline under it, flush with the card's rounded top (card radius 8 - 1px edge) -->
    <Style x:Key="OverlayHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="7,7,0,0" />
        <Setter Property="Padding" Value="12,8,12,7" />
    </Style>

    <!-- Header content, the same in every panel: an optional gold glyph, the title, one muted line under it -->
    <Style x:Key="OverlayHeaderIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style x:Key="OverlayHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="OverlayHeaderNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- Dark plate for a few key figures under a header -->
    <Style x:Key="OverlayStatPlate" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlayBadgeShade}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5,8,4" />
    </Style>
    <Style x:Key="OverlayStatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="OverlayStatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Card rows: a gold hairline along the top edge lifts the row off the panel -->
    <Style x:Key="OverlayRowSheen" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{StaticResource OverlayBorder}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Rarity colour along the left edge of a card row (the brush comes from the row) -->
    <Style x:Key="OverlayRarityStrip" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Copy count on a dark plate at the right end of a card row, readable over bright art -->
    <Style x:Key="OverlayCountBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlayBadgeShade}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Gold wash over a card row whose count just moved; the row template fades it out once (1.4 s), nothing loops -->
    <Style x:Key="OverlayRowFlash" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- One small source line at the bottom of a panel -->
    <Style x:Key="OverlayFooter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
