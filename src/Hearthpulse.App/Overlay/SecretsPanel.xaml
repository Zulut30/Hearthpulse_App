<UserControl x:Class="Hearthpulse.App.Overlay.SecretsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Secrets helper: the opponent's active Secrets (one line each) and the Secrets they can still be, folded to the first
         few above the board; "+N more" unfolds the whole pool (crossed out by hand, then ruled out by the game: struck
         through, dimmed). A click on a row crosses it out or brings it back; only the rows and "+N more" take clicks.
         DataContext: OverlayViewModel. Tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <i:VisibleWhen x:Key="Vis" />

        <DataTemplate x:Key="SecretTemplate" DataType="{x:Type o:SecretTile}">
            <Button Command="{Binding DataContext.ToggleSecret, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                    Cursor="Hand" Focusable="False" o:OverlayHit.Interactive="True" Margin="0,0,0,2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Row" Height="22" Background="Transparent" TextElement.Foreground="{StaticResource Text}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:ManaCost Width="21" Height="21" Text="{Binding Cost}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Border x:Name="Tile" Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                                <Grid>
                                    <Image x:Name="Art" i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                    <Rectangle Fill="{StaticResource TileFade}" />
                                    <DockPanel Margin="8,0,3,0">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" Margin="4,0,3,0" Visibility="{Binding Known, Converter={StaticResource Vis}}" />
                                        <!-- "×2" on a dark plate, like the copy counts of the deck and the opponent's played cards -->
                                        <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" Height="16" Padding="5,0"
                                                Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- A lighter plate than Row: the Hover wash over the panel fill would make the row darker -->
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface3}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Open}" Value="False">
                                <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter TargetName="Art" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RuledOut}" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCard}" Width="210">
        <StackPanel>
            <Border Style="{StaticResource OverlayHeader}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="&#xF02D7;" Style="{StaticResource OverlayHeaderIcon}" />
                        <TextBlock Text="{Binding SecretsTitle}" Style="{StaticResource OverlayHeaderTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding SecretsPool}" Style="{StaticResource OverlayHeaderNote}" />
                </StackPanel>
            </Border>
            <StackPanel Margin="12,6,12,10">
                <ItemsControl ItemsSource="{Binding SecretSlots}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:SecretSlotLine}">
                            <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SecretTiles}" ItemTemplate="{StaticResource SecretTemplate}" />
                <Button Command="{Binding ToggleSecretsExpanded}" Cursor="Hand" Focusable="False" o:OverlayHit.Interactive="True" HorizontalAlignment="Left"
                        Visibility="{Binding ShowSecretsMore, Converter={StaticResource Vis}}" Margin="33,1,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="More" Text="{Binding SecretsMore}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Background="Transparent" Padding="0,1,6,1" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="More" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
