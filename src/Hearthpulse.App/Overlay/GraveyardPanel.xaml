<UserControl x:Class="Hearthpulse.App.Overlay.GraveyardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- The Graveyard panel (MovablePanel "graveyard", docs/graveyard.md): the minions that died this game, the opponent's
         above yours as on the board, as tracker rows; the full card on hover. DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <i:VisibleWhen x:Key="Vis" />
            <i:KeyBrush x:Key="KeyBrush" />

            <!-- A dead minion: cost gem, name over the art with its rarity strip, "×2" for repeats -->
            <DataTemplate x:Key="DeadRow" DataType="{x:Type o:PoolListRow}">
                <Grid x:Name="RowRoot" Height="22" Margin="0,0,0,2" Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.CardId="{Binding CardId}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:ManaCost x:Name="Gem" Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                        <Grid>
                            <Image x:Name="Art" i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                            <Rectangle x:Name="Fade" Fill="{StaticResource TileFade}" />
                            <Border Style="{StaticResource OverlayRarityStrip}" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                            <DockPanel Margin="8,0,3,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource OverlayCountBadge}" Height="16" Visibility="{Binding CountText, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource OverlayRowSheen}" />
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="RowRoot" Property="o:MovablePanel.Compact" Value="True">
                        <Setter TargetName="RowRoot" Property="Height" Value="18" />
                        <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Fade" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Gem" Property="Width" Value="18" />
                        <Setter TargetName="Gem" Property="Height" Value="18" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="SideNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="Margin" Value="0,1,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCard}" Width="214">
        <StackPanel>
            <Border Style="{StaticResource OverlayHeader}">
                <DockPanel>
                    <TextBlock Text="&#xF068C;" Style="{StaticResource OverlayHeaderIcon}" />
                    <TextBlock Text="{i:Loc Related.Graveyard.Title}" Style="{StaticResource OverlayHeaderTitle}" />
                </DockPanel>
            </Border>
            <StackPanel Margin="12,0,12,10">
                <c:Ornament Text="{Binding GraveyardOpponentTitle}" Size="10.5" Margin="0,10,0,6" />
                <ItemsControl ItemsSource="{Binding GraveyardOpponent}" ItemTemplate="{StaticResource DeadRow}" Focusable="False" />
                <TextBlock Text="{Binding GraveyardOpponentMore}" Style="{StaticResource SideNote}" Visibility="{Binding GraveyardOpponentMore, Converter={StaticResource Vis}}" />

                <c:Ornament Text="{Binding GraveyardLocalTitle}" Size="10.5" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding GraveyardLocal}" ItemTemplate="{StaticResource DeadRow}" Focusable="False" />
                <TextBlock Text="{Binding GraveyardLocalMore}" Style="{StaticResource SideNote}" Visibility="{Binding GraveyardLocalMore, Converter={StaticResource Vis}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
