<UserControl x:Class="Hearthpulse.App.Overlay.OpponentArchetypePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- The opponent's likely archetype from the cards it played face up, two or three alternatives, and the cards the
         archetype's lists usually run that it has not shown yet. Nothing here is hidden information. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <i:VisibleWhen x:Key="Vis" />
        <i:FractionWidth x:Key="Fraction" />
        <i:KeyBrush x:Key="KeyBrush" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayCard}" Width="220">
        <StackPanel>
            <!-- The close button and the card rows (hover shows the card) take the pointer; the rest passes clicks to the game. -->
            <Border Style="{StaticResource OverlayHeader}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" Width="22" Height="22" FontSize="14" Margin="0,-5,-6,-3"
                                VerticalAlignment="Top" Focusable="False" Command="{Binding DismissArchetype}" ToolTip="{i:Loc Widgets.Archetype.Hide}"
                                o:OverlayHit.Interactive="True" />
                        <TextBlock Text="{i:Loc Widgets.Archetype.Title}" Style="{StaticResource OverlayHeaderNote}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ArchetypeChance}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <!-- Its meta tier, as on the site's meta page -->
                        <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"
                              Visibility="{Binding ArchetypeTier, Converter={StaticResource Vis}}">
                            <c:Scallop Fill="{Binding ArchetypeTier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                            <TextBlock Text="{Binding ArchetypeTier}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding ArchetypeName}" Style="{StaticResource OverlayHeaderTitle}" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <StackPanel Margin="12,7,12,10">
                <TextBlock Text="{Binding ArchetypeDetail}" FontSize="11" Foreground="{StaticResource Muted}" />

                <c:Ornament Text="{i:Loc Widgets.Archetype.Alternatives}" Size="10.5" Margin="0,10,0,6"
                            Visibility="{Binding ArchetypeAlternatives, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding ArchetypeAlternatives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ArchetypeRow}">
                            <StackPanel Margin="0,0,0,5">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tier}" Style="{StaticResource TierLetter}" Width="16" Margin="4,0,0,0"
                                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Chance}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource Surface3}" Margin="0,3,0,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource AccentLine}"
                                            Width="{Binding Fraction, Converter={StaticResource Fraction}, ConverterParameter=196}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:Ornament Text="{i:Loc Widgets.Archetype.MayHold}" Size="10.5" Margin="0,8,0,6"
                            Visibility="{Binding LikelyCards, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding LikelyCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:LikelyTile}">
                            <Grid Height="22" Margin="0,0,0,2" Background="Transparent" o:OverlayHit.Interactive="True" c:CardPreview.CardId="{Binding CardId}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:ManaCost Width="21" Height="21" Text="{Binding Cost}" HorizontalAlignment="Left" />
                                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                                    <Grid>
                                        <Image i:CardArt.Tile="{Binding CardId}" Width="120" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                        <Rectangle Fill="{StaticResource TileFade}" />
                                        <DockPanel Margin="8,0,3,0">
                                            <!-- The chance on a dark plate, like the copy counts of the deck and the played cards -->
                                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" Height="16" Padding="5,0"
                                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Chance}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ArchetypeNote}" FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{i:Loc Overlay.Tier.Meta}" FontSize="9.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding ArchetypeTier, Converter={StaticResource Vis}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
