<UserControl x:Class="Hearthpulse.App.Overlay.CardPoolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:p="clr-namespace:Hearthpulse.Core.CardPool;assembly=Hearthpulse.Core">
    <!-- The card pool panel (MovablePanel "card-pool"); DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />

        <ItemsPanelTemplate x:Key="BarRow">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="HistogramTemplate" DataType="{x:Type o:PoolHistogramModel}">
            <StackPanel Margin="5,0">
                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource ManaGem}" />
                <!-- Tag carries the histogram's colour down to its bars. -->
                <ItemsControl x:Name="Bars" ItemsSource="{Binding Bars}" ItemsPanel="{StaticResource BarRow}" Height="36" Margin="0,4,0,0" Tag="{StaticResource ManaGem}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolBarModel}">
                            <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="1.5" ToolTip="{Binding ToolTip}"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMedian}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Text}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource OverlayBorder}" />
                <ItemsControl ItemsSource="{Binding Bars}" ItemsPanel="{StaticResource BarRow}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolBarModel}">
                            <TextBlock Text="{Binding Label}" FontSize="8.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MedianText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="median" FontSize="9.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAttack}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TierS}" />
                    <Setter TargetName="Bars" Property="Tag" Value="{StaticResource TierS}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHealth}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter TargetName="Bars" Property="Tag" Value="{StaticResource Negative}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MechanicTemplate" DataType="{x:Type p:PoolMechanic}">
            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="8,3,8,4" Margin="0,0,5,5" MinWidth="62">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- Not interactive: clicks reach the board and the Discover options under it; hover and right-click are polled. -->
    <Border x:Name="Card" Style="{StaticResource OverlayCard}" Width="324" Background="{StaticResource OverlayPanelSolid}">
        <StackPanel Margin="10,9,10,8">
            <TextBlock Text="{Binding CardPoolTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CardPoolDescription}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,1,0,0" />

            <ItemsControl ItemsSource="{Binding CardPoolHistograms}" ItemTemplate="{StaticResource HistogramTemplate}" Margin="-5,9,-5,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Highlighted card: most played in meta decks -->
            <Border Margin="-10,8,-10,0" Height="30" Background="{StaticResource Row}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="0,1"
                    Visibility="{Binding CardPoolFeatured, Converter={StaticResource Vis}}" ToolTip="{Binding CardPoolFeaturedNote}">
                <Grid>
                    <Grid Width="200" HorizontalAlignment="Right">
                        <Image i:CardArt.Tile="{Binding CardPoolFeatured.CardId}" Width="150" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CardPoolFeatured.Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding CardPoolMechanics}" ItemTemplate="{StaticResource MechanicTemplate}" Margin="0,9,0,0" HorizontalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Right-click to see all options" FontSize="10.5" FontStyle="Italic" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
