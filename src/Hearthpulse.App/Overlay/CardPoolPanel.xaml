<UserControl x:Class="Hearthpulse.App.Overlay.CardPoolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- The compact card pool panel (300 wide): at its own spot (MovablePanel "card-pool") or next to its card (the card
         pool layer). Header, the cards of this game a hovered card looks back at, a summary grid, the most played cards as
         tracker rows, the right-click hint (the full view is the pool browser), and the card's related cards in a zone
         of their own. DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />

        <!-- Section chips (the generator's separate pools) -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!-- Every card row of the panel (this game, Excavate, meta, related) as a deck tracker row: cost gem, name over a
             strip of art, "×2" or a share on the right; one quiet edge for all, no rarity colour. -->
        <DataTemplate x:Key="PoolRowTemplate" DataType="{x:Type o:PoolListRow}">
            <!-- The full card on hover: the panel lets clicks through, so the poll finds the row under the pointer -->
            <Grid Height="24" Margin="0,0,0,2" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                <Border Style="{StaticResource OverlayCapsule}" c:RoundClip.Radius="12">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <DockPanel Margin="1,0,3,0">
                            <c:ManaCost Text="{Binding Cost}" Width="22" Height="22" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,4,0" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource OverlayCountBadge}" Visibility="{Binding CountText, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding CountText}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayRarityEdge}" BorderBrush="{StaticResource OverlayBorder}" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Not interactive: clicks reach the board and the Discover options under it; hover and right-click are polled.
         The opacity carries the short fade-in when the panel first appears. The popup's fill (OverlayPopupSolid, set in
         code) does not fade with the overlay opacity; the edge turns gold while the pointer holds the pool. -->
    <Border x:Name="Card" Width="300">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource OverlayCardSolid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CardPoolHeld}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- ===== Header: the pool's size (or the list's name), one line of classes · format ===== -->
            <Border Style="{StaticResource OverlayHeader}">
                <StackPanel>
                    <TextBlock Text="{Binding CardPoolTitle}" Style="{StaticResource OverlayHeaderTitle}" TextWrapping="Wrap" MaxHeight="38" />
                    <!-- Next to its card: "classes · format"; at its own spot the card's name comes first (code shows one) -->
                    <TextBlock x:Name="PopupNote" Text="{Binding CardPoolMeta}" Style="{StaticResource OverlayHeaderNote}" TextWrapping="Wrap" MaxHeight="30"
                               Visibility="{Binding CardPoolMeta, Converter={StaticResource Vis}}" />
                    <TextBlock x:Name="PanelNote" Text="{Binding CardPoolSourceNote}" Style="{StaticResource OverlayHeaderNote}" TextWrapping="Wrap" MaxHeight="30"
                               Visibility="{Binding CardPoolSourceNote, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding CardPoolSections}" Focusable="False" Margin="12,8,12,-4" Visibility="{Binding ShowCardPoolPanelSections, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type o:PoolChipModel}">
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== This game: the cards the hovered card looks back at (died, cast, played) ===== -->
            <StackPanel Margin="12,12,12,0" Visibility="{Binding ShowCardPoolList, Converter={StaticResource Vis}}">
                <ContentControl Style="{StaticResource OverlaySection}" Content="{Binding CardPoolListTitle}" Margin="0,0,0,4"
                                Visibility="{Binding CardPoolListTitle, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding CardPoolList}" ItemTemplate="{StaticResource PoolRowTemplate}" Focusable="False" />
                <TextBlock Text="{Binding CardPoolListNote}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                           Visibility="{Binding CardPoolListNote, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- ===== Excavate: the next tier's treasures as rows, then the other tiers in the cycle's order, one line each ===== -->
            <StackPanel Margin="12,12,12,0" Visibility="{Binding ShowCardPoolExcavate, Converter={StaticResource Vis}}">
                <ContentControl Style="{StaticResource OverlaySection}" Content="{Binding CardPoolExcavateNext}" Margin="0,0,0,4"
                                Visibility="{Binding CardPoolExcavateNext, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateRows}" ItemTemplate="{StaticResource PoolRowTemplate}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateTiers}" Focusable="False" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ExcavateTierRow}">
                            <!-- The tier's rarity is its colour: the one place the panel shows one -->
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="3" Height="12" CornerRadius="1.5" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                           Width="34" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Names}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Your open choice: what players take from these options, Hearthpulse data (numbers only, no advice) ===== -->
            <StackPanel Margin="12,12,12,0" Visibility="{Binding CardPoolPicks, Converter={StaticResource Vis}}">
                <ContentControl Style="{StaticResource OverlaySection}" Content="{i:Loc Pool.Picks.Title}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding CardPoolPicks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolPickRowModel}">
                            <!-- Two lines: the name (gold with a star when clearly the most taken), then pick bar, share and win rate; faded on few games. -->
                            <StackPanel Margin="0,0,0,3">
                                <DockPanel>
                                    <TextBlock x:Name="TopMark" DockPanel.Dock="Left" Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="PickName" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Height="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PickBar" Height="6" CornerRadius="3" Background="{StaticResource Hover}" VerticalAlignment="Center">
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource PoolMechanicFill}" />
                                    </Border>
                                    <TextBlock x:Name="PickShare" Grid.Column="1" Text="{Binding PickText}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PickWin" Grid.Column="2" Text="{Binding WinText}" FontSize="9.5" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Top}" Value="True">
                                    <Setter TargetName="TopMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PickName" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LowSample}" Value="True">
                                    <Setter TargetName="PickBar" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="PickShare" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="PickWin" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardPoolPicksNote}" FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0"
                           Visibility="{Binding CardPoolPicksNote, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- ===== Summary: averages, then the most common mechanics, two cells a row ===== -->
            <ItemsControl ItemsSource="{Binding CardPoolSummary}" Focusable="False" Margin="12,12,0,0" Visibility="{Binding CardPoolSummary, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type o:PoolAverage}">
                        <DockPanel Height="18" Margin="0,0,12,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Most played in meta decks: rows with their share ===== -->
            <StackPanel Margin="12,12,12,0" Visibility="{Binding CardPoolTopCards, Converter={StaticResource Vis}}">
                <ContentControl Style="{StaticResource OverlaySection}" Content="{i:Loc Pool.FeaturedReason}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding CardPoolTopCards}" ItemTemplate="{StaticResource PoolRowTemplate}" Focusable="False" />
            </StackPanel>

            <!-- ===== The end of the pool: the right-click hint (gold while the pointer holds the pool) ===== -->
            <TextBlock Text="{i:Loc Pool.RightClickHint}" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" Margin="12,8,12,8" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding CardPoolHasCards, Converter={StaticResource Vis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CardPoolHeld}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Height="8" Visibility="{Binding CardPoolHasCards, Converter={StaticResource Vis}, ConverterParameter=!}" />

            <!-- ===== Related cards: a zone of its own under a full-width hairline, not part of the pool ===== -->
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8,12,8" Visibility="{Binding ShowCardPoolRelated, Converter={StaticResource Vis}}">
                <StackPanel>
                    <ContentControl Style="{StaticResource OverlaySection}" Content="{Binding CardPoolRelatedTitle}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding CardPoolRelated}" ItemTemplate="{StaticResource PoolRowTemplate}" Focusable="False" />
                    <TextBlock Text="{Binding CardPoolRelatedNote}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                               Visibility="{Binding CardPoolRelatedNote, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
