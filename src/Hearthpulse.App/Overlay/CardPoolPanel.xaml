<UserControl x:Class="Hearthpulse.App.Overlay.CardPoolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- The compact card pool panel (300 wide): at its own spot (MovablePanel "card-pool") or next to its card (the card
         pool layer). The cards of this game a hovered card looks back at, one line of averages, the most played cards as
         tracker rows; the full view is the pool browser
         (right-click). DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <Style x:Key="PoolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- A tracker row: cost gem, the whole name over a strip of art, rarity strip, "×2" when it counts twice. -->
        <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type o:PoolListRow}">
            <Grid Height="22" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:ManaCost Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Style="{StaticResource OverlayRarityStrip}" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                        <DockPanel Margin="9,0,3,0">
                            <Border DockPanel.Dock="Right" Style="{StaticResource OverlayCountBadge}" Height="16" Visibility="{Binding CountText, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource OverlayRowSheen}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Not interactive: clicks reach the board and the Discover options under it; hover and right-click are polled.
         The opacity carries the short fade-in when the panel appears or its pool changes. -->
    <Border x:Name="Card" Style="{StaticResource OverlayCard}" Width="300" Background="{StaticResource OverlayPanelSolid}">
        <StackPanel>
            <!-- ===== Summary: pool size, the generator card, classes · format, sections ===== -->
            <Border Style="{StaticResource OverlayHeader}">
                <StackPanel>
                    <TextBlock Text="{Binding CardPoolTitle}" Style="{StaticResource OverlayHeaderTitle}" />
                    <TextBlock Text="{Binding CardPoolPhrase}" Style="{StaticResource OverlayHeaderNote}" TextTrimming="None" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Margin="12,5,12,0">
                <TextBlock Text="{Binding CardPoolMeta}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding CardPoolMeta, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding CardPoolSections}" Focusable="False" Margin="0,5,0,-4" Visibility="{Binding ShowCardPoolPanelSections, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolChipModel}">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Excavate: the next tier's treasures as tracker rows, then the other tiers in the cycle's order, one line each ===== -->
            <StackPanel Margin="12,9,12,0" Visibility="{Binding ShowCardPoolExcavate, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding CardPoolExcavateNext}" Style="{StaticResource PoolLabel}" Foreground="{StaticResource Accent}"
                           Visibility="{Binding CardPoolExcavateNext, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateRows}" ItemTemplate="{StaticResource ListRowTemplate}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding CardPoolExcavateTiers}" Focusable="False" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:ExcavateTierRow}">
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="3" Height="11" CornerRadius="1.5" Margin="0,0,5,0" VerticalAlignment="Center"
                                        Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Width="34" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Names}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== This game: the cards the hovered card looks back at (died, cast, played), as tracker rows ===== -->
            <StackPanel Margin="12,9,12,0" Visibility="{Binding ShowCardPoolList, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding CardPoolListTitle}" Style="{StaticResource PoolLabel}" Visibility="{Binding CardPoolListTitle, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding CardPoolList}" ItemTemplate="{StaticResource ListRowTemplate}" Focusable="False">
                </ItemsControl>
                <TextBlock Text="{Binding CardPoolListNote}" FontSize="9.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"
                           Visibility="{Binding CardPoolListNote, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- ===== Your open choice: what players take from these options, Hearthpulse data (numbers only, no advice) ===== -->
            <StackPanel Margin="12,9,12,0" Visibility="{Binding CardPoolPicks, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Pool.Picks.Title}" Style="{StaticResource PoolLabel}" />
                <ItemsControl ItemsSource="{Binding CardPoolPicks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolPickRowModel}">
                            <!-- Two lines: the name (gold with a star when clearly the most taken), then pick bar, share and win rate; faded on few games. -->
                            <StackPanel Margin="0,0,0,3">
                                <DockPanel>
                                    <TextBlock x:Name="TopMark" DockPanel.Dock="Left" Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="PickName" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Height="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PickBar" Height="6" CornerRadius="3" Background="{StaticResource Hover}" VerticalAlignment="Center">
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource PoolMechanicFill}" />
                                    </Border>
                                    <TextBlock x:Name="PickShare" Grid.Column="1" Text="{Binding PickText}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PickWin" Grid.Column="2" Text="{Binding WinText}" FontSize="9.5" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Top}" Value="True">
                                    <Setter TargetName="TopMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PickName" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LowSample}" Value="True">
                                    <Setter TargetName="PickBar" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="PickShare" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="PickWin" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CardPoolPicksNote}" FontSize="9.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0" />
            </StackPanel>

            <!-- ===== One line of averages: "Average  Mana 6  Attack 4.2  Health 5.1" ===== -->
            <DockPanel Margin="12,9,12,0" Visibility="{Binding CardPoolAverages, Converter={StaticResource Vis}}">
                <TextBlock DockPanel.Dock="Left" Text="{i:Loc Pool.Average}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ItemsControl ItemsSource="{Binding CardPoolAverages}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolAverage}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,11,0">
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ===== The most common mechanics, one quiet line ===== -->
            <ItemsControl ItemsSource="{Binding CardPoolMechanicRows}" Focusable="False" Margin="12,5,12,0" Visibility="{Binding CardPoolMechanicRows, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type o:PoolMechanicRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,1">
                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding PercentText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="3,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Most played in meta decks: tracker rows (cost gem, whole name over the art strip, share) ===== -->
            <StackPanel Margin="12,10,12,0" Visibility="{Binding CardPoolTopCards, Converter={StaticResource Vis}}">
                <TextBlock Text="{i:Loc Pool.FeaturedReason}" Style="{StaticResource PoolLabel}" />
                <ItemsControl ItemsSource="{Binding CardPoolTopCards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type o:PoolTopRow}">
                            <Grid Height="22" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:ManaCost Text="{Binding Cost}" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                                    <Grid>
                                        <Image i:CardArt.Tile="{Binding CardId}" Width="112" HorizontalAlignment="Right" Stretch="UniformToFill" />
                                        <Rectangle Fill="{StaticResource TileFade}" />
                                        <Border Style="{StaticResource OverlayRarityStrip}" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}" />
                                        <DockPanel Margin="9,0,3,0">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource OverlayCountBadge}" Height="16">
                                                <TextBlock Text="{Binding ShareText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Style="{StaticResource OverlayRowSheen}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{i:Loc Pool.RightClickHint}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,8"
                       Visibility="{Binding CardPoolHasCards, Converter={StaticResource Vis}}" />
            <Border Height="9" Visibility="{Binding CardPoolHasCards, Converter={StaticResource Vis}, ConverterParameter=!}" />
        </StackPanel>
    </Border>
</UserControl>
