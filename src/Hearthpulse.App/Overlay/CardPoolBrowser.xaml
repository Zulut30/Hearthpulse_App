<UserControl x:Class="Hearthpulse.App.Overlay.CardPoolBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:p="clr-namespace:Hearthpulse.Core.CardPool;assembly=Hearthpulse.Core">
    <!-- The pool browser (MovablePanel "card-pool-browser"): every card of the pool. DataContext is the OverlayViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <i:VisibleWhen x:Key="Vis" />

        <DataTemplate x:Key="FilterChipTemplate" DataType="{x:Type o:PoolChipModel}">
            <Border x:Name="Chip" CornerRadius="6" Padding="8,3" Margin="0,0,5,5" Cursor="Hand" Background="{StaticResource Surface3}"
                    BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1" MouseLeftButtonUp="OnChipClick">
                <TextBlock x:Name="Text" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentContainer}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource OnAccentContainer}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type p:PoolEntry}">
            <Image i:CardRender.Card="{Binding CardId}" Stretch="Uniform" Margin="2,0" Cursor="Hand"
                   Height="{Binding DataContext.CardPoolCardHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   ToolTipService.InitialShowDelay="150" ToolTipService.Placement="Right" ToolTipService.HorizontalOffset="8">
                <Image.ToolTip>
                    <ToolTip Padding="0" Background="Transparent" BorderThickness="0">
                        <Image i:CardRender.Card="{Binding CardId}" Width="258" Height="364" Stretch="Uniform" />
                    </ToolTip>
                </Image.ToolTip>
            </Image>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type o:PoolCardRowModel}">
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,0,6" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCard}" Background="{StaticResource OverlayPanelSolid}" Height="1064"
            Width="{Binding CardPoolBrowserWidth}" o:OverlayHit.Interactive="True" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: "<Card> Pool: N cards" and the close button -->
            <Border Style="{StaticResource OverlayHeader}" Padding="14,8,8,7">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" VerticalAlignment="Top" Focusable="False"
                            Command="{Binding CloseCardPoolBrowser}" ToolTip="{i:Loc Pool.CloseEsc}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CardPoolBrowserTitle}" Style="{StaticResource OverlayHeaderTitle}" TextTrimming="None" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CardPoolDescription}" Style="{StaticResource OverlayHeaderNote}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Highlighted card, as on the compact panel -->
            <Border Grid.Row="1" Height="30" Background="{StaticResource Row}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="0,1"
                    Visibility="{Binding CardPoolFeatured, Converter={StaticResource Vis}}" ToolTip="{Binding CardPoolFeaturedNote}">
                <Grid>
                    <Grid Width="200" HorizontalAlignment="Right">
                        <Image i:CardArt.Tile="{Binding CardPoolFeatured.CardId}" Width="150" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xF04CE;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CardPoolFeatured.Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILTERS: mechanics of this pool; the selected ones must all be on a card -->
            <StackPanel Grid.Row="2" Margin="14,8,14,4">
                <!-- Excavate: what the player's next Excavate gives; the tier chips below filter the grid, which starts at that tier -->
                <TextBlock Text="{Binding CardPoolExcavateNext}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"
                           Visibility="{Binding CardPoolExcavateNext, Converter={StaticResource Vis}}" />
                <!-- The generator's separate pools (Hearthstone Wiki): click one to see only its cards -->
                <ItemsControl ItemsSource="{Binding CardPoolSections}" ItemTemplate="{StaticResource FilterChipTemplate}" Margin="0,0,0,6" Visibility="{Binding CardPoolSections, Converter={StaticResource Vis}}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <DockPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnFiltersClick" Visibility="{Binding CardPoolFilterChips, Converter={StaticResource Vis}}">
                    <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xF0140;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardPoolFiltersOpen}" Value="True">
                                        <Setter Property="Text" Value="&#xF0143;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc Pool.Filters}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding CardPoolFilterActive, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding CardPoolBrowserNote}" FontSize="10.5" Foreground="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding CardPoolFilterChips}" ItemTemplate="{StaticResource FilterChipTemplate}" Margin="0,8,0,0" Focusable="False"
                              Visibility="{Binding CardPoolFiltersOpen, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Card grid: rows of three, virtualized, pixel scrolling eased in code-behind -->
            <ItemsControl Grid.Row="3" x:Name="Grid" ItemsSource="{Binding CardPoolBrowserRows}" ItemTemplate="{StaticResource RowTemplate}" Margin="10,4,4,10"
                          Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0"
                                      PreviewMouseWheel="OnWheel">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Right edge (the browser sits at the left of the screen): drag to change the width -->
            <Thumb Grid.RowSpan="4" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragDelta="OnResize" DragCompleted="OnResized" />
        </Grid>
    </Border>
</UserControl>
