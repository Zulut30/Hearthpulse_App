<UserControl x:Class="Hearthpulse.App.Overlay.BgBadgesLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             IsHitTestVisible="False" Focusable="False">
    <!-- Badges beside the leaderboard tiles ("bg-badges", DataContext: the overlay view model): tavern tier, then the main
         tribe of the board last seen with its count. Each item fills the strip right of its tile and centres on it. -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
    </UserControl.Resources>
    <ItemsControl x:Name="Badges" ItemsSource="{Binding BgBadges}" Visibility="{Binding ShowBgBadges, Converter={StaticResource Vis}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                <Setter Property="Height" Value="{Binding Height}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type o:BgBadge}">
                <!-- Tier shield | tribe capsule (fixed width, so the next column lines up down the leaderboard) | column 2 kept
                     empty for the opponents' rating (up to 6 characters): it takes its width from that text -->
                <Grid x:Name="Badge" Height="24" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Tier" Width="20" Height="24">
                        <Path Data="M0.5,0.5 H19.5 V11 C19.5,17 15.5,21.5 10,23.5 C4.5,21.5 0.5,17 0.5,11 Z" Stretch="None"
                              Fill="{StaticResource OverlayBadgeShade}" Stroke="{StaticResource AccentDeep}" StrokeThickness="1" />
                        <!-- Raised: the shield's point puts its visual centre above the middle -->
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" />
                    </Grid>
                    <!-- Empty until a board was seen: an opponent's only after a fight with them -->
                    <Border x:Name="Tribe" Grid.Column="1" Height="18" CornerRadius="9" Padding="0,0,6,0" Margin="4,0,0,0" HorizontalAlignment="Left"
                            Background="{StaticResource OverlayBadgeShade}" Visibility="{Binding Tribe, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource AccentDeep}" BorderThickness="1">
                                <TextBlock Text="{Binding Tribe.Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding TribeCount}" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Dead}" Value="True">
                        <Setter TargetName="Badge" Property="Opacity" Value="0.35" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
