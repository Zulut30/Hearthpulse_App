<UserControl x:Class="Hearthpulse.App.Overlay.BgBadgesLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             IsHitTestVisible="False" Focusable="False">
    <!-- Labels beside the leaderboard tiles ("bg-badges", DataContext: the overlay view model), in words: "Tavern 5", then the
         main tribe of the board last seen ("Quilboar: 4 of 7"). No glyphs. Each item fills the strip right of its tile and
         centres on it; the whole layer hides while the mouse is on the leaderboard (the game's popup sits there). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
    </UserControl.Resources>
    <ItemsControl x:Name="Badges" ItemsSource="{Binding BgBadges}" Visibility="{Binding ShowBgBadges, Converter={StaticResource Vis}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                <Setter Property="Height" Value="{Binding Height}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type o:BgBadge}">
                <!-- The label in words, two lines: "Tavern 5", then "Quilboar: 4 of 7" once a fight showed the board -->
                <Grid x:Name="Badge" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border x:Name="Label" MinWidth="72" CornerRadius="4" Padding="6,2" Background="{DynamicResource OverlayBadgeShade}"
                            BorderBrush="{StaticResource AccentDeep}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{i:Loc Overlay.LeaderboardBadge.Tier}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Empty until a board was seen and a tribe has two minions on it -->
                            <TextBlock Text="{Binding Tribe}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Text}"
                                       Visibility="{Binding HasTribe, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
