<UserControl x:Class="Hearthpulse.App.Overlay.BgBadgesLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             IsHitTestVisible="False" Focusable="False">
    <!-- Badges beside the leaderboard tiles ("bg-badges", DataContext: the overlay view model): tavern tier, then the main
         tribe of the board last seen with its count. Each item fills the strip right of its tile and centres on it. -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
    </UserControl.Resources>
    <ItemsControl x:Name="Badges" ItemsSource="{Binding BgBadges}" Visibility="{Binding ShowBgBadges, Converter={StaticResource Vis}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                <Setter Property="Height" Value="{Binding Height}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type o:BgBadge}">
                <!-- Column 2 is kept empty for the opponents' rating (up to 6 characters): it takes its width from that text -->
                <Grid x:Name="Badge" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Tier" Width="22" Height="22" CornerRadius="5" Background="{StaticResource OverlayPanelSolid}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1">
                        <TextBlock Text="{Binding Tier}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Empty until a board was seen: an opponent's only after a fight with them -->
                    <Border x:Name="Tribe" Grid.Column="1" Height="22" CornerRadius="11" Padding="3,0,6,0" Margin="4,0,0,0"
                            Background="{StaticResource OverlayPanelSolid}" Visibility="{Binding Tribe, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tribe.Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TribeCount}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Dead}" Value="True">
                        <Setter TargetName="Badge" Property="Opacity" Value="0.35" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
