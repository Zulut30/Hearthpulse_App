<UserControl x:Class="Hearthpulse.App.Overlay.ArenaPicksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Arena draft: a badge over each offered card (ArenaSmith score and tier, its place on the curve and among the
         deck's types) or hero (class win rate and place), the best one in gold. Laid across the width of the draft screen's card row, so each badge sits over its card. Nothing here
         takes clicks: the cards under it stay clickable. DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
        <i:KeyBrush x:Key="KeyBrush" />
        <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />

        <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type o:ArenaPickBadge}">
            <Border x:Name="Badge" HorizontalAlignment="Center" Background="{StaticResource OverlayPanelSolid}" BorderBrush="{StaticResource OverlayBorder}"
                    BorderThickness="1.5" CornerRadius="14" Padding="6,5,14,5" MinWidth="138">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" />
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Star" Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                       Margin="0,0,4,0" Visibility="{Binding IsBest, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Number}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="Caption" Text="{Binding Caption}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <!-- Where the card would sit in the deck: its curve bucket, its type (or package) -->
                        <TextBlock Text="{Binding FitCost}" FontSize="10" Foreground="{StaticResource Text}" Margin="0,2,0,0"
                                   Visibility="{Binding FitCost, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding FitType}" FontSize="10" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding FitType, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="2.5" />
                    <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Width="{Binding ArenaPickRowWidth}" IsHitTestVisible="False">
        <Border Height="{Binding ArenaPickDrop}" />
        <ItemsControl ItemsSource="{Binding ArenaPicks}" ItemTemplate="{StaticResource BadgeTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="{Binding ArenaSource}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
