<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ===== Palette: Hearthstone menus - dark wood browns, parchment text, gold trim ===== -->
            <Color x:Key="BgColor">#140D08</Color>
            <Color x:Key="SurfaceColor">#21160E</Color>
            <Color x:Key="Surface2Color">#2B1D12</Color>
            <Color x:Key="Surface3Color">#3A2817</Color>
            <Color x:Key="Surface4Color">#4A331E</Color>
            <Color x:Key="BorderColor">#3D2A19</Color>
            <Color x:Key="OutlineColor">#6E4E2C</Color>
            <Color x:Key="TextColor">#F4E7C9</Color>
            <Color x:Key="MutedColor">#CDB894</Color>
            <Color x:Key="FaintColor">#8F7A5C</Color>
            <Color x:Key="AccentColor">#E9B949</Color>
            <Color x:Key="AccentDeepColor">#C48E2C</Color>
            <Color x:Key="AccentContainerColor">#5A3D17</Color>
            <Color x:Key="SecondaryContainerColor">#3F2C19</Color>
            <Color x:Key="PositiveColor">#8CCF63</Color>
            <Color x:Key="NegativeColor">#EC6A52</Color>
            <Color x:Key="InfoColor">#6FB8F2</Color>

            <!-- Fluent controls (sliders, scroll bars, focus) pick up the app accent: Hearthstone gold. -->
            <Color x:Key="SystemAccentColor">#E9B949</Color>
            <Color x:Key="SystemAccentColorDark1">#C48E2C</Color>
            <Color x:Key="SystemAccentColorDark2">#8A6533</Color>
            <Color x:Key="SystemAccentColorDark3">#5A3D17</Color>
            <Color x:Key="SystemAccentColorLight1">#EFC865</Color>
            <Color x:Key="SystemAccentColorLight2">#F5D88A</Color>
            <Color x:Key="SystemAccentColorLight3">#FBE3A6</Color>

            <!-- Fluent scroll bars: parchment-tinted thumb (same as the WPF ScrollThumb), warm track and arrows. -->
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#2EF4E7C9</Color>
            <Color x:Key="ScrollBarThumbBackgroundColor">#2EF4E7C9</Color>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#2EF4E7C9" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#55F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#55F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#21160E" Opacity="0.9" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#21160E" Opacity="0.9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#CDB894" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#8F7A5C" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#1FF4E7C9" />

            <!-- Fluent sliders: the unfilled track is Surface4 (Outline on hover), like the WPF slider. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#4A331E" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#6E4E2C" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4A331E" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#3A2817" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#8F7A5C" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#8F7A5C" />

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="Surface4" Color="{StaticResource Surface4Color}" />
            <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1FE9B949" />
            <SolidColorBrush x:Key="AccentLine" Color="#99E9B949" />
            <SolidColorBrush x:Key="AccentContainer" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="OnAccentContainer" Color="#FBE3A6" />
            <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
            <SolidColorBrush x:Key="OnSecondaryContainer" Color="#EBDDBD" />
            <SolidColorBrush x:Key="OnAccent" Color="#2A1906" />
            <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="PositiveSoft" Color="#228CCF63" />
            <SolidColorBrush x:Key="Negative" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="NegativeSoft" Color="#24EC6A52" />
            <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="Hover" Color="#12F4E7C9" />
            <SolidColorBrush x:Key="Pressed" Color="#1FF4E7C9" />
            <SolidColorBrush x:Key="Decor" Color="#0EE9B949" />
            <SolidColorBrush x:Key="DecorStrong" Color="#16E9B949" />
            <SolidColorBrush x:Key="OverlayPanel" Color="#F0201510" />
            <SolidColorBrush x:Key="OverlayPanelSolid" Color="#FA201510" />
            <SolidColorBrush x:Key="OverlayBorder" Color="#40E9B949" />
            <SolidColorBrush x:Key="ManaGem" Color="#3D7BE0" />
            <SolidColorBrush x:Key="Row" Color="#2E1F13" />
            <SolidColorBrush x:Key="Ink" Color="{StaticResource BgColor}" />
            <LinearGradientBrush x:Key="TileFade" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FF2E1F13" Offset="0" />
                <GradientStop Color="#FF2E1F13" Offset="0.42" />
                <GradientStop Color="#662E1F13" Offset="0.8" />
                <GradientStop Color="#142E1F13" Offset="1" />
            </LinearGradientBrush>

            <!-- Gold trim, framed edges and the selected / primary fills. -->
            <SolidColorBrush x:Key="GoldTrim" Color="#8A6533" />
            <SolidColorBrush x:Key="GoldFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelEdge" Color="#3D2A19" />
            <SolidColorBrush x:Key="SelectedEdge" Color="#8A6533" />
            <LinearGradientBrush x:Key="SelectedFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#4A331E" Offset="0" />
                <GradientStop Color="#36251A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F2CB5C" Offset="0" />
                <GradientStop Color="#C99331" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F7D676" Offset="0" />
                <GradientStop Color="#D6A040" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="RarityCommon" Color="#D8CDB8" />
            <SolidColorBrush x:Key="RarityRare" Color="#5B9BFF" />
            <SolidColorBrush x:Key="RarityEpic" Color="#B98AF5" />
            <SolidColorBrush x:Key="RarityLegendary" Color="#FFB547" />

            <SolidColorBrush x:Key="TierS" Color="#FFC857" />
            <SolidColorBrush x:Key="TierA" Color="#8CCF63" />
            <SolidColorBrush x:Key="TierB" Color="#7CC0FF" />
            <SolidColorBrush x:Key="TierC" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="TierD" Color="{StaticResource NegativeColor}" />

            <!-- ===== Type: Montserrat for display (OFL), the platform UI font for text, Material Design Icons ===== -->
            <!-- UiFont is replaced at startup with the platform's UI font (Segoe UI on Windows, Inter elsewhere). -->
            <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="DisplayFont">avares://Hearthlens.UI/Assets/Fonts#Montserrat</FontFamily>
            <FontFamily x:Key="IconFont">avares://Hearthlens.UI/Assets/Fonts#Material Design Icons</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces: framed panels with a thin bronze edge ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style Selector="Border.overlayCard">
        <Setter Property="Background" Value="{StaticResource OverlayPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,2" />
    </Style>
    <Style Selector="Border.segmentBar">
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- ===== Buttons: framed rectangles, gold for the primary action ===== -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                    <Border Name="State" Background="Transparent" CornerRadius="8" />
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource PrimaryFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{StaticResource PrimaryFillHover}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#State">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>

    <!-- Round icon buttons stay circles. -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="999" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- A button with no chrome: the content draws everything (overlay chips, rows). -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== Navigation: framed item with a gold bar on the left of the active one ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="10,2" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Bd" CornerRadius="8" Margin="10,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Panel>
                            <Border Name="Bar" Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}" IsVisible="False" />
                            <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                <!-- No "icon" class here: a class style would outrank these template values in Avalonia. -->
                                <TextBlock Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontSize="20"
                                           FontWeight="Normal" Width="24" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ TextBlock#Glyph">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ===== Chips / segmented filter ===== -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="6" Padding="12,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="Check" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="14" FontWeight="Normal"
                                   Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" IsVisible="False" />
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.segment:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ TextBlock#Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Switch (the track stays rounded: it is a toggle) ===== -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Name="Track" Grid.Column="1" Width="48" Height="28" CornerRadius="14"
                            Background="{StaticResource Surface4}" BorderBrush="{StaticResource Faint}" BorderThickness="2">
                        <Panel Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="5,0">
                            <Ellipse Name="Knob" Fill="{StaticResource Faint}" />
                            <TextBlock Name="Tick" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="14" FontWeight="Normal"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Panel#Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ TextBlock#Tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ===== List rows ===== -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="-10,0,-10,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- List boxes draw no chrome: rows style themselves. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="0,0,0,3" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="8" Padding="13,9" Margin="0,0,0,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:selected /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</Styles>
