<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hearthpulse.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface strings, read by Localization/Loc.cs (docs/localization.md). Plain embedded JSON, not resx: the hosts
         set SatelliteResourceLanguages=en, which would drop satellite assemblies of other languages. -->
    <EmbeddedResource Include="Localization\Strings\en\*.json" LogicalName="Hearthpulse.Loc.en.%(Filename).json" />
    <EmbeddedResource Include="Localization\Strings\ru\*.json" LogicalName="Hearthpulse.Loc.ru.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hearthpulse.Tests" />
  </ItemGroup>

</Project>
