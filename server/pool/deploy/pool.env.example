POOL_HOST=127.0.0.1
POOL_PORT=3181
POOL_DATA_DIR=/var/lib/hearthpulse-pool
# Deliberately small staging limits; reserve includes source input and bounded worker output.
POOL_ARCHIVE_BYTES=268435456
POOL_DAILY_BYTES=134217728
POOL_DAILY_CAPTURES=1000
POOL_MIN_FREE_BYTES=67108864
POOL_RETENTION_DAYS=180
POOL_UNFINISHED_HOURS=24
POOL_MAX_REQUESTS=4
POOL_LEGACY_DAILY=15000
POOL_EVENTS_DAILY=10000
POOL_WORKER_TIMEOUT_MS=120000
# P4 installs the real self-contained P3 executable at this fixed operator-selected path.
# Leave BOTH unset until installed. Sources then stay stored. No parser version is hardcoded by the API.
# POOL_WORKER_EXECUTABLE=/opt/hearthpulse-pool/worker/Hearthpulse.SourceWorker
# systemd EnvironmentFile removes outer single quotes; the JSON double quotes must survive.
# POOL_WORKER_ARGS='[]'
# Set locally to a generated secret (never commit the value). Without it reprocess is disabled.
# POOL_OPERATOR_TOKEN=
